// The math functions (SQLITE_ENABLE_MATH_FUNCTIONS), compared with the sqlite3 shell. The shell prints reals with
// 17 significant digits, so these answers match bit for bit; the arguments are ones where libm.cee and the libm
// of macOS agree (README.md says how often they differ on random arguments).

@test
fn mathFunctionsOnOrdinaryValues() -> Result<void, TestFailure> {
    let path = "out/math-ordinary.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT sin(0.5), sin(1), sin(2), sin(-3), sin(10), sin(100), cos(0.5), cos(1), cos(2), cos(-3), cos(10), cos(100)
        SELECT tan(0.5), tan(3), tan(100), tan(pi() / 4), tan(-0.25), tan(1e-10)
        SELECT asin(0.4), asin(-0.25), asin(0.99), asin(1), acos(0.25), acos(-0.75), acos(0.99), acos(-1), acos(1)
        SELECT atan(0.25), atan(-3), atan(0.1), atan(-7), atan(1e10), atan2(1, 2), atan2(-1, -2), atan2(3, -4), atan2(0, -1)
        SELECT sinh(0.5), sinh(-3), sinh(30), cosh(0.5), cosh(-3), cosh(30), tanh(0.5), tanh(-3), tanh(30)
        SELECT asinh(0.5), asinh(-3), asinh(1e10), acosh(1.5), acosh(3), acosh(1e10), atanh(0.5), atanh(-0.25), atanh(0.99)
        SELECT exp(1), exp(-1), exp(10), exp(0.5), exp(-20), exp(700)
        SELECT ln(2), ln(10), ln(0.5), ln(1e300), log(100), log(2), log(1000), log10(1e-5), log10(3), log2(8), log2(3), log2(1e-300)
        SELECT log(2, 8), log(10, 1000), log(3, 81), log(1.5, 7), log(100, 0.5)
        SELECT pow(2, 10), pow(2, 0.5), power(10, -2), pow(-8, 3), pow(-2, -3), pow(1.5, 2.5), pow(10, 308), pow(7, 1 / 3.0)
        SELECT degrees(pi()), degrees(1), degrees(-0.5), radians(180), radians(1), radians(-45)
        SELECT sqrt(2), sqrt(16), sqrt(0.5), pi(), mod(7, 3), mod(-7, 3), mod(7.5, 2), mod(5, 0), mod(5, 1.5)
        SELECT floor(2.5), floor(-2.5), floor(3), ceil(2.5), ceiling(-2.5), ceil(3), trunc(2.7), trunc(-2.7), trunc(-3)
        SELECT sign(-2), sign(0), sign(2.5), abs(-3), abs(-3.5)
        """);
}

@test
fn mathFunctionsOnSpecialValues() -> Result<void, TestFailure> {
    let path = "out/math-special.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT sin(0), sin(-0.0), cos(0), tan(-0.0), asin(0), atan(-0.0), sinh(-0.0), tanh(-0.0), asinh(-0.0), atanh(-0.0)
        SELECT sin(1e999), cos(-1e999), tan(1e999), atan(1e999), atan(-1e999), tanh(1e999), tanh(-1e999)
        SELECT exp(1e999), exp(-1e999), exp(710), exp(-746), exp(-740), exp(709.7), sinh(1e999), cosh(-1e999), sinh(710), cosh(710)
        SELECT asinh(1e999), acosh(1e999), atanh(1), atanh(-1), atanh(2), acosh(0.5), acosh(1), asin(1.5), acos(-1.5)
        SELECT ln(0), ln(-1), log(-0.0), log10(0), log2(-5), ln(1e999), log(1), log2(1), log10(1)
        SELECT log(1, 8), log(0.5, 8), log(-2, 8), log(2, 0), log(2, -8), log(0, 8)
        SELECT pow(0, 0), pow(0, -1), pow(-1e-300 * 1e-300, -1), pow(-8, 1.0 / 3), pow(1e999, 0), pow(1, 1e999), pow(-1, 1e999), pow(2, 1e999), pow(0.5, 1e999), pow(2, -1e999)
        SELECT pow(1e999, -1), pow(-1e999, 3), pow(-1e999, 2), pow(2, 1024), pow(2, -1075), pow(2, -1074), pow(10, -320), pow(-2, 0.5)
        SELECT atan2(0, 0), atan2(0, -1e-300 * 1e-300), atan2(-1e-300 * 1e-300, -1), atan2(1, 0), atan2(-1, 0), atan2(1e999, 1e999), atan2(1e999, -1e999), atan2(1, 1e999), atan2(1, -1e999), atan2(1e300, 1e-300)
        SELECT degrees(1e308), radians(1e999), sqrt(-1), sqrt(-0.0), sqrt(1e999), mod(1e999, 2), mod(2, 1e999)
        SELECT exp(5e-324), sin(5e-324), log(5e-324), log2(5e-324), log10(2.2250738585072014e-308), pow(5e-324, 0.5)
        """);
}

@test
fn trigonometryOfLargeArguments() -> Result<void, TestFailure> {
    let path = "out/math-large.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT sin(1e22), cos(1e22), sin(1e300), cos(1e300), sin(1.7976931348623157e308), cos(-1.7976931348623157e308)
        SELECT sin(1e6), cos(1e6), tan(1e6), sin(123456789), cos(123456789), sin(2 * pi()), cos(pi()), sin(pi())
        SELECT sin(3.14159265358979), cos(1.5707963267949), sin(6.28318530717959), sin(1e15), cos(1e17), sin(-1e19), tan(-1e19)
        SELECT asin(0.5), atan(0.5), acos(0.3), tan(0.7), atanh(0.4), asinh(0.6), tan(1.2), acos(-0.9)
        """);
}

@test
fn mathFunctionsAgreeWithTheShellOnManyArguments() -> Result<void, TestFailure> {
    // The engine calls the platform's libm, as sqlite3 does: every result the same, bit for bit (%!.17g).
    let path = "out/math-sweep.db";
    makeDatabase(path, """
        CREATE TABLE a(x REAL);
        WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 400)
        INSERT INTO a SELECT (i * 7919 % 2003 - 1001) / 97.3 FROM c;
        """)?;
    return sameAnswers(path, """
        SELECT printf('%!.17g %!.17g %!.17g %!.17g %!.17g', sin(x), cos(x), tan(x), atan(x), exp(x / 4)) FROM a
        SELECT printf('%!.17g %!.17g %!.17g %!.17g', asin(x / 11), acos(x / 11), atanh(x / 11), asinh(x)) FROM a
        SELECT printf('%!.17g %!.17g %!.17g %!.17g', ln(abs(x)), log10(abs(x)), log2(abs(x)), pow(abs(x), 0.37)) FROM a
        SELECT printf('%!.17g %!.17g %!.17g %!.17g', sinh(x / 3), cosh(x / 3), tanh(x), atan2(x, 1.3)) FROM a
        """);
}

@test
fn mathFunctionsOnTextAndNull() -> Result<void, TestFailure> {
    let path = "out/math-text.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT sin(NULL), cos('abc'), exp(''), ln(x'31'), pow(NULL, 2), pow(2, NULL), atan2('x', 1), atan2(1, x'00')
        SELECT sin('1'), cos(' 2 '), exp('1e1'), ln('2.5'), pow('2', '3'), atan2('1', '-1'), degrees('3'), radians(' 90')
        SELECT sin('1abc'), exp('1 x'), log('100'), log('2', '8'), log(2, '8abc'), log(2, NULL), log(2, x'38'), log(NULL, 8), log('b', 8)
        SELECT sqrt('4'), sqrt('abc'), sqrt(x'34'), sqrt(NULL), mod('7', '3'), mod('abc', 2), mod(x'35', 3), mod(5, NULL)
        SELECT floor('2.5'), ceil('2.5'), trunc('-2.5'), floor('3'), floor(x'33'), ceil('abc'), trunc('2.5x'), floor(NULL), sign(x'31')
        SELECT typeof(sin(1)), typeof(floor(2)), typeof(floor(2.0)), typeof(sqrt(4)), typeof(pow(2, 2)), typeof(sin(1e999))
        SELECT SIN(1), Log10(100), POWER(2, 3), Ln(1)
        """);
}

@test
fn mathFunctionsOverTableRows() -> Result<void, TestFailure> {
    let path = "out/math-rows.db";
    makeDatabase(path, """
        CREATE TABLE t(x REAL);
        WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 200)
        INSERT INTO t SELECT i * 0.37 - 40 FROM c;
        """)?;
    return sameAnswers(path, """
        SELECT count(*), sum(sin(x) IS NULL), sum(ln(x) IS NULL), sum(asin(x / 40) IS NULL) FROM t
        SELECT x, exp(x), sinh(x / 2), cosh(x / 2), tanh(x / 4), atan2(x, 3) FROM t WHERE x BETWEEN -5 AND 5
        SELECT x, ln(x), log10(x), log2(x), sqrt(x), pow(x, 1.5) FROM t WHERE x > 0
        """);
}
