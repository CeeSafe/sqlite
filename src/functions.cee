// The built-in functions: scalar ones here, aggregates and window functions named here and computed in
// aggregate.cee. Each follows SQLite's func.c (3.53): its NULL handling, its types, its argument counts.
//
// Differences from the C# engine, which this replaces (each checked against sqlite3 3.54):
// - LIKE and GLOB are a port of SQLite's patternCompare: LIKE folds ASCII letters only, `[...]` sets, ranges and
//   `^` work in GLOB, an ESCAPE must be one character, and text stops at a NUL as in SQLite;
// - length() counts characters up to the first NUL, and substr() counts characters for text and bytes for blobs,
//   with SQLite's rules for a negative start and length;
// - iif() takes two or more arguments like a CASE, and coalesce(), ifnull() and iif() evaluate only the arguments
//   they need;
// - abs() of the smallest integer is an "integer overflow" error, as in SQLite; abs() of text is a real;
// - round() goes through SQLite's own decimal rounding, so round(1.005, 2) is 1.0 as in SQLite, and round() of
//   an integer is a real;
// - quote() of a real has 17 significant digits (shortened as SQLite shortens them), and infinity is 9.0e+999;
// - sign() of text that is not entirely a number is NULL;
// - min(), max() and nullif() compare with the collation of their arguments.
//
// The date and time functions are in datetime.cee, printf() and format() in printf.cee, and the JSON functions
// are named here and computed in json.cee.
//
// The math functions (sin, log, pow and the rest) compute with libm.cee, a port of FreeBSD's msun; their results
// may differ in the last bit from the platform's libm that sqlite3 uses. floor(), ceil(), trunc(), sqrt() and
// mod() of a blob or of text that is not a number are NULL, as in SQLite.
//
// json_each, json_tree, jsonb_each and jsonb_tree are table-valued functions (json_each.cee).

enum ScalarFunction {
    Abs,
    Ceil,
    Changes,
    Char,
    Coalesce,
    Concat,
    ConcatWs,
    Date,
    Datetime,
    Floor,
    Glob,
    Hex,
    IfNull,
    Iif,
    Instr,
    Json,
    JsonArray,
    JsonArrayInsert,
    JsonArrayLength,
    JsonErrorPosition,
    JsonExtract,
    /// json_group_array or json_group_object with the wrong number of arguments: a name that never fits.
    JsonGroup,
    JsonInsert,
    JsonObject,
    JsonPatch,
    JsonPretty,
    JsonQuote,
    JsonRemove,
    JsonReplace,
    JsonSet,
    /// Internal, not callable by name: its argument, marked with the JSON subtype (json.cee).
    JsonSubtype,
    JsonType,
    JsonValid,
    // The jsonb_* functions: as their json_* namesakes, returning JSONB (json.cee).
    Jsonb,
    JsonbArray,
    JsonbArrayInsert,
    JsonbExtract,
    JsonbInsert,
    JsonbObject,
    JsonbPatch,
    JsonbRemove,
    JsonbReplace,
    JsonbSet,
    JulianDay,
    LastInsertRowid,
    Length,
    Like,
    Likelihood,
    Likely,
    Lower,
    Ltrim,
    Max,
    Min,
    Mod,
    NullIf,
    OctetLength,
    Pi,
    Printf,
    Quote,
    Random,
    RandomBlob,
    Replace,
    Round,
    Rtrim,
    Sign,
    Sqrt,
    SqliteVersion,
    Strftime,
    Substr,
    Time,
    TimeDiff,
    TotalChanges,
    Trim,
    Trunc,
    TypeOf,
    Unhex,
    Unicode,
    UnixEpoch,
    Unlikely,
    Upper,
    ZeroBlob,
    // The math functions (SQLITE_ENABLE_MATH_FUNCTIONS) beyond those above, computed by mathFunction with libm.cee.
    Acos,
    Acosh,
    Asin,
    Asinh,
    Atan,
    Atan2,
    Atanh,
    Cos,
    Cosh,
    Degrees,
    Exp,
    Ln,
    Log,
    Log10,
    Log2,
    Pow,
    Radians,
    Sin,
    Sinh,
    Tan,
    Tanh,
}

/// The function and whether `argc` arguments suit it.
struct FunctionEntry {
    function: ScalarFunction;
    fits: bool;
}

fn entry(function: ScalarFunction, argc: usize, least: usize, most: usize) -> FunctionEntry =>
    FunctionEntry { function: function, fits: argc >= least && argc <= most };

const MANY: usize = 1000;

fn scalarEntry(name: StringView, argc: usize) -> FunctionEntry? {
    var lower = [0u8; 32];
    if (name.length > 32) {
        return null;
    }
    for (i in 0..name.length) {
        lower[i] = foldAscii(name[i]);
    }
    let key = lower[0..name.length];
    return match (key) {
        "abs" => entry(ScalarFunction.Abs, argc, 1, 1),
        "ceil" | "ceiling" => entry(ScalarFunction.Ceil, argc, 1, 1),
        "changes" => entry(ScalarFunction.Changes, argc, 0, 0),
        "char" => entry(ScalarFunction.Char, argc, 0, MANY),
        "coalesce" => entry(ScalarFunction.Coalesce, argc, 2, MANY),
        "concat" => entry(ScalarFunction.Concat, argc, 1, MANY),
        "concat_ws" => entry(ScalarFunction.ConcatWs, argc, 2, MANY),
        "date" => entry(ScalarFunction.Date, argc, 0, MANY),
        "datetime" => entry(ScalarFunction.Datetime, argc, 0, MANY),
        "floor" => entry(ScalarFunction.Floor, argc, 1, 1),
        "glob" => entry(ScalarFunction.Glob, argc, 2, 2),
        "hex" => entry(ScalarFunction.Hex, argc, 1, 1),
        "ifnull" => entry(ScalarFunction.IfNull, argc, 2, 2),
        "iif" | "if" => entry(ScalarFunction.Iif, argc, 2, MANY),
        "instr" => entry(ScalarFunction.Instr, argc, 2, 2),
        "json" => entry(ScalarFunction.Json, argc, 1, 1),
        "json_array" => entry(ScalarFunction.JsonArray, argc, 0, MANY),
        "json_array_insert" => entry(ScalarFunction.JsonArrayInsert, argc, 0, MANY),
        "json_array_length" => entry(ScalarFunction.JsonArrayLength, argc, 1, 2),
        "json_error_position" => entry(ScalarFunction.JsonErrorPosition, argc, 1, 1),
        "json_extract" => entry(ScalarFunction.JsonExtract, argc, 0, MANY),
        "json_group_array" | "json_group_object" => entry(ScalarFunction.JsonGroup, argc, 1, 0),
        "json_insert" => entry(ScalarFunction.JsonInsert, argc, 0, MANY),
        "json_object" => entry(ScalarFunction.JsonObject, argc, 0, MANY),
        "json_patch" => entry(ScalarFunction.JsonPatch, argc, 2, 2),
        "json_pretty" => entry(ScalarFunction.JsonPretty, argc, 1, 2),
        "json_quote" => entry(ScalarFunction.JsonQuote, argc, 1, 1),
        "json_remove" => entry(ScalarFunction.JsonRemove, argc, 0, MANY),
        "json_replace" => entry(ScalarFunction.JsonReplace, argc, 0, MANY),
        "json_set" => entry(ScalarFunction.JsonSet, argc, 0, MANY),
        "json_type" => entry(ScalarFunction.JsonType, argc, 1, 2),
        "json_valid" => entry(ScalarFunction.JsonValid, argc, 1, 2),
        "jsonb" => entry(ScalarFunction.Jsonb, argc, 1, 1),
        "jsonb_array" => entry(ScalarFunction.JsonbArray, argc, 0, MANY),
        "jsonb_array_insert" => entry(ScalarFunction.JsonbArrayInsert, argc, 0, MANY),
        "jsonb_extract" => entry(ScalarFunction.JsonbExtract, argc, 0, MANY),
        "jsonb_group_array" | "jsonb_group_object" => entry(ScalarFunction.JsonGroup, argc, 1, 0),
        "jsonb_insert" => entry(ScalarFunction.JsonbInsert, argc, 0, MANY),
        "jsonb_object" => entry(ScalarFunction.JsonbObject, argc, 0, MANY),
        "jsonb_patch" => entry(ScalarFunction.JsonbPatch, argc, 2, 2),
        "jsonb_remove" => entry(ScalarFunction.JsonbRemove, argc, 0, MANY),
        "jsonb_replace" => entry(ScalarFunction.JsonbReplace, argc, 0, MANY),
        "jsonb_set" => entry(ScalarFunction.JsonbSet, argc, 0, MANY),
        "julianday" => entry(ScalarFunction.JulianDay, argc, 0, MANY),
        "last_insert_rowid" => entry(ScalarFunction.LastInsertRowid, argc, 0, 0),
        "length" => entry(ScalarFunction.Length, argc, 1, 1),
        "like" => entry(ScalarFunction.Like, argc, 2, 3),
        "likelihood" => entry(ScalarFunction.Likelihood, argc, 2, 2),
        "likely" => entry(ScalarFunction.Likely, argc, 1, 1),
        "lower" => entry(ScalarFunction.Lower, argc, 1, 1),
        "ltrim" => entry(ScalarFunction.Ltrim, argc, 1, 2),
        "max" => entry(ScalarFunction.Max, argc, 2, MANY),
        "min" => entry(ScalarFunction.Min, argc, 2, MANY),
        "mod" => entry(ScalarFunction.Mod, argc, 2, 2),
        "nullif" => entry(ScalarFunction.NullIf, argc, 2, 2),
        "octet_length" => entry(ScalarFunction.OctetLength, argc, 1, 1),
        "pi" => entry(ScalarFunction.Pi, argc, 0, 0),
        "printf" | "format" => entry(ScalarFunction.Printf, argc, 0, MANY),
        "quote" => entry(ScalarFunction.Quote, argc, 1, 1),
        "random" => entry(ScalarFunction.Random, argc, 0, 0),
        "randomblob" => entry(ScalarFunction.RandomBlob, argc, 1, 1),
        "replace" => entry(ScalarFunction.Replace, argc, 3, 3),
        "round" => entry(ScalarFunction.Round, argc, 1, 2),
        "rtrim" => entry(ScalarFunction.Rtrim, argc, 1, 2),
        "sign" => entry(ScalarFunction.Sign, argc, 1, 1),
        "sqrt" => entry(ScalarFunction.Sqrt, argc, 1, 1),
        "sqlite_version" => entry(ScalarFunction.SqliteVersion, argc, 0, 0),
        "strftime" => entry(ScalarFunction.Strftime, argc, 0, MANY),
        "substr" | "substring" => entry(ScalarFunction.Substr, argc, 2, 3),
        "time" => entry(ScalarFunction.Time, argc, 0, MANY),
        "timediff" => entry(ScalarFunction.TimeDiff, argc, 2, 2),
        "total_changes" => entry(ScalarFunction.TotalChanges, argc, 0, 0),
        "trim" => entry(ScalarFunction.Trim, argc, 1, 2),
        "trunc" => entry(ScalarFunction.Trunc, argc, 1, 1),
        "typeof" => entry(ScalarFunction.TypeOf, argc, 1, 1),
        "unhex" => entry(ScalarFunction.Unhex, argc, 1, 2),
        "unicode" => entry(ScalarFunction.Unicode, argc, 1, 1),
        "unixepoch" => entry(ScalarFunction.UnixEpoch, argc, 0, MANY),
        "unlikely" => entry(ScalarFunction.Unlikely, argc, 1, 1),
        "upper" => entry(ScalarFunction.Upper, argc, 1, 1),
        "zeroblob" => entry(ScalarFunction.ZeroBlob, argc, 1, 1),
        "acos" => entry(ScalarFunction.Acos, argc, 1, 1),
        "acosh" => entry(ScalarFunction.Acosh, argc, 1, 1),
        "asin" => entry(ScalarFunction.Asin, argc, 1, 1),
        "asinh" => entry(ScalarFunction.Asinh, argc, 1, 1),
        "atan" => entry(ScalarFunction.Atan, argc, 1, 1),
        "atan2" => entry(ScalarFunction.Atan2, argc, 2, 2),
        "atanh" => entry(ScalarFunction.Atanh, argc, 1, 1),
        "cos" => entry(ScalarFunction.Cos, argc, 1, 1),
        "cosh" => entry(ScalarFunction.Cosh, argc, 1, 1),
        "degrees" => entry(ScalarFunction.Degrees, argc, 1, 1),
        "exp" => entry(ScalarFunction.Exp, argc, 1, 1),
        "ln" => entry(ScalarFunction.Ln, argc, 1, 1),
        "log" => entry(ScalarFunction.Log, argc, 1, 2),
        "log10" => entry(ScalarFunction.Log10, argc, 1, 1),
        "log2" => entry(ScalarFunction.Log2, argc, 1, 1),
        "pow" | "power" => entry(ScalarFunction.Pow, argc, 2, 2),
        "radians" => entry(ScalarFunction.Radians, argc, 1, 1),
        "sin" => entry(ScalarFunction.Sin, argc, 1, 1),
        "sinh" => entry(ScalarFunction.Sinh, argc, 1, 1),
        "tan" => entry(ScalarFunction.Tan, argc, 1, 1),
        "tanh" => entry(ScalarFunction.Tanh, argc, 1, 1),
        _ => null,
    };
}

/// The scalar function `name` taking `argc` arguments.
fn scalarFunctionNamed(name: StringView, argc: usize) -> Result<ScalarFunction, SqliteError> {
    let found = scalarEntry(name, argc) ?? {
        return Err(functionNameError("no such function: ", name, ""));
    };
    if (!found.fits) {
        return Err(functionNameError("wrong number of arguments to function ", name, "()"));
    }
    return Ok(found.function);
}

enum AggregateFunction {
    Count,
    CountStar,
    Sum,
    Total,
    Avg,
    Min,
    Max,
    GroupConcat,
    JsonGroupArray,
    JsonGroupObject,
    JsonbGroupArray,
    JsonbGroupObject,
}

/// The aggregate `name` taking `argc` arguments, if it is one.
fn aggregateFunctionNamed(name: StringView, argc: usize, star: bool) -> AggregateFunction? {
    if (star) {
        return if (name.equalsIgnoreAsciiCase("count")) AggregateFunction.CountStar else null;
    }
    if (name.equalsIgnoreAsciiCase("count") && argc <= 1) {
        return if (argc == 0) AggregateFunction.CountStar else AggregateFunction.Count;
    }
    if (argc == 1) {
        if (name.equalsIgnoreAsciiCase("sum")) {
            return AggregateFunction.Sum;
        }
        if (name.equalsIgnoreAsciiCase("total")) {
            return AggregateFunction.Total;
        }
        if (name.equalsIgnoreAsciiCase("avg")) {
            return AggregateFunction.Avg;
        }
        if (name.equalsIgnoreAsciiCase("min")) {
            return AggregateFunction.Min;
        }
        if (name.equalsIgnoreAsciiCase("max")) {
            return AggregateFunction.Max;
        }
    }
    if (name.equalsIgnoreAsciiCase("group_concat") && (argc == 1 || argc == 2)) {
        return AggregateFunction.GroupConcat;
    }
    if (name.equalsIgnoreAsciiCase("string_agg") && argc == 2) {
        return AggregateFunction.GroupConcat;
    }
    if (name.equalsIgnoreAsciiCase("json_group_array") && argc == 1) {
        return AggregateFunction.JsonGroupArray;
    }
    if (name.equalsIgnoreAsciiCase("json_group_object") && argc == 2) {
        return AggregateFunction.JsonGroupObject;
    }
    if (name.equalsIgnoreAsciiCase("jsonb_group_array") && argc == 1) {
        return AggregateFunction.JsonbGroupArray;
    }
    if (name.equalsIgnoreAsciiCase("jsonb_group_object") && argc == 2) {
        return AggregateFunction.JsonbGroupObject;
    }
    return null;
}

enum WindowFunction {
    /// An aggregate used as a window function.
    Aggregate(AggregateFunction),
    RowNumber,
    Rank,
    DenseRank,
    PercentRank,
    CumeDist,
    Ntile,
    Lag,
    Lead,
    FirstValue,
    LastValue,
    NthValue,
}

/// The functions that exist only as window functions.
fn windowOnlyFunctionNamed(name: StringView) -> WindowFunction? {
    let names = [
        "row_number",
        "rank",
        "dense_rank",
        "percent_rank",
        "cume_dist",
        "ntile",
        "lag",
        "lead",
        "first_value",
        "last_value",
        "nth_value",
    ];
    let functions = [
        WindowFunction.RowNumber, WindowFunction.Rank, WindowFunction.DenseRank, WindowFunction.PercentRank,
        WindowFunction.CumeDist, WindowFunction.Ntile, WindowFunction.Lag, WindowFunction.Lead,
        WindowFunction.FirstValue, WindowFunction.LastValue, WindowFunction.NthValue,
    ];
    for (i in 0..names.length) {
        if (name.equalsIgnoreAsciiCase(names[i])) {
            return functions[i];
        }
    }
    return null;
}

/// The window function `name` taking `argc` arguments, if it is one.
fn windowFunctionNamed(name: StringView, argc: usize, star: bool) -> WindowFunction? {
    if (aggregateFunctionNamed(name, argc, star) is Some(a)) {
        return WindowFunction.Aggregate(a);
    }
    let found = windowOnlyFunctionNamed(name) ?? {
        return null;
    };
    let fits = match (found) {
        WindowFunction.RowNumber | WindowFunction.Rank | WindowFunction.DenseRank | WindowFunction.PercentRank | WindowFunction.CumeDist =>
            argc == 0,
        WindowFunction.Ntile | WindowFunction.FirstValue | WindowFunction.LastValue => argc == 1,
        WindowFunction.NthValue => argc == 2,
        WindowFunction.Lag | WindowFunction.Lead => argc >= 1 && argc <= 3,
        WindowFunction.Aggregate(_) => false,
    };
    return if (fits) found else null;
}

// ── UTF-8 ────────────────────────────────────────────────────────────────────────────────────────────────────

/// The characters of text, as SQLite reads them (READ_UTF8, sqlite3Utf8Read): a byte below 0xC0 is a character
/// of its own, even a stray continuation byte; a byte from 0xC0 takes every continuation byte after it, and the
/// result is U+FFFD when it is overlong or a surrogate. U+FFFE and U+FFFF are characters like any other, as in
/// SQLite 3.54's sources and sqlite.org's builds (Apple's sqlite3 3.54.0 still makes them U+FFFD). A NUL ends the
/// text.
struct Utf8Chars<region r> {
    bytes: Slice<r, u8>;
    at: usize;

    fn of(bytes: Slice<r, u8>) -> Utf8Chars<r> => Utf8Chars { bytes: bytes, at: 0 };

    fn next(borrow mut this) -> u32? {
        if (this.at >= this.bytes.length || this.bytes[this.at] == 0) {
            return null;
        }
        let b = this.bytes[this.at];
        this.at += 1;
        if (b < 0xC0) {
            return b as u32;
        }
        // sqlite3Utf8Trans1: the bits of the first byte that SQLite keeps.
        var code: u32 =
            if (b < 0xE0) (b - 0xC0) as u32
                else if (b < 0xF0) (b - 0xE0) as u32
                else if (b < 0xF8) (b - 0xF0) as u32
                else if (b < 0xFC) (b - 0xF8) as u32
                else if (b < 0xFE) (b - 0xFC) as u32
                else 0;
        while (this.at < this.bytes.length && (this.bytes[this.at] & 0xC0) == 0x80) {
            // C's unsigned arithmetic: a long run of continuation bytes shifts the first bits out.
            code = (code << 6) | ((this.bytes[this.at] & 0x3F) as u32);
            this.at += 1;
        }
        if (code < 0x80 || (code & 0xFFFF_F800) == 0xD800) {
            return 0xFFFD;
        }
        return code;
    }

    /// The bytes not yet read.
    fn rest(borrow this) -> Slice<r, u8> => this.bytes[this.at..];
}

/// The text before its first NUL, as SQLite's C strings end there.
fn beforeNul(bytes: Slice<u8>) -> Slice<u8> => match (bytes.indexOfByte(0)) {
    Some(at) => bytes[0..at],
    null => bytes,
};

// ── LIKE and GLOB ────────────────────────────────────────────────────────────────────────────────────────────

/// What patternCompare can answer.
enum PatternResult {
    Match,
    NoMatch,
    /// No match, and none is possible with a later start: stops the search early.
    NoWildcardMatch,
}

fn lowerAscii(c: u32) -> u32 => if (c >= 'A' && c <= 'Z') c + 32 else c;

/// SQLite's patternCompare. `matchOther` is the escape character for LIKE (0 for none), or '[' for GLOB.
fn patternCompare(
    pattern: Slice<u8>,
    subject: Slice<u8>,
    matchOne: u32,
    matchAll: u32,
    noCase: bool,
    matchSet: bool,
    matchOther: u32,
) -> PatternResult {
    var p = Utf8Chars.of(pattern);
    var s = Utf8Chars.of(subject);
    var escapedAt: usize? = null;
    loop {
        let c0 = p.next() ?? {
            return if (s.next().isNull()) PatternResult.Match else PatternResult.NoMatch;
        };
        var c = c0;
        if (c == matchAll) {
            // Skip further * or %, and for each ? or _ among them, one character of the subject.
            loop {
                c = p.next() ?? {
                    return PatternResult.Match;
                };
                if (c == matchAll) {
                    continue;
                }
                if (c == matchOne && matchOne != 0) {
                    if (s.next().isNull()) {
                        return PatternResult.NoWildcardMatch;
                    }
                    continue;
                }
                break;
            }
            if (c == matchOther && matchOther != 0) {
                if (!matchSet) {
                    c = p.next() ?? {
                        return PatternResult.NoWildcardMatch;
                    };
                } else {
                    // "[...]" right after "*": try every start.
                    let setStart = p.at - 1;
                    var start = s.at;
                    while (start < subject.length && subject[start] != 0) {
                        let r = patternCompare(
                            pattern[setStart..],
                            subject[start..],
                            matchOne,
                            matchAll,
                            noCase,
                            matchSet,
                            matchOther,
                        );
                        if (r != PatternResult.NoMatch) {
                            return r;
                        }
                        var skip = Utf8Chars.of(subject[start..]);
                        let _ = skip.next();
                        start += skip.at;
                    }
                    return PatternResult.NoWildcardMatch;
                }
            }
            // Find each place the next pattern character matches, and try the rest of the pattern from there.
            let rest = p.rest();
            loop {
                let c2 = s.next() ?? {
                    return PatternResult.NoWildcardMatch;
                };
                let same = c2 == c || (noCase && c < 0x80 && c2 < 0x80 && lowerAscii(c) == lowerAscii(c2));
                if (!same) {
                    continue;
                }
                let r = patternCompare(rest, s.rest(), matchOne, matchAll, noCase, matchSet, matchOther);
                if (r != PatternResult.NoMatch) {
                    return r;
                }
            }
        }
        if (c == matchOther && matchOther != 0) {
            if (!matchSet) {
                c = p.next() ?? {
                    return PatternResult.NoMatch;
                };
                escapedAt = p.at;
            } else {
                let subjectChar = s.next() ?? {
                    return PatternResult.NoMatch;
                };
                var priorChar: u32 = 0;
                var seen = false;
                var invert = false;
                var c2 = p.next() ?? 0;
                if (c2 == '^') {
                    invert = true;
                    c2 = p.next() ?? 0;
                }
                if (c2 == ']') {
                    if (subjectChar == ']') {
                        seen = true;
                    }
                    c2 = p.next() ?? 0;
                }
                while (c2 != 0 && c2 != ']') {
                    let following = p.rest();
                    if (c2 == '-' && following.length > 0 &&
                        following[0] != ']' && following[0] != 0 && priorChar > 0) {
                        c2 = p.next() ?? 0;
                        if (subjectChar >= priorChar && subjectChar <= c2) {
                            seen = true;
                        }
                        priorChar = 0;
                    } else {
                        if (subjectChar == c2) {
                            seen = true;
                        }
                        priorChar = c2;
                    }
                    c2 = p.next() ?? 0;
                }
                if (c2 == 0 || seen == invert) {
                    return PatternResult.NoMatch;
                }
                continue;
            }
        }
        let c2 = s.next() ?? 0;
        if (c == c2) {
            continue;
        }
        if (noCase && c < 0x80 && c2 < 0x80 && lowerAscii(c) == lowerAscii(c2)) {
            continue;
        }
        if (c == matchOne && escapedAt != Some(p.at) && c2 != 0) {
            continue;
        }
        return PatternResult.NoMatch;
    }
}

/// `subject LIKE pattern [ESCAPE escape]`: ASCII letters fold, `%` and `_` are wildcards.
fn likeMatch(pattern: Slice<u8>, subject: Slice<u8>, escape: u32?) -> bool =>
    patternCompare(pattern, subject, '_', '%', true, false, escape ?? 0) == PatternResult.Match;

/// `subject GLOB pattern`: case matters, `*`, `?` and `[...]` are wildcards.
fn globMatch(pattern: Slice<u8>, subject: Slice<u8>) -> bool =>
    patternCompare(pattern, subject, '?', '*', false, true, '[') == PatternResult.Match;

/// SQLite's limit on the length of a LIKE or GLOB pattern.
const LIKE_PATTERN_LIMIT: usize = 50000;

// ── calls ────────────────────────────────────────────────────────────────────────────────────────────────────

fn textResult(text: ByteString) -> SqliteValue => SqliteValue.Text(text);

fn hexDigit(n: u8) -> u8 => if (n < 10) '0' + n else 'A' + n - 10;

/// The bytes a value has as text, or as a blob for a blob.
fn valueBytes(value: borrow SqliteValue) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    match (value) {
        SqliteValue.Blob(b) => { out.extend(b.view())?; }
        SqliteValue.Text(s) => { out.extend(s.bytes())?; }
        SqliteValue.Null => {}
        _ => {
            let text = valueText(value)?;
            out.extend(text.bytes())?;
        }
    }
    return Ok(out);
}

/// The characters of a set of code points (unhex's characters to skip).
fn trimSet(value: borrow SqliteValue) -> Result<Vector<u32>, AllocError> {
    let text = valueText(value)?;
    var chars = Vector<u32>.create();
    var it = Utf8Chars.of(text.bytes());
    while (it.next() is Some(c)) {
        chars.push(c)?;
    }
    return Ok(chars);
}

/// The end of the character that starts at `at` (SQLITE_SKIP_UTF8): a byte from 0xC0 takes the continuation
/// bytes after it.
fn skipUtf8(bytes: Slice<u8>, at: usize) -> usize {
    var end = at + 1;
    if (bytes[at] >= 0xC0) {
        while (end < bytes.length && (bytes[end] & 0xC0) == 0x80) {
            end += 1;
        }
    }
    return end;
}

/// trim(X, Y), ltrim and rtrim, as trimFunc does: Y is cut into characters (SQLITE_SKIP_UTF8, up to a NUL), and
/// each is matched by its bytes, at either end of all of X's bytes.
fn trimText(
    value: borrow SqliteValue,
    setValue: borrow SqliteValue?,
    left: bool,
    right: bool,
) -> Result<SqliteValue, AllocError> {
    let text = valueText(value)?;
    let bytes = text.bytes();
    let setText = match (setValue) {
        Some(s) => valueText(s)?,
        null => ByteString.fromText(" ")?,
    };
    let set = beforeNul(setText.bytes());
    // Where each character of the set starts; the last entry is the set's end.
    var starts = Vector<usize>.create();
    var at: usize = 0;
    while (at < set.length) {
        starts.push(at)?;
        at = skipUtf8(set, at);
    }
    starts.push(set.length)?;
    var start: usize = 0;
    var end = bytes.length;
    if (starts.length > 1) {
        if (left) {
            loop {
                var found = false;
                for (k in 0..starts.length - 1) {
                    let piece = set[starts[k]..starts[k + 1]];
                    if (piece.length <= end - start && bytes[start..start + piece.length] == piece) {
                        start += piece.length;
                        found = true;
                        break;
                    }
                }
                if (!found || start == end) {
                    break;
                }
            }
        }
        if (right) {
            loop {
                if (end == start) {
                    break;
                }
                var found = false;
                for (k in 0..starts.length - 1) {
                    let piece = set[starts[k]..starts[k + 1]];
                    if (piece.length <= end - start && bytes[end - piece.length..end] == piece) {
                        end -= piece.length;
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    break;
                }
            }
        }
    }
    return SqliteValue.textOfBytes(bytes[start..end]);
}

/// substr(X, Y, Z) on characters (text) or bytes (blob), as SQLite computes it.
fn substrValue(
    x: borrow SqliteValue,
    y: borrow SqliteValue,
    z: borrow SqliteValue?,
) -> Result<SqliteValue, SqliteError> {
    if (x.isNull()) {
        return Ok(SqliteValue.Null);
    }
    var p1 = integerValue(y);
    var p2: i64 = 0x7FFF_FFFF_FFFF_FFFF;
    if (z is Some(zv)) {
        if (zv.isNull()) {
            return Ok(SqliteValue.Null);
        }
        p2 = integerValue(zv);
    }
    if (p1 == 0 && y.isNull()) {
        return Ok(SqliteValue.Null);
    }
    let isBlob = x is SqliteValue.Blob(_);
    let bytes = valueBytes(x)?;
    let data = if (isBlob) bytes.view() else beforeNul(bytes.view());
    var len: i64 = 0;
    if (isBlob) {
        len = truncate<i64>(data.length);
    } else if (p1 < 0) {
        // substrFunc counts with SQLITE_SKIP_UTF8, and skips with length()'s rule (nextCharEnd).
        var it = Utf8Chars.of(data);
        while (it.next().isSome()) {
            len += 1;
        }
    }
    if (p1 < 0) {
        p1 += len;
        if (p1 < 0) {
            p2 = if (p2 < 0) 0 else p2 + p1;
            p1 = 0;
        }
    } else if (p1 > 0) {
        p1 -= 1;
    } else if (p2 > 0) {
        p2 -= 1;
    }
    if (p2 < 0) {
        if (p2 < 0 - p1) {
            p2 = p1;
        } else {
            p2 = 0 - p2;
        }
        p1 -= p2;
    }
    if (isBlob) {
        if (p1 >= len) {
            p1 = 0;
            p2 = 0;
        } else if (p2 > len - p1) {
            p2 = len - p1;
        }
        let start = truncate<usize>(p1);
        return Ok(SqliteValue.blob(data[start..start + truncate<usize>(p2)])?);
    }
    var start: usize = 0;
    while (p1 > 0 && start < data.length) {
        start = nextCharEnd(data, start);
        p1 -= 1;
    }
    var end = start;
    while (p2 > 0 && end < data.length) {
        end = nextCharEnd(data, end);
        p2 -= 1;
    }
    return Ok(SqliteValue.textOfBytes(data[start..end])?);
}

/// The end of the character that starts at `at`, as length() and substr() divide text (SQLite 3.54's
/// tag-20260418-01): a byte from 0x80, a stray continuation byte too, takes the continuation bytes after it.
fn nextCharEnd(bytes: Slice<u8>, at: usize) -> usize {
    var end = at + 1;
    if (bytes[at] >= 0x80) {
        while (end < bytes.length && (bytes[end] & 0xC0) == 0x80) {
            end += 1;
        }
    }
    return end;
}

/// How many characters length() counts in text, up to its first NUL.
fn textLength(bytes: Slice<u8>) -> i64 {
    var count: i64 = 0;
    var at: usize = 0;
    while (at < bytes.length && bytes[at] != 0) {
        at = nextCharEnd(bytes, at);
        count += 1;
    }
    return count;
}

fn findBytes(haystack: Slice<u8>, needle: Slice<u8>) -> usize? {
    if (needle.length == 0) {
        return 0;
    }
    if (needle.length > haystack.length) {
        return null;
    }
    for (i in 0..haystack.length - needle.length + 1) {
        if (haystack[i..i + needle.length] == needle) {
            return i;
        }
    }
    return null;
}

/// quote(X): the value as an SQL literal.
fn quoteValue(value: borrow SqliteValue) -> Result<ByteString, AllocError> {
    var out = ByteString.create();
    match (value) {
        SqliteValue.Null => { out.append("NULL")?; }
        SqliteValue.Integer(i) => { out.appendNumber(i)?; }
        SqliteValue.Real(r) => {
            // "%!0.17g": the zero flag writes infinity as 9.0e+999.
            if (r > 1.7976931348623157e308) {
                out.append("9.0e+999")?;
            } else if (r < -1.7976931348623157e308) {
                out.append("-9.0e+999")?;
            } else {
                var text = String.create();
                appendReal(mut text, r)?;
                out.append(text.view())?;
            }
        }
        SqliteValue.Text(s) => {
            // %Q stops at a NUL, as the C string does, and keeps the other bytes as they are.
            out.appendByte('\'')?;
            for (b in beforeNul(s.bytes())) {
                if (b == '\'') {
                    out.appendByte('\'')?;
                }
                out.appendByte(b)?;
            }
            out.appendByte('\'')?;
        }
        SqliteValue.Blob(b) => {
            out.append("X'")?;
            for (byte in b.view()) {
                let _ = out.appendChar(hexDigit(byte >> 4) as u32)?;
                let _ = out.appendChar(hexDigit(byte & 15) as u32)?;
            }
            out.append("'")?;
        }
    }
    return Ok(out);
}

/// Random bytes, from the operating system.
fn randomBytes(count: usize) -> Result<Vector<u8>, SqliteError> {
    var bytes = Vector<u8>.create();
    bytes.resize(count, 0)?;
    Random.fill(bytes.viewMut())?;
    return Ok(bytes);
}

/// floor(), ceil() and trunc(): an integer stays as it is, a real becomes integral, and text is read as a number.
fn roundingFunction(function: ScalarFunction, value: borrow SqliteValue) -> SqliteValue {
    let number = mathOperand(value) ?? SqliteValue.Null;
    match (number) {
        SqliteValue.Integer(i) => { return SqliteValue.Integer(i); }
        SqliteValue.Real(r) => {
            return SqliteValue.Real(match (function) {
                ScalarFunction.Floor => r.floor(),
                ScalarFunction.Ceil => r.ceil(),
                _ => if (r < 0.0) r.ceil() else r.floor(),
            });
        }
        _ => { return SqliteValue.Null; }
    }
}

/// An argument of a math function as sqlite3_value_numeric_type sees it: an integer or a real, text that is a
/// number entirely converted to one; anything else (other text, a blob, NULL) is `null` and the result NULL.
fn mathOperand(value: borrow SqliteValue) -> SqliteValue? => match (value) {
    SqliteValue.Integer(i) => SqliteValue.Integer(i),
    SqliteValue.Real(r) => SqliteValue.Real(r),
    SqliteValue.Text(s) => textWithNumericAffinity(s.bytes(), false),
    _ => null,
};

/// The argument of a math function as a double, or `null` when it is not a number.
fn mathNumber(value: borrow SqliteValue) -> f64? {
    let number = mathOperand(value) ?? { return null; };
    return realValue(borrow number);
}

/// The math functions of func.c (math1Func, math2Func, logFunc, degToRad, radToDeg), computed by libm.cee. A NaN
/// result (a domain error) is NULL, as sqlite3_result_double makes it.
fn mathFunction(function: ScalarFunction, v: Slice<SqliteValue>) -> SqliteValue {
    let x = mathNumber(borrow v[0]) ?? { return SqliteValue.Null; };
    if (function == ScalarFunction.Log ||
        function == ScalarFunction.Ln || function == ScalarFunction.Log10 || function == ScalarFunction.Log2) {
        if (x <= 0.0) {
            return SqliteValue.Null;
        }
        if (v.length == 2) {
            // log(B, X). As in logFunc, the base must be above 1 (a base in (0, 1] is NULL too), and X is read
            // with sqlite3_value_double, which takes the numeric prefix of text and 0 for NULL.
            let base = x.ln();
            if (base <= 0.0) {
                return SqliteValue.Null;
            }
            let y = realValue(borrow v[1]);
            if (y <= 0.0) {
                return SqliteValue.Null;
            }
            return realResult(y.ln() / base);
        }
        return realResult(match (function) {
            ScalarFunction.Ln => x.ln(),
            ScalarFunction.Log2 => x.log2(),
            // log(X) is the base-10 logarithm, as in SQLite.
            _ => x.log10(),
        });
    }
    if (function == ScalarFunction.Atan2 || function == ScalarFunction.Pow) {
        let y = mathNumber(borrow v[1]) ?? { return SqliteValue.Null; };
        return realResult(if (function == ScalarFunction.Pow) x.pow(y) else x.atan2(y));
    }
    return realResult(match (function) {
        ScalarFunction.Acos => x.acos(),
        ScalarFunction.Acosh => x.acosh(),
        ScalarFunction.Asin => x.asin(),
        ScalarFunction.Asinh => x.asinh(),
        ScalarFunction.Atan => x.atan(),
        ScalarFunction.Atanh => x.atanh(),
        ScalarFunction.Cos => x.cos(),
        ScalarFunction.Cosh => x.cosh(),
        ScalarFunction.Degrees => x * (180.0 / 3.141592653589793),
        ScalarFunction.Exp => x.exp(),
        ScalarFunction.Radians => x * (3.141592653589793 / 180.0),
        ScalarFunction.Sin => x.sin(),
        ScalarFunction.Sinh => x.sinh(),
        ScalarFunction.Tan => x.tan(),
        _ => x.tanh(),
    });
}

/// Calls a scalar function.
fn callFunction(
    call: borrow XCall,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<SqliteValue, SqliteError> {
    let args = call.args.view();
    if (isJsonFunction(call.function)) {
        let result = callJsonFunction(call, frame, db)?;
        return Ok(result.value);
    }
    // The functions that evaluate only some of their arguments.
    match (call.function) {
        ScalarFunction.Coalesce | ScalarFunction.IfNull => {
            for (i in 0..args.length) {
                let v = evaluate(borrow args[i], frame, db)?;
                if (!v.isNull()) {
                    return Ok(v);
                }
            }
            return Ok(SqliteValue.Null);
        }
        ScalarFunction.Iif => {
            var i: usize = 0;
            while (i + 1 < args.length) {
                let condition = evaluate(borrow args[i], frame, db)?;
                if (isTrue(borrow condition)) {
                    return evaluate(borrow args[i + 1], frame, db);
                }
                i += 2;
            }
            if (i < args.length) {
                return evaluate(borrow args[i], frame, db);
            }
            return Ok(SqliteValue.Null);
        }
        _ => {}
    }
    var values = Vector<SqliteValue>.withCapacity(args.length)?;
    for (i in 0..args.length) {
        values.push(evaluate(borrow args[i], frame, db)?)?;
    }
    let encoding = db.textEncoding();
    if (encoding != TextEncoding.Utf8) {
        adaptArgumentsToEncoding(call.function, mut values, encoding)?;
    }
    let v = values.view();
    match (call.function) {
        ScalarFunction.Abs => {
            match (borrow v[0]) {
                SqliteValue.Null => { return Ok(SqliteValue.Null); }
                SqliteValue.Integer(i) => {
                    if (i == -9223372036854775808) {
                        return Err(sqlError("integer overflow"));
                    }
                    return Ok(SqliteValue.Integer(i.abs()));
                }
                other => { return Ok(SqliteValue.Real(realValue(other).abs())); }
            }
        }
        ScalarFunction.Ceil | ScalarFunction.Floor | ScalarFunction.Trunc => {
            return Ok(roundingFunction(call.function, borrow v[0]));
        }
        ScalarFunction.Acos | ScalarFunction.Acosh | ScalarFunction.Asin | ScalarFunction.Asinh | ScalarFunction.Atan | ScalarFunction.Atan2 | ScalarFunction.Atanh | ScalarFunction.Cos | ScalarFunction.Cosh | ScalarFunction.Degrees | ScalarFunction.Exp | ScalarFunction.Ln | ScalarFunction.Log | ScalarFunction.Log10 | ScalarFunction.Log2 | ScalarFunction.Pow | ScalarFunction.Radians | ScalarFunction.Sin | ScalarFunction.Sinh | ScalarFunction.Tan | ScalarFunction.Tanh => {
            return Ok(mathFunction(call.function, v));
        }
        ScalarFunction.Date | ScalarFunction.Datetime | ScalarFunction.JulianDay | ScalarFunction.Strftime | ScalarFunction.Time | ScalarFunction.TimeDiff | ScalarFunction.UnixEpoch => {
            return dateTimeFunction(call.function, v, frame.nowMillis);
        }
        ScalarFunction.Changes => { return Ok(SqliteValue.Integer(db.changes)); }
        ScalarFunction.TotalChanges => { return Ok(SqliteValue.Integer(db.totalChanges)); }
        ScalarFunction.LastInsertRowid => { return Ok(SqliteValue.Integer(db.lastInsertRowid)); }
        ScalarFunction.Char => {
            // charFunc: a surrogate is written as UTF-8 would write it (ED A0 80 for 0xD800), as SQLite does.
            var out = Vector<u8>.create();
            for (i in 0..v.length) {
                let x = integerValue(borrow v[i]);
                appendUtf8(mut out, if (x < 0 || x > 0x10FFFF) 0xFFFD else truncate<u32>(x))?;
            }
            return Ok(textResult(ByteString.fromBytes(out)));
        }
        ScalarFunction.Concat => {
            var out = ByteString.create();
            for (i in 0..v.length) {
                appendValueText(mut out, borrow v[i])?;
            }
            return Ok(textResult(out));
        }
        ScalarFunction.ConcatWs => {
            if (v[0].isNull()) {
                return Ok(SqliteValue.Null);
            }
            let separator = valueText(borrow v[0])?;
            var out = ByteString.create();
            var first = true;
            for (i in 1..v.length) {
                if (v[i].isNull()) {
                    continue;
                }
                if (!first) {
                    out.appendBytes(separator.bytes())?;
                }
                first = false;
                appendValueText(mut out, borrow v[i])?;
            }
            return Ok(textResult(out));
        }
        ScalarFunction.Glob | ScalarFunction.Like => {
            if (v[0].isNull() || v[1].isNull()) {
                return Ok(SqliteValue.Null);
            }
            let pattern = valueText(borrow v[0])?;
            let subject = valueText(borrow v[1])?;
            if (pattern.length() > LIKE_PATTERN_LIMIT) {
                return Err(sqlError("LIKE or GLOB pattern too complex"));
            }
            if (call.function == ScalarFunction.Glob) {
                return Ok(SqliteValue.Integer(if (globMatch(pattern.bytes(), subject.bytes())) 1 else 0));
            }
            var escape: u32? = null;
            if (v.length == 3) {
                if (v[2].isNull()) {
                    return Ok(SqliteValue.Null);
                }
                let e = valueText(borrow v[2])?;
                var chars = Utf8Chars.of(e.bytes());
                escape = chars.next();
                if (escape.isNull() || chars.next().isSome()) {
                    return Err(sqlError("ESCAPE expression must be a single character"));
                }
            }
            return Ok(
                SqliteValue.Integer(if (likeMatch(pattern.bytes(), subject.bytes(), escape)) 1 else 0),
            );
        }
        ScalarFunction.Hex => {
            let bytes = valueBytes(borrow v[0])?;
            var hex = Vector<u8>.withCapacity(bytes.length * 2)?;
            for (b in bytes.view()) {
                hex.push(hexDigit(b >> 4))?;
                hex.push(hexDigit(b & 15))?;
            }
            return Ok(SqliteValue.Text(ByteString.fromBytes(hex)));
        }
        ScalarFunction.Instr => {
            if (v[0].isNull() || v[1].isNull()) {
                return Ok(SqliteValue.Null);
            }
            let bothBlobs = v[0] is SqliteValue.Blob(_) && v[1] is SqliteValue.Blob(_);
            let haystack = valueBytes(borrow v[0])?;
            let needle = valueBytes(borrow v[1])?;
            // instrFunc: the needle is matched by its bytes at the start of each character, where a character
            // here is a byte and the continuation bytes after it.
            let hay = haystack.view();
            let isText = !bothBlobs;
            var n: i64 = 1;
            if (needle.length > 0) {
                var at: usize = 0;
                while (needle.length <= hay.length - at && hay[at..at + needle.length] != needle.view()) {
                    n += 1;
                    at += 1;
                    while (isText && at < hay.length && (hay[at] & 0xC0) == 0x80) {
                        at += 1;
                    }
                }
                if (needle.length > hay.length - at) {
                    n = 0;
                }
            }
            return Ok(SqliteValue.Integer(n));
        }
        ScalarFunction.Length => {
            match (borrow v[0]) {
                SqliteValue.Null => { return Ok(SqliteValue.Null); }
                SqliteValue.Blob(b) => { return Ok(SqliteValue.Integer(truncate<i64>(b.length))); }
                other => {
                    let text = valueText(other)?;
                    return Ok(SqliteValue.Integer(textLength(text.bytes())));
                }
            }
        }
        ScalarFunction.OctetLength => {
            if (v[0].isNull()) {
                return Ok(SqliteValue.Null);
            }
            return Ok(SqliteValue.Integer(truncate<i64>(valueBytes(borrow v[0])?.length)));
        }
        ScalarFunction.Likelihood => {
            let p = borrow v[1];
            let valid = (p is SqliteValue.Real(_) || p is SqliteValue.Integer(_)) && realValue(
                p,
            ) >= 0.0 && realValue(p) <= 1.0;
            if (!valid) {
                return Err(sqlError("second argument to likelihood() must be a constant between 0.0 and 1.0"));
            }
            return Ok(values.remove(0));
        }
        ScalarFunction.Likely | ScalarFunction.Unlikely => { return Ok(values.remove(0)); }
        ScalarFunction.Lower | ScalarFunction.Upper => {
            if (v[0].isNull()) {
                return Ok(SqliteValue.Null);
            }
            let text = valueText(borrow v[0])?;
            var out = Vector<u8>.withCapacity(text.length())?;
            for (b in text.bytes()) {
                if (call.function == ScalarFunction.Lower) {
                    out.push(if (b >= 'A' && b <= 'Z') b + 32 else b)?;
                } else {
                    out.push(if (b >= 'a' && b <= 'z') b - 32 else b)?;
                }
            }
            return Ok(SqliteValue.Text(ByteString.fromBytes(out)));
        }
        ScalarFunction.Ltrim | ScalarFunction.Rtrim | ScalarFunction.Trim => {
            if (v[0].isNull() || (v.length == 2 && v[1].isNull())) {
                return Ok(SqliteValue.Null);
            }
            let set: SqliteValue? = if (v.length == 2) v[1].clone()? else null;
            let left = call.function != ScalarFunction.Rtrim;
            let right = call.function != ScalarFunction.Ltrim;
            return Ok(trimText(borrow v[0], borrow set, left, right)?);
        }
        ScalarFunction.Max | ScalarFunction.Min => {
            var best: usize = 0;
            for (i in 0..v.length) {
                if (v[i].isNull()) {
                    return Ok(SqliteValue.Null);
                }
                if (i == 0) {
                    continue;
                }
                let c = compareValuesIn(borrow v[best], borrow v[i], call.collation, db.textEncoding());
                // min keeps the later of equals, max the earlier, as SQLite's minmaxFunc does.
                if ((call.function == ScalarFunction.Min && c >= 0) || (call.function == ScalarFunction.Max && c < 0)) {
                    best = i;
                }
            }
            return Ok(values.swapRemove(best));
        }
        ScalarFunction.Mod => {
            let x = mathNumber(borrow v[0]) ?? { return Ok(SqliteValue.Null); };
            let y = mathNumber(borrow v[1]) ?? { return Ok(SqliteValue.Null); };
            return Ok(realResult(x.truncatingRemainder(y)));
        }
        ScalarFunction.NullIf => {
            if (!v[0].isNull() && !v[1].isNull() && compareValuesIn(
                borrow v[0],
                borrow v[1],
                call.collation,
                db.textEncoding(),
            ) == 0) {
                return Ok(SqliteValue.Null);
            }
            return Ok(values.swapRemove(0));
        }
        ScalarFunction.Pi => { return Ok(SqliteValue.Real(3.141592653589793)); }
        ScalarFunction.Printf => { return printfFunction(v); }
        ScalarFunction.Quote => { return Ok(SqliteValue.Text(quoteValue(borrow v[0])?)); }
        ScalarFunction.Random => {
            let bytes = randomBytes(8)?;
            var r = bytes.readLE<i64>(0);
            if (r < 0) {
                r = 0 - truncate<i64>(truncate<u64>(r) & 0x7FFF_FFFF_FFFF_FFFF);
            }
            return Ok(SqliteValue.Integer(r));
        }
        ScalarFunction.RandomBlob => {
            let n = integerValue(borrow v[0]);
            return Ok(SqliteValue.Blob(randomBytes(if (n < 1) 1 else truncate<usize>(n.min(1_000_000_000)))?));
        }
        ScalarFunction.Replace => {
            if (v[0].isNull() || v[1].isNull()) {
                return Ok(SqliteValue.Null);
            }
            let pattern = valueBytes(borrow v[1])?;
            // replaceFunc: a pattern that is empty as a C string leaves the subject as it is.
            if (pattern.length == 0 || pattern[0] == 0) {
                return Ok(values.swapRemove(0));
            }
            if (v[2].isNull()) {
                return Ok(SqliteValue.Null);
            }
            let subject = valueBytes(borrow v[0])?;
            let replacement = valueBytes(borrow v[2])?;
            var out = Vector<u8>.withCapacity(subject.length)?;
            var i: usize = 0;
            while (i < subject.length) {
                if (i + pattern.length <= subject.length && subject.view()[i..i + pattern.length] == pattern.view()) {
                    out.extend(replacement.view())?;
                    i += pattern.length;
                } else {
                    out.push(subject[i])?;
                    i += 1;
                }
            }
            return Ok(SqliteValue.Text(ByteString.fromBytes(out)));
        }
        ScalarFunction.Round => {
            var n: i64 = 0;
            if (v.length == 2) {
                if (v[1].isNull()) {
                    return Ok(SqliteValue.Null);
                }
                n = integerValue(borrow v[1]).max(0).min(30);
            }
            if (v[0].isNull()) {
                return Ok(SqliteValue.Null);
            }
            var r = realValue(borrow v[0]);
            if (r < -4503599627370496.0 || r > 4503599627370496.0) {
                // Already integral: nothing to round.
            } else if (n == 0) {
                r = round<f64>(saturatingTruncate<i64>(r + (if (r < 0.0) -0.5 else 0.5)));
            } else {
                r = roundToDecimals(r, truncate<i32>(n))?;
            }
            return Ok(SqliteValue.Real(r));
        }
        ScalarFunction.Sign => {
            let number = match (borrow v[0]) {
                SqliteValue.Text(s) => textWithNumericAffinity(s.bytes(), false) ?? SqliteValue.Null,
                SqliteValue.Integer(i) => SqliteValue.Integer(i),
                SqliteValue.Real(r) => SqliteValue.Real(r),
                _ => SqliteValue.Null,
            };
            match (number) {
                SqliteValue.Integer(i) => { return Ok(SqliteValue.Integer(if (i < 0) -1 else if (i > 0) 1 else 0)); }
                SqliteValue.Real(r) => { return Ok(SqliteValue.Integer(if (r < 0.0) -1 else if (r > 0.0) 1 else 0)); }
                _ => { return Ok(SqliteValue.Null); }
            }
        }
        ScalarFunction.Sqrt => {
            let x = mathNumber(borrow v[0]) ?? { return Ok(SqliteValue.Null); };
            return Ok(realResult(x.sqrt()));
        }
        ScalarFunction.SqliteVersion => { return Ok(SqliteValue.sqlText(SQLITE_VERSION)?); }
        ScalarFunction.Substr => {
            let z: SqliteValue? = if (v.length == 3) v[2].clone()? else null;
            return substrValue(borrow v[0], borrow v[1], borrow z);
        }
        ScalarFunction.TypeOf => { return Ok(SqliteValue.sqlText(typeName(borrow v[0]))?); }
        ScalarFunction.Unhex => {
            if (v[0].isNull() || (v.length == 2 && v[1].isNull())) {
                return Ok(SqliteValue.Null);
            }
            let digits = valueBytes(borrow v[0])?;
            var ignore = Vector<u32>.create();
            if (v.length == 2) {
                ignore = trimSet(borrow v[1])?;
            }
            var out = Vector<u8>.create();
            var it = Utf8Chars.of(digits.view());
            loop {
                let Some(c) = it.next() else {
                    break;
                };
                if (c < 0x80 && isSqlHexDigit(truncate<u8>(c))) {
                    let Some(d) = it.next() else {
                        return Ok(SqliteValue.Null);
                    };
                    if (!(d < 0x80 && isSqlHexDigit(truncate<u8>(d)))) {
                        return Ok(SqliteValue.Null);
                    }
                    out.push((hexValue(truncate<u8>(c)) << 4) | hexValue(truncate<u8>(d)))?;
                    continue;
                }
                var skippable = false;
                for (k in 0..ignore.length) {
                    if (ignore[k] == c) {
                        skippable = true;
                    }
                }
                if (!skippable) {
                    return Ok(SqliteValue.Null);
                }
            }
            return Ok(SqliteValue.Blob(out));
        }
        ScalarFunction.Unicode => {
            if (v[0].isNull()) {
                return Ok(SqliteValue.Null);
            }
            let text = valueText(borrow v[0])?;
            var it = Utf8Chars.of(text.bytes());
            return Ok(match (it.next()) {
                Some(c) => SqliteValue.Integer(c as i64),
                null => SqliteValue.Null,
            });
        }
        ScalarFunction.ZeroBlob => {
            let n = integerValue(borrow v[0]);
            if (n > 1_000_000_000) {
                return Err(sqlError("string or blob too big"));
            }
            var bytes = Vector<u8>.create();
            bytes.resize(if (n < 0) 0 else truncate<usize>(n), 0)?;
            return Ok(SqliteValue.Blob(bytes));
        }
        ScalarFunction.Coalesce | ScalarFunction.IfNull | ScalarFunction.Iif => { return Ok(SqliteValue.Null); }
        // Computed in json.cee, above.
        ScalarFunction.Json | ScalarFunction.JsonArray | ScalarFunction.JsonArrayInsert | ScalarFunction.JsonArrayLength | ScalarFunction.JsonErrorPosition | ScalarFunction.JsonExtract | ScalarFunction.JsonGroup | ScalarFunction.JsonInsert | ScalarFunction.JsonObject | ScalarFunction.JsonPatch | ScalarFunction.JsonPretty | ScalarFunction.JsonQuote | ScalarFunction.JsonRemove | ScalarFunction.JsonReplace | ScalarFunction.JsonSet | ScalarFunction.JsonSubtype | ScalarFunction.JsonType | ScalarFunction.JsonValid | ScalarFunction.Jsonb | ScalarFunction.JsonbArray | ScalarFunction.JsonbArrayInsert | ScalarFunction.JsonbExtract | ScalarFunction.JsonbInsert | ScalarFunction.JsonbObject | ScalarFunction.JsonbPatch | ScalarFunction.JsonbRemove | ScalarFunction.JsonbReplace | ScalarFunction.JsonbSet => {
            return Ok(SqliteValue.Null);
        }
    }
}

/// The SQLite release whose behaviour this engine follows.
const SQLITE_VERSION: StringView = "3.53.4";

/// The civil date of a day number from 1970-01-01 (Howard Hinnant's algorithm).
struct CivilDate {
    year: i64;
    month: i64;
    day: i64;

    fn ofDays(days: i64) -> CivilDate {
        let z = days + 719468;
        let era = floorDivide(z, 146097);
        let doe = z - era * 146097;
        let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        let mp = (5 * doy + 2) / 153;
        let day = doy - (153 * mp + 2) / 5 + 1;
        let month = if (mp < 10) mp + 3 else mp - 9;
        let year = yoe + era * 400 + (if (month <= 2) 1 else 0);
        return CivilDate { year: year, month: month, day: day };
    }
}

fn appendTwoDigits(out: borrow mut String, n: i64) -> Result<void, AllocError> {
    if (n < 10) {
        out.append("0")?;
    }
    return out.appendNumber(n);
}

/// CURRENT_TIME, CURRENT_DATE or CURRENT_TIMESTAMP for the statement's time, in UTC.
fn nowText(kind: LiteralKind, unixMillis: i64) -> Result<SqliteValue, SqliteError> {
    let seconds = floorDivide(unixMillis, 1000);
    let days = floorDivide(seconds, 86400);
    let inDay = seconds - days * 86400;
    let date = CivilDate.ofDays(days);
    var out = String.create();
    if (kind != LiteralKind.CurrentTime) {
        var year = String.create();
        year.appendNumber(date.year)?;
        for (i in year.length..4) {
            out.append("0")?;
        }
        out.append(year.view())?;
        out.append("-")?;
        appendTwoDigits(mut out, date.month)?;
        out.append("-")?;
        appendTwoDigits(mut out, date.day)?;
    }
    if (kind != LiteralKind.CurrentDate) {
        if (kind == LiteralKind.CurrentTimestamp) {
            out.append(" ")?;
        }
        appendTwoDigits(mut out, inDay / 3600)?;
        out.append(":")?;
        appendTwoDigits(mut out, inDay / 60 % 60)?;
        out.append(":")?;
        appendTwoDigits(mut out, inDay % 60)?;
    }
    return Ok(SqliteValue.sqlTextFrom(out)?);
}
