// What the front ends (the shell in cli/, the PostgreSQL wire server in pgwire/) need beyond the connection API.

impl SqliteValue {
    /// The value as SQLite gives it as text (sqlite3_column_text, `CAST(v AS TEXT)`): NULL as the empty text, an
    /// integer in decimal, a real as SQLite writes it (`%!.15g`: `2.0`, `0.3`, `1.0e+20`), a text as it is, and a
    /// blob's bytes read as UTF-8, each byte of an invalid sequence replaced by U+FFFD.
    public fn toText(borrow this) -> Result<String, AllocError> => valueText(this);
}
