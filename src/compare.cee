// SQLite's ordering of values: NULL < numbers (integers and reals compared as numbers) < text (by collation)
// < blobs (by bytes). https://www.sqlite.org/datatype3.html#sort_order
//
// Differences from the C# engine, which this replaces:
// - an integer and a real are compared exactly, as SQLite does; the C# converts the integer to a double first,
//   so 9007199254740993 and 9007199254740992.0 compared equal;
// - text is compared by its UTF-8 bytes (SQLite's memcmp); the C# compares UTF-16 code units, which orders
//   characters above U+FFFF before U+E000..U+FFFF.

/// The built-in collating sequences.
public enum Collation {
    /// Bytes, as memcmp orders them.
    Binary,
    /// As `Binary`, with ASCII letters folded to one case.
    NoCase,
    /// As `Binary`, with trailing spaces ignored.
    RTrim,
}

impl Collation {
    /// The collation called `name` (ASCII case is ignored), or `null` for a name that is not built in.
    public fn named(name: StringView) -> Collation? {
        if (name.equalsIgnoreAsciiCase("BINARY")) {
            return Collation.Binary;
        }
        if (name.equalsIgnoreAsciiCase("NOCASE")) {
            return Collation.NoCase;
        }
        if (name.equalsIgnoreAsciiCase("RTRIM")) {
            return Collation.RTrim;
        }
        return null;
    }

    public fn name(this) -> StringView => match (this) {
        Collation.Binary => "BINARY",
        Collation.NoCase => "NOCASE",
        Collation.RTrim => "RTRIM",
    };
}

fn compareI64(a: i64, b: i64) -> i32 => if (a < b) -1 else if (a > b) 1 else 0;

fn compareUsize(a: usize, b: usize) -> i32 => if (a < b) -1 else if (a > b) 1 else 0;

/// Compares two reals. SQLite never stores a NaN (it becomes NULL); should one arrive, it sorts first.
fn compareF64(a: f64, b: f64) -> i32 {
    if (a < b) {
        return -1;
    }
    if (a > b) {
        return 1;
    }
    if (a == b) {
        return 0;
    }
    let aNan = a != a;
    let bNan = b != b;
    return if (aNan && bNan) 0 else if (aNan) -1 else 1;
}

/// Compares an integer with a real exactly, without rounding the integer (SQLite's sqlite3IntFloatCompare).
fn compareIntReal(i: i64, r: f64) -> i32 {
    if (r != r) {
        return 1;
    }
    if (r < -9223372036854775808.0) {
        return 1;
    }
    if (r >= 9223372036854775808.0) {
        return -1;
    }
    let whole = truncate<i64>(r);
    if (i < whole) {
        return -1;
    }
    if (i > whole) {
        return 1;
    }
    // The integer parts agree; the real's fraction decides.
    let asReal = round<f64>(i);
    return if (asReal < r) -1 else if (asReal > r) 1 else 0;
}

fn compareBytes(a: Slice<u8>, b: Slice<u8>) -> i32 {
    let shared = a.length.min(b.length);
    for (i in 0..shared) {
        if (a[i] != b[i]) {
            return if (a[i] < b[i]) -1 else 1;
        }
    }
    return compareUsize(a.length, b.length);
}

fn foldAscii(b: u8) -> u8 => if (b >= 'A' && b <= 'Z') b + 32 else b;

fn compareNoCase(a: Slice<u8>, b: Slice<u8>) -> i32 {
    let shared = a.length.min(b.length);
    for (i in 0..shared) {
        let x = foldAscii(a[i]);
        let y = foldAscii(b[i]);
        if (x != y) {
            return if (x < y) -1 else 1;
        }
    }
    return compareUsize(a.length, b.length);
}

fn withoutTrailingSpaces(text: Slice<u8>) -> Slice<u8> {
    var end = text.length;
    while (end > 0 && text[end - 1] == ' ') {
        end -= 1;
    }
    return text[0..end];
}

/// Compares two texts under `collation`.
fn compareText(a: Slice<u8>, b: Slice<u8>, collation: Collation) -> i32 => match (collation) {
    Collation.Binary => compareBytes(a, b),
    Collation.NoCase => compareNoCase(a, b),
    Collation.RTrim => compareBytes(withoutTrailingSpaces(a), withoutTrailingSpaces(b)),
};

fn storageRank(value: borrow SqliteValue) -> i32 => match (value) {
    SqliteValue.Null => 1,
    SqliteValue.Integer(_) => 2,
    SqliteValue.Real(_) => 2,
    SqliteValue.Text(_) => 3,
    SqliteValue.Blob(_) => 4,
};

/// Compares two values in SQLite's sort order: negative when `a` sorts first, 0 when they are equal.
fn compareValues(a: borrow SqliteValue, b: borrow SqliteValue, collation: Collation) -> i32 {
    let ra = storageRank(a);
    let rb = storageRank(b);
    if (ra != rb) {
        return if (ra < rb) -1 else 1;
    }
    match (a) {
        SqliteValue.Null => { return 0; }
        SqliteValue.Integer(x) => {
            match (b) {
                SqliteValue.Integer(y) => { return compareI64(x, y); }
                SqliteValue.Real(y) => { return compareIntReal(x, y); }
                _ => { return 0; }
            }
        }
        SqliteValue.Real(x) => {
            match (b) {
                SqliteValue.Integer(y) => { return 0 - compareIntReal(y, x); }
                SqliteValue.Real(y) => { return compareF64(x, y); }
                _ => { return 0; }
            }
        }
        SqliteValue.Text(x) => {
            match (b) {
                SqliteValue.Text(y) => { return compareText(x.bytes(), y.bytes(), collation); }
                _ => { return 0; }
            }
        }
        SqliteValue.Blob(x) => {
            match (b) {
                SqliteValue.Blob(y) => { return compareBytes(x.view(), y.view()); }
                _ => { return 0; }
            }
        }
    }
}

/// `value` in the form under which values that are equal in `collation` are identical: NOCASE text in upper
/// case, RTRIM text without trailing spaces. Used for keys of hash tables.
fn normalizeForKey(value: borrow SqliteValue, collation: Collation) -> Result<SqliteValue, AllocError> {
    let SqliteValue.Text(text) = value else {
        return value.clone();
    };
    match (collation) {
        Collation.Binary => { return value.clone(); }
        Collation.NoCase => {
            var out = Vector<u8>.withCapacity(text.length())?;
            for (b in text.bytes()) {
                out.push(if (b >= 'a' && b <= 'z') b - 32 else b)?;
            }
            return Ok(SqliteValue.Text(ByteString.fromBytes(out)));
        }
        Collation.RTrim => {
            return SqliteValue.textOfBytes(withoutTrailingSpaces(text.bytes()));
        }
    }
}
