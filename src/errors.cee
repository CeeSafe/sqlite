// Errors. The C# engine throws; here every fallible operation returns `Result<T, SqliteError>`.

/// What went wrong in the engine.
public enum SqliteError {
    /// Memory ran out.
    @from Alloc(AllocError),
    /// The file system refused an operation.
    @from Io(IoError),
    /// The database file does not follow the SQLite file format.
    ///
    /// Each message is bytes, as SQLite's are: a name or a RAISE message in it keeps bytes that are not UTF-8.
    Corrupt(ByteString),
    /// The file is not a SQLite database at all.
    NotADatabase(ByteString),
    /// The SQL text could not be parsed, or names something that does not exist.
    Sql(ByteString),
    /// A constraint (NOT NULL, UNIQUE, CHECK, FOREIGN KEY, …) refused a change.
    Constraint(ByteString),
    /// The engine does not support what was asked.
    Unsupported(ByteString),
    /// Another connection of the same pool holds the database (SQLITE_BUSY), and the busy timeout ran out.
    Busy(ByteString),
    /// RAISE(IGNORE) in a trigger: the row is skipped, and the statement goes on.
    RaiseIgnore,
}

impl SqliteError {
    /// The error's message, as SQLite gives it: bytes, UTF-8 unless a name, a value or the statement's text in
    /// it held bytes that are not (`messageText` for a `String`).
    public fn message(borrow this) -> ByteStringView => match (this) {
        SqliteError.Alloc(_) => ByteStringView.fromText("out of memory"),
        SqliteError.Io(e) => ByteStringView.fromText(e.message()),
        SqliteError.Corrupt(m) => m.view(),
        SqliteError.NotADatabase(m) => m.view(),
        SqliteError.Sql(m) => m.view(),
        SqliteError.Constraint(m) => m.view(),
        SqliteError.Unsupported(m) => m.view(),
        SqliteError.Busy(m) => m.view(),
        SqliteError.RaiseIgnore => ByteStringView.fromText("RAISE(IGNORE)"),
    };

    /// The message as text, U+FFFD for each byte of it that is not UTF-8.
    public fn messageText(borrow this) -> Result<String, AllocError> => this.message().toUtf8Lossy();
}

/// A message made in the engine, whose names are SQL text in the engine's form (sqltext.cee), as the bytes it
/// stands for.
fn ownedMessage(message: StringView) -> ByteString => match (sqlBytes(message)) {
    Ok(s) => s,
    Err(_) => ByteString.create(),
};

fn corrupt(message: StringView) -> SqliteError => SqliteError.Corrupt(ownedMessage(message));

fn notADatabase(message: StringView) -> SqliteError => SqliteError.NotADatabase(ownedMessage(message));

fn sqlError(message: StringView) -> SqliteError => SqliteError.Sql(ownedMessage(message));

fn unsupported(message: StringView) -> SqliteError => SqliteError.Unsupported(ownedMessage(message));

fn constraintError(message: StringView) -> SqliteError => SqliteError.Constraint(ownedMessage(message));
