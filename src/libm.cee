// The transcendental functions SQLite's math functions call (func.c, SQLITE_ENABLE_MATH_FUNCTIONS): pure
// functions on f64. sin, cos, tan, atan and the inverse hyperbolic functions are FreeBSD's msun (Sun's fdlibm,
// within one unit in the last place); exp, the logarithms, pow, sinh, cosh, tanh, asin, acos and atan2 are
// computed in double-double arithmetic and rounded once (the last section), because the libm of macOS rounds
// those correctly or nearly so and msun's would differ from it on several percent of arguments.
//
// CeeSafe has no math library beyond sqrt, abs, floor and ceil (CEESAFE_FINDINGS.md finding 1), and this package
// may not call C. Each msun function follows its source (named above it) step by step, with these changes:
// - a word of a double is read and written through `bits()` and `f64.fromBits`, and the bit operations are on
//   unsigned words; where msun compares a signed high word, the comparison is made on the signed value;
// - the tricks that only raise floating-point exceptions (`huge + x > one`, `tiny * tiny`, volatile constants) are
//   left out: CeeSafe has no floating-point flags, and their results are the plain values;
// - the tables of doubles are functions (constant arrays of f64 are refused, finding 16);
// - __kernel_rem_pio2 is specialised to double precision (prec 1) and its rescans are bounded.
//
// The libm of macOS, which the sqlite3 shell calls, is a different implementation: results can differ in the last
// bit (README.md says how often).

/// The high 32 bits of a double.
fn libmHigh(x: f64) -> u32 => truncate<u32>(x.bits() >> 32);

/// The high 32 bits of a double, as msun's signed `int32_t`.
fn libmSignedHigh(x: f64) -> i64 => truncate<i32>(libmHigh(x)) as i64;

/// The low 32 bits of a double.
fn libmLow(x: f64) -> u32 => truncate<u32>(x.bits());

/// The double of two words (INSERT_WORDS).
fn libmWords(high: u32, low: u32) -> f64 => f64.fromBits(((high as u64) << 32) | (low as u64));

/// `x` with its low word replaced (SET_LOW_WORD).
fn libmWithLow(x: f64, low: u32) -> f64 => libmWords(libmHigh(x), low);

/// `x` with its high word replaced (SET_HIGH_WORD).
fn libmWithHigh(x: f64, high: u32) -> f64 => libmWords(high, libmLow(x));

/// A high word made from a signed value, as C's conversion to `u_int32_t` makes it.
fn libmWord(value: i64) -> u32 => truncate<u32>(value);

fn libmNan() -> f64 => f64.fromBits(0x7FF8000000000000);

fn libmInfinity() -> f64 => f64.fromBits(0x7FF0000000000000);

/// 2^n, for n in -1022..=1023.
fn libmPowerOfTwo(n: i64) -> f64 => f64.fromBits(truncate<u64>(n + 1023) << 52);

/// x * 2^n (s_scalbn.c).
fn libmScalbn(x: f64, n: i64) -> f64 {
    var y = x;
    var e = n;
    if (e > 1023) {
        y = y * libmPowerOfTwo(1023);
        e -= 1023;
        if (e > 1023) {
            y = y * libmPowerOfTwo(1023);
            e -= 1023;
            if (e > 1023) {
                e = 1023;
            }
        }
    } else if (e < -1022) {
        // 2^-1022 * 2^53: scaling in two steps keeps the result from being rounded twice as a subnormal.
        y = y * (libmPowerOfTwo(-1022) * libmPowerOfTwo(53));
        e += 1022 - 53;
        if (e < -1022) {
            y = y * (libmPowerOfTwo(-1022) * libmPowerOfTwo(53));
            e += 1022 - 53;
            if (e < -1022) {
                e = -1022;
            }
        }
    }
    return y * libmPowerOfTwo(e);
}

/// Rounds toward zero to an integer (C's conversion of a double to int, for values that fit).
fn libmToInt(x: f64) -> i64 => saturatingTruncate<i64>(x);

// ---- Argument reduction for sin, cos and tan (e_rem_pio2.c, k_rem_pio2.c) ----

/// x - n * pi/2 as hi + lo, and n.
struct LibmReduced {
    n: i64;
    hi: f64;
    lo: f64;
}

const LIBM_PIO2_1: f64 = 1.57079632673412561417e+00;
const LIBM_PIO2_1T: f64 = 6.07710050650619224932e-11;
const LIBM_PIO2_2: f64 = 6.07710050630396597660e-11;
const LIBM_PIO2_2T: f64 = 2.02226624879595063154e-21;
const LIBM_PIO2_3: f64 = 2.02226624871116645580e-21;
const LIBM_PIO2_3T: f64 = 8.47842766036889956997e-32;
const LIBM_INVPIO2: f64 = 6.36619772367581382433e-01;
const LIBM_TWO24: f64 = 1.67772160000000000000e+07;
const LIBM_TWON24: f64 = 5.96046447753906250000e-08;

/// The bits of 2/pi, 24 at a time (enough for every double's exponent).
const LIBM_IPIO2: [u32; 66] = [
    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7,
    0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129, 0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C,
    0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8, 0x97FFDE, 0x05980F, 0xEF2F11,
    0x8B5A0A, 0x6D1F6D, 0x367ECF, 0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7,
    0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3, 0x91615E,
    0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880, 0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B,
];

/// pi/2 in pieces of 24 bits (k_rem_pio2.c's PIo2).
fn libmPio2Part(k: usize) -> f64 => match (k) {
    0 => 1.57079625129699707031e+00,
    1 => 7.54978941586159635335e-08,
    2 => 5.39030252995776476554e-15,
    3 => 3.28200341580791294123e-22,
    4 => 1.27065575308067607349e-29,
    5 => 1.22933308981111328932e-36,
    6 => 2.73370053816464559624e-44,
    _ => 2.16741683877804819444e-51,
};

fn libmIndex(i: i64) -> usize => truncate<usize>(i);

/// __kernel_rem_pio2 for doubles: `x` holds the 24-bit pieces of the argument scaled by 2^-e0, `nx` of them.
fn libmKernelRemPio2(x: [f64; 3], nx: i64, e0: i64) -> LibmReduced {
    let jk: i64 = 4;
    let jp: i64 = jk;
    var iq = [0u32; 20];
    var f = [0.0f64; 20];
    var fq = [0.0f64; 20];
    var q = [0.0f64; 20];
    let jx = nx - 1;
    var jv = (e0 - 3) / 24;
    if (jv < 0) {
        jv = 0;
    }
    var q0 = e0 - 24 * (jv + 1);
    var j = jv - jx;
    let m = jx + jk;
    for (i in 0..m + 1) {
        f[libmIndex(i)] = if (j < 0) 0.0 else LIBM_IPIO2[libmIndex(j)] as f64;
        j += 1;
    }
    for (i in 0..jk + 1) {
        var fw = 0.0;
        for (k in 0..jx + 1) {
            fw = fw + x[libmIndex(k)] * f[libmIndex(jx + i - k)];
        }
        q[libmIndex(i)] = fw;
    }
    var jz = jk;
    var z = 0.0;
    var n: i64 = 0;
    var ih: i64 = 0;
    // The rescans below are bounded by the tables: msun's loop back to `recompute` needs a few at most.
    var rescans = 0;
    loop {
        // Distill q[] into iq[] in reverse order.
        z = q[libmIndex(jz)];
        var i: i64 = 0;
        var jj = jz;
        while (jj > 0) {
            let fw = round<f64>(libmToInt(LIBM_TWON24 * z));
            iq[libmIndex(i)] = truncate<u32>(libmToInt(z - LIBM_TWO24 * fw));
            z = q[libmIndex(jj - 1)] + fw;
            i += 1;
            jj -= 1;
        }
        // The integer part of the product, mod 8, and the fraction.
        z = libmScalbn(z, q0);
        z = z - 8.0 * (z * 0.125).floor();
        n = libmToInt(z);
        z = z - round<f64>(n);
        ih = 0;
        let last = libmIndex(jz - 1);
        if (q0 > 0) {
            let whole = iq[last] >> truncate<u32>(24 - q0);
            n += whole as i64;
            iq[last] -= whole << truncate<u32>(24 - q0);
            ih = (iq[last] >> truncate<u32>(23 - q0)) as i64;
        } else if (q0 == 0) {
            ih = (iq[last] >> 23) as i64;
        } else if (z >= 0.5) {
            ih = 2;
        }
        if (ih > 0) {
            // The fraction is at least 1/2: take 1 - fraction.
            n += 1;
            var carry = false;
            for (k in 0..jz) {
                let word = iq[libmIndex(k)];
                if (!carry) {
                    if (word != 0) {
                        carry = true;
                        iq[libmIndex(k)] = 0x1000000 - word;
                    }
                } else {
                    iq[libmIndex(k)] = 0xffffff - word;
                }
            }
            if (q0 == 1) {
                iq[last] &= 0x7fffff;
            } else if (q0 == 2) {
                iq[last] &= 0x3fffff;
            }
            if (ih == 2) {
                z = 1.0 - z;
                if (carry) {
                    z = z - libmScalbn(1.0, q0);
                }
            }
        }
        // Too much cancellation: take more bits of 2/pi and start again.
        if (z == 0.0 && rescans < 4) {
            var any: u32 = 0;
            var k = jz - 1;
            while (k >= jk) {
                any |= iq[libmIndex(k)];
                k -= 1;
            }
            if (any == 0) {
                var more: i64 = 1;
                while (more < jk && iq[libmIndex(jk - more)] == 0) {
                    more += 1;
                }
                if (jz + more < 20 && jv + jz + more < 66) {
                    for (add in jz + 1..jz + more + 1) {
                        f[libmIndex(jx + add)] = LIBM_IPIO2[libmIndex(jv + add)] as f64;
                        var fw = 0.0;
                        for (t in 0..jx + 1) {
                            fw = fw + x[libmIndex(t)] * f[libmIndex(jx + add - t)];
                        }
                        q[libmIndex(add)] = fw;
                    }
                    jz += more;
                    rescans += 1;
                    continue;
                }
            }
        }
        break;
    }
    // Chop off the zero terms.
    if (z == 0.0) {
        jz -= 1;
        q0 -= 24;
        while (jz > 0 && iq[libmIndex(jz)] == 0) {
            jz -= 1;
            q0 -= 24;
        }
    } else {
        // Break z into 24-bit pieces if needed.
        z = libmScalbn(z, 0 - q0);
        if (z >= LIBM_TWO24) {
            let fw = round<f64>(libmToInt(LIBM_TWON24 * z));
            iq[libmIndex(jz)] = truncate<u32>(libmToInt(z - LIBM_TWO24 * fw));
            jz += 1;
            q0 += 24;
            iq[libmIndex(jz)] = truncate<u32>(libmToInt(fw));
        } else {
            iq[libmIndex(jz)] = truncate<u32>(libmToInt(z));
        }
    }
    // Convert the integer bit chunks to floating point.
    var fw = libmScalbn(1.0, q0);
    var i = jz;
    while (i >= 0) {
        q[libmIndex(i)] = fw * (iq[libmIndex(i)] as f64);
        fw = fw * LIBM_TWON24;
        i -= 1;
    }
    // Multiply by pi/2.
    i = jz;
    while (i >= 0) {
        var sum = 0.0;
        var k: i64 = 0;
        while (k <= jp && k <= jz - i) {
            sum = sum + libmPio2Part(libmIndex(k)) * q[libmIndex(i + k)];
            k += 1;
        }
        fq[libmIndex(jz - i)] = sum;
        i -= 1;
    }
    // Compress fq[] into hi + lo.
    var sum = 0.0;
    i = jz;
    while (i >= 0) {
        sum = sum + fq[libmIndex(i)];
        i -= 1;
    }
    let hi = if (ih == 0) sum else 0.0 - sum;
    var rest = fq[0] - sum;
    for (k in 1..jz + 1) {
        rest = rest + fq[libmIndex(k)];
    }
    let lo = if (ih == 0) rest else 0.0 - rest;
    return LibmReduced { n: n % 8, hi: hi, lo: lo };
}

/// One of the first four multiples of pi/2, for small arguments.
fn libmReduceSmall(x: f64, k: i64, negative: bool) -> LibmReduced {
    let kf = round<f64>(k);
    if (!negative) {
        let z = x - kf * LIBM_PIO2_1;
        let hi = z - kf * LIBM_PIO2_1T;
        return LibmReduced { n: k, hi: hi, lo: (z - hi) - kf * LIBM_PIO2_1T };
    }
    let z = x + kf * LIBM_PIO2_1;
    let hi = z + kf * LIBM_PIO2_1T;
    return LibmReduced { n: 0 - k, hi: hi, lo: (z - hi) + kf * LIBM_PIO2_1T };
}

/// __ieee754_rem_pio2: x - n * pi/2, for |x| above pi/4.
fn libmRemPio2(x: f64) -> LibmReduced {
    let hx = libmHigh(x);
    let ix = hx & 0x7fffffff;
    let negative = (hx >> 31) != 0;
    if (ix <= 0x400f6a7a) {
        // |x| ~<= 5pi/4; a multiple of pi/2 near x needs the medium method.
        if ((ix & 0xfffff) != 0x921fb) {
            return libmReduceSmall(x, if (ix <= 0x4002d97c) 1 else 2, negative);
        }
    } else if (ix <= 0x401c463b) {
        // |x| ~<= 9pi/4
        if (ix <= 0x4015fdbc) {
            if (ix != 0x4012d97c) {
                return libmReduceSmall(x, 3, negative);
            }
        } else if (ix != 0x401921fb) {
            return libmReduceSmall(x, 4, negative);
        }
    }
    if (ix < 0x413921fb) {
        // |x| ~< 2^20 * pi/2: medium size.
        let nearest = (x * LIBM_INVPIO2 + 6755399441055744.0) - 6755399441055744.0;
        let n = libmToInt(nearest);
        var r = x - nearest * LIBM_PIO2_1;
        var w = nearest * LIBM_PIO2_1T;
        let j = (ix >> 20) as i64;
        var hi = r - w;
        var i = j - ((libmHigh(hi) >> 20) & 0x7ff) as i64;
        if (i > 16) {
            // 2nd iteration, good to 118 bits.
            var t = r;
            w = nearest * LIBM_PIO2_2;
            r = t - w;
            w = nearest * LIBM_PIO2_2T - ((t - r) - w);
            hi = r - w;
            i = j - ((libmHigh(hi) >> 20) & 0x7ff) as i64;
            if (i > 49) {
                // 3rd iteration, 151 bits.
                t = r;
                w = nearest * LIBM_PIO2_3;
                r = t - w;
                w = nearest * LIBM_PIO2_3T - ((t - r) - w);
                hi = r - w;
            }
        }
        return LibmReduced { n: n, hi: hi, lo: (r - hi) - w };
    }
    if (ix >= 0x7ff00000) {
        return LibmReduced { n: 0, hi: libmNan(), lo: libmNan() };
    }
    // Large: split |x| scaled to [2^23, 2^24) into three 24-bit pieces.
    let e0 = (ix >> 20) as i64 - 1046;
    var z = libmWords(libmWord(ix as i64 - e0 * 0x100000), libmLow(x));
    var tx = [0.0f64; 3];
    for (i in 0..2) {
        tx[i] = round<f64>(libmToInt(z));
        z = (z - tx[i]) * LIBM_TWO24;
    }
    tx[2] = z;
    var nx: i64 = 3;
    while (nx > 1 && tx[libmIndex(nx - 1)] == 0.0) {
        nx -= 1;
    }
    let reduced = libmKernelRemPio2(tx, nx, e0);
    if (negative) {
        return LibmReduced { n: 0 - reduced.n, hi: 0.0 - reduced.hi, lo: 0.0 - reduced.lo };
    }
    return reduced;
}

// ---- sin, cos, tan (k_sin.c, k_cos.c, k_tan.c, s_sin.c, s_cos.c, s_tan.c) ----

/// sin(x + y) for |x| ~<= pi/4, y the tail of x; `withTail` false when y is 0.
fn libmKernelSin(x: f64, y: f64, withTail: bool) -> f64 {
    let s1 = -1.66666666666666324348e-01;
    let s2 = 8.33333333332248946124e-03;
    let s3 = -1.98412698298579493134e-04;
    let s4 = 2.75573137070700676789e-06;
    let s5 = -2.50507602534068634195e-08;
    let s6 = 1.58969099521155010221e-10;
    let z = x * x;
    let w = z * z;
    let r = s2 + z * (s3 + z * s4) + z * w * (s5 + z * s6);
    let v = z * x;
    if (!withTail) {
        return x + v * (s1 + z * r);
    }
    return x - ((z * (0.5 * y - v * r) - y) - v * s1);
}

/// cos(x + y) for |x| ~<= pi/4.
fn libmKernelCos(x: f64, y: f64) -> f64 {
    let c1 = 4.16666666666666019037e-02;
    let c2 = -1.38888888888741095749e-03;
    let c3 = 2.48015872894767294178e-05;
    let c4 = -2.75573143513906633035e-07;
    let c5 = 2.08757232129817482790e-09;
    let c6 = -1.13596475577881948265e-11;
    let z = x * x;
    var w = z * z;
    let r = z * (c1 + z * (c2 + z * c3)) + w * w * (c4 + z * (c5 + z * c6));
    let hz = 0.5 * z;
    w = 1.0 - hz;
    return w + (((1.0 - w) - hz) + (z * r - x * y));
}

fn libmTanCoefficient(i: usize) -> f64 => match (i) {
    0 => 3.33333333333334091986e-01,
    1 => 1.33333333333201242699e-01,
    2 => 5.39682539762260521377e-02,
    3 => 2.18694882948595424599e-02,
    4 => 8.86323982359930005737e-03,
    5 => 3.59207910759131235356e-03,
    6 => 1.45620945432529025516e-03,
    7 => 5.88041240820264096874e-04,
    8 => 2.46463134818469906812e-04,
    9 => 7.81794442939557092300e-05,
    10 => 7.14072491382608190305e-05,
    11 => -1.85586374855275456654e-05,
    _ => 2.59073051863633712884e-05,
};

/// tan(x + y) for |x| ~<= pi/4, or -1/tan(x + y) when `odd`.
fn libmKernelTan(x0: f64, y0: f64, odd: bool) -> f64 {
    let pio4 = 7.85398163397448278999e-01;
    let pio4lo = 3.06161699786838301793e-17;
    var x = x0;
    var y = y0;
    let hx = libmHigh(x);
    let ix = hx & 0x7fffffff;
    let negative = (hx >> 31) != 0;
    let big = ix >= 0x3FE59428;
    if (big) {
        // |x| >= 0.6744: tan(x) = tan(pi/4 - (pi/4 - x)).
        if (negative) {
            x = 0.0 - x;
            y = 0.0 - y;
        }
        let z = pio4 - x;
        let w = pio4lo - y;
        x = z + w;
        y = 0.0;
    }
    let t = libmTanCoefficient;
    var z = x * x;
    var w = z * z;
    var r = t(1) + w * (t(3) + w * (t(5) + w * (t(7) + w * (t(9) + w * t(11)))));
    var v = z * (t(2) + w * (t(4) + w * (t(6) + w * (t(8) + w * (t(10) + w * t(12))))));
    var s = z * x;
    r = y + z * (s * (r + v) + y);
    r = r + t(0) * s;
    w = x + r;
    if (big) {
        v = if (odd) -1.0 else 1.0;
        let sign = if (negative) -1.0 else 1.0;
        return sign * (v - 2.0 * (x - (w * w / (w + v) - r)));
    }
    if (!odd) {
        return w;
    }
    // -1/(x + r), computed accurately.
    z = libmWithLow(w, 0);
    v = r - (z - x);
    let a = -1.0 / w;
    let tt = libmWithLow(a, 0);
    s = 1.0 + tt * z;
    return tt + a * (s + tt * v);
}

fn libmSin(x: f64) -> f64 {
    let ix = libmHigh(x) & 0x7fffffff;
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e500000) {
            return x;
        }
        return libmKernelSin(x, 0.0, false);
    }
    if (ix >= 0x7ff00000) {
        return libmNan();
    }
    let y = libmRemPio2(x);
    return match (truncate<u64>(y.n) & 3) {
        0 => libmKernelSin(y.hi, y.lo, true),
        1 => libmKernelCos(y.hi, y.lo),
        2 => 0.0 - libmKernelSin(y.hi, y.lo, true),
        _ => 0.0 - libmKernelCos(y.hi, y.lo),
    };
}

fn libmCos(x: f64) -> f64 {
    let ix = libmHigh(x) & 0x7fffffff;
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e46a09e) {
            return 1.0;
        }
        return libmKernelCos(x, 0.0);
    }
    if (ix >= 0x7ff00000) {
        return libmNan();
    }
    let y = libmRemPio2(x);
    return match (truncate<u64>(y.n) & 3) {
        0 => libmKernelCos(y.hi, y.lo),
        1 => 0.0 - libmKernelSin(y.hi, y.lo, true),
        2 => 0.0 - libmKernelCos(y.hi, y.lo),
        _ => libmKernelSin(y.hi, y.lo, true),
    };
}

fn libmTan(x: f64) -> f64 {
    let ix = libmHigh(x) & 0x7fffffff;
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e400000) {
            return x;
        }
        return libmKernelTan(x, 0.0, false);
    }
    if (ix >= 0x7ff00000) {
        return libmNan();
    }
    let y = libmRemPio2(x);
    return libmKernelTan(y.hi, y.lo, (truncate<u64>(y.n) & 1) != 0);
}

// ---- atan and atan2 (s_atan.c, e_atan2.c; asin and acos are in the double-double section) ----

const LIBM_PIO2_HI: f64 = 1.57079632679489655800e+00;
const LIBM_PIO2_LO: f64 = 6.12323399573676603587e-17;
const LIBM_PI: f64 = 3.14159265358979311600e+00;

fn libmAtanHi(id: i64) -> f64 => match (id) {
    0 => 4.63647609000806093515e-01,
    1 => 7.85398163397448278999e-01,
    2 => 9.82793723247329054082e-01,
    _ => 1.57079632679489655800e+00,
};

fn libmAtanLo(id: i64) -> f64 => match (id) {
    0 => 2.26987774529616870924e-17,
    1 => 3.06161699786838301793e-17,
    2 => 1.39033110312309984516e-17,
    _ => 6.12323399573676603587e-17,
};

fn libmAtan(x0: f64) -> f64 {
    var x = x0;
    let hx = libmHigh(x);
    let ix = hx & 0x7fffffff;
    let negative = (hx >> 31) != 0;
    if (ix >= 0x44100000) {
        // |x| >= 2^66
        if (x != x) {
            return x + x;
        }
        let z = libmAtanHi(3) + libmAtanLo(3);
        return if (negative) 0.0 - z else z;
    }
    var id: i64 = -1;
    if (ix < 0x3fdc0000) {
        // |x| < 0.4375
        if (ix < 0x3e400000) {
            return x;
        }
    } else {
        x = x.abs();
        if (ix < 0x3ff30000) {
            if (ix < 0x3fe60000) {
                id = 0;
                x = (2.0 * x - 1.0) / (2.0 + x);
            } else {
                id = 1;
                x = (x - 1.0) / (x + 1.0);
            }
        } else if (ix < 0x40038000) {
            id = 2;
            x = (x - 1.5) / (1.0 + 1.5 * x);
        } else {
            id = 3;
            x = -1.0 / x;
        }
    }
    let z = x * x;
    let w = z * z;
    let s1 =
        z *
            (3.33333333333329318027e-01 +
                w *
                    (1.42857142725034663711e-01 +
                        w *
                            (9.09088713343650656196e-02 +
                                w *
                                    (6.66107313738753120669e-02 +
                                        w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))));
    let s2 =
        w *
            (-1.99999999998764832476e-01 +
                w *
                    (-1.11111104054623557880e-01 +
                        w *
                            (-7.69187620504482999495e-02 +
                                w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))));
    if (id < 0) {
        return x - x * (s1 + s2);
    }
    let r = libmAtanHi(id) - ((x * (s1 + s2) - libmAtanLo(id)) - x);
    return if (negative) 0.0 - r else r;
}

fn libmAtan2(y: f64, x: f64) -> f64 {
    let piOver4 = 7.8539816339744827900E-01;
    let piOver2 = 1.5707963267948965580E+00;
    let piLo = 1.2246467991473531772E-16;
    if (x != x || y != y) {
        return x + y;
    }
    let hx = libmHigh(x);
    let lx = libmLow(x);
    let ix = hx & 0x7fffffff;
    let hy = libmHigh(y);
    let ly = libmLow(y);
    let iy = hy & 0x7fffffff;
    if (hx == 0x3ff00000 && lx == 0) {
        return libmAtan(y);
    }
    let yNegative = (hy >> 31) != 0;
    let xNegative = (hx >> 31) != 0;
    // 2 * sign(x) + sign(y)
    let m = (if (yNegative) 1 else 0) + (if (xNegative) 2 else 0);
    if (iy == 0 && ly == 0) {
        return match (m) {
            0 | 1 => y,
            2 => LIBM_PI,
            _ => 0.0 - LIBM_PI,
        };
    }
    if (ix == 0 && lx == 0) {
        return if (yNegative) 0.0 - piOver2 else piOver2;
    }
    if (ix == 0x7ff00000) {
        if (iy == 0x7ff00000) {
            return match (m) {
                0 => piOver4,
                1 => 0.0 - piOver4,
                2 => 3.0 * piOver4,
                _ => -3.0 * piOver4,
            };
        }
        return match (m) {
            0 => 0.0,
            1 => -0.0,
            2 => LIBM_PI,
            _ => 0.0 - LIBM_PI,
        };
    }
    if (iy == 0x7ff00000) {
        return if (yNegative) 0.0 - piOver2 else piOver2;
    }
    // k = (iy - ix) >> 20, the difference of the exponents.
    let d = iy as i64 - ix as i64;
    var quadrant = m;
    var z = 0.0;
    if (d >= 61 * 0x100000) {
        // |y/x| > 2^60
        z = piOver2 + 0.5 * piLo;
        quadrant = m % 2;
    } else if (xNegative && d < -60 * 0x100000) {
        // 0 > x, |y|/x < -2^60
        z = 0.0;
    } else {
        // Not msun: atan(|y/x|) in double-double, so the result is rounded once (the libm of macOS is that
        // accurate; msun's rounded quotient is not).
        return libmAtan2Accurate(y.abs(), x.abs(), quadrant);
    }
    return match (quadrant) {
        0 => z,
        1 => 0.0 - z,
        2 => LIBM_PI - (z - piLo),
        _ => (z - piLo) - LIBM_PI,
    };
}

const LIBM_INVLN2: f64 = 1.44269504088896338700e+00;
const LIBM_EXP_OVERFLOW: f64 = 7.09782712893383973096e+02;
const LIBM_EXP_UNDERFLOW: f64 = -7.45133219101941108420e+02;

// ---- The inverse hyperbolic functions (s_asinh.c, e_acosh.c, e_atanh.c) ----
//
// msun's formulas, with log and log1p rounded once (below) as the libm of macOS rounds them: macOS computes
// these the same way, so its results are matched far more often than with msun's log and log1p.

const LIBM_TWO54: f64 = 1.80143985094819840000e+16;

const LIBM_LN2: f64 = 6.93147180559945286227e-01;

fn libmAsinh(x: f64) -> f64 {
    let hx = libmHigh(x);
    let ix = hx & 0x7fffffff;
    if (ix >= 0x7ff00000) {
        return x + x;
    }
    if (ix < 0x3e300000) {
        // |x| < 2^-28
        return x;
    }
    var w = 0.0;
    if (ix > 0x41b00000) {
        // |x| > 2^28
        w = libmLnAccurate(x.abs()) + LIBM_LN2;
    } else if (ix > 0x40000000) {
        // 2^28 > |x| > 2.0
        let t = x.abs();
        w = libmLnAccurate(2.0 * t + 1.0 / ((x * x + 1.0).sqrt() + t));
    } else {
        // 2.0 > |x| > 2^-28
        let t = x * x;
        w = libmLog1pAccurate(x.abs() + t / (1.0 + (1.0 + t).sqrt()));
    }
    return if ((hx >> 31) == 0) w else 0.0 - w;
}

fn libmAcosh(x: f64) -> f64 {
    let hx = libmSignedHigh(x);
    if (hx < 0x3ff00000) {
        // x < 1
        return libmNan();
    }
    if (hx >= 0x41b00000) {
        // x > 2^28
        if (hx >= 0x7ff00000) {
            return x + x;
        }
        return libmLnAccurate(x) + LIBM_LN2;
    }
    if (hx == 0x3ff00000 && libmLow(x) == 0) {
        return 0.0;
    }
    if (hx > 0x40000000) {
        // 2^28 > x > 2
        let t = x * x;
        return libmLnAccurate(2.0 * x - 1.0 / (x + (t - 1.0).sqrt()));
    }
    // 1 < x < 2
    let t = x - 1.0;
    return libmLog1pAccurate(t + (2.0 * t + t * t).sqrt());
}

fn libmAtanh(x0: f64) -> f64 {
    let hx = libmHigh(x0);
    let ix = hx & 0x7fffffff;
    let ax = x0.abs();
    if (x0 != x0 || ax > 1.0) {
        return libmNan();
    }
    if (ax == 1.0) {
        return if ((hx >> 31) == 0) libmInfinity() else 0.0 - libmInfinity();
    }
    if (ix < 0x3e300000) {
        // |x| < 2^-28
        return x0;
    }
    var t = 0.0;
    if (ix < 0x3fe00000) {
        // |x| < 0.5
        t = ax + ax;
        t = 0.5 * libmLog1pAccurate(t + t * ax / (1.0 - ax));
    } else {
        t = 0.5 * libmLog1pAccurate((ax + ax) / (1.0 - ax));
    }
    return if ((hx >> 31) == 0) t else 0.0 - t;
}

// ---- pow (e_pow.c's special cases; the general case in double-double) ----

fn libmPow(x: f64, y: f64) -> f64 {
    let hxBits = libmHigh(x);
    let lx = libmLow(x);
    let hyBits = libmHigh(y);
    let ly = libmLow(y);
    let hx = libmSignedHigh(x);
    let hy = libmSignedHigh(y);
    var ix = hxBits & 0x7fffffff;
    let iy = hyBits & 0x7fffffff;
    // y == 0: x**0 = 1
    if (iy == 0 && ly == 0) {
        return 1.0;
    }
    // 1**y = 1, even for NaN
    if (hxBits == 0x3ff00000 && lx == 0) {
        return 1.0;
    }
    if (x != x || y != y) {
        return x + y;
    }
    // When x < 0, whether y is an odd integer (1), an even one (2) or not one (0).
    var yisint: i64 = 0;
    if (hx < 0) {
        if (iy >= 0x43400000) {
            yisint = 2;
        } else if (iy >= 0x3ff00000) {
            let k = (iy >> 20) as i64 - 0x3ff;
            if (k > 20) {
                let j = ly >> truncate<u32>(52 - k);
                if ((j << truncate<u32>(52 - k)) == ly) {
                    yisint = 2 - (j & 1) as i64;
                }
            } else if (ly == 0) {
                let j = iy >> truncate<u32>(20 - k);
                if ((j << truncate<u32>(20 - k)) == iy) {
                    yisint = 2 - (j & 1) as i64;
                }
            }
        }
    }
    // Special values of y.
    if (ly == 0) {
        if (iy == 0x7ff00000) {
            // y is +-inf
            if (ix == 0x3ff00000 && lx == 0) {
                return 1.0;
            }
            if (ix >= 0x3ff00000) {
                return if (hy >= 0) y else 0.0;
            }
            return if (hy < 0) 0.0 - y else 0.0;
        }
        if (iy == 0x3ff00000) {
            return if (hy < 0) 1.0 / x else x;
        }
        if (hy == 0x40000000) {
            return x * x;
        }
        if (hy == 0x3fe00000 && hx >= 0) {
            return x.sqrt();
        }
    }
    var ax = x.abs();
    // Special values of x.
    if (lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000)) {
        var z = ax;
        if (hy < 0) {
            z = 1.0 / z;
        }
        if (hx < 0) {
            if (ix == 0x3ff00000 && yisint == 0) {
                // (-1)**non-int is NaN
                z = libmNan();
            } else if (yisint == 1) {
                z = 0.0 - z;
            }
        }
        return z;
    }
    // (x<0)**(non-int) is NaN
    if (hx < 0 && yisint == 0) {
        return libmNan();
    }
    // The sign of the result.
    let s = if (hx < 0 && yisint == 1) -1.0 else 1.0;
    if (iy > 0x41e00000) {
        // |y| > 2^31
        if (iy > 0x43f00000) {
            // |y| > 2^64: overflow or underflow
            if (ix <= 0x3fefffff) {
                return if (hy < 0) libmInfinity() else 0.0;
            }
            if (ix >= 0x3ff00000) {
                return if (hy > 0) libmInfinity() else 0.0;
            }
        }
        if (ix < 0x3fefffff) {
            return if (hy < 0) s * libmInfinity() else s * 0.0;
        }
        if (ix > 0x3ff00000) {
            return if (hy > 0) s * libmInfinity() else s * 0.0;
        }
    }
    // Not msun: exp(y * log(|x|)) in double-double, rounded once, as the libm of macOS rounds pow correctly
    // (msun's pow is within one unit in the last place).
    let product = ddMul(libmLnDouble(ax), ddOf(y));
    if (product.hi > 710.0) {
        return s * libmInfinity();
    }
    if (product.hi < -746.0) {
        return s * 0.0;
    }
    let power = libmExpScaled(product);
    return s * libmRoundScaled(power.m, power.k);
}

// ---- Double-double arithmetic, for the functions macOS rounds correctly ----
//
// The libm of macOS returns exp, log, log10, log2, pow, sinh, cosh, tanh and atan2 correctly rounded on almost
// every argument, which msun does not (it is within one unit in the last place); its asin and acos are closer to
// correctly rounded than msun's too. These are computed here in
// double-double arithmetic (about 100 bits) and rounded once at the end, so they agree with macOS except where the
// exact value is within about 2^-100 of half a unit. Not from msun: written for this port.

/// hi + lo, with |lo| at most half a unit in the last place of hi.
struct LibmDd {
    hi: f64;
    lo: f64;
}

fn ddOf(x: f64) -> LibmDd => LibmDd { hi: x, lo: 0.0 };

fn ddBits(hi: u64, lo: u64) -> LibmDd => LibmDd { hi: f64.fromBits(hi), lo: f64.fromBits(lo) };

/// a + b exactly (Knuth's TwoSum).
fn ddTwoSum(a: f64, b: f64) -> LibmDd {
    let s = a + b;
    let bb = s - a;
    return LibmDd { hi: s, lo: (a - (s - bb)) + (b - bb) };
}

/// a + b exactly, for |a| >= |b| (Dekker's FastTwoSum).
fn ddFastTwoSum(a: f64, b: f64) -> LibmDd {
    let s = a + b;
    return LibmDd { hi: s, lo: b - (s - a) };
}

/// The high 26 bits of a (Veltkamp's split).
fn ddSplitHigh(a: f64) -> f64 {
    let t = 134217729.0 * a;
    return t - (t - a);
}

/// a * b exactly (Dekker's TwoProduct: CeeSafe has no fused multiply-add).
fn ddTwoProduct(a: f64, b: f64) -> LibmDd {
    let p = a * b;
    let ah = ddSplitHigh(a);
    let al = a - ah;
    let bh = ddSplitHigh(b);
    let bl = b - bh;
    return LibmDd { hi: p, lo: ((ah * bh - p) + ah * bl + al * bh) + al * bl };
}

fn ddAdd(x: LibmDd, y: LibmDd) -> LibmDd {
    let s = ddTwoSum(x.hi, y.hi);
    let t = ddTwoSum(x.lo, y.lo);
    let u = ddFastTwoSum(s.hi, s.lo + t.hi);
    return ddFastTwoSum(u.hi, u.lo + t.lo);
}

fn ddNegate(x: LibmDd) -> LibmDd => LibmDd { hi: 0.0 - x.hi, lo: 0.0 - x.lo };

fn ddSub(x: LibmDd, y: LibmDd) -> LibmDd => ddAdd(x, ddNegate(y));

fn ddMul(x: LibmDd, y: LibmDd) -> LibmDd {
    let p = ddTwoProduct(x.hi, y.hi);
    return ddFastTwoSum(p.hi, p.lo + (x.hi * y.lo + x.lo * y.hi));
}

fn ddDiv(x: LibmDd, y: LibmDd) -> LibmDd {
    let q1 = x.hi / y.hi;
    var r = ddSub(x, ddMul(y, ddOf(q1)));
    let q2 = r.hi / y.hi;
    r = ddSub(r, ddMul(y, ddOf(q2)));
    let q3 = r.hi / y.hi;
    return ddAdd(ddFastTwoSum(q1, q2), ddOf(q3));
}

/// x * 2^k, exact while neither part overflows or becomes subnormal.
fn ddScale(x: LibmDd, k: i64) -> LibmDd => LibmDd { hi: libmScalbn(x.hi, k), lo: libmScalbn(x.lo, k) };

fn ddToDouble(x: LibmDd) -> f64 => x.hi + x.lo;

fn libmLn2Dd() -> LibmDd => ddBits(0x3FE62E42FEFA39EF, 0x3C7ABC9E3B39803F);

fn libmInvLn2Dd() -> LibmDd => ddBits(0x3FF71547652B82FE, 0x3C7777D0FFDA0D24);

fn libmInvLn10Dd() -> LibmDd => ddBits(0x3FDBCB7B1526E50E, 0x3C695355BAAAFAD3);

fn libmPiDd() -> LibmDd => ddBits(0x400921FB54442D18, 0x3CA1A62633145C07);

fn libmPio2Dd() -> LibmDd => ddBits(0x3FF921FB54442D18, 0x3C91A62633145C07);

/// atan(j/16) for j in 0..=16, high and low parts.
const LIBM_ATAN_SIXTEENTHS_HI: [u64; 17] = [
    0x0000000000000000, 0x3FAFF55BB72CFDEA, 0x3FBFD5BA9AAC2F6E, 0x3FC7B97B4BCE5B02, 0x3FCF5B75F92C80DD,
    0x3FD362773707EBCC, 0x3FD6F61941E4DEF1, 0x3FDA64EEC3CC23FD, 0x3FDDAC670561BB4F, 0x3FE0657E94DB30D0,
    0x3FE1E00BABDEFEB4, 0x3FE345F01CCE37BB, 0x3FE4978FA3269EE1, 0x3FE5D58987169B18, 0x3FE700A7C5784634,
    0x3FE819D0B7158A4D, 0x3FE921FB54442D18,
];

const LIBM_ATAN_SIXTEENTHS_LO: [u64; 17] = [
    0x0000000000000000, 0xBC3C934D86D23F1D, 0xBC4CD37686760C17, 0x3C5347B0B4F881CA, 0x3C68AB6E3CF7AFBD,
    0xBC6963A544B672D8, 0xBC7C63AAE6F6E918, 0xBC724DEC1B50B7FF, 0x3C7A2B7F222F65E2, 0xBC7D5B495F6349E6,
    0xBC5928DF287A668F, 0x3C81021137C71102, 0x3C72419A87F2A458, 0x3C60028E4BC5E7CA, 0xBC78C34D25AADEF6,
    0xBC7BF76229D3B917, 0x3C81A62633145C07,
];

/// m * 2^k: a result kept apart from its scale, so that it neither overflows nor underflows before rounding.
struct LibmScaled {
    k: i64;
    m: LibmDd;
}

/// exp(a), for |a.hi| below about 750.
fn libmExpScaled(a: LibmDd) -> LibmScaled {
    let k = libmToInt((a.hi * LIBM_INVLN2 + 0.5).floor());
    // r = a - k ln2, |r| <= ln2/2, then s = r / 2^10.
    let r = ddSub(a, ddMul(libmLn2Dd(), ddOf(round<f64>(k))));
    let s = ddScale(r, -10);
    // expm1(s) = s (1 + s/2 (1 + s/3 (1 + ... (1 + s/12)))), |s| < 2^-11.
    var e = ddOf(1.0);
    var n: i64 = 12;
    while (n >= 2) {
        e = ddAdd(ddOf(1.0), ddMul(ddDiv(s, ddOf(round<f64>(n))), e));
        n -= 1;
    }
    e = ddMul(s, e);
    // exp(r) = (1 + expm1(s))^(2^10): square ten times, keeping the part below 1 apart.
    for (i in 0..10) {
        e = ddAdd(ddScale(e, 1), ddMul(e, e));
    }
    return LibmScaled { k: k, m: ddAdd(ddOf(1.0), e) };
}

/// m * 2^k rounded once to a double, m positive: a subnormal result is rounded from m's full precision.
fn libmRoundScaled(m: LibmDd, k: i64) -> f64 {
    let z = libmScalbn(m.hi, k);
    if (z == 0.0 || z.abs() >= 2.2250738585072014e-308 || z != z || k > 0) {
        return z;
    }
    // Subnormal: what scaling m.hi dropped, plus m.lo, against half a unit of the subnormal.
    let back = libmScalbn(z, 0 - k);
    let rest = (m.hi - back) + m.lo;
    let half = libmScalbn(0.5, -1074 - k);
    let unit = f64.fromBits(1);
    if (rest > half) {
        return z + unit;
    }
    if (rest < 0.0 - half) {
        return z - unit;
    }
    return z;
}

fn libmExpAccurate(x: f64) -> f64 {
    if (x != x) {
        return x + x;
    }
    if (x > LIBM_EXP_OVERFLOW) {
        return libmInfinity();
    }
    if (x < LIBM_EXP_UNDERFLOW) {
        return 0.0;
    }
    if (x.abs() < 5.551115123125783e-17) {
        // |x| < 2^-54: exp(x) rounds to 1.
        return 1.0;
    }
    let e = libmExpScaled(ddOf(x));
    return libmRoundScaled(e.m, e.k);
}

/// ln(u) in double-double, for positive finite u.
fn libmLnOfDd(u0: LibmDd) -> LibmDd {
    var u = u0;
    var k: i64 = 0;
    if (u.hi < 2.2250738585072014e-308) {
        u = LibmDd { hi: u.hi * LIBM_TWO54, lo: u.lo * LIBM_TWO54 };
        k = -54;
    }
    let e = truncate<i64>(u.hi.bits() >> 52) - 1023;
    k += e;
    var m = ddScale(u, 0 - e);
    if (m.hi > 1.4142135623730951) {
        m = ddScale(m, -1);
        k += 1;
    }
    // ln(m) = 2 atanh(s) = 2 (s + s^3/3 + s^5/5 + ...), s = (m - 1)/(m + 1), |s| <= 0.1716.
    let s = ddDiv(ddSub(m, ddOf(1.0)), ddAdd(m, ddOf(1.0)));
    let s2 = ddMul(s, s);
    var sum = ddDiv(ddOf(1.0), ddOf(45.0));
    var j: i64 = 21;
    while (j >= 0) {
        sum = ddAdd(ddDiv(ddOf(1.0), ddOf(round<f64>(2 * j + 1))), ddMul(s2, sum));
        j -= 1;
    }
    return ddAdd(ddMul(libmLn2Dd(), ddOf(round<f64>(k))), ddMul(ddScale(s, 1), sum));
}

/// ln(x) in double-double, for positive finite x.
fn libmLnDouble(x: f64) -> LibmDd => libmLnOfDd(ddOf(x));

/// ln(1 + x), rounded once: 1 + x is formed exactly as a double-double.
fn libmLog1pAccurate(x: f64) -> f64 {
    if (x != x || x > 1.7976931348623157e308) {
        return x + x;
    }
    if (x == -1.0) {
        return 0.0 - libmInfinity();
    }
    if (x < -1.0) {
        return libmNan();
    }
    if (x.abs() < 5.551115123125783e-17) {
        // |x| < 2^-54: log1p(x) rounds to x.
        return x;
    }
    return ddToDouble(libmLnOfDd(ddTwoSum(1.0, x)));
}

/// The special results of ln, log10 and log2 (of zero, negative numbers, infinity and NaN), or null.
fn libmLogSpecial(x: f64) -> f64? {
    if (x != x) {
        return x + x;
    }
    if (x == 0.0) {
        return 0.0 - libmInfinity();
    }
    if (x < 0.0) {
        return libmNan();
    }
    if (x > 1.7976931348623157e308) {
        return x;
    }
    return null;
}

fn libmLnAccurate(x: f64) -> f64 {
    if (libmLogSpecial(x) is Some(special)) {
        return special;
    }
    return ddToDouble(libmLnDouble(x));
}

fn libmLog10Accurate(x: f64) -> f64 {
    if (libmLogSpecial(x) is Some(special)) {
        return special;
    }
    return ddToDouble(ddMul(libmLnDouble(x), libmInvLn10Dd()));
}

fn libmLog2Accurate(x: f64) -> f64 {
    if (libmLogSpecial(x) is Some(special)) {
        return special;
    }
    return ddToDouble(ddMul(libmLnDouble(x), libmInvLn2Dd()));
}

/// sinh(x) by its series, for |x| < 1: x (1 + x^2/(2*3) (1 + x^2/(4*5) (1 + ...))).
fn libmSinhSeries(x: f64) -> LibmDd {
    let x2 = ddTwoProduct(x, x);
    var sum = ddOf(1.0);
    var n: i64 = 30;
    while (n >= 2) {
        sum = ddAdd(ddOf(1.0), ddMul(ddDiv(x2, ddOf(round<f64>(n * (n + 1)))), sum));
        n -= 2;
    }
    return ddMul(sum, ddOf(x));
}

/// cosh(x) by its series, for |x| < 1: 1 + x^2/(1*2) (1 + x^2/(3*4) (1 + ...)).
fn libmCoshSeries(x: f64) -> LibmDd {
    let x2 = ddTwoProduct(x, x);
    var sum = ddOf(1.0);
    var n: i64 = 30;
    while (n >= 2) {
        sum = ddAdd(ddOf(1.0), ddMul(ddDiv(x2, ddOf(round<f64>((n - 1) * n))), sum));
        n -= 2;
    }
    return sum;
}

/// (e^a + sign e^-a) / 2 for a >= 1: cosh(a) with sign 1, sinh(a) with sign -1.
fn libmHyperbolic(a: f64, sign: f64) -> f64 {
    let e = libmExpScaled(ddOf(a));
    if (e.k > 60) {
        // e^-a is below 2^-120 of e^a.
        return libmRoundScaled(e.m, e.k - 1);
    }
    let big = ddScale(e.m, e.k);
    let small = ddDiv(ddOf(1.0), big);
    return ddToDouble(ddScale(ddAdd(big, ddMul(small, ddOf(sign))), -1));
}

fn libmCoshAccurate(x: f64) -> f64 {
    let a = x.abs();
    if (x != x) {
        return x + x;
    }
    if (a > 711.0) {
        return libmInfinity();
    }
    if (a < 7.450580596923828e-9) {
        // |x| < 2^-27: cosh(x) rounds to 1.
        return 1.0;
    }
    if (a < 1.0) {
        return ddToDouble(libmCoshSeries(a));
    }
    return libmHyperbolic(a, 1.0);
}

fn libmSinhAccurate(x: f64) -> f64 {
    let a = x.abs();
    if (x != x || a > 711.0) {
        return x * 1.0e307;
    }
    if (a < 1.4901161193847656e-8) {
        // |x| < 2^-26: sinh(x) rounds to x.
        return x;
    }
    let r = if (a < 1.0) ddToDouble(libmSinhSeries(a)) else libmHyperbolic(a, -1.0);
    return if (x < 0.0) 0.0 - r else r;
}

fn libmTanhAccurate(x: f64) -> f64 {
    let a = x.abs();
    if (x != x) {
        return x + x;
    }
    if (a < 1.4901161193847656e-8) {
        return x;
    }
    var r = 1.0;
    if (a < 1.0) {
        r = ddToDouble(ddDiv(libmSinhSeries(a), libmCoshSeries(a)));
    } else if (a < 22.0) {
        // 1 - 2/(e^2a + 1)
        let e = libmExpScaled(ddOf(2.0 * a));
        let big = ddScale(e.m, e.k);
        r = ddToDouble(ddSub(ddOf(1.0), ddDiv(ddOf(2.0), ddAdd(big, ddOf(1.0)))));
    }
    return if (x < 0.0) 0.0 - r else r;
}

/// atan(z) in double-double, for 0 <= z.
fn libmAtanDouble(z0: LibmDd) -> LibmDd {
    let inverted = z0.hi > 1.0;
    let z = if (inverted) ddDiv(ddOf(1.0), z0) else z0;
    // atan(z) = atan(c) + atan((z - c)/(1 + z c)), c = j/16 nearest z.
    let j = libmToInt(z.hi * 16.0 + 0.5);
    let c = round<f64>(j) / 16.0;
    let t = ddDiv(ddSub(z, ddOf(c)), ddAdd(ddOf(1.0), ddMul(z, ddOf(c))));
    let t2 = ddMul(t, t);
    // atan(t) = t (1 - t^2/3 + t^4/5 - ...), |t| <= 1/32.
    var sum = ddOf(0.0);
    var n: i64 = 12;
    while (n >= 0) {
        let term = ddDiv(ddOf(if (n % 2 == 0) 1.0 else -1.0), ddOf(round<f64>(2 * n + 1)));
        sum = ddAdd(term, ddMul(t2, sum));
        n -= 1;
    }
    let index = libmIndex(j);
    let base = ddBits(LIBM_ATAN_SIXTEENTHS_HI[index], LIBM_ATAN_SIXTEENTHS_LO[index]);
    let result = ddAdd(base, ddMul(t, sum));
    return if (inverted) ddSub(libmPio2Dd(), result) else result;
}

/// atan2 for finite nonzero |y| = ay and |x| = ax whose quotient is within 2^±61, placed in its quadrant
/// (0: x > 0 and y > 0, 1: x > 0 and y < 0, 2: x < 0 and y > 0, 3: both negative).
fn libmAtan2Accurate(ay0: f64, ax0: f64, quadrant: i32) -> f64 {
    var ay = ay0;
    var ax = ax0;
    // Scale both so that the larger is near 1: the double-double steps then neither overflow nor underflow.
    var big = ay.max(ax);
    if (big < 1.0e-300) {
        ay = ay * libmPowerOfTwo(600);
        ax = ax * libmPowerOfTwo(600);
        big = ay.max(ax);
    }
    let shift = 1023 - truncate<i64>(big.bits() >> 52);
    ay = libmScalbn(ay, shift);
    ax = libmScalbn(ax, shift);
    let quotient = ddDiv(ddOf(ay), ddOf(ax));
    if (quotient.hi < 1.0e-150) {
        // atan(z) rounds to z.
        let z = ay / ax;
        return if (quadrant == 1) 0.0 - z else z;
    }
    let a = libmAtanDouble(quotient);
    return ddToDouble(match (quadrant) {
        0 => a,
        1 => ddNegate(a),
        2 => ddSub(libmPiDd(), a),
        _ => ddSub(a, libmPiDd()),
    });
}

/// The square root of a positive double-double (one Newton step from the double's).
fn ddSqrt(d: LibmDd) -> LibmDd {
    let s = d.hi.sqrt();
    let r = ddSub(d, ddTwoProduct(s, s));
    return ddFastTwoSum(s, r.hi / (2.0 * s));
}

/// sqrt(1 - x^2) for |x| < 1, from (1 - |x|)(1 + |x|) so that nothing cancels.
fn libmCosineOfSine(x: f64) -> LibmDd {
    let a = x.abs();
    return ddSqrt(ddMul(ddTwoSum(1.0, 0.0 - a), ddTwoSum(1.0, a)));
}

/// asin(x) = atan(x / sqrt(1 - x^2)) in double-double. Not msun's e_asin.c: rounded once, this agrees with macOS
/// about twice as often.
fn libmAsinAccurate(x: f64) -> f64 {
    let a = x.abs();
    if (x != x || a > 1.0) {
        return libmNan();
    }
    if (a == 1.0) {
        return x * LIBM_PIO2_HI;
    }
    if (a < 1.4901161193847656e-8) {
        // |x| < 2^-26: asin(x) rounds to x.
        return x;
    }
    let r = ddToDouble(libmAtanDouble(ddDiv(ddOf(a), libmCosineOfSine(a))));
    return if (x < 0.0) 0.0 - r else r;
}

/// acos(x) = atan(sqrt(1 - x^2) / x) in double-double, placed in [0, pi]. Not msun's e_acos.c, for the same
/// reason as asin.
fn libmAcosAccurate(x: f64) -> f64 {
    let a = x.abs();
    if (x != x || a > 1.0) {
        return libmNan();
    }
    if (x == 1.0) {
        return 0.0;
    }
    if (x == -1.0) {
        return LIBM_PI;
    }
    if (a < 1.4901161193847656e-8) {
        // |x| < 2^-26: acos(x) is pi/2 - x to well past rounding.
        return ddToDouble(ddSub(libmPio2Dd(), ddOf(x)));
    }
    let angle = libmAtanDouble(ddDiv(libmCosineOfSine(a), ddOf(a)));
    return ddToDouble(if (x < 0.0) ddSub(libmPiDd(), angle) else angle);
}
