// CREATE and DROP of tables, indexes and views, written to the pages of the transaction.
//
// Differences from the C# engine, which this replaces:
// - a definition is stored in sqlite_schema as the statement's own text, as SQLite stores it; the C# stored its
//   renderer's version, which lost what it did not know;
// - DROP gives the object's pages back to the freelist, and CREATE takes pages from it first;
// - every change to the schema adds one to the schema cookie, so other connections read the schema again.
//
// TEMP objects and those of attached databases are made by the same code, with their database made the session's
// active one (Session.run).

/// Writes an empty b-tree page: a table leaf or an index leaf.
fn initRoot(pager: borrow mut WritablePager, page: u32, kind: u8) -> Result<void, SqliteError> {
    let bytes = pager.pageMut(page)?;
    bytes.fill(0);
    BTreeBuilder.fillPage(bytes, 0, kind, [], null);
    return Ok();
}

/// Adds a row to sqlite_schema.
fn addSchemaRow<N: TextView, M: TextView, P: TextView>(
    db: borrow mut Session,
    kind: N,
    name: M,
    table: P,
    root: u32,
    sql: ByteStringView?,
) -> Result<void, SqliteError> {
    var values = Vector<SqliteValue>.create();
    values.push(SqliteValue.ofText(kind)?)?;
    values.push(SqliteValue.ofText(name)?)?;
    values.push(SqliteValue.ofText(table)?)?;
    values.push(SqliteValue.Integer(root as i64))?;
    values.push(if (sql is Some(s)) SqliteValue.ofText(s)? else SqliteValue.Null)?;
    let rowId = (lastRowid(mut db.pager, 1)? ?? 0) + 1;
    var op = Vector<TableOp>.create();
    op.push(TableOp { rowId: rowId, record: Record.encodeIn(values.view(), db.pager.textEncoding)? })?;
    TableMutator.applyBatch(mut db.pager, 1, op.view())?;
    return Ok();
}

/// Removes the rows of sqlite_schema for which `pick` is true, and gives back their b-trees' pages.
fn removeSchemaRows(db: borrow mut Session, name: ByteStringView, alsoOfTable: bool) -> Result<void, SqliteError> {
    var cursor = TableCursor.scan(1);
    var doomed = Vector<i64>.create();
    var roots = Vector<u32>.create();
    while (cursor.next(mut db.pager)? is Some(row)) {
        if (row.columns.length < 5) {
            continue;
        }
        let objectName = textOrEmptyRef(borrow row.columns[1])?;
        let tableName = textOrEmptyRef(borrow row.columns[2])?;
        let matches = objectName.view().equalsIgnoreAsciiCase(
            name,
        ) || (alsoOfTable && tableName.view().equalsIgnoreAsciiCase(name));
        if (!matches) {
            continue;
        }
        doomed.push(row.rowId)?;
        if (row.columns[3] is SqliteValue.Integer(root) && root > 0) {
            roots.push(truncate<u32>(root))?;
        }
    }
    var ops = Vector<TableOp>.create();
    for (i in 0..doomed.length) {
        ops.push(TableOp { rowId: doomed[i], record: null })?;
    }
    TableMutator.applyBatch(mut db.pager, 1, ops.view())?;
    for (i in 0..roots.length) {
        freeBTree(mut db.pager, roots[i])?;
    }
    return Ok();
}

/// A column of sqlite_schema as SQL text, its bytes whatever they are, or empty when it is not text.
fn textOrEmptyRef(value: borrow SqliteValue) -> Result<ByteString, AllocError> => match (value) {
    SqliteValue.Text(s) => s.clone(),
    _ => Ok(ByteString.create()),
};

/// Gives every page of a b-tree (table or index, overflow pages included) back to the freelist.
fn freeBTree(pager: borrow mut WritablePager, root: u32) -> Result<void, SqliteError> {
    let usable = pager.usable;
    var pending = Vector<u32>.create();
    var all = Vector<u32>.create();
    pending.push(root)?;
    while (pending.pop() is Some(page)) {
        if (all.length > pager.pageCount as usize) {
            return Err(corrupt("a b-tree's pages form a cycle"));
        }
        all.push(page)?;
        let bytes = pager.copy(page)?;
        let header = BTreePageHeader.parse(bytes.view()[0..usable], page)?;
        let table = header.kind == PAGE_LEAF_TABLE || header.kind == PAGE_INTERIOR_TABLE;
        for (i in 0..header.cellCount) {
            let offset = header.cellOffset(bytes.view()[0..usable], i)?;
            if (!header.isLeaf()) {
                pending.push(bytes.readBE<u32>(offset))?;
                if (table) {
                    continue;
                }
            }
            // A cell with a payload: its overflow pages too.
            var at = if (header.isLeaf()) offset else offset + 4;
            let length = Varint.read(bytes.view(), at)?;
            at += length.length;
            if (header.kind == PAGE_LEAF_TABLE) {
                at += Varint.read(bytes.view(), at)?.length;
            }
            let total = checkedTruncate<usize>(length.value) ?? 0;
            let maxLocal = if (table) usable - 35 else (usable - 12) * 64 / 255 - 23;
            if (total > maxLocal) {
                let inCell = cellPayloadSize(usable, total, maxLocal);
                var overflow = bytes.readBE<u32>(at + inCell - 4);
                while (overflow != 0) {
                    if (all.length > pager.pageCount as usize) {
                        return Err(corrupt("an overflow chain forms a cycle"));
                    }
                    all.push(overflow)?;
                    overflow = pager.read(overflow)?.readBE<u32>(0);
                }
            }
        }
        if (!header.isLeaf()) {
            pending.push(header.rightMost)?;
        }
    }
    for (i in 0..all.length) {
        pager.freePage(all[i])?;
    }
    return Ok();
}

fn objectExists(db: borrow Session, name: ByteStringView) -> bool {
    for (i in 0..db.entries.length) {
        if (db.entries[i].name.view().equalsIgnoreAsciiCase(name)) {
            return true;
        }
    }
    return false;
}

/// The name a CREATE TABLE, VIEW or TRIGGER statement gives its object, as written (quotes and all), which
/// SQLite's "… already exists" shows (`%T`); `name` when it cannot be found.
fn writtenObjectName(sql: ByteStringView, name: ByteStringView) -> ByteString {
    let tokens = match (Tokenizer.tokenize(sql)) {
        Ok(t) => t,
        Err(_) => { return ownedName(name); }
    };
    for (i in 0..tokens.length) {
        let t = borrow tokens[i];
        if (!(t.isWord("TABLE") || t.isWord("VIEW") || t.isWord("TRIGGER"))) {
            continue;
        }
        var at = i + 1;
        if (at < tokens.length && tokens[at].isWord("IF")) {
            at += 3;
        }
        if (at + 2 < tokens.length && tokens[at + 1].isOp(".")) {
            at += 2;
        }
        if (at < tokens.length && tokens[at].offset <= tokens[at].end && tokens[at].end <= sql.length()) {
            return ownedName(sql.slice(tokens[at].offset, tokens[at].end));
        }
        break;
    }
    return ownedName(name);
}

fn ownedName(name: ByteStringView) -> ByteString => ownedText(name).ok() ?? ByteString.create();

fn existsError<N: TextView, M: TextView>(kind: N, name: M) -> SqliteError {
    var message = ByteString.create();
    let _ = message.append(kind);
    let _ = message.append(" ");
    let _ = message.append(name);
    let _ = message.append(" already exists");
    return sqlError(message.view());
}

fn isReservedName(name: ByteStringView) -> bool => name.startsWithIgnoreAsciiCase("sqlite_");

/// CREATE TABLE.
fn executeCreateTable(
    stmt: borrow CreateTableStmt,
    sql: ByteStringView,
    db: borrow mut Session,
) -> Result<void, SqliteError> {
    let name = stmt.name.name.view();
    if (objectExists(db, name)) {
        if (stmt.ifNotExists) {
            return Ok();
        }
        // SQLite names what is there: a table, an index or a view.
        return Err(
            existsError(
                if (db.viewSql(name)?.isSome()) "view" else if (db.catalog.table(name)?.isSome()) "table" else "index",
                writtenObjectName(sql, name).view(),
            ),
        );
    }
    if (borrow stmt.asSelect is Some(query)) {
        return executeCreateTableAs(name, query, db);
    }
    if (isReservedName(name)) {
        return Err(namedError("object name reserved for internal use: ", name));
    }
    let table = buildTableSchema(stmt, name, 0, sql)?;
    if (table.withoutRowid && table.primaryKey.length == 0) {
        return Err(namedError("PRIMARY KEY missing on table ", name));
    }
    let root = db.pager.allocatePage()?;
    initRoot(mut db.pager, root, if (table.withoutRowid) PAGE_LEAF_INDEX else PAGE_LEAF_TABLE)?;
    addSchemaRow(db, "table", name, name, root, sql)?;
    // An automatic index for each PRIMARY KEY (when not the rowid, nor a WITHOUT ROWID table's) and UNIQUE.
    var sequence: u64 = 0;
    for (k in 0..table.keys.length) {
        // A WITHOUT ROWID table's primary key has its number but no index of its own.
        sequence += 1;
        if (table.keys[k].primaryKey && table.withoutRowid) {
            continue;
        }
        var indexName = ownedText("sqlite_autoindex_")?;
        indexName.append(name)?;
        indexName.append("_")?;
        indexName.appendUnsigned(sequence)?;
        let indexRoot = db.pager.allocatePage()?;
        initRoot(mut db.pager, indexRoot, PAGE_LEAF_INDEX)?;
        addSchemaRow(db, "index", indexName.view(), name, indexRoot, null)?;
    }
    if (table.autoincrement && db.catalog.table("sqlite_sequence")?.isNull()) {
        let sequenceRoot = db.pager.allocatePage()?;
        initRoot(mut db.pager, sequenceRoot, PAGE_LEAF_TABLE)?;
        addSchemaRow(
            db,
            "table",
            "sqlite_sequence",
            "sqlite_sequence",
            sequenceRoot,
            ByteStringView.fromText("CREATE TABLE sqlite_sequence(name,seq)"),
        )?;
    }
    db.pager.bumpSchemaCookie()?;
    return db.reloadSchema();
}

/// CREATE INDEX: the index is built from the table's rows.
fn executeCreateIndex(
    stmt: borrow CreateIndexStmt,
    sql: ByteStringView,
    db: borrow mut Session,
) -> Result<void, SqliteError> {
    let name = stmt.name.name.view();
    if (objectExists(db, name)) {
        if (stmt.ifNotExists) {
            return Ok();
        }
        return Err(existsError("index", name));
    }
    if (isReservedName(name)) {
        return Err(namedError("object name reserved for internal use: ", name));
    }
    let table = db.catalog.table(stmt.table.view())? ?? {
        return Err(namedError("no such table: main.", stmt.table.view()));
    };
    let tableName = table.name.clone()?;
    let root = db.pager.allocatePage()?;
    initRoot(mut db.pager, root, PAGE_LEAF_INDEX)?;
    addSchemaRow(db, "index", name, tableName.view(), root, sql)?;
    db.reloadSchema()?;
    // Fill it, checking UNIQUE as rows go in.
    var compiler = newCompiler(db)?;
    let writer = TableWriter.create(mut compiler, tableName.view(), db)?;
    var frame = newFrame(mut compiler, [], db)?;
    for (i in 0..writer.indexes.length) {
        let index = borrow writer.indexes[i];
        if (!index.name.view().equalsIgnoreAsciiCase(name)) {
            continue;
        }
        writer.rebuildIndex(index, mut frame, db)?;
        if (index.unique) {
            var cursor = RowCursor.scan(borrow writer.read);
            while (cursor.next(mut db.pager)? is Some(row)) {
                loadTableRow(borrow writer.read, row.rowId, row.columns, mut frame.slots[writer.slot])?;
                if (writer.read.generated.length != 0) {
                    computeGenerated(borrow writer.read, writer.slot, mut frame, db)?;
                }
                let Some(entry) = writer.entryFor(index, mut frame, db)? else {
                    continue;
                };
                var self = Vector<RowKey>.create();
                self.push(writer.keyOf(borrow frame.slots[writer.slot])?)?;
                if (writer.conflictsIn(index, borrow entry, self.view(), db)?.length != 0) {
                    var message = ownedText("UNIQUE constraint failed: ")?;
                    message.append(index.keyNames.view())?;
                    return Err(constraintError(message.view()));
                }
            }
        }
    }
    db.pager.bumpSchemaCookie()?;
    return Ok();
}

/// CREATE VIEW: checked by compiling its SELECT.
fn executeCreateView(
    stmt: borrow CreateViewStmt,
    sql: ByteStringView,
    db: borrow mut Session,
) -> Result<void, SqliteError> {
    let name = stmt.name.name.view();
    if (objectExists(db, name)) {
        if (stmt.ifNotExists) {
            return Ok();
        }
        return Err(existsError("view", writtenObjectName(sql, name).view()));
    }
    var compiler = newCompiler(db)?;
    let plan = compileSelect(mut compiler, borrow stmt.select, db)?;
    let none = Vector<ByteString>.create();
    let _ = planScopeColumns(borrow plan, if (stmt.columns.length != 0) borrow stmt.columns else borrow none)?;
    addSchemaRow(db, "view", name, name, 0, sql)?;
    db.pager.bumpSchemaCookie()?;
    return db.reloadSchema();
}

/// DROP TABLE, INDEX, VIEW or TRIGGER.
fn executeDrop(stmt: borrow DropStmt, db: borrow mut Session) -> Result<void, SqliteError> {
    let name = stmt.name.name.view();
    var kind: StringView = "";
    for (i in 0..db.entries.length) {
        if (db.entries[i].name.view().equalsIgnoreAsciiCase(name)) {
            kind = match (db.entries[i].kind.view()) {
                "table" => "table",
                "index" => "index",
                "view" => "view",
                _ => "trigger",
            };
        }
    }
    let wanted: StringView = match (stmt.kind) {
        DropKind.Table => "table",
        DropKind.Index => "index",
        DropKind.View => "view",
        DropKind.Trigger => "trigger",
    };
    if (kind != wanted) {
        if (stmt.ifExists) {
            return Ok();
        }
        if (kind.length != 0 && wanted != "trigger") {
            var message = ownedText("use DROP ")?;
            message.append(match (kind) {
                "table" => "TABLE",
                "index" => "INDEX",
                _ => "VIEW",
            })?;
            message.append(" to delete ")?;
            message.append(kind)?;
            message.append(" ")?;
            message.append(name)?;
            return Err(sqlError(message.view()));
        }
        return Err(namedError(match (stmt.kind) {
            DropKind.Table => "no such table: ",
            DropKind.Index => "no such index: ",
            DropKind.View => "no such view: ",
            DropKind.Trigger => "no such trigger: ",
        }, name));
    }
    if (isReservedName(name) && stmt.kind != DropKind.Index) {
        var message = ownedText("table ")?;
        message.append(name)?;
        message.append(" may not be dropped")?;
        return Err(sqlError(message.view()));
    }
    if (stmt.kind == DropKind.Index) {
        for (i in 0..db.entries.length) {
            if (db.entries[i].name.view().equalsIgnoreAsciiCase(name) && db.entries[i].sql.isNull()) {
                return Err(sqlError("index associated with UNIQUE or PRIMARY KEY constraint cannot be dropped"));
            }
        }
    }
    // A table takes its indexes and triggers with it, and its row in sqlite_sequence; a view its triggers.
    removeSchemaRows(db, name, stmt.kind == DropKind.Table || stmt.kind == DropKind.View)?;
    if (stmt.kind == DropKind.Table && db.catalog.table("sqlite_sequence")?.isSome()) {
        db.reloadSchema()?;
        db.removeSequence(name)?;
    }
    db.pager.bumpSchemaCookie()?;
    return db.reloadSchema();
}

/// SQLite's keywords: a name that is one is written in double quotes.
const SQL_KEYWORDS: [StringView; 147] = [
    "ABORT", "ACTION", "ADD", "AFTER", "ALL", "ALTER", "ALWAYS", "ANALYZE", "AND", "AS", "ASC", "ATTACH",
    "AUTOINCREMENT", "BEFORE", "BEGIN", "BETWEEN", "BY", "CASCADE", "CASE", "CAST", "CHECK", "COLLATE", "COLUMN",
    "COMMIT", "CONFLICT", "CONSTRAINT", "CREATE", "CROSS", "CURRENT", "CURRENT_DATE", "CURRENT_TIME",
    "CURRENT_TIMESTAMP", "DATABASE", "DEFAULT", "DEFERRABLE", "DEFERRED", "DELETE", "DESC", "DETACH", "DISTINCT",
    "DO", "DROP", "EACH", "ELSE", "END", "ESCAPE", "EXCEPT", "EXCLUDE", "EXCLUSIVE", "EXISTS", "EXPLAIN", "FAIL",
    "FILTER", "FIRST", "FOLLOWING", "FOR", "FOREIGN", "FROM", "FULL", "GENERATED", "GLOB", "GROUP", "GROUPS",
    "HAVING", "IF", "IGNORE", "IMMEDIATE", "IN", "INDEX", "INDEXED", "INITIALLY", "INNER", "INSERT", "INSTEAD",
    "INTERSECT", "INTO", "IS", "ISNULL", "JOIN", "KEY", "LAST", "LEFT", "LIKE", "LIMIT", "MATCH", "MATERIALIZED",
    "NATURAL", "NO", "NOT", "NOTHING", "NOTNULL", "NULL", "NULLS", "OF", "OFFSET", "ON", "OR", "ORDER", "OTHERS",
    "OUTER", "OVER", "PARTITION", "PLAN", "PRAGMA", "PRECEDING", "PRIMARY", "QUERY", "RAISE", "RANGE", "RECURSIVE",
    "REFERENCES", "REGEXP", "REINDEX", "RELEASE", "RENAME", "REPLACE", "RESTRICT", "RETURNING", "RIGHT",
    "ROLLBACK", "ROW", "ROWS", "SAVEPOINT", "SELECT", "SET", "TABLE", "TEMP", "TEMPORARY", "THEN", "TIES", "TO",
    "TRANSACTION", "TRIGGER", "UNBOUNDED", "UNION", "UNIQUE", "UPDATE", "USING", "VACUUM", "VALUES", "VIEW",
    "VIRTUAL", "WHEN", "WHERE", "WINDOW", "WITH", "WITHOUT",
];

/// A name as SQLite's createTableStmt writes it (identPut): in double quotes when it is not all letters, digits and
/// `_`, starts with a digit, is empty, or is a keyword.
fn appendIdentPut(out: borrow mut ByteString, name: ByteStringView) -> Result<void, AllocError> {
    var plain = name.length() != 0 && !(name[0] >= '0' && name[0] <= '9');
    for (c in name.bytes()) {
        plain = plain && ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_');
    }
    plain = plain && !wordIn(name, SQL_KEYWORDS[..]);
    if (plain) {
        out.append(name)?;
        return Ok();
    }
    out.append("\"")?;
    var first = true;
    for (part in name.split("\"")) {
        if (!first) {
            out.append("\"\"")?;
        }
        first = false;
        out.append(part)?;
    }
    out.append("\"")?;
    return Ok();
}

/// The number of bytes SQLite counts for a name (identLength): its length with each `"` doubled, plus 2.
fn identLength(name: ByteStringView) -> usize {
    var n: usize = 2;
    for (c in name.bytes()) {
        n += if (c == '"') 2 else 1;
    }
    return n;
}

/// CREATE TABLE … AS SELECT: a table with the query's result columns (named as SQLite names them, typed by their
/// affinities), written as SQLite writes its statement, then filled with the query's rows.
fn executeCreateTableAs(
    name: ByteStringView,
    query: borrow SelectStmt,
    db: borrow mut Session,
) -> Result<void, SqliteError> {
    if (isReservedName(name)) {
        return Err(namedError("object name reserved for internal use: ", name));
    }
    var compiler = newCompiler(db)?;
    let plan = compileSelect(mut compiler, query, db)?;
    // Unique names: a repeated one gets ":N" (sqlite3ColumnsFromExprList).
    var names = Vector<ByteString>.withCapacity(plan.columnNames.length)?;
    for (i in 0..plan.columnNames.length) {
        var candidate = plan.columnNames[i].clone()?;
        if (candidate.length() == 0) {
            candidate = ownedText("column")?;
            candidate.appendUnsigned((i + 1) as u64)?;
        }
        var count: u64 = 0;
        loop {
            var taken = false;
            for (k in 0..names.length) {
                taken = taken || names[k].view().equalsIgnoreAsciiCase(candidate.view());
            }
            if (!taken) {
                break;
            }
            // Without a ":digits" ending it already has.
            var stem = candidate.length();
            var j = candidate.length() - 1;
            while (j > 0 && candidate.view()[j] >= '0' && candidate.view()[j] <= '9') {
                j -= 1;
            }
            if (j > 0 && candidate.view()[j] == ':') {
                stem = j;
            }
            count += 1;
            var next = ownedText(candidate.view().slice(0, stem))?;
            next.append(":")?;
            next.appendUnsigned(count)?;
            candidate = next;
        }
        names.push(candidate)?;
    }
    // The statement, as createTableStmt writes it: on one line when short, else a column a line.
    var length: usize = identLength(name);
    for (i in 0..names.length) {
        length += identLength(names[i].view()) + 5;
    }
    let short = length < 50;
    var sql = ownedText("CREATE TABLE ")?;
    appendIdentPut(mut sql, name)?;
    sql.append("(")?;
    for (i in 0..names.length) {
        sql.append(if (i == 0) (if (short) "" else "\n  ") else (if (short) "," else ",\n  "))?;
        appendIdentPut(mut sql, names[i].view())?;
        sql.append(match (plan.columnAffinities[i]) {
            ExprAffinity.Text => " TEXT",
            ExprAffinity.Numeric => " NUM",
            ExprAffinity.Integer => " INT",
            ExprAffinity.Real => " REAL",
            _ => "",
        })?;
    }
    sql.append(if (short) ")" else "\n)")?;
    let Stmt.CreateTable(created) = Parser.parseStatement(sql.view())? else {
        return Err(sqlError("CREATE TABLE … AS SELECT made a statement that is not CREATE TABLE"));
    };
    executeCreateTable(borrow created, sql.view(), db)?;
    // The rows.
    let insert = InsertStmt {
        with: null,
        conflict: null,
        table: QualifiedName { schema: null, name: ownedText(name)? },
        columns: Vector<ByteString>.create(),
        source: InsertSource.Select(cloneSelect(query)?),
        upserts: Vector<UpsertClause>.create(),
        returning: Vector<ResultColumn>.create(),
        alias: null,
        returningTexts: Vector<ByteString>.create(),
    };
    let changes = db.changes;
    let total = db.totalChanges;
    let _ = executeInsert(borrow insert, [], db)?;
    db.changes = changes;
    db.totalChanges = total;
    return Ok();
}
