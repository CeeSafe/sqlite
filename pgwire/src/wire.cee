// PostgreSQL frontend/backend protocol 3.0 framing: reading the client's messages off a TCP stream, and building
// the server's into a buffer that is sent at the protocol's sync points (ReadyForQuery, Flush).
//
// Nothing a client sends is trusted: a length outside the protocol's bounds ends the connection, and a payload is
// read through a `Cursor` whose every read is checked, so a short or malformed message is an error, never a read
// past its end.

/// The longest startup packet PostgreSQL accepts (MAX_STARTUP_PACKET_LENGTH).
const MAX_STARTUP_LENGTH: usize = 10000;

/// The longest message this server accepts. PostgreSQL allows up to 1 GiB; a query or a bound value longer than
/// this is refused rather than buffered.
const MAX_MESSAGE_LENGTH: usize = 64 * 1024 * 1024;

/// What can go wrong on the wire.
enum WireError {
    /// The socket failed, or the client went away.
    @from Io(IoError),
    /// The client broke the protocol: the connection ends with this message (SQLSTATE 08P01).
    Protocol(String),
    /// Memory ran out.
    @from Alloc(AllocError),
}

fn protocolError(message: StringView) -> WireError => match (String.from(message)) {
    Ok(m) => WireError.Protocol(m),
    Err(e) => WireError.Alloc(e),
};

/// One message from the client: its type byte and its payload (the length word left out).
struct Message {
    kind: u8;
    payload: Vector<u8>;
}

/// The client's end of the connection: the stream and the bytes read from it and not yet used.
struct Wire {
    stream: TcpStream;
    input: Vector<u8>;
    at: usize;
    /// Messages built and not yet sent.
    output: Vector<u8>;

    fn over(stream: TcpStream) -> Wire =>
        Wire { stream: stream, input: Vector<u8>.create(), at: 0, output: Vector<u8>.create() };

    /// Makes sure `n` bytes are buffered; false when the stream ends first.
    fn fill(borrow mut this, n: usize) -> Result<bool, WireError> {
        if (this.at == this.input.length) {
            this.input.clear();
            this.at = 0;
        }
        var chunk = [0u8; 8192];
        while (this.input.length - this.at < n) {
            let got = match (this.stream.read(mut chunk[..])) {
                Ok(g) => g,
                Err(e) => { return Err(WireError.Io(e)); }
            };
            if (got == 0) {
                return Ok(false);
            }
            if (this.input.extend(chunk[0..got]) is Err(e)) {
                return Err(WireError.Alloc(e));
            }
        }
        return Ok(true);
    }

    /// The next `n` buffered bytes, taken.
    fn take(borrow mut this, n: usize) -> Result<Vector<u8>, WireError> {
        var bytes = match (Vector<u8>.withCapacity(n)) {
            Ok(v) => v,
            Err(e) => { return Err(WireError.Alloc(e)); }
        };
        if (bytes.extend(this.input.view()[this.at..this.at + n]) is Err(e)) {
            return Err(WireError.Alloc(e));
        }
        this.at += n;
        return Ok(bytes);
    }

    /// The startup packet, which has no type byte: its request code and the rest of it. Null when the client
    /// closed the connection before sending one.
    fn readStartup(borrow mut this) -> Result<Message?, WireError> {
        if (!this.fill(4)?) {
            return Ok(null);
        }
        let length = this.input.view().readBE<u32>(this.at) as usize;
        if (length < 8 || length > MAX_STARTUP_LENGTH) {
            return Err(protocolError("invalid length of startup packet"));
        }
        this.at += 4;
        if (!this.fill(length - 4)?) {
            return Err(protocolError("incomplete startup packet"));
        }
        // The code is kept as the message's first four bytes; `kind` is unused.
        let payload = this.take(length - 4)?;
        return Ok(Message { kind: 0, payload: payload });
    }

    /// The next message; null when the client closed the connection between messages.
    fn readMessage(borrow mut this) -> Result<Message?, WireError> {
        if (!this.fill(5)?) {
            if (this.input.length == this.at) {
                return Ok(null);
            }
            return Err(protocolError("unexpected EOF within message type and length"));
        }
        let kind = this.input[this.at];
        let length = this.input.view().readBE<u32>(this.at + 1) as usize;
        if (length < 4 || length > MAX_MESSAGE_LENGTH) {
            return Err(protocolError("invalid message length"));
        }
        this.at += 5;
        if (!this.fill(length - 4)?) {
            return Err(protocolError("unexpected EOF within message"));
        }
        let payload = this.take(length - 4)?;
        return Ok(Message { kind: kind, payload: payload });
    }

    /// Sends the messages built so far.
    fn flush(borrow mut this) -> Result<void, WireError> {
        if (this.output.length == 0) {
            return Ok();
        }
        let sent = this.stream.write(this.output.view());
        this.output.clear();
        return match (sent) {
            Ok() => Ok(),
            Err(e) => Err(WireError.Io(e)),
        };
    }
}

/// A server message being built in an output buffer: its type byte, a length word patched by `end`, and the
/// payload between.
struct Builder {
    start: usize;
}

/// Starts a message of type `kind` in `out`.
fn begin(out: borrow mut Vector<u8>, kind: u8) -> Result<Builder, AllocError> {
    out.push(kind)?;
    let start = out.length;
    out.pushBE(0u32)?;
    return Ok(Builder { start: start });
}

/// Ends the message `b`: its length counts itself and the payload.
fn end(out: borrow mut Vector<u8>, b: Builder) {
    let length = truncate<u32>(out.length - b.start);
    out.writeBE(b.start, length);
}

fn putI16(out: borrow mut Vector<u8>, v: i16) -> Result<void, AllocError> => out.pushBE(truncate<u16>(v));

fn putI32(out: borrow mut Vector<u8>, v: i32) -> Result<void, AllocError> => out.pushBE(truncate<u32>(v));

fn putU32(out: borrow mut Vector<u8>, v: u32) -> Result<void, AllocError> => out.pushBE(v);

/// A C string: the text and a zero byte. A zero byte inside the text would end it early, so it is left out.
fn putText(out: borrow mut Vector<u8>, text: StringView) -> Result<void, AllocError> {
    let bytes = text.bytes();
    for (i in 0..bytes.length) {
        if (bytes[i] != 0) {
            out.push(bytes[i])?;
        }
    }
    out.push(0)?;
    return Ok();
}

/// A message with no payload (ParseComplete, BindComplete, NoData, …).
fn putEmpty(out: borrow mut Vector<u8>, kind: u8) -> Result<void, AllocError> {
    let b = begin(mut out, kind)?;
    end(mut out, b);
    return Ok();
}

/// Reads a client message's payload; every read checks that the bytes are there.
struct Cursor {
    at: usize;

    fn start() -> Cursor => Cursor { at: 0 };

    fn atEnd(borrow this, bytes: Slice<u8>) -> bool => this.at >= bytes.length;

    fn byte(borrow mut this, bytes: Slice<u8>) -> Result<u8, WireError> {
        if (this.at + 1 > bytes.length) {
            return Err(protocolError("insufficient data left in message"));
        }
        this.at += 1;
        return Ok(bytes[this.at - 1]);
    }

    fn i16(borrow mut this, bytes: Slice<u8>) -> Result<i16, WireError> {
        if (this.at + 2 > bytes.length) {
            return Err(protocolError("insufficient data left in message"));
        }
        let v = bytes.readBE<i16>(this.at);
        this.at += 2;
        return Ok(v);
    }

    fn i32(borrow mut this, bytes: Slice<u8>) -> Result<i32, WireError> {
        if (this.at + 4 > bytes.length) {
            return Err(protocolError("insufficient data left in message"));
        }
        let v = bytes.readBE<i32>(this.at);
        this.at += 4;
        return Ok(v);
    }

    /// Passes the next `n` bytes, and gives where they start.
    fn skip(borrow mut this, bytes: Slice<u8>, n: usize) -> Result<usize, WireError> {
        if (n > bytes.length - this.at.min(bytes.length)) {
            return Err(protocolError("insufficient data left in message"));
        }
        let start = this.at;
        this.at += n;
        return Ok(start);
    }

    /// A C string, which must be UTF-8 (the only client encoding this server takes).
    fn text(borrow mut this, bytes: Slice<u8>) -> Result<String, WireError> {
        var stop = this.at;
        while (stop < bytes.length && bytes[stop] != 0) {
            stop += 1;
        }
        if (stop >= bytes.length) {
            return Err(protocolError("invalid string in message"));
        }
        let view = StringView.fromUtf8(bytes[this.at..stop]) ?? {
            return Err(protocolError("invalid byte sequence for encoding \"UTF8\""));
        };
        this.at = stop + 1;
        return match (String.from(view)) {
            Ok(s) => Ok(s),
            Err(e) => Err(WireError.Alloc(e)),
        };
    }
}
