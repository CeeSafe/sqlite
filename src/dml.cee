// INSERT, UPDATE and DELETE on rowid tables, with their indexes, constraints and conflict actions.
//
// Differences from the C# engine, which this replaces:
// - a statement that fails undoes its own changes and no others, inside BEGIN … COMMIT as outside it;
// - rows are written to the pages they belong in; the C# rewrote whole tables at commit;
// - UNIQUE is checked through the index, in the index's collation, so 'a' and 'A' collide in a NOCASE index;
// - a new rowid is one past the largest, read from the b-tree's right edge, and AUTOINCREMENT keeps
//   sqlite_sequence as SQLite does;
// - the values of an INTEGER PRIMARY KEY must be integers ("datatype mismatch"), as in SQLite.
//
// Not yet supported, and refused by name: triggers, foreign key actions, upserts, UPDATE … FROM, and changes to
// WITHOUT ROWID tables.

/// A column of an index key: a table column, or an expression on the row.
struct IndexKeyColumn {
    column: usize?;
    expr: XExpr?;
}

/// An index of a table, as writes keep it.
struct TableIndex {
    name: String;
    root: u32;
    unique: bool;
    columns: Vector<IndexKeyColumn>;
    filter: XExpr?;
    /// The order of whole entries: the key's collations and directions, then the rowid.
    order: IndexOrder;
    /// For error messages: "t.a, t.b", or "index 'name'" for an expression index.
    keyNames: String;
    /// In a WITHOUT ROWID table: the primary key's columns the entry holds after the indexed ones (those the index
    /// does not already hold), and where in the entry each primary-key column is.
    suffix: Vector<usize>;
    keyAt: Vector<usize>;
    /// A removal could not be done in place: the index is rebuilt from the table when the statement ends, and
    /// takes no more changes until then.
    stale: Cell<bool>;
}

/// What writing rows to a table needs.
struct TableWriter {
    table: TableSchema;
    read: TablePlan;
    slot: usize;
    indexes: Vector<TableIndex>;
    defaults: Vector<XExpr?>;
    /// Generated columns, VIRTUAL and STORED, computed in declaration order.
    generated: Vector<GeneratedColumn>;
    checks: Vector<XExpr>;
    checkNames: Vector<String>;
    triggers: Vector<TriggerPlan>;
    /// A WITHOUT ROWID table's primary key; no columns for a rowid table.
    primaryKey: PrimaryKeyColumns;
}

/// What names a row: its rowid, or in a WITHOUT ROWID table its primary key's values, in the key's order.
enum RowKey {
    Rowid(i64),
    Key(Vector<SqliteValue>),
}

impl RowKey {
    fn copy(borrow this) -> Result<RowKey, AllocError> => match (this) {
        RowKey.Rowid(r) => Ok(RowKey.Rowid(r)),
        RowKey.Key(k) => Ok(RowKey.Key(cloneValues(k.view())?)),
    };
}

/// A WITHOUT ROWID table's primary key: its columns, their order, and their names for messages (`t.a, t.b`).
struct PrimaryKeyColumns {
    columns: Vector<usize>;
    order: IndexOrder;
    names: String;
}

fn copyOrder(order: borrow IndexOrder) -> Result<IndexOrder, AllocError> {
    var out = IndexOrder.plain();
    for (i in 0..order.collations.length) {
        out.collations.push(order.collations[i])?;
    }
    for (i in 0..order.descending.length) {
        out.descending.push(order.descending[i])?;
    }
    return Ok(out);
}

/// The primary key of a WITHOUT ROWID table (none for a rowid table).
fn withoutRowidKey(table: borrow TableSchema) -> Result<PrimaryKeyColumns, SqliteError> {
    var key = PrimaryKeyColumns { columns: Vector<usize>.create(), order: IndexOrder.plain(), names: String.create() };
    if (!table.withoutRowid) {
        return Ok(key);
    }
    for (k in 0..table.primaryKey.length) {
        let kc = borrow table.primaryKey[k];
        let at = table.indexOf(kc.name.view()) ?? {
            return Err(corrupt("a primary key names a column its table does not have"));
        };
        key.columns.push(at)?;
        key.order.collations.push(table.keyCollation(kc))?;
        key.order.descending.push(kc.descending)?;
        appendKeyName(mut key.names, table, at)?;
    }
    return Ok(key);
}

/// For an index of a WITHOUT ROWID table: adds the primary key's columns the index lacks to its entries, as
/// SQLite does (a column the index holds with the same collation is not repeated), and records where each is.
fn addKeySuffix(
    table: borrow TableSchema,
    key: borrow PrimaryKeyColumns,
    columns: borrow Vector<IndexKeyColumn>,
    order: borrow mut IndexOrder,
    suffix: borrow mut Vector<usize>,
    keyAt: borrow mut Vector<usize>,
) -> Result<void, AllocError> {
    for (k in 0..key.columns.length) {
        let column = key.columns[k];
        var found: usize? = null;
        for (c in 0..columns.length) {
            if (found.isNull() && columns[c].column == Some(column) && order.collations[c] == key.order.collations[k]) {
                found = c;
            }
        }
        if (found is Some(at)) {
            keyAt.push(at)?;
            continue;
        }
        keyAt.push(columns.length + suffix.length)?;
        suffix.push(column)?;
        order.collations.push(key.order.collations[k])?;
        order.descending.push(key.order.descending[k])?;
    }
    return Ok();
}

fn tableScope(table: borrow TableSchema, slot: usize) -> Result<Scope, AllocError> {
    var scope = Scope { sources: Vector<ScopeSource>.create() };
    scope.sources.push(
        ScopeSource {
            name: table.name.clone()?,
            columns: tableScopeColumns(table)?,
            slot: slot,
            hasRowid: !table.withoutRowid,
            rowidAlias: table.rowidAlias,
            merged: Vector<String>.create(), coalesceMerged: false,
        },
    )?;
    return Ok(scope);
}

/// Compiles an expression in the table's own scope only.
fn compileInTable(
    compiler: borrow mut Compiler,
    e: borrow Expr,
    table: borrow TableSchema,
    slot: usize,
    db: borrow mut Session,
) -> Result<XExpr, SqliteError> {
    let saved = replace(mut compiler.scopes, compiler.freshScopes()?);
    compiler.scopes.push(tableScope(table, slot)?)?;
    let result = compiler.compile(e, db);
    compiler.scopes = saved;
    return result;
}

fn appendKeyName(out: borrow mut String, table: borrow TableSchema, column: usize) -> Result<void, AllocError> {
    if (out.length != 0) {
        out.append(", ")?;
    }
    out.append(table.name.view())?;
    out.append(".")?;
    return out.append(table.columns[column].name.view());
}

/// The indexes of a table: its automatic ones (for PRIMARY KEY and UNIQUE) and the ones CREATE INDEX made.
fn tableIndexes(
    compiler: borrow mut Compiler,
    table: borrow TableSchema,
    slot: usize,
    db: borrow mut Session,
) -> Result<Vector<TableIndex>, SqliteError> {
    var out = Vector<TableIndex>.create();
    let primaryKey = withoutRowidKey(table)?;
    // Automatic indexes have no SQL; sqlite_autoindex_T_N is the N-th of the table's key constraints.
    var prefix = String.from("sqlite_autoindex_")?;
    prefix.append(table.name.view())?;
    prefix.append("_")?;
    for (e in 0..db.entries.length) {
        let entry = borrow db.entries[e];
        if (entry.kind.view() != "index" || entry.sql.isSome() || !entry.tableName.view().equalsIgnoreAsciiCase(
            table.name.view(),
        )) {
            continue;
        }
        let name = entry.name.view();
        if (name.length <= prefix.length || !name[0..prefix.length].equalsIgnoreAsciiCase(prefix.view())) {
            continue;
        }
        let n = name[prefix.length..].parseInt<usize>() ?? 0;
        // A WITHOUT ROWID table's primary key, which is the table itself, keeps its number.
        var key: usize? = null;
        if (n >= 1 && n <= table.keys.length && !(table.keys[n - 1].primaryKey && table.withoutRowid)) {
            key = n - 1;
        }
        let Some(k) = key else {
            return Err(corrupt("an automatic index does not match its table's constraints"));
        };
        var columns = Vector<IndexKeyColumn>.create();
        var order = IndexOrder.plain();
        var keyNames = String.create();
        for (c in 0..table.keys[k].columns.length) {
            let kc = borrow table.keys[k].columns[c];
            let at = table.indexOf(kc.name.view()) ?? {
                return Err(corrupt("a key names a column its table does not have"));
            };
            columns.push(IndexKeyColumn { column: at, expr: null })?;
            order.collations.push(table.keyCollation(kc))?;
            order.descending.push(kc.descending)?;
            appendKeyName(mut keyNames, table, at)?;
        }
        var suffix = Vector<usize>.create();
        var keyAt = Vector<usize>.create();
        addKeySuffix(table, borrow primaryKey, borrow columns, mut order, mut suffix, mut keyAt)?;
        out.push(
            TableIndex {
                name: entry.name.clone()?,
                root: entry.rootPage,
                unique: true,
                columns: columns,
                filter: null,
                order: order,
                keyNames: keyNames,
                suffix: suffix,
                keyAt: keyAt,
                stale: Cell<bool>.create(false),
            },
        )?;
    }
    // CREATE INDEX: parsed again from its SQL, so its expressions compile against this table.
    for (i in 0..db.catalog.indexes.length) {
        if (!db.catalog.indexes[i].table.view().equalsIgnoreAsciiCase(table.name.view())) {
            continue;
        }
        let root = db.catalog.indexes[i].rootPage;
        let name = db.catalog.indexes[i].name.clone()?;
        let sql = db.indexSql(name.view())? ?? {
            continue;
        };
        let Stmt.CreateIndex(stmt) = Parser.parseStatement(sql.view())? else {
            continue;
        };
        let schema = buildIndexSchema(cloneIndexStmt(borrow stmt)?, name.view(), root, table)?;
        var columns = Vector<IndexKeyColumn>.create();
        var order = IndexOrder.plain();
        var keyNames = String.create();
        var plainKey = true;
        for (c in 0..schema.columns.length) {
            let ic = borrow schema.columns[c];
            if (borrow stmt.columns[c].expression is Some(x)) {
                columns.push(IndexKeyColumn { column: null, expr: compileInTable(compiler, x, table, slot, db)? })?;
                plainKey = false;
            } else {
                let at = table.indexOf(ic.name.view()) ?? {
                    return Err(namedError("no such column: ", ic.name.view()));
                };
                columns.push(IndexKeyColumn { column: at, expr: null })?;
                appendKeyName(mut keyNames, table, at)?;
            }
            order.collations.push(ic.collation)?;
            order.descending.push(ic.descending)?;
        }
        if (!plainKey) {
            keyNames = String.from("index '")?;
            keyNames.append(name.view())?;
            keyNames.append("'")?;
        }
        var filter: XExpr? = null;
        if (borrow stmt.filter is Some(f)) {
            filter = compileInTable(compiler, f, table, slot, db)?;
        }
        var suffix = Vector<usize>.create();
        var keyAt = Vector<usize>.create();
        addKeySuffix(table, borrow primaryKey, borrow columns, mut order, mut suffix, mut keyAt)?;
        out.push(
            TableIndex {
                name: name,
                root: root,
                unique: schema.unique,
                columns: columns,
                filter: filter,
                order: order,
                keyNames: keyNames,
                suffix: suffix,
                keyAt: keyAt,
                stale: Cell<bool>.create(false),
            },
        )?;
    }
    return Ok(out);
}

fn cloneIndexStmt(s: borrow CreateIndexStmt) -> Result<CreateIndexStmt, AllocError> {
    var columns = Vector<IndexedColumn>.withCapacity(s.columns.length)?;
    for (i in 0..s.columns.length) {
        let c = borrow s.columns[i];
        columns.push(
            IndexedColumn {
                name: c.name.clone()?,
                expression: cloneOptional(borrow c.expression)?,
                descending: c.descending,
                collation: c.collation.clone()?,
            },
        )?;
    }
    return Ok(
        CreateIndexStmt {
            unique: s.unique,
            ifNotExists: s.ifNotExists,
            name: cloneName(borrow s.name)?,
            table: s.table.clone()?,
            columns: columns,
            filter: cloneOptional(borrow s.filter)?,
        },
    );
}

impl TableWriter {
    /// Everything needed to write to the table `name`.
    fn create(
        compiler: borrow mut Compiler,
        name: StringView,
        db: borrow mut Session,
    ) -> Result<TableWriter, SqliteError> {
        let table = db.catalog.tableCopy(name)?;
        let slot = compiler.slotsInUse;
        compiler.slotsInUse += 1;
        let read = tablePlan(borrow table, compiler, slot, db)?;
        let indexes = tableIndexes(compiler, borrow table, slot, db)?;
        var defaults = Vector<XExpr?>.withCapacity(table.columns.length)?;
        var generated = Vector<GeneratedColumn>.create();
        for (c in 0..table.columns.length) {
            var d: XExpr? = null;
            if (borrow table.columns[c].defaultValue is Some(v)) {
                // A default sees no columns.
                let saved = replace(mut compiler.scopes, compiler.freshScopes()?);
                let compiled = compiler.compile(borrow v.expr, db);
                compiler.scopes = saved;
                d = compiled?;
            }
            defaults.push(d)?;
            if (borrow table.columns[c].generated is Some(g)) {
                generated.push(
                    GeneratedColumn {
                        column: c,
                        expr: compileInTable(compiler, borrow g.expr, borrow table, slot, db)?,
                    },
                )?;
            }
        }
        var checks = Vector<XExpr>.create();
        var checkNames = Vector<String>.create();
        for (k in 0..table.checks.length) {
            checks.push(compileInTable(compiler, borrow table.checks[k].expr, borrow table, slot, db)?)?;
            checkNames.push(table.checks[k].text.clone()?)?;
        }
        let triggers = tableTriggers(db, table.name.view())?;
        let primaryKey = withoutRowidKey(borrow table)?;
        return Ok(
            TableWriter {
                table: table,
                read: read,
                slot: slot,
                indexes: indexes,
                defaults: defaults,
                generated: generated,
                checks: checks,
                checkNames: checkNames,
                triggers: triggers,
                primaryKey: primaryKey,
            },
        );
    }

    /// What names the row in the slot.
    fn keyOf(borrow this, slot: borrow Slot) -> Result<RowKey, AllocError> {
        if (!this.table.withoutRowid) {
            return Ok(RowKey.Rowid(slot.rowId));
        }
        var key = Vector<SqliteValue>.withCapacity(this.primaryKey.columns.length)?;
        for (k in 0..this.primaryKey.columns.length) {
            key.push(slot.values[this.primaryKey.columns[k]].clone()?)?;
        }
        return Ok(RowKey.Key(key));
    }

    /// Whether two keys name the same row: equal rowids, or primary keys equal under the key's collations.
    fn sameRow(borrow this, a: borrow RowKey, b: borrow RowKey) -> bool => match (a) {
        RowKey.Rowid(x) => b is RowKey.Rowid(y) && x == y,
        RowKey.Key(x) => match (b) {
            RowKey.Key(y) => this.primaryKey.order.comparePrefix(x.view(), y.view()) == 0,
            _ => false,
        },
    };

    /// The stored row a key names: its rowid and record.
    fn findRow(borrow this, key: borrow RowKey, db: borrow mut Session) -> Result<CursorRow?, SqliteError> {
        match (key) {
            RowKey.Rowid(rowId) => {
                let Some(row) = seekTableRow(mut db.pager, this.read.root, rowId)? else {
                    return Ok(null);
                };
                return Ok(CursorRow { rowId: row.rowId, columns: row.columns });
            }
            RowKey.Key(values) => {
                let range = IndexRange.equalTo(copyOrder(borrow this.primaryKey.order)?, values.view())?;
                var cursor = IndexCursor.create(this.read.root, range, false);
                let Some(entry) = cursor.next(mut db.pager)? else {
                    return Ok(null);
                };
                return Ok(CursorRow { rowId: 0, columns: entry });
            }
        }
    }

    /// The row an index entry names: its rowid, or the primary key's columns it holds.
    fn keyInEntry(borrow this, index: borrow TableIndex, entry: Slice<SqliteValue>) -> Result<RowKey, SqliteError> {
        if (!this.table.withoutRowid) {
            return Ok(RowKey.Rowid(indexEntryRowId(entry)?));
        }
        var key = Vector<SqliteValue>.withCapacity(index.keyAt.length)?;
        for (k in 0..index.keyAt.length) {
            if (index.keyAt[k] >= entry.length) {
                return Err(corrupt("an index entry is shorter than its table's primary key"));
            }
            key.push(entry[index.keyAt[k]].clone()?)?;
        }
        return Ok(RowKey.Key(key));
    }

    /// The index entry of the row in the slot, or `null` when a partial index leaves it out.
    fn entryFor(
        borrow this,
        index: borrow TableIndex,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<Vector<SqliteValue>?, SqliteError> {
        if (borrow index.filter is Some(f)) {
            let keep = evaluate(f, frame, db)?;
            if (!isTrue(borrow keep)) {
                return Ok(null);
            }
        }
        var entry = Vector<SqliteValue>.withCapacity(index.columns.length + index.suffix.length + 1)?;
        for (c in 0..index.columns.length) {
            if (index.columns[c].column is Some(at)) {
                entry.push(frame.slots[this.slot].values[at].clone()?)?;
            } else if (borrow index.columns[c].expr is Some(x)) {
                entry.push(evaluate(x, frame, db)?)?;
            }
        }
        if (this.table.withoutRowid) {
            for (k in 0..index.suffix.length) {
                entry.push(frame.slots[this.slot].values[index.suffix[k]].clone()?)?;
            }
        } else {
            entry.push(SqliteValue.Integer(frame.slots[this.slot].rowId))?;
        }
        return Ok(entry);
    }

    /// The table's record for the row in the slot, as values in storage order: the rowid's alias as NULL, and a
    /// REAL column's integral value as an integer, as SQLite writes them. A WITHOUT ROWID table's record holds
    /// the primary key's columns first.
    fn storedValues(borrow this, frame: borrow Frame) -> Result<Vector<SqliteValue>, SqliteError> {
        let values = borrow frame.slots[this.slot].values;
        var count: usize = 0;
        for (c in 0..this.table.columns.length) {
            if (this.read.recordPosition[c] is Some(at)) {
                count = count.max(at + 1);
            }
        }
        var stored = Vector<SqliteValue>.withCapacity(count)?;
        for (i in 0..count) {
            stored.push(SqliteValue.Null)?;
        }
        for (c in 0..this.table.columns.length) {
            let Some(at) = this.read.recordPosition[c] else {
                continue;
            };
            if (this.table.rowidAlias == Some(c)) {
                continue;
            }
            var v = values[c].clone()?;
            if (this.read.realColumns[c] && v is SqliteValue.Real(r) && realAsExactInteger(r) is Some(i)) {
                v = SqliteValue.Integer(i);
            }
            stored[at] = v;
        }
        return Ok(stored);
    }

    /// Computes the generated columns of the row in the slot.
    fn computeGeneratedColumns(
        borrow this,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<void, SqliteError> {
        for (g in 0..this.generated.length) {
            let v = evaluate(borrow this.generated[g].expr, frame, db)?;
            let column = this.generated[g].column;
            frame.slots[this.slot].values[column] = applyColumnAffinity(v, this.table.columns[column].affinity)?;
        }
        return Ok();
    }

    /// Reads the row `key` names into the slot; false when there is none.
    fn loadRow(
        borrow this,
        key: borrow RowKey,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<bool, SqliteError> {
        let Some(row) = this.findRow(key, db)? else {
            return Ok(false);
        };
        loadTableRow(borrow this.read, row.rowId, row.columns, mut frame.slots[this.slot])?;
        if (this.read.generated.length != 0) {
            computeGenerated(borrow this.read, this.slot, frame, db)?;
        }
        return Ok(true);
    }

    /// The rows whose entry in `index` has the same key as `entry`, other than those `except` names.
    fn conflictsIn(
        borrow this,
        index: borrow TableIndex,
        entry: borrow Vector<SqliteValue>,
        except: Slice<RowKey>,
        db: borrow mut Session,
    ) -> Result<Vector<RowKey>, SqliteError> {
        var found = Vector<RowKey>.create();
        let keyLength = index.columns.length;
        for (k in 0..keyLength) {
            // NULLs never collide.
            if (entry[k].isNull()) {
                return Ok(found);
            }
        }
        var order = IndexOrder.plain();
        for (k in 0..keyLength) {
            order.collations.push(index.order.collations[k])?;
            order.descending.push(index.order.descending[k])?;
        }
        let range = IndexRange.equalTo(order, entry.view()[0..keyLength])?;
        var cursor = IndexCursor.create(index.root, range, false);
        while (cursor.next(mut db.pager)? is Some(other)) {
            let key = this.keyInEntry(index, other.view())?;
            var excluded = false;
            for (e in 0..except.length) {
                excluded = excluded || this.sameRow(borrow key, borrow except[e]);
            }
            if (!excluded) {
                found.push(key)?;
            }
        }
        return Ok(found);
    }

    /// Adds or removes index entries. An index that cannot take a removal in place is marked stale: rebuilding
    /// it now would read rows the statement has not finished changing.
    fn applyIndexOps(
        borrow this,
        index: borrow TableIndex,
        ops: Vector<IndexOp>,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<void, SqliteError> {
        if (ops.length == 0 || index.stale.get()) {
            return Ok();
        }
        if (!IndexMutator.applyBatch(mut db.pager, index.root, ops.view(), borrow index.order)?) {
            index.stale.set(true);
        }
        return Ok();
    }

    /// Ends the statement: stale indexes are rebuilt from the table's rows as they now are.
    fn finish(borrow this, frame: borrow mut Frame, db: borrow mut Session) -> Result<void, SqliteError> {
        for (i in 0..this.indexes.length) {
            let index = borrow this.indexes[i];
            if (index.stale.get()) {
                this.rebuildIndex(index, frame, db)?;
                index.stale.set(false);
            }
        }
        return Ok();
    }

    /// Builds an index again from every row of the table.
    fn rebuildIndex(
        borrow this,
        index: borrow TableIndex,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<void, SqliteError> {
        let saved = replace(
            mut frame.slots[this.slot],
            Slot { values: Vector<SqliteValue>.create(), rowId: 0, isNull: false },
        );
        var entries = Vector<Vector<SqliteValue>>.create();
        var cursor = RowCursor.scan(borrow this.read);
        while (cursor.next(mut db.pager)? is Some(row)) {
            loadTableRow(borrow this.read, row.rowId, row.columns, mut frame.slots[this.slot])?;
            if (this.read.generated.length != 0) {
                computeGenerated(borrow this.read, this.slot, frame, db)?;
            }
            if (this.entryFor(index, frame, db)? is Some(entry)) {
                entries.push(entry)?;
            }
        }
        frame.slots[this.slot] = saved;
        let order = borrow index.order;
        entries.sortBy((a, b) => order.comparePrefix(a.view(), b.view()));
        var records = Vector<Vector<u8>>.withCapacity(entries.length)?;
        for (i in 0..entries.length) {
            records.push(Record.encode(entries[i].view())?)?;
        }
        IndexMutator.rebuild(mut db.pager, index.root, records.view())?;
        return Ok();
    }

    /// Removes the record `key` names from a WITHOUT ROWID table's b-tree. When the tree cannot lose it in place,
    /// the tree is built again from its other records.
    fn removeKeyedRecord(borrow this, key: borrow RowKey, db: borrow mut Session) -> Result<void, SqliteError> {
        let Some(row) = this.findRow(key, db)? else {
            return Ok();
        };
        let order = borrow this.primaryKey.order;
        var op = Vector<IndexOp>.create();
        op.push(IndexOp { entry: cloneValues(row.columns.view())?, remove: true })?;
        if (IndexMutator.applyBatch(mut db.pager, this.read.root, op.view(), order)?) {
            return Ok();
        }
        var records = Vector<Vector<u8>>.create();
        var cursor = RowCursor.scan(borrow this.read);
        while (cursor.next(mut db.pager)? is Some(other)) {
            if (order.comparePrefix(other.columns.view(), row.columns.view()[0..this.primaryKey.columns.length]) != 0) {
                records.push(Record.encode(other.columns.view())?)?;
            }
        }
        IndexMutator.rebuild(mut db.pager, this.read.root, records.view())?;
        return Ok();
    }

    /// Removes the row `key` names (loaded in the slot) and its index entries.
    fn deleteRow(
        borrow this,
        key: borrow RowKey,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<void, SqliteError> {
        for (i in 0..this.indexes.length) {
            let index = borrow this.indexes[i];
            var ops = Vector<IndexOp>.create();
            if (this.entryFor(index, frame, db)? is Some(entry)) {
                ops.push(IndexOp { entry: entry, remove: true })?;
            }
            this.applyIndexOps(index, ops, frame, db)?;
        }
        match (key) {
            RowKey.Rowid(rowId) => {
                var op = Vector<TableOp>.create();
                op.push(TableOp { rowId: rowId, record: null })?;
                TableMutator.applyBatch(mut db.pager, this.read.root, op.view())?;
            }
            RowKey.Key(_) => { this.removeKeyedRecord(key, db)?; }
        }
        return Ok();
    }

    /// Writes the row in the slot (new, or replacing the one with its key) and adds its index entries.
    fn writeRow(borrow this, frame: borrow mut Frame, db: borrow mut Session) -> Result<void, SqliteError> {
        let stored = this.storedValues(frame)?;
        if (this.table.withoutRowid) {
            let key = this.keyOf(borrow frame.slots[this.slot])?;
            this.removeKeyedRecord(borrow key, db)?;
            var op = Vector<IndexOp>.create();
            op.push(IndexOp { entry: stored, remove: false })?;
            let _ = IndexMutator.applyBatch(mut db.pager, this.read.root, op.view(), borrow this.primaryKey.order)?;
        } else {
            var op = Vector<TableOp>.create();
            op.push(TableOp { rowId: frame.slots[this.slot].rowId, record: Record.encode(stored.view())? })?;
            TableMutator.applyBatch(mut db.pager, this.read.root, op.view())?;
        }
        for (i in 0..this.indexes.length) {
            let index = borrow this.indexes[i];
            var ops = Vector<IndexOp>.create();
            if (this.entryFor(index, frame, db)? is Some(entry)) {
                ops.push(IndexOp { entry: entry, remove: false })?;
            }
            this.applyIndexOps(index, ops, frame, db)?;
        }
        return Ok();
    }

    /// Checks NOT NULL and CHECK for the row in the slot. With REPLACE, a NULL in a NOT NULL column with a default
    /// takes the default. False when the row is to be skipped (OR IGNORE).
    fn checkRow(
        borrow this,
        action: ConflictAction,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<bool, SqliteError> {
        for (c in 0..this.table.columns.length) {
            let column = borrow this.table.columns[c];
            // A WITHOUT ROWID table's primary key is NOT NULL, written or not.
            var inKey = false;
            for (k in 0..this.primaryKey.columns.length) {
                inKey = inKey || this.primaryKey.columns[k] == c;
            }
            if (!(column.notNull || inKey) || this.table.rowidAlias == Some(
                c,
            ) || !frame.slots[this.slot].values[c].isNull()) {
                continue;
            }
            if (action == ConflictAction.Ignore) {
                return Ok(false);
            }
            if (action == ConflictAction.Replace) {
                if (borrow this.defaults[c] is Some(d)) {
                    let v = evaluate(d, frame, db)?;
                    frame.slots[this.slot].values[c] = applyColumnAffinity(v, column.affinity)?;
                    if (!frame.slots[this.slot].values[c].isNull()) {
                        continue;
                    }
                }
            }
            var message = String.from("NOT NULL constraint failed: ")?;
            message.append(this.table.name.view())?;
            message.append(".")?;
            message.append(column.name.view())?;
            return Err(SqliteError.Constraint(message));
        }
        for (k in 0..this.checks.length) {
            let v = evaluate(borrow this.checks[k], frame, db)?;
            if (truthOf(borrow v) == Some(false)) {
                if (action == ConflictAction.Ignore) {
                    return Ok(false);
                }
                var message = String.from("CHECK constraint failed: ")?;
                message.append(this.checkNames[k].view())?;
                return Err(SqliteError.Constraint(message));
            }
        }
        return Ok(true);
    }

    /// The message of a PRIMARY KEY conflict on the table itself.
    fn keyConflictMessage(borrow this) -> Result<String, AllocError> {
        var message = String.from("UNIQUE constraint failed: ")?;
        if (this.table.withoutRowid) {
            message.append(this.primaryKey.names.view())?;
            return Ok(message);
        }
        message.append(this.table.name.view())?;
        message.append(".")?;
        if (this.table.rowidAlias is Some(alias)) {
            message.append(this.table.columns[alias].name.view())?;
        } else {
            message.append("rowid")?;
        }
        return Ok(message);
    }

    /// Resolves UNIQUE and PRIMARY KEY conflicts of the row in the slot before it is written; `old` names the row
    /// it replaces in an UPDATE. False when the row is to be skipped (OR IGNORE). REPLACE deletes the rows it
    /// conflicts with.
    fn resolveConflicts(
        borrow this,
        action: ConflictAction,
        old: borrow RowKey?,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<bool, SqliteError> {
        let key = this.keyOf(borrow frame.slots[this.slot])?;
        var except = Vector<RowKey>.create();
        except.push(key.copy()?)?;
        var sameAsOld = false;
        if (old is Some(o)) {
            except.push(o.copy()?)?;
            sameAsOld = this.sameRow(o, borrow key);
        }
        // The table's own key.
        if (!sameAsOld && this.findRow(borrow key, db)?.isSome()) {
            if (action == ConflictAction.Ignore) {
                return Ok(false);
            }
            if (action != ConflictAction.Replace) {
                return Err(SqliteError.Constraint(this.keyConflictMessage()?));
            }
            this.replaceRow(borrow key, frame, db)?;
        }
        for (i in 0..this.indexes.length) {
            let index = borrow this.indexes[i];
            if (!index.unique) {
                continue;
            }
            if (index.stale.get()) {
                // Its entries are out of date: rebuild it from the table as it is now, before relying on it.
                let saved = copySlot(borrow frame.slots[this.slot])?;
                this.rebuildIndex(index, frame, db)?;
                frame.slots[this.slot] = saved;
                index.stale.set(false);
            }
            let Some(entry) = this.entryFor(index, frame, db)? else {
                continue;
            };
            let conflicting = this.conflictsIn(index, borrow entry, except.view(), db)?;
            if (conflicting.length == 0) {
                continue;
            }
            if (action == ConflictAction.Ignore) {
                return Ok(false);
            }
            if (action != ConflictAction.Replace) {
                var message = String.from("UNIQUE constraint failed: ")?;
                message.append(index.keyNames.view())?;
                return Err(SqliteError.Constraint(message));
            }
            for (k in 0..conflicting.length) {
                this.replaceRow(borrow conflicting[k], frame, db)?;
            }
        }
        return Ok(true);
    }

    /// The first PRIMARY KEY or UNIQUE constraint the row in the slot (not yet written) would break.
    fn firstConflict(
        borrow this,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<ConflictFound?, SqliteError> {
        let key = this.keyOf(borrow frame.slots[this.slot])?;
        if (this.findRow(borrow key, db)?.isSome()) {
            return Ok(ConflictFound { index: null, key: key });
        }
        for (i in 0..this.indexes.length) {
            let index = borrow this.indexes[i];
            if (!index.unique) {
                continue;
            }
            if (index.stale.get()) {
                let saved = copySlot(borrow frame.slots[this.slot])?;
                this.rebuildIndex(index, frame, db)?;
                frame.slots[this.slot] = saved;
                index.stale.set(false);
            }
            let Some(entry) = this.entryFor(index, frame, db)? else {
                continue;
            };
            var others = this.conflictsIn(index, borrow entry, [], db)?;
            if (others.length != 0) {
                return Ok(ConflictFound { index: i, key: others.remove(0) });
            }
        }
        return Ok(null);
    }

    /// OR REPLACE: deletes the row `victim` that the new row (in the slot) conflicts with.
    fn replaceRow(
        borrow this,
        victim: borrow RowKey,
        frame: borrow mut Frame,
        db: borrow mut Session,
    ) -> Result<void, SqliteError> {
        let saved = replace(
            mut frame.slots[this.slot],
            Slot { values: Vector<SqliteValue>.create(), rowId: 0, isNull: false },
        );
        if (this.loadRow(victim, frame, db)?) {
            this.deleteRow(victim, frame, db)?;
        }
        frame.slots[this.slot] = saved;
        return Ok();
    }

    /// The rowid a new row gets: one past the largest, or past sqlite_sequence's for AUTOINCREMENT.
    fn newRowid(borrow this, db: borrow mut Session) -> Result<i64, SqliteError> {
        var largest = lastRowid(mut db.pager, this.read.root)? ?? 0;
        if (this.table.autoincrement) {
            largest = largest.max(db.sequenceValue(this.table.name.view())? ?? 0);
        }
        if (largest < 9223372036854775807) {
            return Ok(largest + 1);
        }
        if (this.table.autoincrement) {
            return Err(sqlError("database or disk is full"));
        }
        // Every rowid up to the largest is taken at the top: look for a free one at random, as SQLite does.
        for (attempt in 0..100) {
            let bytes = randomBytes(8)?;
            let candidate = truncate<i64>(bytes.readLE<u64>(0) >> 1);
            if (candidate > 0 && seekTableRow(mut db.pager, this.read.root, candidate)?.isNull()) {
                return Ok(candidate);
            }
        }
        return Err(sqlError("database or disk is full"));
    }
}

/// The largest rowid in a table b-tree, by its right edge.
fn lastRowid<P: PageSource>(pager: borrow mut P, root: u32) -> Result<i64?, SqliteError> {
    var page = root;
    for (depth in 0..BTREE_MAX_DEPTH) {
        let bytes = pager.readPage(page)?;
        let header = BTreePageHeader.parse(bytes.view(), page)?;
        if (header.kind == PAGE_LEAF_TABLE) {
            if (header.cellCount == 0) {
                return Ok(null);
            }
            let offset = header.cellOffset(bytes.view(), header.cellCount - 1)?;
            return Ok(TableLeafCell.parse(bytes.view(), offset)?.rowId);
        }
        if (header.kind != PAGE_INTERIOR_TABLE) {
            return Err(corrupt("a page in a table b-tree is not a table page"));
        }
        page = header.rightMost;
    }
    return Err(corrupt("a table b-tree's pages form a cycle"));
}

/// Where an INSERT's rows come from, compiled.
enum InsertSourcePlan {
    DefaultValues,
    Values(Vector<Vector<XExpr>>),
    Select(SelectPlan),
}

fn compileInsertSource(
    stmt: borrow InsertStmt,
    compiler: borrow mut Compiler,
    db: borrow mut Session,
) -> Result<InsertSourcePlan, SqliteError> {
    // The values see no table: not even the one they go into.
    let saved = replace(mut compiler.scopes, compiler.freshScopes()?);
    let result = compileInsertSourceInner(stmt, compiler, db);
    compiler.scopes = saved;
    return result;
}

fn compileInsertSourceInner(
    stmt: borrow InsertStmt,
    compiler: borrow mut Compiler,
    db: borrow mut Session,
) -> Result<InsertSourcePlan, SqliteError> {
    match (borrow stmt.source) {
        InsertSource.DefaultValues => { return Ok(InsertSourcePlan.DefaultValues); }
        InsertSource.Values(list) => {
            var compiled = Vector<Vector<XExpr>>.withCapacity(list.length)?;
            for (r in 0..list.length) {
                var row = Vector<XExpr>.withCapacity(list[r].length)?;
                for (c in 0..list[r].length) {
                    row.push(compiler.compile(borrow list[r][c], db)?)?;
                }
                compiled.push(row)?;
            }
            return Ok(InsertSourcePlan.Values(compiled));
        }
        InsertSource.Select(select) => { return Ok(InsertSourcePlan.Select(compileSelect(compiler, select, db)?)); }
    }
}

/// The rows an INSERT adds: each one's values for the named columns.
fn insertRows(
    source: borrow InsertSourcePlan,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<Vector<SqliteValue>>, SqliteError> {
    var rows = Vector<Vector<SqliteValue>>.create();
    match (source) {
        InsertSourcePlan.DefaultValues => { rows.push(Vector<SqliteValue>.create())?; }
        InsertSourcePlan.Values(list) => {
            for (r in 0..list.length) {
                var values = Vector<SqliteValue>.withCapacity(list[r].length)?;
                for (c in 0..list[r].length) {
                    values.push(evaluate(borrow list[r][c], frame, db)?)?;
                }
                rows.push(values)?;
            }
        }
        InsertSourcePlan.Select(plan) => { rows = runSelect(plan, frame, db)?; }
    }
    return Ok(rows);
}

/// INSERT.
fn executeInsert(
    stmt: borrow InsertStmt,
    params: Slice<SqliteValue>,
    db: borrow mut Session,
) -> Result<QueryResult, SqliteError> {
    var compiler = newCompiler(db)?;
    let writer = TableWriter.create(mut compiler, stmt.table.name.view(), db)?;
    let table = borrow writer.table;
    // Which column each value goes to.
    var targets = Vector<usize>.create();
    if (stmt.columns.length == 0) {
        for (c in 0..table.columns.length) {
            if (table.columns[c].generated.isNull()) {
                targets.push(c)?;
            }
        }
    } else {
        for (k in 0..stmt.columns.length) {
            let name = stmt.columns[k].view();
            var at = table.indexOf(name);
            if (at.isNull() && isRowidName(name) && table.rowidAlias.isNull()) {
                at = table.columns.length;
            }
            let found = at ?? {
                var message = String.from("table ")?;
                message.append(table.name.view())?;
                message.append(" has no column named ")?;
                message.append(name)?;
                return Err(SqliteError.Sql(message));
            };
            if (found < table.columns.length && table.columns[found].generated.isSome()) {
                var message = String.from("cannot INSERT into generated column \"")?;
                message.append(name)?;
                message.append("\"")?;
                return Err(SqliteError.Sql(message));
            }
            targets.push(found)?;
        }
    }
    let returning = compileReturning(mut compiler, borrow stmt.returning, borrow writer, db)?;
    let excludedSlot = compiler.slotsInUse;
    compiler.slotsInUse += 1;
    let upserts = compileUpserts(mut compiler, stmt, borrow writer, excludedSlot, db)?;
    if (borrow stmt.with is Some(with)) {
        let _ = compileWith(mut compiler, with, db)?;
    }
    let source = compileInsertSource(stmt, mut compiler, db)?;
    var frame = newFrame(mut compiler, params, db)?;
    var rows = insertRows(borrow source, mut frame, db)?;
    var output = Vector<Vector<SqliteValue>>.create();
    let action = stmt.conflict ?? ConflictAction.Abort;
    var count: i64 = 0;
    for (r in 0..rows.length) {
        let given = takeRow(mut rows, r);
        if (given.length != targets.length) {
            var message = String.create();
            if (stmt.columns.length == 0) {
                message.append("table ")?;
                message.append(table.name.view())?;
                message.append(" has ")?;
                message.appendNumber(targets.length)?;
                message.append(" columns but ")?;
                message.appendNumber(given.length)?;
                message.append(" values were supplied")?;
            } else {
                message.appendNumber(given.length)?;
                message.append(" values for ")?;
                message.appendNumber(targets.length)?;
                message.append(" columns")?;
            }
            return Err(SqliteError.Sql(message));
        }
        // The row: defaults, then the given values with the columns' affinities.
        var values = Vector<SqliteValue>.withCapacity(table.columns.length)?;
        var provided = Vector<bool>.create();
        provided.resize(table.columns.length + 1, false)?;
        for (k in 0..targets.length) {
            provided[targets[k]] = true;
        }
        for (c in 0..table.columns.length) {
            var v = SqliteValue.Null;
            if (!provided[c] && table.columns[c].generated.isNull()) {
                if (borrow writer.defaults[c] is Some(d)) {
                    v = evaluate(d, mut frame, db)?;
                }
            }
            values.push(v)?;
        }
        var explicitRowid: SqliteValue? = null;
        var k: usize = 0;
        for (v in given) {
            let at = targets[k];
            if (at == table.columns.length) {
                explicitRowid = v.clone()?;
            } else {
                values[at] = applyColumnAffinity(v.clone()?, table.columns[at].affinity)?;
            }
            k += 1;
        }
        // The rowid: the INTEGER PRIMARY KEY's value, an explicit rowid, or a new one.
        var rowValue: SqliteValue = SqliteValue.Null;
        if (table.rowidAlias is Some(alias)) {
            rowValue = values[alias].clone()?;
        } else if (explicitRowid is Some(v)) {
            rowValue = applyColumnAffinity(v, Affinity.Integer)?;
        }
        var rowId: i64 = 0;
        match (rowValue) {
            SqliteValue.Null if (table.withoutRowid) => {}
            SqliteValue.Null => { rowId = writer.newRowid(db)?; }
            SqliteValue.Integer(i) => { rowId = i; }
            _ => { return Err(sqlError("datatype mismatch")); }
        }
        if (table.rowidAlias is Some(alias)) {
            values[alias] = SqliteValue.Integer(rowId);
        }
        frame.slots[writer.slot] = Slot { values: values, rowId: rowId, isNull: false };
        writer.computeGeneratedColumns(mut frame, db)?;
        if (writer.triggers.length != 0) {
            let noRow: Slot? = null;
            let proposed: Slot? = copySlot(borrow frame.slots[writer.slot])?;
            if (!fireTriggers(
                borrow writer.triggers,
                borrow writer.table,
                TriggerEvent.Insert,
                TriggerTiming.Before,
                borrow noRow,
                borrow proposed,
                [],
                db,
            )?) {
                continue;
            }
        }
        if (!writer.checkRow(action, mut frame, db)?) {
            continue;
        }
        if (upserts.length != 0) {
            if (writer.firstConflict(mut frame, db)? is Some(conflict)) {
                var chosen: usize? = null;
                for (u in 0..upserts.length) {
                    if (chosen.isNull() && (upserts[u].anyConflict || upserts[u].index == conflict.index)) {
                        chosen = u;
                    }
                }
                if (chosen is Some(u)) {
                    let plan = borrow upserts[u];
                    if (plan.doNothing) {
                        continue;
                    }
                    // DO UPDATE: the proposed row is "excluded"; the existing one is updated.
                    frame.slots[excludedSlot] = copySlot(borrow frame.slots[writer.slot])?;
                    if (!writer.loadRow(borrow conflict.key, mut frame, db)?) {
                        continue;
                    }
                    if (borrow plan.filter is Some(f)) {
                        let ok = evaluate(f, mut frame, db)?;
                        if (!isTrue(borrow ok)) {
                            continue;
                        }
                    }
                    if (updateLoadedRow(borrow writer, borrow plan.set, ConflictAction.Abort, mut frame, db)?) {
                        count += 1;
                        if (returning.length != 0) {
                            output.push(returningRow(borrow returning, mut frame, db)?)?;
                        }
                    }
                    continue;
                }
            }
        }
        let noKey: RowKey? = null;
        if (!writer.resolveConflicts(action, borrow noKey, mut frame, db)?) {
            continue;
        }
        writer.writeRow(mut frame, db)?;
        if (db.foreignKeys && table.foreignKeys.length != 0) {
            checkChildRow(table, borrow frame.slots[writer.slot], db)?;
        }
        if (table.autoincrement) {
            db.updateSequence(table.name.view(), rowId)?;
        }
        if (writer.triggers.length != 0) {
            let noRow: Slot? = null;
            let inserted: Slot? = copySlot(borrow frame.slots[writer.slot])?;
            let _ = fireTriggers(
                borrow writer.triggers,
                borrow writer.table,
                TriggerEvent.Insert,
                TriggerTiming.After,
                borrow noRow,
                borrow inserted,
                [],
                db,
            )?;
        }
        if (!table.withoutRowid) {
            db.lastInsertRowid = rowId;
        }
        count += 1;
        if (returning.length != 0) {
            var out = Vector<SqliteValue>.withCapacity(returning.length)?;
            for (i in 0..returning.length) {
                out.push(evaluate(borrow returning[i], mut frame, db)?)?;
            }
            output.push(out)?;
        }
    }
    writer.finish(mut frame, db)?;
    db.changes = count;
    db.totalChanges += count;
    return Ok(QueryResult { columns: returningNames(borrow stmt.returning, borrow writer.table)?, rows: output });
}

/// RETURNING's expressions, compiled in the table's scope; `*` is every column.
fn compileReturning(
    compiler: borrow mut Compiler,
    columns: borrow Vector<ResultColumn>,
    writer: borrow TableWriter,
    db: borrow mut Session,
) -> Result<Vector<XExpr>, SqliteError> {
    var out = Vector<XExpr>.create();
    for (i in 0..columns.length) {
        match (borrow columns[i]) {
            ResultColumn.Expr(e, _) => {
                out.push(compileInTable(compiler, e, borrow writer.table, writer.slot, db)?)?;
            }
            _ => {
                for (c in 0..writer.table.columns.length) {
                    out.push(XExpr.Column(writer.slot, c))?;
                }
            }
        }
    }
    return Ok(out);
}

fn returningNames(
    columns: borrow Vector<ResultColumn>,
    table: borrow TableSchema,
) -> Result<Vector<String>, AllocError> {
    var names = Vector<String>.create();
    for (i in 0..columns.length) {
        match (borrow columns[i]) {
            ResultColumn.Expr(e, alias) => { names.push(if (alias is Some(a)) a.clone()? else defaultColumnName(e)?)?; }
            _ => {
                for (c in 0..table.columns.length) {
                    names.push(table.columns[c].name.clone()?)?;
                }
            }
        }
    }
    return Ok(names);
}

/// The rowids of the table's rows a WHERE clause selects, with the rows (in the order of the table).
fn matchingRows(
    writer: borrow TableWriter,
    filter: borrow XExpr?,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<RowKey>, SqliteError> {
    var cursor = RowCursor.scan(borrow writer.read);
    var rowidSeek = false;
    if (filter is Some(f) && !writer.table.withoutRowid) {
        if (rowidEqualityFor(f, writer.slot)? is Some(seek)) {
            rowidSeek = true;
            let Some(rowId) = seekRowid(borrow seek, frame, db)? else {
                return Ok(Vector<RowKey>.create());
            };
            cursor = RowCursor.Rows(TableCursor.range(writer.read.root, rowId, rowId));
        }
    }
    var rowids = Vector<RowKey>.create();
    // An index that narrows the rows, as in a SELECT.
    if (filter is Some(f) && !writer.table.withoutRowid && !rowidSeek) {
        var bounds = Vector<ColumnBound>.create();
        columnBounds(f, writer.slot, true, mut bounds)?;
        if (chooseIndexSeek(db, borrow writer.table, borrow bounds)? is Some(seek)) {
            let Some(range) = seekRange(borrow seek, frame, db)? else {
                return Ok(rowids);
            };
            var found = Vector<i64>.create();
            var entries = IndexCursor.create(seek.root, range, false);
            while (entries.next(mut db.pager)? is Some(entry)) {
                found.push(indexEntryRowId(entry.view())?)?;
            }
            // In rowid order, as a scan would give them.
            found.sortBy((a, b) => compareI64(a, b));
            for (i in 0..found.length) {
                let key = RowKey.Rowid(found[i]);
                if (!writer.loadRow(borrow key, frame, db)?) {
                    return Err(corrupt("an index entry names a row its table does not have"));
                }
                let ok = evaluate(f, frame, db)?;
                if (isTrue(borrow ok)) {
                    rowids.push(key)?;
                }
            }
            return Ok(rowids);
        }
    }
    while (cursor.next(mut db.pager)? is Some(row)) {
        loadTableRow(borrow writer.read, row.rowId, row.columns, mut frame.slots[writer.slot])?;
        if (writer.read.generated.length != 0) {
            computeGenerated(borrow writer.read, writer.slot, frame, db)?;
        }
        if (filter is Some(f)) {
            let ok = evaluate(f, frame, db)?;
            if (!isTrue(borrow ok)) {
                continue;
            }
        }
        rowids.push(writer.keyOf(borrow frame.slots[writer.slot])?)?;
    }
    return Ok(rowids);
}

/// DELETE.
fn executeDelete(
    stmt: borrow DeleteStmt,
    params: Slice<SqliteValue>,
    db: borrow mut Session,
) -> Result<QueryResult, SqliteError> {
    var compiler = newCompiler(db)?;
    let writer = TableWriter.create(mut compiler, stmt.table.name.view(), db)?;
    if (borrow stmt.with is Some(with)) {
        let _ = compileWith(mut compiler, with, db)?;
    }
    var filter: XExpr? = null;
    if (borrow stmt.filter is Some(f)) {
        filter = compileInTable(mut compiler, f, borrow writer.table, writer.slot, db)?;
    }
    let returning = compileReturning(mut compiler, borrow stmt.returning, borrow writer, db)?;
    var frame = newFrame(mut compiler, params, db)?;
    let rowids = matchingRows(borrow writer, borrow filter, mut frame, db)?;
    var output = Vector<Vector<SqliteValue>>.create();
    var count: i64 = 0;
    for (i in 0..rowids.length) {
        if (!writer.loadRow(borrow rowids[i], mut frame, db)?) {
            continue;
        }
        if (writer.triggers.length != 0) {
            let noRow: Slot? = null;
            let old: Slot? = copySlot(borrow frame.slots[writer.slot])?;
            if (!fireTriggers(
                borrow writer.triggers,
                borrow writer.table,
                TriggerEvent.Delete,
                TriggerTiming.Before,
                borrow old,
                borrow noRow,
                [],
                db,
            )?) {
                continue;
            }
            // The trigger may have changed or removed the row.
            if (!writer.loadRow(borrow rowids[i], mut frame, db)?) {
                continue;
            }
        }
        if (returning.length != 0) {
            var out = Vector<SqliteValue>.withCapacity(returning.length)?;
            for (k in 0..returning.length) {
                out.push(evaluate(borrow returning[k], mut frame, db)?)?;
            }
            output.push(out)?;
        }
        let deleted: Slot? = if (writer.triggers.length != 0) copySlot(borrow frame.slots[writer.slot])? else null;
        writer.deleteRow(borrow rowids[i], mut frame, db)?;
        count += 1;
        if (db.foreignKeys) {
            let gone = copySlot(borrow frame.slots[writer.slot])?;
            let noNew: Slot? = null;
            parentChanged(borrow writer.table, borrow gone, borrow noNew, db)?;
        }
        if (writer.triggers.length != 0) {
            let noRow: Slot? = null;
            let _ = fireTriggers(
                borrow writer.triggers,
                borrow writer.table,
                TriggerEvent.Delete,
                TriggerTiming.After,
                borrow deleted,
                borrow noRow,
                [],
                db,
            )?;
        }
    }
    writer.finish(mut frame, db)?;
    db.changes = count;
    db.totalChanges += db.changes;
    return Ok(QueryResult { columns: returningNames(borrow stmt.returning, borrow writer.table)?, rows: output });
}

/// The columns an UPDATE (or an upsert's DO UPDATE) sets, and their new values.
struct Assignments {
    /// Column positions; the table's column count stands for the rowid itself.
    targets: Vector<usize>;
    values: Vector<XExpr>;
}

/// The column `name` of a SET: its position, or the column count for the rowid itself.
fn assignmentTarget(name: StringView, table: borrow TableSchema) -> Result<usize, SqliteError> {
    var at = table.indexOf(name);
    if (at.isNull() && isRowidName(name)) {
        at = table.rowidAlias ?? table.columns.length;
    }
    let found = at ?? {
        return Err(namedError("no such column: ", name));
    };
    if (found < table.columns.length && table.columns[found].generated.isSome()) {
        var message = String.from("cannot UPDATE generated column \"")?;
        message.append(name)?;
        message.append("\"")?;
        return Err(SqliteError.Sql(message));
    }
    return Ok(found);
}

/// Compiles SET column = value, …, each value in the scope the compiler has.
fn compileAssignments(
    compiler: borrow mut Compiler,
    list: borrow Vector<Assignment>,
    table: borrow TableSchema,
    db: borrow mut Session,
) -> Result<Assignments, SqliteError> {
    var out = Assignments { targets: Vector<usize>.create(), values: Vector<XExpr>.create() };
    for (a in 0..list.length) {
        out.targets.push(assignmentTarget(list[a].column.view(), table)?)?;
        out.values.push(compiler.compile(borrow list[a].value, db)?)?;
    }
    return Ok(out);
}

/// Updates the row loaded in the writer's slot: the new values (all computed from the old row), constraints,
/// conflicts, index entries. False when OR IGNORE skipped it.
fn updateLoadedRow(
    writer: borrow TableWriter,
    set: borrow Assignments,
    action: ConflictAction,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<bool, SqliteError> {
    var newValues = Vector<SqliteValue>.withCapacity(set.values.length)?;
    for (a in 0..set.values.length) {
        newValues.push(evaluate(borrow set.values[a], frame, db)?)?;
    }
    return applyUpdate(writer, set.targets.view(), newValues, action, frame, db);
}

/// Gives the row loaded in the writer's slot `newValues` in the columns `targets`, with the constraints, conflicts,
/// triggers and index entries that go with it. False when the row was skipped.
fn applyUpdate(
    writer: borrow TableWriter,
    targets: Slice<usize>,
    values: Vector<SqliteValue>,
    action: ConflictAction,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<bool, SqliteError> {
    var newValues = values;
    let table = borrow writer.table;
    let oldRowid = frame.slots[writer.slot].rowId;
    let oldKey = writer.keyOf(borrow frame.slots[writer.slot])?;
    let oldSlot = copySlot(borrow frame.slots[writer.slot])?;
    var newRowid = oldRowid;
    for (a in 0..targets.length) {
        let at = targets[a];
        let v = replace(mut newValues[a], SqliteValue.Null);
        if (at == table.columns.length || table.rowidAlias == Some(at)) {
            match (applyColumnAffinity(v, Affinity.Integer)?) {
                SqliteValue.Integer(n) => { newRowid = n; }
                _ => { return Err(sqlError("datatype mismatch")); }
            }
            if (at < table.columns.length) {
                frame.slots[writer.slot].values[at] = SqliteValue.Integer(newRowid);
            }
        } else {
            frame.slots[writer.slot].values[at] = applyColumnAffinity(v, table.columns[at].affinity)?;
        }
    }
    frame.slots[writer.slot].rowId = newRowid;
    writer.computeGeneratedColumns(frame, db)?;
    let oldForTriggers: Slot? = if (writer.triggers.length != 0) copySlot(borrow oldSlot)? else null;
    if (writer.triggers.length != 0) {
        let proposed: Slot? = copySlot(borrow frame.slots[writer.slot])?;
        if (!fireTriggers(
            borrow writer.triggers,
            table,
            TriggerEvent.Update,
            TriggerTiming.Before,
            borrow oldForTriggers,
            borrow proposed,
            targets,
            db,
        )?) {
            frame.slots[writer.slot] = oldSlot;
            return Ok(false);
        }
    }
    if (!writer.checkRow(action, frame, db)?) {
        frame.slots[writer.slot] = oldSlot;
        return Ok(false);
    }
    let old: RowKey? = oldKey.copy()?;
    if (!writer.resolveConflicts(action, borrow old, frame, db)?) {
        frame.slots[writer.slot] = oldSlot;
        return Ok(false);
    }
    // Out with the old row's entries (and the row, when its rowid changes), then in with the new.
    let oldBeforeWrite: Slot? = if (db.foreignKeys) copySlot(borrow oldSlot)? else null;
    let newKey = writer.keyOf(borrow frame.slots[writer.slot])?;
    let newSlot = replace(mut frame.slots[writer.slot], oldSlot);
    if (!writer.sameRow(borrow newKey, borrow oldKey)) {
        writer.deleteRow(borrow oldKey, frame, db)?;
    } else {
        for (x in 0..writer.indexes.length) {
            let index = borrow writer.indexes[x];
            var ops = Vector<IndexOp>.create();
            if (writer.entryFor(index, frame, db)? is Some(entry)) {
                ops.push(IndexOp { entry: entry, remove: true })?;
            }
            writer.applyIndexOps(index, ops, frame, db)?;
        }
    }
    frame.slots[writer.slot] = newSlot;
    writer.writeRow(frame, db)?;
    if (db.foreignKeys) {
        if (table.foreignKeys.length != 0) {
            checkChildRow(table, borrow frame.slots[writer.slot], db)?;
        }
        let newRow: Slot? = copySlot(borrow frame.slots[writer.slot])?;
        if (borrow oldBeforeWrite is Some(before)) {
            parentChanged(table, before, borrow newRow, db)?;
        }
    }
    if (writer.triggers.length != 0) {
        let updated: Slot? = copySlot(borrow frame.slots[writer.slot])?;
        let _ = fireTriggers(
            borrow writer.triggers,
            table,
            TriggerEvent.Update,
            TriggerTiming.After,
            borrow oldForTriggers,
            borrow updated,
            targets,
            db,
        )?;
    }
    return Ok(true);
}

fn returningRow(
    returning: borrow Vector<XExpr>,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<SqliteValue>, SqliteError> {
    var out = Vector<SqliteValue>.withCapacity(returning.length)?;
    for (i in 0..returning.length) {
        out.push(evaluate(borrow returning[i], frame, db)?)?;
    }
    return Ok(out);
}

/// UPDATE.
fn executeUpdate(
    stmt: borrow UpdateStmt,
    params: Slice<SqliteValue>,
    db: borrow mut Session,
) -> Result<QueryResult, SqliteError> {
    if (stmt.from.isSome()) {
        return executeUpdateFrom(stmt, params, db);
    }
    var compiler = newCompiler(db)?;
    let writer = TableWriter.create(mut compiler, stmt.table.name.view(), db)?;
    if (borrow stmt.with is Some(with)) {
        let _ = compileWith(mut compiler, with, db)?;
    }
    let saved = replace(mut compiler.scopes, compiler.freshScopes()?);
    compiler.scopes.push(tableScope(borrow writer.table, writer.slot)?)?;
    let set = compileAssignments(mut compiler, borrow stmt.assignments, borrow writer.table, db);
    var filter: XExpr? = null;
    if (borrow stmt.filter is Some(f)) {
        filter = compiler.compile(f, db)?;
    }
    compiler.scopes = saved;
    let assignments = set?;
    let returning = compileReturning(mut compiler, borrow stmt.returning, borrow writer, db)?;
    var frame = newFrame(mut compiler, params, db)?;
    let rowids = matchingRows(borrow writer, borrow filter, mut frame, db)?;
    let action = stmt.conflict ?? ConflictAction.Abort;
    var output = Vector<Vector<SqliteValue>>.create();
    var count: i64 = 0;
    for (i in 0..rowids.length) {
        if (!writer.loadRow(borrow rowids[i], mut frame, db)?) {
            continue;
        }
        if (!updateLoadedRow(borrow writer, borrow assignments, action, mut frame, db)?) {
            continue;
        }
        count += 1;
        if (returning.length != 0) {
            output.push(returningRow(borrow returning, mut frame, db)?)?;
        }
    }
    writer.finish(mut frame, db)?;
    db.changes = count;
    db.totalChanges += count;
    return Ok(QueryResult { columns: returningNames(borrow stmt.returning, borrow writer.table)?, rows: output });
}

/// An upsert clause compiled: the constraint it answers (a unique index, or the rowid; any for none), and what
/// it does.
struct UpsertPlan {
    /// The index it targets, by position in the writer's indexes; `null` for the rowid; `anyConflict` for a bare
    /// ON CONFLICT.
    index: usize?;
    anyConflict: bool;
    doNothing: bool;
    set: Assignments;
    filter: XExpr?;
}

/// Compiles the ON CONFLICT clauses of an INSERT. `excludedSlot` holds the proposed row.
fn compileUpserts(
    compiler: borrow mut Compiler,
    stmt: borrow InsertStmt,
    writer: borrow TableWriter,
    excludedSlot: usize,
    db: borrow mut Session,
) -> Result<Vector<UpsertPlan>, SqliteError> {
    var plans = Vector<UpsertPlan>.create();
    let table = borrow writer.table;
    for (u in 0..stmt.upserts.length) {
        let clause = borrow stmt.upserts[u];
        var index: usize? = null;
        var any = clause.target.length == 0;
        if (any && u + 1 != stmt.upserts.length) {
            return Err(sqlError("ON CONFLICT clause does not match any PRIMARY KEY or UNIQUE constraint"));
        }
        if (!any) {
            // The target must name exactly the columns of the rowid's alias or of a unique index.
            var found = false;
            // A WITHOUT ROWID table's primary key is the table itself.
            if (table.withoutRowid && clause.target.length == writer.primaryKey.columns.length) {
                var all = true;
                for (t in 0..clause.target.length) {
                    var named = false;
                    for (c in 0..writer.primaryKey.columns.length) {
                        named = named || table.columns[writer.primaryKey.columns[c]].name.view().equalsIgnoreAsciiCase(
                            clause.target[t].view(),
                        );
                    }
                    all = all && named;
                }
                found = all;
            }
            if (clause.target.length == 1 && table.rowidAlias.isSome() &&
                table.columns[table.rowidAlias!].name.view().equalsIgnoreAsciiCase(
                    clause.target[0].view(),
                )) {
                found = true;
            }
            for (x in 0..writer.indexes.length) {
                if (found) {
                    break;
                }
                let candidate = borrow writer.indexes[x];
                if (!candidate.unique ||
                    candidate.columns.length != clause.target.length || candidate.filter.isSome()) {
                    continue;
                }
                var same = true;
                for (k in 0..clause.target.length) {
                    var named = false;
                    for (c in 0..candidate.columns.length) {
                        if (candidate.columns[c].column is Some(at) &&
                            table.columns[at].name.view().equalsIgnoreAsciiCase(
                                clause.target[k].view(),
                            )) {
                            named = true;
                        }
                    }
                    same = same && named;
                }
                if (same) {
                    index = x;
                    found = true;
                }
            }
            if (!found) {
                return Err(sqlError("ON CONFLICT clause does not match any PRIMARY KEY or UNIQUE constraint"));
            }
        }
        // DO UPDATE sees the existing row by the table's name and the proposed one as "excluded".
        let saved = replace(mut compiler.scopes, compiler.freshScopes()?);
        var scope = tableScope(table, writer.slot)?;
        // Unqualified names are the table's: "excluded" is named only when written.
        var hidden = Vector<String>.create();
        for (c in 0..table.columns.length) {
            hidden.push(table.columns[c].name.clone()?)?;
        }
        scope.sources.push(
            ScopeSource {
                name: String.from("excluded")?,
                columns: tableScopeColumns(table)?,
                slot: excludedSlot,
                hasRowid: true,
                rowidAlias: table.rowidAlias,
                merged: hidden, coalesceMerged: false,
            },
        )?;
        compiler.scopes.push(scope)?;
        let set = compileAssignments(compiler, borrow clause.assignments, table, db);
        var filter: Result<XExpr?, SqliteError> = Ok(null);
        if (borrow clause.filter is Some(f)) {
            filter = match (compiler.compile(f, db)) {
                Ok(x) => Ok(x),
                Err(e) => Err(e),
            };
        }
        compiler.scopes = saved;
        plans.push(
            UpsertPlan {
                index: index,
                anyConflict: any,
                doNothing: clause.assignments.length == 0,
                set: set?,
                filter: filter?,
            },
        )?;
    }
    return Ok(plans);
}

/// A constraint a proposed row breaks: the index (`null` for the rowid) and the row already there.
struct ConflictFound {
    index: usize?;
    key: RowKey;
}

/// UPDATE … FROM: the target joined with the FROM items, as SQLite does it. A SELECT of the target's rowid and the
/// new values runs first; then each target row it names takes the values of the first row that names it.
fn executeUpdateFrom(
    stmt: borrow UpdateStmt,
    params: Slice<SqliteValue>,
    db: borrow mut Session,
) -> Result<QueryResult, SqliteError> {
    var compiler = newCompiler(db)?;
    let writer = TableWriter.create(mut compiler, stmt.table.name.view(), db)?;
    var targets = Vector<usize>.withCapacity(stmt.assignments.length)?;
    for (a in 0..stmt.assignments.length) {
        targets.push(assignmentTarget(stmt.assignments[a].column.view(), borrow writer.table)?)?;
    }
    // SELECT <what names the row>, value, … FROM t, <from> WHERE <filter>: the rowid, or the primary key.
    var columns = Vector<ResultColumn>.withCapacity(stmt.assignments.length + 1)?;
    var keyNames = Vector<String>.create();
    if (writer.table.withoutRowid) {
        for (k in 0..writer.primaryKey.columns.length) {
            keyNames.push(writer.table.columns[writer.primaryKey.columns[k]].name.clone()?)?;
        }
    } else {
        keyNames.push(String.from("rowid")?)?;
    }
    let keyLength = keyNames.length;
    for (k in 0..keyNames.length) {
        let named = Expr.Column(
            ColumnRef {
                schema: null,
                table: stmt.table.name.clone()?,
                name: replace(mut keyNames[k], String.create()),
                doubleQuoted: false,
            },
        );
        columns.push(ResultColumn.Expr(named, null))?;
    }
    for (a in 0..stmt.assignments.length) {
        columns.push(ResultColumn.Expr(cloneExpr(borrow stmt.assignments[a].value)?, null))?;
    }
    let Some(from) = cloneFromClause(borrow stmt.from)? else {
        return Err(sqlError("UPDATE … FROM without a FROM clause"));
    };
    var joins = Vector<Join>.withCapacity(from.joins.length + 1)?;
    joins.push(Join { kind: JoinKind.Comma, natural: false, item: from.source, constraint: JoinConstraint.None })?;
    for (j in 0..from.joins.length) {
        joins.push(cloneJoin(borrow from.joins[j])?)?;
    }
    let target = FromItem.Table(
        TableSource { name: cloneName(borrow stmt.table)?, alias: null, indexedBy: null, notIndexed: false },
    );
    var cores = Vector<SelectCore>.create();
    cores.push(
        SelectCore {
            distinct: false,
            columns: columns,
            from: FromClause { source: target, joins: joins },
            filter: cloneOptional(borrow stmt.filter)?,
            groupBy: Vector<Expr>.create(),
            having: null,
            windows: Vector<NamedWindow>.create(),
            isValues: false,
            columnTexts: Vector<String>.create(),
        },
    )?;
    let select = SelectStmt {
        with: cloneWith(borrow stmt.with)?,
        cores: cores,
        compoundOps: Vector<CompoundOp>.create(),
        orderBy: Vector<OrderTerm>.create(),
        limit: null,
        offset: null,
    };
    var selectCompiler = newCompiler(db)?;
    let plan = compileSelect(mut selectCompiler, borrow select, db)?;
    var selectFrame = newFrame(mut selectCompiler, params, db)?;
    var joined = runSelect(borrow plan, mut selectFrame, db)?;

    let returning = compileReturning(mut compiler, borrow stmt.returning, borrow writer, db)?;
    var frame = newFrame(mut compiler, params, db)?;
    let action = stmt.conflict ?? ConflictAction.Abort;
    var done = Vector<RowKey>.create();
    var doneRowids = HashMap<i64, bool>.create();
    var output = Vector<Vector<SqliteValue>>.create();
    var count: i64 = 0;
    for (r in 0..joined.length) {
        var key = RowKey.Rowid(0);
        if (writer.table.withoutRowid) {
            key = RowKey.Key(cloneValues(joined[r].view()[0..keyLength])?);
        } else {
            let SqliteValue.Integer(rowId) = joined[r][0] else {
                continue;
            };
            key = RowKey.Rowid(rowId);
        }
        var seen = false;
        if (key is RowKey.Rowid(rowId)) {
            seen = doneRowids.contains(rowId);
            doneRowids.put(rowId, true)?;
        } else {
            for (d in 0..done.length) {
                seen = seen || writer.sameRow(borrow done[d], borrow key);
            }
        }
        if (seen) {
            continue;
        }
        if (!writer.loadRow(borrow key, mut frame, db)?) {
            continue;
        }
        if (writer.table.withoutRowid) {
            done.push(key)?;
        }
        var values = Vector<SqliteValue>.withCapacity(targets.length)?;
        for (a in 0..targets.length) {
            values.push(replace(mut joined[r][a + keyLength], SqliteValue.Null))?;
        }
        if (!applyUpdate(borrow writer, targets.view(), values, action, mut frame, db)?) {
            continue;
        }
        count += 1;
        if (returning.length != 0) {
            output.push(returningRow(borrow returning, mut frame, db)?)?;
        }
    }
    writer.finish(mut frame, db)?;
    db.changes = count;
    db.totalChanges += count;
    return Ok(QueryResult { columns: returningNames(borrow stmt.returning, borrow writer.table)?, rows: output });
}
