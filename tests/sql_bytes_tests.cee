// SQL text of any bytes: SQLite takes a statement as bytes, so a string literal keeps every byte, a name may hold
// any byte above 0x7F, and names, definitions and messages carry them on. Each script is written with `\xHH` for a
// byte, fed as bytes to one sqlite3 process on standard input and to one session here (`Session.queryBytes`), and
// the two are compared as `shownText` shows bytes.

/// `text` with each `\xHH` (two lowercase or uppercase hex digits) as the byte HH.
fn unescaped(text: StringView) -> ByteString {
    var out = ByteString.create();
    let bytes = text.bytes();
    var at: usize = 0;
    while (at < bytes.length) {
        if (bytes[at] == '\\' && at + 3 < bytes.length && bytes[at + 1] == 'x') {
            let high = hexDigitOf(bytes[at + 2]);
            let low = hexDigitOf(bytes[at + 3]);
            if (high is Some(h) && low is Some(l)) {
                out.appendByte(h * 16 + l)!;
                at += 4;
                continue;
            }
        }
        out.appendByte(bytes[at])!;
        at += 1;
    }
    return out;
}

fn hexDigitOf(c: u8) -> u8? {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    if (c >= 'a' && c <= 'f') {
        return c - 'a' + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return c - 'A' + 10;
    }
    return null;
}

/// A result as the shell prints it with `.headers on` in list mode: the names, then the rows; nothing for no row.
fn listWithHeaders(result: borrow QueryResult) -> String {
    if (result.rows.length == 0) {
        return String.create();
    }
    var out = ByteString.create();
    for (c in 0..result.columns.length) {
        if (c != 0) {
            out.append("|")!;
        }
        out.appendBytes(result.columns[c].bytes())!;
    }
    out.append("\n")!;
    var text = shownText(out.bytes());
    text.append(listText(result).view())!;
    return text;
}

/// Makes a fresh database at `path` by feeding `script` (with `\xHH` escapes) to the sqlite3 shell.
fn makeDatabaseOfBytes(path: StringView, script: StringView) -> Result<void, TestFailure> {
    freshPath(path);
    var arguments = Vector<StringView>.create();
    arguments.push(path)!;
    let input = unescaped(script);
    let output = Process.capture("sqlite3", borrow arguments, input.bytes())!;
    if (output.status != 0) {
        return Check.fail(shownText(output.stderr.view()).view());
    }
    return Ok();
}

/// Runs `script` (one statement a line, `\xHH` for a byte) through one sqlite3 process and through one session on
/// a database of each engine's own, made by `fixture` in the shell (none when empty); compares what both print,
/// headers and errors included.
fn sameByteSession(name: StringView, fixture: StringView, script: StringView) -> Result<void, TestFailure> {
    var ourPath = String.from("out/bytes-ours-")!;
    ourPath.append(name)!;
    ourPath.append(".db")!;
    var theirPath = String.from("out/bytes-theirs-")!;
    theirPath.append(name)!;
    theirPath.append(".db")!;
    freshPath(ourPath.view());
    freshPath(theirPath.view());
    if (fixture.length != 0) {
        makeDatabaseOfBytes(ourPath.view(), fixture)?;
        makeDatabaseOfBytes(theirPath.view(), fixture)?;
    }
    var input = ByteString.fromText(".headers on\n")!;
    var statements = Vector<ByteString>.create();
    var lines = script.split("\n");
    while (lines.next() is Some(line)) {
        let sql = line.trim();
        if (sql.length == 0) {
            continue;
        }
        let bytes = unescaped(sql);
        input.appendBytes(bytes.bytes())!;
        input.append(";\n")!;
        statements.push(bytes)!;
    }
    var arguments = Vector<StringView>.create();
    arguments.push(theirPath.view())!;
    let output = Process.capture("sqlite3", borrow arguments, input.bytes())!;
    let theirs = shownText(output.stdout.view());
    // Errors, in order, as "error: message"; the shell writes "… near line N: message", then for a parse error
    // the statement and a caret, on lines that start with spaces.
    let errors = shownText(output.stderr.view());
    var errorLines = errors.view().split("\n");
    var theirErrors = String.create();
    while (errorLines.next() is Some(e)) {
        if (!e.startsWith(" ") && e.splitOnce(": ") is Some(halves)) {
            theirErrors.append("error: ")!;
            theirErrors.append(halves.right)!;
            theirErrors.append("\n")!;
        }
    }
    var session = Session.open(ourPath.view())!;
    var mine = String.create();
    var myErrors = String.create();
    let none = Vector<SqliteValue>.create();
    for (i in 0..statements.length) {
        match (session.queryBytes(statements[i].view(), none.view())) {
            Ok(result) => { mine.append(listWithHeaders(borrow result).view())!; }
            Err(e) => {
                myErrors.append("error: ")!;
                myErrors.append(shownText(e.message().bytes()).view())!;
                myErrors.append("\n")!;
            }
        }
    }
    sameLines(theirs.view(), mine.view())?;
    sameLines(theirErrors.view(), myErrors.view())?;
    return expectIntact(ourPath.view());
}

/// Fails at the first line where `mine` differs from `theirs`, naming both.
fn sameLines(theirs: StringView, mine: StringView) -> Result<void, TestFailure> {
    var a = theirs.split("\n");
    var b = mine.split("\n");
    var line: u64 = 0;
    while (true) {
        line += 1;
        let left = a.next();
        let right = b.next();
        if (left.isNull() && right.isNull()) {
            return Ok();
        }
        let l = left ?? "<none>";
        let r = right ?? "<none>";
        if (l != r) {
            var message = String.from("line ")!;
            message.appendNumber(line)!;
            message.append("\n  sqlite3:     ")!;
            message.append(l)!;
            message.append("\n  this engine: ")!;
            message.append(r)!;
            return Check.fail(message.view());
        }
    }
    return Ok();
}

@test
fn stringLiteralsKeepTheirBytes() -> Result<void, TestFailure> {
    return sameByteSession("literals", "", """
        SELECT hex('a\xffb'), length('\xff'), typeof('\xff'), '\xc3' || '\xa9' = 'é'
        SELECT hex('\xf4\x8f\xbe\x80'), hex('\xf4\x8f\xbe'), hex('\xed\xa0\x80'), hex('\xc0\xaf'), hex('\x80')
        CREATE TABLE t(id INTEGER PRIMARY KEY, x TEXT)
        INSERT INTO t(x) VALUES ('\xfe\xff'), ('\xf4\x8f\xbf\xbf'), ('it''s \xff')
        SELECT id, hex(x) FROM t WHERE x = '\xfe\xff' OR x = '\xf4\x8f\xbf\xbf'
        SELECT id, hex(x), quote(x) FROM t ORDER BY x
        SELECT hex(x'41' || '\xff'), hex(printf('%s-\xff', '\xfe')), hex(replace('a\xffa', 'a', '\xfe'))
        SELECT x'41' \xff
        SELECT 1 AS "\xf4\x8f\xbe\x80", 2 AS "\xff", '\xfe'
        SELECT json_extract('{}', '$[\xff')
        SELECT '\xff' nosuch
        """);
}

@test
fn namesKeepTheirBytes() -> Result<void, TestFailure> {
    // The macOS sqlite3 shell runs with legacy_alter_table on.
    return sameByteSession("names", "", """
        PRAGMA legacy_alter_table = ON
        CREATE TABLE "t\xff"(a\xfe INT, "b\xc3" TEXT)
        CREATE TABLE u\xe9\xff(x)
        INSERT INTO "t\xff" VALUES (1, 'x')
        SELECT a\xfe, "b\xc3" FROM "T\xff"
        SELECT * FROM "t\xfe"
        SELECT * FROM u\xe9\xff
        SELECT name, hex(name), sql FROM sqlite_schema ORDER BY name
        PRAGMA table_info("t\xff")
        SELECT name FROM pragma_table_info('t\xff')
        SELECT a\xfe AS "c\xff" FROM "t\xff"
        CREATE INDEX "i\xff" ON "t\xff"(a\xfe)
        PRAGMA index_list("t\xff")
        PRAGMA index_info('i\xff')
        ALTER TABLE "t\xff" RENAME TO "v\xfe"
        ALTER TABLE "v\xfe" RENAME COLUMN a\xfe TO "z\xff"
        ALTER TABLE "v\xfe" ADD COLUMN "n\xf0" DEFAULT '\xf1'
        SELECT type, name, tbl_name, sql FROM sqlite_schema ORDER BY name
        CREATE VIEW "w\xff" AS SELECT "z\xff", "n\xf0" FROM "v\xfe"
        SELECT * FROM "w\xff"
        CREATE TRIGGER "tr\xff" AFTER INSERT ON "v\xfe" WHEN new."z\xff" > 5 BEGIN SELECT RAISE(ABORT, 'no\xff'); END
        INSERT INTO "v\xfe" VALUES (7, 'y', 'z')
        INSERT INTO "v\xfe" VALUES (2, 'y', 'z')
        SELECT * FROM "v\xfe" WHERE nosuch\xff = 1
        SELECT "z\xff" FROM "v\xfe" ORDER BY 1
        CREATE TABLE "V\xfe"(x)
        DROP TRIGGER "tr\xff"
        DROP VIEW "w\xff"
        ALTER TABLE "v\xfe" DROP COLUMN "n\xf0"
        DROP INDEX "i\xff"
        SELECT type, name, tbl_name, sql FROM sqlite_schema ORDER BY name
        ANALYZE
        SELECT hex(tbl), hex(idx) FROM sqlite_stat1 ORDER BY 1
        PRAGMA integrity_check
        """);
}

@test
fn schemasSqliteWroteWithBytesRoundTrip() -> Result<void, TestFailure> {
    // A database whose names and definitions sqlite3 wrote with bytes that are not UTF-8: read here, changed, and
    // read back by sqlite3 (sameByteSession checks the file).
    return sameByteSession("schema", """
        CREATE TABLE "t\xff"(a\xfe INTEGER PRIMARY KEY, "b\xc3" TEXT DEFAULT '\xfd' CHECK ("b\xc3" <> '\xfc'));
        CREATE INDEX "t\xff_b" ON "t\xff"("b\xc3");
        CREATE VIEW "v\xff" AS SELECT a\xfe, "b\xc3" || '\xfb' AS "c\xfa" FROM "t\xff";
        CREATE TRIGGER "g\xff" BEFORE INSERT ON "t\xff" WHEN new."b\xc3" = '\xf9' BEGIN SELECT RAISE(FAIL, '\xf8 refused'); END;
        INSERT INTO "t\xff" VALUES (1, 'one'), (2, '\xf7');
        """, """
        PRAGMA legacy_alter_table = ON
        SELECT a\xfe, hex("b\xc3") FROM "t\xff" ORDER BY "b\xc3"
        SELECT hex("c\xfa") FROM "v\xff" ORDER BY 1
        INSERT INTO "t\xff"(a\xfe) VALUES (3)
        INSERT INTO "t\xff" VALUES (4, '\xfc')
        INSERT INTO "t\xff" VALUES (5, '\xf9')
        SELECT a\xfe FROM "t\xff" WHERE "b\xc3" = '\xfd'
        ALTER TABLE "t\xff" ADD COLUMN "d\xf6" TEXT DEFAULT '\xf5'
        SELECT * FROM "v\xff" ORDER BY 1
        ALTER TABLE "t\xff" RENAME TO "T\xf4"
        SELECT type, name, tbl_name, hex(sql) FROM sqlite_schema ORDER BY name
        PRAGMA integrity_check
        """);
}

@test
fn fileNamesThatAreNotUtf8AreRefused() -> Result<void, TestFailure> {
    // The file system refuses such names here, and SQLite's open fails with them as this does.
    return sameByteSession("files", "", """
        ATTACH 'out/a\xffb.db' AS x
        CREATE TABLE t(a)
        VACUUM INTO 'out/v\xff.db'
        """);
}

@test
fn connectionsTakeSqlOfAnyBytes() -> Result<void, TestFailure> {
    let path = "out/api-bytes.db";
    freshPath(path);
    var connection = Connection.open(path)!;
    connection.executeScriptBytes(unescaped("CREATE TABLE \"t\\xff\"(x); INSERT INTO \"t\\xff\" VALUES ('\\xfe')").view())!;
    var params = Params.create();
    params.bindBytes(unescaped(":p\\xff").view(), SqliteValue.text("given")!)!;
    let none = Params.create();
    Check.isTrue(
        connection.executeBytes(unescaped("INSERT INTO \"t\\xff\" VALUES (:p\\xff)").view(), borrow params)! == 1,
        "a parameter whose name is not UTF-8",
    )?;
    let value = connection.scalarBytes(unescaped("SELECT hex(group_concat(x, '\\xfd')) FROM \"t\\xff\"").view(), borrow none)!;
    Check.isTrue(value is Some(SqliteValue.Text(_)), "a text")?;
    if (value is Some(SqliteValue.Text(t))) {
        Check.equalText("FEFD676976656E", t.toUtf8() ?? "")?;
    }
    let result = connection.queryBytes(unescaped("SELECT x AS \"c\\xff\" FROM \"t\\xff\" LIMIT 1").view(), borrow none)!;
    Check.isTrue(result.columns[0].bytes() == unescaped("c\\xff").bytes(), "a column name keeps its bytes")?;
    match (connection.queryBytes(unescaped("SELECT * FROM \"u\\xff\"").view(), borrow none)) {
        Ok(_) => { return Check.fail("expected no such table"); }
        Err(e) => {
            Check.isTrue(e.message().bytes() == unescaped("no such table: u\\xff").bytes(), "the message keeps the name's bytes")?;
            Check.equalText("no such table: u\u{FFFD}", e.messageText()!.view())?;
        }
    }
    // The StringView forms take text that is UTF-8, whatever it holds: U+10FF80 is a character like any other.
    let real = connection.scalar("SELECT hex('\u{10FF80}')", borrow none)!;
    if (real is Some(SqliteValue.Text(t))) {
        Check.equalText("F48FBE80", t.toUtf8() ?? "")?;
    } else {
        return Check.fail("expected a text");
    }
    connection.close()!;
    return expectIntact(path);
}

// ── UTF-16 databases ─────────────────────────────────────────────────────────────────────────────────────────

const UTF16_QUERIES: StringView = """
    SELECT hex(a), hex(b), length(a), length(b), length(CAST(a AS BLOB)), quote(a), quote(b), octet_length(a) FROM t ORDER BY id
    SELECT hex(substr(CAST(a AS BLOB), 1, 3)), substr(a, 1, 3), hex(CAST(CAST(b AS TEXT) AS BLOB)), CAST(b AS TEXT) = a FROM t ORDER BY id
    SELECT hex('é'), hex(x'c3a9'), CAST(x'e900' AS TEXT), hex(CAST(x'e900' AS TEXT)), length(x'e900'), octet_length('é')
    SELECT hex(12), octet_length(12), hex(CAST(12 AS BLOB)), hex(CAST(1.5 AS BLOB)), hex(1.5), octet_length(1.5)
    SELECT hex(a || 'x'), hex(upper(a)), instr(CAST(a AS BLOB), x'6c'), hex(replace(a, 'l', 'L')), hex(printf('%s', a)) FROM t ORDER BY id
    SELECT typeof(CAST(a AS BLOB)), CAST(a AS BLOB) = b, hex(json_quote(a)), hex(lower(a)) FROM t ORDER BY id
    SELECT hex(group_concat(a, '|')) FROM (SELECT a FROM t ORDER BY id)
    SELECT hex(x'6100' || 'b'), length(x'6100' || 'b'), upper(x'6100'), CAST(x'6100' AS TEXT) = 'a', hex(substr(x'61006200', 2))
    SELECT hex(quote(x'61')), hex(quote('a')), unhex('6100') = CAST('a' AS BLOB), instr(x'68006c00', x'6c00'), instr('héllo', 'l')
    SELECT unicode(x'e900'), hex(replace(x'6100', 'a', 'b')), hex(trim(x'20006100')), hex(lower(x'4100')), printf('%s', x'6100')
    SELECT CAST(x'3100' AS INTEGER), hex(group_concat(x'6100'))
    SELECT group_concat(hex(CAST(column1 AS BLOB)), ' ') FROM (SELECT column1 FROM (VALUES ('a'), ('Ā'), ('😀'), ('￿'), ('b'), ('ab'), ('aĀ')) ORDER BY 1)
    SELECT 'a' < 'Ā', hex(max('a', 'Ā')), hex(min('a', 'Ā')), 'ab' < 'aĀ', '😀' < '' COLLATE NOCASE, '😀' < ''
    SELECT id FROM t ORDER BY a
    SELECT id FROM t ORDER BY a DESC
    SELECT id, hex(a) FROM t WHERE a > 'h' ORDER BY a
    SELECT hex(min(a)), hex(max(a)) FROM t
    SELECT id FROM t INDEXED BY ta WHERE a >= 'a' ORDER BY a
    SELECT id FROM t INDEXED BY ta WHERE a = 'Ā'
    SELECT a FROM t GROUP BY a ORDER BY 1
    SELECT a FROM t UNION SELECT 'zz' ORDER BY 1
    SELECT a, row_number() OVER (ORDER BY a) FROM t ORDER BY 2
    """;

const UTF16_FIXTURE_ROWS: StringView = """
    CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT, b BLOB);
    CREATE INDEX ta ON t(a);
    INSERT INTO t VALUES (1, 'héllo', CAST('héllo' AS BLOB)), (2, 'a', x'6100'), (3, 'Ā', NULL), (4, '😀', x'3dd800de');
    INSERT INTO t VALUES (5, '￿', NULL), (6, 'ab', NULL), (7, 'aĀ', NULL), (8, 'zebra', NULL);
    """;

/// A UTF-16 fixture of `UTF16_FIXTURE_ROWS`, made by sqlite3.
fn makeUtf16Database(path: StringView, encoding: StringView) -> Result<void, TestFailure> {
    var script = String.from("PRAGMA encoding = '")!;
    script.append(encoding)!;
    script.append("';\n")!;
    script.append(UTF16_FIXTURE_ROWS)!;
    makeDatabase(path, script.view())?;
    return Ok();
}

@test
fn utf16TextMeetsBytesAsInSqlite() -> Result<void, TestFailure> {
    // In a UTF-16 database SQLite holds text in the database's encoding: hex(), CAST AS BLOB, octet_length() and
    // blob comparisons see those bytes, a blob read as text is read in it, and BINARY orders by its bytes.
    let le = "out/utf16-functions-le.db";
    makeUtf16Database(le, "UTF-16le")?;
    sameAnswers(le, UTF16_QUERIES)?;
    let be = "out/utf16-functions-be.db";
    makeUtf16Database(be, "UTF-16be")?;
    return sameAnswers(be, UTF16_QUERIES);
}

const UTF16_WRITES: StringView = """
    INSERT INTO t(a, b) VALUES ('wörld', CAST('wörld' AS BLOB)), ('Ā2', x'0001'), ('😀😀', NULL), ('', '')
    UPDATE t SET b = CAST(a AS BLOB) WHERE b IS NULL
    INSERT INTO t(a) SELECT a || '!' FROM t WHERE id < 5
    DELETE FROM t WHERE a = 'zebra'
    CREATE TABLE "naïve"(k TEXT PRIMARY KEY, v) WITHOUT ROWID
    INSERT INTO "naïve" SELECT a, id FROM t
    CREATE INDEX "naïve_v" ON "naïve"(v, k)
    CREATE UNIQUE INDEX tb ON t(b)
    SELECT id, hex(a), hex(b) FROM t ORDER BY a
    SELECT hex(k), v FROM "naïve" ORDER BY k DESC
    SELECT name, hex(name), sql FROM sqlite_schema ORDER BY name
    ALTER TABLE t ADD COLUMN c TEXT DEFAULT 'défaut'
    SELECT hex(c) FROM t LIMIT 1
    ATTACH 'out/bytes-utf8-other.db' AS o
    SELECT id, hex(a) FROM t ORDER BY a
    PRAGMA encoding
    PRAGMA integrity_check
    """;

@test
fn utf16DatabasesAreWrittenInTheirEncoding() -> Result<void, TestFailure> {
    // The C# wrote text into a UTF-16 database's records as UTF-8, and its indexes in UTF-8 order.
    let other = "out/bytes-utf8-other.db";
    makeDatabase(other, "CREATE TABLE x(y)")?;
    var le = String.from("PRAGMA encoding = 'UTF-16le';\n")!;
    le.append(UTF16_FIXTURE_ROWS)!;
    sameByteSession("utf16le", le.view(), UTF16_WRITES)?;
    var be = String.from("PRAGMA encoding = 'UTF-16be';\n")!;
    be.append(UTF16_FIXTURE_ROWS)!;
    return sameByteSession("utf16be", be.view(), UTF16_WRITES);
}
