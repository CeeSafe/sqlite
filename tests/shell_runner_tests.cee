// Running the sqlite3 shell (and the few other programs the tests start) on every system. On macOS and Linux this
// is lib/std's `Process.capture` and `Process.run`. On Windows neither can run the shell at ceesafec 0.95.5
// (CEESAFE_FINDINGS.md 45 and 46): `Process.capture` keeps its input file open for writing while the runtime opens
// it again to read, which Windows refuses, so it always fails; `Process.run` hands the arguments to `_wspawnvp`,
// which joins them with spaces without quoting, so an argument of SQL arrives as many words. `Process.spawn`
// quotes its arguments but cannot send a child's streams to files, and a package cannot call the runtime's
// `ceesafe_host_spawn` itself (N0292). So on Windows `tests/capture.py`, started by `Process.spawn`, runs the
// program with its streams in files.

/// The setting under which the sqlite3 shell lets `PRAGMA writable_schema = ON` change sqlite_schema, which the
/// tests do to make damaged databases: sqlite.org's shell runs in defensive mode, which forbids it, and Apple's
/// does not. As an argument before the SQL; it prints the setting.
const SCHEMA_WRITABLE: StringView = ".dbconfig defensive off";

/// Whether the sqlite3 on the path is Apple's build (its source id ends in "aapl"). The engine follows sqlite.org's
/// SQLite 3.54.1, which CI runs; Apple's sqlite3 3.54.0, from an earlier snapshot of SQLite, answers a few
/// statements differently. Where a comparison meets one of them with Apple's shell, the engine is checked against
/// sqlite.org's answer (`officialAnswerWhereAppleDiffers`) instead of Apple's; with sqlite.org's shell every
/// answer is the shell's.
fn sqliteIsApples() -> bool {
    var arguments = Vector<StringView>.create();
    arguments.push(":memory:")!;
    arguments.push("SELECT sqlite_source_id()")!;
    return match (captureSqlite(borrow arguments, "".bytes())) {
        Ok(output) => withoutCarriageReturns(output.stdout.view()).view().endsWith("aapl\n".bytes()),
        Err(_) => false,
    };
}

/// sqlite.org's sqlite3 3.54.1's answer to `sql` on the database at `path`, as the tests show answers, where
/// Apple's 3.54.0 gives another:
/// - U+FFFE and U+FFFF are characters (Apple's reads them as U+FFFD);
/// - an empty printf() result is '' (Apple's gives NULL);
/// - a time of 24:00:00 is the next day's midnight, and 24 with other minutes or seconds is no time;
/// - `t.*` in a RIGHT or FULL join is the table's own columns (Apple's coalesces those USING or NATURAL shares);
/// - PRAGMA data_version starts at 1 (Apple's at 2);
/// - a checkpoint by a connection opened read-only fails as it writes the database, "disk I/O error" (Apple's
///   refuses it first, "attempt to write a readonly database").
fn officialAnswerWhereAppleDiffers(path: StringView, sql: StringView, theirs: StringView) -> String? {
    var k: usize = 0;
    while (k + 3 < APPLE_DIFFERS.length) {
        if ((APPLE_DIFFERS[k].length == 0 || APPLE_DIFFERS[k] == path) && APPLE_DIFFERS[k + 1] == sql &&
            APPLE_DIFFERS[k + 2] == theirs) {
            return String.from(APPLE_DIFFERS[k + 3])!;
        }
        k += 4;
    }
    return null;
}

/// The statements of `officialAnswerWhereAppleDiffers`, four entries each: the database (any if empty), the
/// statement, Apple's answer and sqlite.org's. sqlite.org's stands in only when Apple's shell gave exactly the
/// answer recorded for it.
const APPLE_DIFFERS: [StringView; 60] = [
    "out/ro-connection.db",
    "PRAGMA wal_checkpoint(TRUNCATE)",
    "error: attempt to write a readonly database\n",
    "error: disk I/O error\n",
    "out/lock-data-version.db",
    "PRAGMA data_version",
    "2\n",
    "1\n",
    "",
    "SELECT date('2024-02-29 24:00'), datetime('2024-02-29 24:00:00.5'), datetime('2024-12-31 24:00', 'start of day'), datetime('2024-02-29 24:30'), time('24:59:59'), time('24:00:00.000'), datetime('2024-02-29 13:45:30', '+24:30')",
