// What the front ends (the shell in cli/, the PostgreSQL wire server in pgwire/) need beyond the connection API.

impl SqliteValue {
    /// The value as SQLite gives it as text (sqlite3_column_text, `CAST(v AS TEXT)`): NULL as the empty text, an
    /// integer in decimal, a real as SQLite writes it (`%!.15g`: `2.0`, `0.3`, `1.0e+20`), a text's or a blob's
    /// bytes as they are, UTF-8 or not (`toUtf8()` or `toUtf8Lossy()` on the result to get a `String`).
    public fn toText(borrow this) -> Result<ByteString, AllocError> => valueText(this);
}
