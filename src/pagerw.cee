// The writable pager: a transaction's view of a database's pages. Pages are changed in memory; `commit` journals
// the old ones, writes the new, and removes the journal; in WAL mode it appends the new ones to the write-ahead
// log instead (wal.cee). Freed pages go to SQLite's freelist and are used again.
// https://www.sqlite.org/fileformat2.html#the_freelist
//
// Differences from the C# engine, which this replaces:
// - a database that keeps pointer-map pages (auto-vacuum or incremental vacuum) is refused. The C# changed its
//   b-trees without updating the pointer map, which SQLite then finds in disagreement with the file;
// - in WAL mode one pager does both: reads see the log, commits append to it. The C# had a second pager for WAL
//   mode (WalPager), whose freelist made every freed page a trunk and checked no page number it read;
// - in WAL mode page 1 is written only when a commit changes it, as SQLite does, so a commit's frames are the
//   pages SQLite would write;
// - page numbers and counts read from the freelist are checked, so a damaged freelist is `Corrupt` instead of a
//   page handed out twice;
// - a freed page becomes a leaf of the first trunk page while that has room. The C# made every freed page a
//   trunk of its own, which is a valid freelist but touches the header for each page;
// - the page that holds SQLite's lock bytes is never allocated;
// - `rollback` forgets a transaction's changes. The C# pager could only be thrown away.

/// SQLite's default for PRAGMA wal_autocheckpoint, in frames.
const WAL_DEFAULT_AUTOCHECKPOINT: u32 = 1000;

struct WritablePager {
    private file: File;
    /// The write-ahead log; commits go to it in WAL mode.
    private wal: WalLog;
    private walMode: bool;
    /// The number of pages in the database file itself, which in WAL mode may be fewer than the database has.
    private filePages: u32;
    /// A commit that leaves this many frames or more in the log checkpoints it; 0 never does.
    autoCheckpoint: u32;
    private path: String;
    pageSize: usize;
    usable: usize;
    textEncoding: TextEncoding;
    /// The number of pages the database has in this transaction.
    pageCount: u32;
    // The state at the last commit, which `rollback` returns to and the journal restores.
    private committedPageCount: u32;
    private committedFreeTrunk: u32;
    private committedFreeCount: u32;
    private changeCounter: u32;
    private freeTrunk: u32;
    private freeCount: u32;
    // The pages the transaction has looked at: `slots` says where in `pages` each one is.
    private slots: HashMap<u32, usize>;
    private pages: Vector<Vector<u8>>;
    private preImages: HashMap<u32, Vector<u8>>;
    private dirty: HashMap<u32, bool>;
    /// A statement in progress: each page's content when it began, saved before its first change.
    private statement: StatementUndo?;

    /// Opens the database at `path` for changes, first undoing a commit that was interrupted.
    fn open(path: StringView) -> Result<WritablePager, SqliteError> {
        let _ = Journal.recover(path)?;
        var file = File.openReadWrite(path)?;
        var bytes = Vector<u8>.create();
        bytes.resize(100, 0)?;
        if (!readFully(mut file, bytes.viewMut(), 0)?) {
            return Err(notADatabase("file is too small to be a SQLite database"));
        }
        let fileHeader = DatabaseHeader.parse(bytes.view())?;
        let pages = file.length()? / (fileHeader.pageSize as u64);
        let filePages = checkedTruncate<u32>(pages) ?? {
            return Err(corrupt("database file has more pages than the format allows"));
        };
        // A log with commits in it is part of the database, whatever mode the file's header names, as in SQLite.
        var wal = WalLog.open(path, true)?;
        var pageCount = filePages;
        if (wal.hasFrames()) {
            if (wal.pageSize != fileHeader.pageSize) {
                return Err(corrupt("the write-ahead log's page size is not the database's"));
            }
            var page = Vector<u8>.create();
            page.resize(wal.pageSize, 0)?;
            if (wal.readPage(1, page.viewMut())?) {
                bytes.viewMut().copyFrom(page.view()[0..100]);
            }
            pageCount = wal.databasePages;
        }
        let header = DatabaseHeader.parse(bytes.view())?;
        if (header.pageSize != fileHeader.pageSize) {
            return Err(corrupt("the write-ahead log's page 1 gives another page size"));
        }
        if (bytes[18] > 2 || bytes[19] > 2) {
            return Err(unsupported("the database's file format is newer than this engine"));
        }
        let walMode = bytes[18] == 2 || bytes[19] == 2 || wal.hasFrames();
        if (bytes.view().readBE<u32>(52) != 0) {
            return Err(unsupported("databases with auto-vacuum or incremental vacuum cannot be written"));
        }
        if (header.schemaFormat > 4) {
            return Err(unsupported("the database's schema format is newer than this engine"));
        }
        return Ok(WritablePager {
            file: file,
            wal: wal,
            walMode: walMode,
            filePages: filePages,
            autoCheckpoint: WAL_DEFAULT_AUTOCHECKPOINT,
            path: String.from(path)?,
            pageSize: header.pageSize,
            usable: header.usableSize(),
            textEncoding: header.textEncoding,
            pageCount: pageCount,
            committedPageCount: pageCount,
            committedFreeTrunk: header.firstFreelistTrunkPage,
            committedFreeCount: header.freelistPageCount,
            changeCounter: header.fileChangeCounter,
            freeTrunk: header.firstFreelistTrunkPage,
            freeCount: header.freelistPageCount,
            slots: HashMap<u32, usize>.create(),
            pages: Vector<Vector<u8>>.create(),
            preImages: HashMap<u32, Vector<u8>>.create(),
            dirty: HashMap<u32, bool>.create(),
            statement: null,
        });
    }

    /// The file's path, as it was opened.
    fn filePath(borrow this) -> StringView => this.path.view();

    /// Whether the transaction has changed anything.
    fn hasChanges(borrow this) -> bool => this.dirty.length() != 0;

    /// The number of pages the transaction has changed.
    fn changedPages(borrow this) -> usize => this.dirty.length();

    /// The first trunk page of the freelist, and the number of pages on it, as the transaction sees them.
    fn freelistTrunk(borrow this) -> u32 => this.freeTrunk;

    fn freelistCount(borrow this) -> u32 => this.freeCount;

    /// The number of pages the file held at the last commit.
    fn committedPages(borrow this) -> u32 => this.committedPageCount;

    /// The page that holds SQLite's lock bytes, which no b-tree may use.
    private fn pendingPage(borrow this) -> u32 => truncate<u32>(PENDING_BYTE / (this.pageSize as u64)) + 1;

    private fn load(borrow mut this, number: u32) -> Result<void, SqliteError> {
        if (number < 1 || number > this.pageCount) {
            return Err(corrupt("a page pointer leads outside the database file"));
        }
        if (this.slots.contains(borrow number)) {
            return Ok();
        }
        var bytes = Vector<u8>.create();
        bytes.resize(this.pageSize, 0)?;
        if (number <= this.committedPageCount) {
            if (this.walMode && this.wal.readPage(number, bytes.viewMut())?) {
                // The log's latest committed frame of the page.
            } else if (this.walMode && number > this.filePages) {
                // Past the end of the file and in no frame: zeros, as SQLite reads it.
            } else {
                let offset = ((number - 1) as u64) * (this.pageSize as u64);
                if (!readFully(mut this.file, bytes.viewMut(), offset)?) {
                    return Err(corrupt("database file ends inside a page"));
                }
            }
        }
        let slot = this.pages.length;
        this.pages.push(bytes)?;
        let _ = this.slots.put(number, slot)?;
        return Ok();
    }

    /// Where page `number`, which is loaded, is in `pages`.
    private fn slotOf(borrow this, number: u32) -> usize => *this.slots.get(borrow number)!;

    /// Page `number` as the transaction sees it.
    fn read(borrow mut this, number: u32) -> Result<Slice<u8>, SqliteError> {
        this.load(number)?;
        return Ok(this.pages[this.slotOf(number)].view());
    }

    /// A copy of page `number`, for code that reads other pages while it looks at this one.
    fn copy(borrow mut this, number: u32) -> Result<Vector<u8>, SqliteError> {
        this.load(number)?;
        return Ok(this.pages[this.slotOf(number)].clone()?);
    }

    /// Page `number`, to change. Its old image is kept for the journal.
    fn write(borrow mut this, number: u32) -> Result<SliceMut<u8>, SqliteError> {
        this.load(number)?;
        if (borrow mut this.statement is Some(undo)) {
            if (!undo.saved.contains(borrow number)) {
                let image = this.pages[*this.slots.get(borrow number)!].clone()?;
                let wasDirty = this.dirty.contains(borrow number);
                let _ = undo.saved.put(number, SavedPage { image: image, wasDirty: wasDirty })?;
            }
        }
        if (number <= this.committedPageCount && !this.preImages.contains(borrow number)) {
            let image = this.pages[this.slotOf(number)].clone()?;
            let _ = this.preImages.put(number, image)?;
        }
        let _ = this.dirty.put(number, true)?;
        let slot = this.slotOf(number);
        return Ok(this.pages[slot].viewMut());
    }

    /// The number of page numbers a freelist trunk page can hold. SQLite keeps six slots unused, for the sake
    /// of old versions of itself.
    private fn trunkCapacity(borrow this) -> usize => this.usable / 4 - 8;

    /// A zeroed page: one from the freelist if it has any, else a new one at the end of the file.
    fn allocatePage(borrow mut this) -> Result<u32, SqliteError> {
        if (this.freeTrunk != 0) {
            let trunkNumber = this.freeTrunk;
            let mostLeaves = this.usable / 4 - 2;
            let next = this.read(trunkNumber)?.readBE<u32>(0);
            let leaves = this.read(trunkNumber)?.readBE<u32>(4) as usize;
            if (leaves > mostLeaves) {
                return Err(corrupt("a freelist trunk page claims more leaves than fit in it"));
            }
            var taken = trunkNumber;
            if (leaves > 0) {
                taken = this.read(trunkNumber)?.readBE<u32>(8 + (leaves - 1) * 4);
                if (taken < 2 || taken > this.pageCount || taken == trunkNumber) {
                    return Err(corrupt("the freelist names a page outside the database file"));
                }
                this.write(trunkNumber)?.writeBE(4, truncate<u32>(leaves - 1));
            } else {
                // A trunk without leaves is itself the page to use; the next trunk heads the list.
                if (next > this.pageCount || next == trunkNumber) {
                    return Err(corrupt("the freelist names a page outside the database file"));
                }
                this.freeTrunk = next;
            }
            this.freeCount = this.freeCount.saturatingSub(1);
            this.write(taken)?.fill(0);
            return Ok(taken);
        }
        var number = this.pageCount;
        loop {
            if (number >= 4294967294) {
                return Err(unsupported("the database would have more pages than the file format allows"));
            }
            number += 1;
            var bytes = Vector<u8>.create();
            bytes.resize(this.pageSize, 0)?;
            let slot = this.pages.length;
            this.pages.push(bytes)?;
            let _ = this.slots.put(number, slot)?;
            let _ = this.dirty.put(number, true)?;
            this.pageCount = number;
            if (number != this.pendingPage()) {
                return Ok(number);
            }
        }
    }

    /// Puts page `number` on the freelist: nothing refers to it any more.
    fn freePage(borrow mut this, number: u32) -> Result<void, SqliteError> {
        if (number < 2 || number > this.pageCount) {
            return Err(corrupt("a page to free is outside the database file"));
        }
        if (this.freeTrunk != 0) {
            let trunkNumber = this.freeTrunk;
            let leaves = this.read(trunkNumber)?.readBE<u32>(4) as usize;
            if (leaves < this.trunkCapacity()) {
                let trunk = this.write(trunkNumber)?;
                trunk.writeBE(8 + leaves * 4, number);
                trunk.writeBE(4, truncate<u32>(leaves + 1));
                this.freeCount += 1;
                return Ok();
            }
        }
        // The page becomes a trunk, at the head of the list.
        let previous = this.freeTrunk;
        let page = this.write(number)?;
        page.fill(0);
        page.writeBE(0, previous);
        this.freeTrunk = number;
        this.freeCount += 1;
        return Ok();
    }

    /// Adds one to the schema cookie, so that other connections read the schema again.
    fn bumpSchemaCookie(borrow mut this) -> Result<void, SqliteError> {
        let header = this.write(1)?;
        let cookie = header.readBE<u32>(40);
        header.writeBE(40, cookie.wrappingAdd(1));
        return Ok();
    }

    /// Starts a statement: `rollbackStatement` can then undo its changes alone.
    fn beginStatement(borrow mut this) {
        this.statement = StatementUndo {
            saved: HashMap<u32, SavedPage>.create(),
            pageCount: this.pageCount,
            freeTrunk: this.freeTrunk,
            freeCount: this.freeCount,
        };
    }

    /// Keeps the statement's changes in the transaction.
    fn endStatement(borrow mut this) {
        this.statement = null;
    }

    /// Undoes the statement's changes, leaving the transaction as it was before it.
    fn rollbackStatement(borrow mut this) -> Result<void, SqliteError> {
        let Some(undo) = replace(mut this.statement, null) else {
            return Ok();
        };
        var saved = undo.saved;
        for (i in 0..saved.length()) {
            let number = *saved.keyAt(i);
            if (number > undo.pageCount) {
                continue;
            }
            let slot = *this.slots.get(borrow number)!;
            let page = saved.getMut(borrow number)!;
            this.pages[slot] = replace(mut page.image, Vector<u8>.create());
            if (!page.wasDirty) {
                let _ = this.dirty.remove(borrow number);
            }
        }
        // Pages added by the statement are gone again.
        var gone = Vector<u32>.create();
        for (i in 0..this.dirty.length()) {
            let number = *this.dirty.keyAt(i);
            if (number > undo.pageCount) {
                gone.push(number)?;
            }
        }
        for (i in 0..gone.length) {
            let _ = this.dirty.remove(borrow gone[i]);
            let _ = this.slots.remove(borrow gone[i]);
        }
        this.pageCount = undo.pageCount;
        this.freeTrunk = undo.freeTrunk;
        this.freeCount = undo.freeCount;
        return Ok();
    }

    /// Forgets everything the transaction changed.
    fn rollback(borrow mut this) {
        this.statement = null;
        this.slots.clear();
        this.pages.clear();
        this.preImages.clear();
        this.dirty.clear();
        this.pageCount = this.committedPageCount;
        this.freeTrunk = this.committedFreeTrunk;
        this.freeCount = this.committedFreeCount;
    }

    /// Makes the transaction's changes durable, as one step: after a crash the database holds all of them or
    /// none.
    fn commit(borrow mut this) -> Result<void, SqliteError> {
        if (this.dirty.length() == 0) {
            return Ok();
        }
        let pageCount = this.pageCount;
        let freeTrunk = this.freeTrunk;
        let freeCount = this.freeCount;
        // In WAL mode, as in SQLite, page 1 is written only when the commit changes it: its size or freelist
        // fields, or anything else on it. A rollback-journal commit always counts a change in it.
        let first: u32 = 1;
        let headerChanged = this.dirty.contains(borrow first) || pageCount != this.committedPageCount ||
            freeTrunk != this.committedFreeTrunk || freeCount != this.committedFreeCount;
        var counter = this.changeCounter;
        if (!this.walMode || headerChanged) {
            counter = counter.wrappingAdd(1);
            let header = this.write(1)?;
            header.writeBE(24, counter);
            header.writeBE(28, pageCount);
            header.writeBE(32, freeTrunk);
            header.writeBE(36, freeCount);
            // The version-valid-for number says the in-header size is current.
            header.writeBE(92, counter);
            header.writeBE(96, WRITER_SQLITE_VERSION);
        }

        if (this.walMode) {
            this.commitToLog(pageCount)?;
        } else {
            var journal = JournalWriter.begin(this.path.view(), this.pageSize, this.committedPageCount)?;
            for (i in 0..this.preImages.length()) {
                journal.add(*this.preImages.keyAt(i), this.preImages.valueAt(i).view())?;
            }
            journal.finish()?;
            for (i in 0..this.dirty.length()) {
                let number = *this.dirty.keyAt(i);
                let offset = ((number - 1) as u64) * (this.pageSize as u64);
                let slot = this.slotOf(number);
                this.file.writeAt(this.pages[slot].view(), offset)?;
            }
            this.file.setLength((pageCount as u64) * (this.pageSize as u64))?;
            this.file.syncAll()?;
            Journal.remove(this.path.view())?;
            this.filePages = pageCount;
        }

        this.changeCounter = counter;
        this.committedPageCount = pageCount;
        this.committedFreeTrunk = freeTrunk;
        this.committedFreeCount = freeCount;
        this.preImages.clear();
        this.dirty.clear();
        // SQLite's automatic checkpoint: a passive one once the log holds wal_autocheckpoint frames.
        if (this.walMode && this.autoCheckpoint != 0 && this.wal.frames >= this.autoCheckpoint) {
            let _ = this.checkpoint(false)?;
        }
        return Ok();
    }

    /// Appends the changed pages to the log, in page order, the last frame marking the commit.
    private fn commitToLog(borrow mut this, pageCount: u32) -> Result<void, SqliteError> {
        var numbers = Vector<u32>.withCapacity(this.dirty.length())?;
        for (i in 0..this.dirty.length()) {
            numbers.push(*this.dirty.keyAt(i))?;
        }
        numbers.sortBy((a, b) => if (*a < *b) -1 else if (*a > *b) 1 else 0);
        this.wal.beginCommit(this.pageSize)?;
        for (k in 0..numbers.length) {
            let number = numbers[k];
            let commitSize = if (k + 1 == numbers.length) pageCount else 0;
            let slot = this.slotOf(number);
            this.wal.addFrame(number, this.pages[slot].view(), commitSize)?;
        }
        this.wal.finishCommit(pageCount)?;
        return Ok();
    }

    /// Whether the database is in WAL mode: commits go to its write-ahead log.
    fn inWalMode(borrow this) -> bool => this.walMode;

    /// Copies the log's committed pages into the database file (SQLite's checkpoint), and with `truncate` empties
    /// the log. The transaction must have no changes.
    fn checkpoint(borrow mut this, truncate: bool) -> Result<WalCheckpoint, SqliteError> {
        assert(this.dirty.length() == 0, "a checkpoint is made between transactions");
        if (!this.walMode) {
            return Ok(WalCheckpoint { logFrames: -1, checkpointed: -1 });
        }
        this.wal.checkpoint(mut this.file)?;
        if (this.wal.hasFrames()) {
            this.filePages = this.wal.databasePages;
        }
        let result = WalCheckpoint { logFrames: this.wal.frames as i64, checkpointed: this.wal.backfilled as i64 };
        if (truncate) {
            this.wal.truncate()?;
            return Ok(WalCheckpoint { logFrames: 0, checkpointed: 0 });
        }
        return Ok(result);
    }

    /// Puts the database in WAL mode: the header's format numbers become 2, in a commit of their own.
    fn enterWalMode(borrow mut this) -> Result<void, SqliteError> {
        if (this.walMode) {
            return Ok();
        }
        let header = this.write(1)?;
        header[18] = 2;
        header[19] = 2;
        this.commit()?;
        this.walMode = true;
        return Ok();
    }

    /// Leaves WAL mode for a rollback journal: the log is checkpointed and removed, and the header's format
    /// numbers become 1.
    fn leaveWalMode(borrow mut this) -> Result<void, SqliteError> {
        if (!this.walMode) {
            return Ok();
        }
        let _ = this.checkpoint(false)?;
        this.wal.remove()?;
        this.walMode = false;
        let header = this.write(1)?;
        header[18] = 1;
        header[19] = 1;
        this.commit()?;
        return Ok();
    }

    /// Ends the connection: a transaction in progress is forgotten and, as SQLite does when its last connection
    /// closes, a write-ahead log is checkpointed and removed.
    fn close(this) -> Result<void, SqliteError> {
        var me = this;
        me.rollback();
        if (me.walMode) {
            let _ = me.checkpoint(false)?;
            me.wal.remove()?;
        }
        return Ok();
    }
}

impl PageSource for WritablePager {
    fn readPage(borrow mut this, number: u32) -> Result<Page, SqliteError> {
        let bytes = this.copy(number)?;
        return Ok(Page { bytes: Arc<Vector<u8>>.create(bytes)? });
    }

    fn usableSize(borrow this) -> usize => this.usable;

    fn textEncoding(borrow this) -> TextEncoding => this.textEncoding;

    fn totalPages(borrow this) -> u32 => this.pageCount;
}

impl PageSink for WritablePager {
    fn usableBytes(borrow this) -> usize => this.usable;

    fn allocate(borrow mut this) -> Result<u32, SqliteError> => this.allocatePage();

    fn pageMut(borrow mut this, number: u32) -> Result<SliceMut<u8>, SqliteError> {
        let usable = this.usable;
        let page = this.write(number)?;
        return Ok(borrow mut page[0..usable]);
    }
}

/// A page's content before a statement changed it.
struct SavedPage {
    image: Vector<u8>;
    wasDirty: bool;
}

struct StatementUndo {
    saved: HashMap<u32, SavedPage>;
    pageCount: u32;
    freeTrunk: u32;
    freeCount: u32;
}
