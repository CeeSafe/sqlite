// The JSON functions, answered by this engine and by the sqlite3 shell, compared as the shell prints them.

@test
fn jsonParsesAndMinifies() -> Result<void, TestFailure> {
    let path = "out/json-parse.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json(' { "a" : [1, 2.50, -3e2, true, false, null] , "b" : {} } ')
        SELECT json('[]'), json('{}'), json('"x"'), json('123'), json(' 1.0 '), json('null'), json('true')
        SELECT json('{"a":1,"a":2}'), json('{"a":1,"a":2}') -> '$.a', json_extract('{"a":1,"a":2}', '$.a')
        SELECT json(1), json(1.5), json(-0.0), json(1e999), json(-1e999), json('1e999'), json('-1E+999')
        SELECT json('[0, -0, 0.0, -0.0, 1e5, 1E-5, 1.5e+300, 123456789012345678901234567890]')
        SELECT json('9223372036854775807') + 0, json_extract('[9223372036854775807, 9223372036854775808, -9223372036854775808, -9223372036854775809]', '$[0]', '$[1]', '$[2]', '$[3]')
        SELECT json_extract('9223372036854775808', '$'), json_extract('-9223372036854775808', '$'), json_extract('-9223372036854775809', '$'), json_extract('1e400', '$'), json_extract('-1e400', '$')
        SELECT json_extract('1e-400', '$'), json_extract('2.2250738585072014e-308', '$'), json_extract('4.9e-324', '$'), json_extract('0.1', '$'), json_extract('-0.0', '$'), json_extract('-0', '$')
        SELECT typeof(json_extract('[1, 1.0, "1", true, null, [], {}]', '$[0]')), typeof(json_extract('[1.0]', '$[0]')), typeof(json_extract('[true]', '$[0]')), typeof(json_extract('[null]', '$[0]'))
        SELECT json('[1,2,3]') = '[1,2,3]', length(json('[ 1 , 2 ]'))
        SELECT json('"éA\n\t\"\\\/"'), json_extract('"éA\n\t\"\\\/"', '$')
        SELECT json_quote('a"b\c' || char(10) || char(1) || char(31) || char(127) || 'é'), json_quote(char(8, 9, 12, 13, 0x1f600))
        SELECT json_quote(1), json_quote(-1.5), json_quote(NULL), json_quote(1e999), json_quote(-1e999), json_quote(0.1), json_quote(1e300), json_quote(123456789.123)
        SELECT json_quote(json('[1]')), json_quote('[1]'), json_quote(json_quote('x')), json_quote(x'00')
        SELECT json_quote(x'01'), json_quote(x'abcd')
        SELECT json_array(), json_array(1, 2.5, 'x', NULL), json_array('[1]', json('[1]')), json_array(1e999, -1e999, 0.0, -0.0)
        SELECT json_object(), json_object('a', 1, 'b', 'x', 'c', NULL, 'd', json('{"e":[]}')), json_object('a"b', 1, '', 2)
        SELECT json_object('a', 1, 'a', 2), json_object(1, 2), json_object('a'), json_object('a', x'01')
        SELECT json_array(x'01'), json_array(1, x'02', 'x'), json_object('a', x'00')
        """);
}

@test
fn jsonAcceptsJson5() -> Result<void, TestFailure> {
    let path = "out/json-json5.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json('{a:1, $b_2:2, _c:3, é:4}'), json('{''single'': ''quoted''}'), json('[1,2,]'), json('{"a":1,}')
        SELECT json('[0x1F, -0x1f, +0X10, 0xFFFFFFFFFFFFFFFF, 0x7FFFFFFFFFFFFFFF, 0x10000000000000000]')
        SELECT json('[.5, 5., -.5, +5, +.5e3, 5.e3, 1.e-2]'), json('[Infinity, -Infinity, +Infinity, inf, -INF, NaN, -NaN, QNaN, SNaN, nan]')
        SELECT json('[1, /* comment */ 2, // line' || char(10) || '3]'), json('/* x */ [1] // y'), json(char(11) || char(12) || '[1]' || char(160) || char(0xfeff))
        SELECT json('[1' || char(0x2028) || ',' || char(0x2029) || '2' || char(0x3000) || ']'), json('[1' || char(0x1680) || char(0x2000) || char(0x200a) || char(0x202f) || char(0x205f) || ']')
        SELECT json('"\x41\v\0\''"'), json('''a"b'''), json('"a\' || char(10) || 'b"'), json('"a\' || char(13) || char(10) || 'b"'), json('"tab' || char(9) || 'here"')
        SELECT json('"\' || char(0x2028) || 'x"'), json('"\' || char(0x2029) || 'x"'), json_extract('"\x41\v\0b"', '$') = 'A' || char(11) || char(0) || 'b'
        SELECT json('"\01"'), json('"\08"'), json('"\0"'), json('{a:1}'), json('{ab:1}')
        SELECT json_valid('{a:1}'), json_valid('{a:1}', 1), json_valid('{a:1}', 2), json_valid('{a:1}', 3), json_valid('[1]', 1), json_valid('[Infinity]', 1), json_valid('[Infinity]', 2)
        SELECT json_valid(' [1] /* c */', 1), json_valid(' [1] /* c */', 2), json_valid('[1,]'), json_valid('[1,]', 6)
        SELECT json('{null:1}'), json('{true:1}'), json('{1:1}')
        SELECT json('{nullx:1, truex:2, Infinityy:3}')
        SELECT json('[1e5]') -> '$[0]', json('[0x10]') ->> '$[0]', json_extract('[+5]', '$[0]'), json_extract('[.5]', '$[0]'), json_extract('[-0x10]', '$[0]')
        SELECT json_extract('0x8000000000000000', '$'), json_extract('-0x8000000000000000', '$'), json_extract('0xFFFFFFFFFFFFFFFF', '$')
        SELECT json_extract('0x10000000000000000', '$')
        SELECT json_type('[Infinity, NaN, 0x10, .5]', '$[0]'), json_type('[Infinity, NaN, 0x10, .5]', '$[1]'), json_type('[Infinity, NaN, 0x10, .5]', '$[2]'), json_type('[Infinity, NaN, 0x10, .5]', '$[3]')
        """);
}

@test
fn jsonRejectsMalformedInput() -> Result<void, TestFailure> {
    let path = "out/json-malformed.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json('')
        SELECT json(' ')
        SELECT json('[1,2')
        SELECT json('{"a" 1}')
        SELECT json('{"a":}')
        SELECT json('[1] x')
        SELECT json('01')
        SELECT json('-01')
        SELECT json('1.')
        SELECT json('[1e]')
        SELECT json('[1e+]')
        SELECT json('[1.2.3]')
        SELECT json('[--1]')
        SELECT json('"\q"')
        SELECT json('"\u12"')
        SELECT json('tru')
        SELECT json('nul')
        SELECT json('[,1]')
        SELECT json('[1,,2]')
        SELECT json('{,}')
        SELECT json('"abc')
        SELECT json('/* open')
        SELECT json(x'5b315d')
        SELECT json_valid(''), json_valid(' '), json_valid('[1,2'), json_valid('{"a" 1}'), json_valid(NULL), json_valid(1), json_valid(1.5), json_valid('"x"')
        SELECT json_valid('[1]', 0)
        SELECT json_valid('[1]', 16)
        SELECT json_valid('[1]', NULL)
        SELECT json_valid('[1]', 4), json_valid('[1]', 8), json_valid(x'00', 4), json_valid(x'00', 8), json_valid(x'00', 1), json_valid(x'5b315d', 1), json_valid(x'5b315d', 4)
        SELECT json_error_position('[1,2,3]'), json_error_position('[1,2,x]'), json_error_position(''), json_error_position('{"é":tru}'), json_error_position(NULL), json_error_position('[1] x')
        SELECT json_error_position('[1,2'), json_error_position('{"a" 1}'), json_error_position('{"a":}'), json_error_position('"\q"'), json_error_position('01'), json_error_position('[1.2.3]'), json_error_position(123)
        SELECT json_error_position('{a:1}'), json_error_position(x'00'), json_error_position(x'5b315d'), json_error_position('é[')
        SELECT json_extract('[1,2', '$[0]')
        SELECT json_type('{', '$')
        SELECT json_array_length('[1')
        SELECT json_remove('[1', '$[0]')
        SELECT json_set('[1', '$[0]', 1)
        SELECT json_patch('[1', '{}')
        SELECT json_patch('{}', '[1')
        SELECT json_pretty('[1')
        SELECT '[1' -> '$'
        SELECT '[1' ->> '$'
        SELECT json_insert('{}', '$.a', json('[1'))
        """);
}

// SQLite 3.53.4 allows JSON nested 1000 deep (JSON_MAX_DEPTH), and so does this engine; the sqlite3 shell these
// tests run was built with a limit of 800. The depths below are ones where the two limits give the same answer.
@test
fn jsonNestsDeeply() -> Result<void, TestFailure> {
    let path = "out/json-deep.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT length(json(replace(hex(zeroblob(800)), '00', '[') || replace(hex(zeroblob(800)), '00', ']')))
        SELECT json(replace(hex(zeroblob(1001)), '00', '[') || replace(hex(zeroblob(1001)), '00', ']'))
        SELECT json(replace(hex(zeroblob(5000)), '00', '{"a":') || '1' || replace(hex(zeroblob(5000)), '00', '}'))
        SELECT json_valid(replace(hex(zeroblob(1001)), '00', '[') || replace(hex(zeroblob(1001)), '00', ']'))
        SELECT length(json_array(json(replace(hex(zeroblob(800)), '00', '[') || replace(hex(zeroblob(800)), '00', ']'))))
        SELECT json_extract(replace(hex(zeroblob(5)), '00', '[') || '7' || replace(hex(zeroblob(5)), '00', ']'), '$[0][0][0][0][0]')
        SELECT length(json_pretty(replace(hex(zeroblob(799)), '00', '[') || replace(hex(zeroblob(799)), '00', ']')))
        SELECT length(json_set('{}', '$' || replace(hex(zeroblob(790)), '00', '.a'), 1))
        SELECT json_set('{}', '$' || replace(hex(zeroblob(1100)), '00', '.a'), 1)
        SELECT json_insert('[]', '$' || replace(hex(zeroblob(1100)), '00', '[0]'), 1)
        SELECT length(json_set('[]', '$' || replace(hex(zeroblob(500)), '00', '[0]'), 1))
        SELECT json_extract(replace(hex(zeroblob(799)), '00', '[') || replace(hex(zeroblob(799)), '00', ']'), '$' || replace(hex(zeroblob(798)), '00', '[0]'))
        SELECT length(json_patch('{}', replace(hex(zeroblob(790)), '00', '{"a":') || '1' || replace(hex(zeroblob(790)), '00', '}')))
        SELECT length(json_patch(replace(hex(zeroblob(790)), '00', '{"a":') || '1' || replace(hex(zeroblob(790)), '00', '}'), replace(hex(zeroblob(790)), '00', '{"a":') || '2' || replace(hex(zeroblob(790)), '00', '}')))
        """);
}

@test
fn jsonReadsUnicodeEscapes() -> Result<void, TestFailure> {
    let path = "out/json-unicode.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json_extract('"Aé中😀"', '$'), json('"Aé😀"'), hex(json_extract('"😀"', '$'))
        SELECT json('"\ud800"'), json('"\udc00x"'), json('"\ud800A"'), json_quote(json('"\ud800"')), json_valid('"\ud800"'), json_extract('["\ud800",1]', '$[1]')
        SELECT hex(json_extract('"😀ÿ߿ࠀ￿"', '$')), json_extract('"\u004"', '$')
        SELECT hex(json_extract('"a\u0000b"', '$')), length(json_extract('"a\u0000b"', '$')), json('"a\u0000b"')
        SELECT json_extract('{"a":1}', '$.a'), json_extract('{"a":1}', '$."a"'), json_extract('{"é":1}', '$.é'), json_extract('{"é":2}', '$.é'), json_extract('{"😀":3}', '$."😀"')
        SELECT json_extract('{"a\"b":1}', '$."a\"b"'), json_extract('{"a.b":1}', '$."a.b"'), json_extract('{"a b":1}', '$.a b'), json_extract('{"":1}', '$.""')
        SELECT json_quote('😀é中'), json_array('😀'), json_object('😀', 'é'), json('"😀"'), length(json_extract('"😀"', '$'))
        SELECT json_extract('["\x41\x7e"]', '$[0]'), json('["\xff"]'), hex(json_extract('["\xff"]', '$[0]'))
        SELECT json_extract('{"a":"é"}', '$.a') = 'é', '{"a":"é"}' ->> 'a', '{"a":"é"}' -> 'a'
        """);
}

@test
fn jsonFollowsPaths() -> Result<void, TestFailure> {
    let path = "out/json-paths.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json_extract('{"a":{"b":[10,20,{"c":"d"}]}}', '$'), json_extract('{"a":{"b":[10,20,{"c":"d"}]}}', '$.a'), json_extract('{"a":{"b":[10,20,{"c":"d"}]}}', '$.a.b[2].c')
        SELECT json_extract('[1,2,3]', '$[0]'), json_extract('[1,2,3]', '$[2]'), json_extract('[1,2,3]', '$[3]'), json_extract('[1,2,3]', '$[#-1]'), json_extract('[1,2,3]', '$[#-3]'), json_extract('[1,2,3]', '$[#-4]'), json_extract('[1,2,3]', '$[#]')
        SELECT json_extract('[1,2,3]', '$[#-0]'), json_extract('[1,2,3]', '$[99999999999999999999]'), json_extract('[1,2,3]', '$[#-99999999999999]'), json_extract('[[1,2],[3,4]]', '$[1][#-1]')
        SELECT json_extract('{"a":1}', '$.b'), json_extract('{"a":1}', '$[0]'), json_extract('[1]', '$.a'), json_extract('{"a":1}', '$.a.b'), json_extract('{"a":1}', '$.a[0]')
        SELECT json_extract('{"a":1}', 'a')
        SELECT json_extract('{"a":1}', '$a')
        SELECT json_extract('{"a":1}', '$.')
        SELECT json_extract('{"a":1}', '$.a.')
        SELECT json_extract('{"a":{"b":1}}', '$.a.')
        SELECT json_extract('[1]', '$[')
        SELECT json_extract('[1]', '$[]')
        SELECT json_extract('[1]', '$[x]')
        SELECT json_extract('[1]', '$[0')
        SELECT json_extract('[1]', '$[#-]')
        SELECT json_extract('[1]', '$[#+1]')
        SELECT json_extract('[1]', '$[-1]')
        SELECT json_extract('{"a":1}', '$."a')
        SELECT json_extract('{"a":1}', '$.a]')
        SELECT json_extract('{}', '$[x]'), json_extract('[]', '$.a.b.c'), json_extract('{"a":1}', NULL), json_extract(NULL, '$'), json_extract('{"a":1}')
        SELECT json_extract('{"a":1,"b":[2]}', '$.a', '$.b', '$.c'), json_extract('[1]', '$[0]', NULL), json_extract('{"a":"x"}', '$.a', '$.a')
        SELECT json_extract('{"a":1}', '$.a', 'x')
        SELECT json_extract('{"a":1}', '$.a', '$x')
        SELECT json_extract('{"a":"x","b":[1],"c":{},"d":null,"e":true}', '$.a'), json_extract('{"a":"x","b":[1],"c":{},"d":null,"e":true}', '$.b'), json_extract('{"a":"x","b":[1],"c":{},"d":null,"e":true}', '$.c'), json_extract('{"a":"x","b":[1],"c":{},"d":null,"e":true}', '$.d'), json_extract('{"a":"x","b":[1],"c":{},"d":null,"e":true}', '$.e')
        SELECT '{"a":"x","b":[1],"d":null,"e":true}' -> '$.a', '{"a":"x","b":[1],"d":null,"e":true}' -> '$.b', '{"a":"x","b":[1],"d":null,"e":true}' -> '$.d', '{"a":"x","b":[1],"d":null,"e":true}' -> '$.e', '{"a":1}' -> '$.zz'
        SELECT '{"a":"x","b":[1],"d":null,"e":true}' ->> '$.a', '{"a":"x","b":[1],"d":null,"e":true}' ->> '$.b', '{"a":"x","b":[1],"d":null,"e":true}' ->> '$.d', '{"a":"x","b":[1],"d":null,"e":true}' ->> '$.e'
        SELECT '{"a":{"b":2}}' -> 'a', '{"a":{"b":2}}' -> 'a' -> 'b', '{"a":{"b":2}}' ->> 'a' ->> 'b', '[10,20,30]' -> 1, '[10,20,30]' ->> -1, '[10,20,30]' -> '[2]', '[10,20,30]' -> '[#-2]'
        SELECT '{"a b":1, "1":2, "x.y":3}' ->> 'a b', '{"a b":1, "1":2, "x.y":3}' ->> '1', '{"a b":1, "1":2, "x.y":3}' ->> 'x.y', '{"":4}' ->> '', '{"a_1":5}' ->> 'a_1'
        SELECT '[1,2]' -> 5, '[1,2]' -> -5, '[1,2]' -> 1.0, '{"1.0":7}' ->> 1.0, NULL -> '$', '[1]' -> NULL
        SELECT '[1]' -> 'x[0'
        SELECT json_type('{"a":[1,2.5,"x",true,false,null,{}]}'), json_type('{"a":[1,2.5,"x",true,false,null,{}]}', '$.a'), json_type('{"a":[1,2.5,"x",true,false,null,{}]}', '$.a[0]'), json_type('{"a":[1,2.5,"x",true,false,null,{}]}', '$.a[1]')
        SELECT json_type('{"a":[1,2.5,"x",true,false,null,{}]}', '$.a[2]'), json_type('{"a":[1,2.5,"x",true,false,null,{}]}', '$.a[3]'), json_type('{"a":[1,2.5,"x",true,false,null,{}]}', '$.a[4]'), json_type('{"a":[1,2.5,"x",true,false,null,{}]}', '$.a[5]'), json_type('{"a":[1,2.5,"x",true,false,null,{}]}', '$.a[6]')
        SELECT json_type('[1]', '$[9]'), json_type(NULL), json_type('[1]', NULL), json_type('1'), json_type('"x"')
        SELECT json_type('[1]', 'x')
        SELECT json_type('[1]', '$[')
        SELECT json_array_length('[1,2,3]'), json_array_length('[]'), json_array_length('{"a":1}'), json_array_length('"x"'), json_array_length('{"a":[1,2]}', '$.a'), json_array_length('{"a":[1,2]}', '$.b'), json_array_length(NULL), json_array_length('[1]', NULL)
        SELECT json_array_length('[1]', 'x')
        SELECT json_array_length('{"a":[1,2]}', '$.a[')
        """);
}

@test
fn jsonEditsValues() -> Result<void, TestFailure> {
    let path = "out/json-edits.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json_set('{"a":1}', '$.a', 2, '$.b', 3), json_insert('{"a":1}', '$.a', 2, '$.b', 3), json_replace('{"a":1}', '$.a', 2, '$.b', 3)
        SELECT json_set('[1,2]', '$[0]', 9, '$[2]', 8, '$[5]', 7), json_insert('[1,2]', '$[#]', 3), json_set('[1,2]', '$[#]', 3, '$[#]', 4), json_replace('[1,2]', '$[#-1]', 0)
        SELECT json_set('{}', '$.a.b.c', 1), json_set('{}', '$.a[0]', 1), json_set('{}', '$.a[#]', 1), json_set('[]', '$[0].a', 1), json_set('{}', '$.a[1]', 1), json_insert('{"a":1}', '$.a.b', 2)
        SELECT json_set('{"a":1}', '$', 5), json_replace('{"a":1}', '$', '[1]'), json_insert('{"a":1}', '$', 5), json_set('{"a":1}', '$', json('[1]'))
        SELECT json_set('{}', '$.a', 'text', '$.b', 1.5, '$.c', NULL, '$.d', json('{"x":[1]}'), '$.e', json_array(1, 2), '$.f', '[1]')
        SELECT json_set('{}', '$.a', 1e999, '$.b', -1e999, '$.c', 9223372036854775807, '$.d', -0.0, '$.e', 0.1)
        SELECT json_set('{}', '$."a b"', 1, '$."x\"y"', 2, '$.é', 3, '$."é"', 4), json_set('{"a":1}', '$."a"', 2)
        SELECT json_set('{"a":1}', NULL, 2), json_set(NULL, '$.a', 1), json_set('{"a":1}', '$.a', NULL), json_insert('{"a":1}')
        SELECT json_set('{"a":1}', '$.a')
        SELECT json_insert('{"a":1}', '$.a')
        SELECT json_replace('{"a":1}', '$.a')
        SELECT json_array_insert('[1,2]', '$.a')
        SELECT json_set('{"a":1}', 'a', 2)
        SELECT json_set('{"a":1}', '$.b', 2, 'x', 3)
        SELECT json_set('{"a":1}', '$[', 2)
        SELECT json_set('{"a":1}', '$.a', x'01')
        SELECT json_set('{"a":1}', '$.a', json('[1'))
        SELECT json_set('[1]', '$.a', 1), json_set('{"a":1}', '$[0]', 1), json_replace('[1]', '$[5]', 1), json_insert('[[1]]', '$[0][#-0]', 2)
        SELECT json_array_insert('[1,2,3]', '$[1]', 9), json_array_insert('[1,2,3]', '$[#]', 9), json_array_insert('[1,2,3]', '$[9]', 9), json_array_insert('{"a":[1]}', '$.a[0]', 0), json_array_insert('[1]', '$', 5)
        SELECT json_array_insert('{"a":1}', '$.a', 0)
        SELECT json_array_insert('{"a":[1]}', '$.b', 0)
        SELECT json_array_insert('{}', '$.b[0]', 0), json_array_insert('[[1]]', '$[0][0]', 0, '$[0][#]', 9)
        SELECT json_remove('[1,2,3]', '$[1]'), json_remove('[1,2,3]', '$[#-1]', '$[0]'), json_remove('{"a":1,"b":2}', '$.a'), json_remove('{"a":1,"b":2}', '$.c'), json_remove('{"a":{"b":1,"c":2}}', '$.a.b')
        SELECT json_remove('[1,2]', '$'), json_remove('[1,2]', NULL), json_remove('[1,2]'), json_remove(NULL, '$[0]'), json_remove('[1,2]', '$[0]', '$[0]', '$[0]'), json_remove('{"a":1,"a":2}', '$.a')
        SELECT json_remove('[1,2]', 'x')
        SELECT json_remove('[1,2]', '$[')
        SELECT json_remove(' [ 1 , 2 ] '), json_remove('{a:1}')
        SELECT json_patch('{"a":1,"b":2}', '{"b":null,"c":3}'), json_patch('{"a":{"x":1}}', '{"a":{"y":2}}'), json_patch('{"a":1}', '[1]'), json_patch('[1]', '{"a":1}'), json_patch('{"a":1}', '{"a":{"b":null}}')
        SELECT json_patch('{}', '{"a":{"b":{"c":null,"d":1}}}'), json_patch('{"a":[1]}', '{"a":{"0":2}}'), json_patch('1', '2'), json_patch('{"a":1,"a":2}', '{"a":3}'), json_patch(NULL, '{}'), json_patch('{}', NULL)
        SELECT json_patch('{"a":1}', '{"a":2}'), json_patch('{a:1}', '{b:Infinity}'), json_patch('{"a":1}', '{"a":null,"a":5}')
        SELECT json_pretty('{"a":[1,2,{"b":null}],"c":{}, "d":[]}'), json_pretty('[1,[2,[3]]]', '--'), json_pretty('{"a":1}', ''), json_pretty('[]'), json_pretty('5'), json_pretty(NULL), json_pretty('[1]', NULL)
        SELECT json_pretty('{a:.5, ''b'':0x10}')
        SELECT json_set('{a:1, /* c */ b:[1,2,]}', '$.b[#]', 3), json_remove('[Infinity, NaN, ''x'']', '$[1]'), json_insert('{"a":"\x41"}', '$.b', 1), json_replace('{"a b":1}', '$."a b"', 2)
        SELECT json_set('{"a":{"b":1}}', '$.a.b', json_object('c', json_array(1, 2)), '$.a.d', 'x'), json_set('[[1,2],[3]]', '$[1][#]', 4, '$[0][0]', 0), json_remove('{"a":[1,{"b":2,"c":3}]}', '$.a[1].b')
        SELECT json_set('{"x":1}', '$.x', json('{"deep":{"er":[1,2,3]}}'), '$.x.deep.er[1]', 'two'), json_set('{}', '$.a', 1, '$.a', 2, '$.a', 3)
        """);
}

/// A blob that is JSONB is read as JSONB, as SQLite reads it; another blob is read as text.
@test
fn jsonReadsJsonbBlobs() -> Result<void, TestFailure> {
    let path = "out/json-jsonb-input.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json(x'8B133117613C176200'), json_extract(x'8B133117613C176200', '$[1]'), json_type(x'8B133117613C176200', '$[2]'), json_array_length(x'8B133117613C176200'), x'8B133117613C176200' -> '$[2].b'
        SELECT json(x'AB4430783146262E351771'), json(x'CC1017615B35312E3501176358785C5C6E79'), json_quote(x'CC1017615B35312E3501176358785C5C6E79'), json_array(x'8B133117613C176200', x'00', x'01', x'02')
        SELECT json_valid(x'8B133117613C176200'), json_valid(x'8B133117613C176200', 4), json_valid(x'8B133117613C176200', 8), json_valid(x'8B133117613C176200', 2), json_error_position(x'8B133117613C176200')
        SELECT json_set(x'8B133117613C176200', '$[0]', 5, '$[2].c', 'x'), json_remove(x'8B133117613C176200', '$[1]'), json_patch(x'CC1017615B35312E3501176358785C5C6E79', '{"a":null}')
        SELECT json(x'3132'), json(x'7B7D'), json(x'5B315D'), json_valid(x'7B7D'), json_valid(x'7B7D', 8), json_valid(x'3132', 4)
        SELECT json(x'2C1331')
        SELECT json_valid(x'2C1331', 4), json_valid(x'2C1331', 8), json_error_position(x'2C1331'), json_type(x'2C1331')
        SELECT json(x'8B1331176100')
        SELECT json_error_position(x'8B1331176100'), json_valid(x'8B1331176100', 4)
        SELECT json(x'1335'), json(x'1B'), json(x'0B'), json(x'0C'), json(x'00'), json(x'01'), json(x'02'), json_extract(x'0C', '$.a')
        SELECT json(x'23312E'), json_error_position(x'23312E'), json_valid(x'23312E', 8), json(x'4630783147'), json_error_position(x'4630783147')
        SELECT json(x'15'), json(x'3631652B'), json(x'662E3565'), json_error_position(x'662E3565')
        SELECT json_extract(x'5730782D31', '$'), json_extract(x'A4307846464646464646464646', '$')
        SELECT json(x'397822'), json(x'49785C76'), json_error_position(x'49785C71'), json(x'49785C71')
        """);
}

@test
fn jsonNestsJsonResultsBySubtype() -> Result<void, TestFailure> {
    let path = "out/json-subtype.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json_array(json('[1]'), '[1]', json_array(2), json_object('a', 3), json_quote('q'))
        SELECT json_array(coalesce(json('[1]'), 2), ifnull(NULL, json('[2]')), iif(1, json('[3]'), 0), iif(0, 0, json('[4]')), CASE WHEN 1 THEN json('[5]') END, CASE 2 WHEN 2 THEN json('[6]') ELSE 0 END)
        SELECT json_array(+json('[1]'), nullif(json('[2]'), 'x'), likely(json('[3]')), unlikely(json('[4]')), json('[5]') COLLATE NOCASE, CAST(json('[6]') AS TEXT), CASE WHEN 0 THEN 1 ELSE json('[7]') END)
        SELECT json_array(max(json('[1]'), '0'), min(json('[2]'), 'z'), max(json('[1]'), 'z'))
        SELECT json_array(json_extract('{"a":[1]}', '$.a'), json_extract('{"a":"x"}', '$.a'), json_extract('{"a":[1]}', '$.a', '$.a'), '{"a":[1]}' -> '$.a', '{"a":"x"}' -> '$.a', '{"a":[1]}' ->> '$.a')
        SELECT json_array(json_set('{}', '$.a', 1), json_insert('[]', '$[0]', 1), json_replace('[0]', '$[0]', 1), json_remove('[1,2]', '$[0]'), json_patch('{}', '{"a":1}'), json_array_insert('[]', '$[0]', 1))
        SELECT json_array(json_pretty('[1]'), json_type('[1]'), json_valid('[1]'), json_array_length('[1]'), json_error_position('[1]'))
        SELECT json_array(lower(json('[1]')), json('[1]') || '', substr(json('[1]'), 1), json('[1]') -> '$')
        SELECT json_object('a', json('{"b":1}'), 'c', '{"b":1}'), json_set('{}', '$.a', json('[1]'), '$.b', '[1]'), json_insert('[]', '$[#]', json_array()), json_replace('[0]', '$[0]', json_object())
        SELECT json_array(x) FROM (SELECT json('[1]') AS x)
        WITH c(x) AS (SELECT json('[1]')) SELECT json_array(x) FROM c
        SELECT json_array(json('[1]') -> '$[0]'), json_array(json(' "x" ')), json_array(json('1')), json_quote(json('"x"'))
        """);
}

const JSON_FIXTURE: StringView = """
    CREATE TABLE t(g INTEGER, k, v);
    INSERT INTO t VALUES (1, 'a', 1), (1, NULL, 2), (1, 'b', NULL), (2, 'c', 'x'), (2, 3, 1.5), (1, 'a', '[1]'), (3, NULL, NULL), (4, 'q"', 'tab' || char(9));
    CREATE TABLE docs(id INTEGER PRIMARY KEY, body TEXT);
    INSERT INTO docs VALUES (1, '{"name":"alice","tags":["x","y"],"age":30}'), (2, '{"name":"bob","tags":[],"age":null}'), (3, 'not json'), (4, NULL), (5, '{"name":"carol","nested":{"deep":[1,{"k":"v"}]}}');
    """;

@test
fn jsonAggregates() -> Result<void, TestFailure> {
    let path = "out/json-aggregates.db";
    makeDatabase(path, JSON_FIXTURE)?;
    return sameAnswers(path, """
        SELECT json_group_array(v) FROM t
        SELECT json_group_array(DISTINCT v) FROM t
        SELECT g, json_group_array(v), json_group_object(k, v) FROM t GROUP BY g ORDER BY g
        SELECT json_group_array(v) FROM t WHERE 0
        SELECT json_group_object(k, v) FROM t WHERE 0
        SELECT json_group_object(k, v) FROM t WHERE g = 3
        SELECT json_group_object(k, v) FROM t WHERE g = 1
        SELECT json_group_array(v) FILTER (WHERE g = 2) FROM t
        SELECT json_object('all', json_group_array(v), 'n', count(*)) FROM t
        SELECT json_array(json_group_array(g), json_group_object(k, g)) FROM t WHERE k IS NOT NULL
        SELECT json_group_array(json(v)) FROM t WHERE g = 1 AND v IS NOT NULL
        SELECT json_group_array(json_array(g, v)) FROM t
        SELECT json_group_array(x'00') FROM t
        SELECT json_group_array(x'01') FROM t
        SELECT json_group_object(k, x'01') FROM t
        SELECT json_group_array(json('[1')) FROM t
        SELECT json_group_array() FROM t
        SELECT json_group_object(k) FROM t
        SELECT json_group_object(DISTINCT k, v) FROM t
        SELECT json_group_array(v) FROM t GROUP BY g HAVING json_array_length(json_group_array(v)) > 1 ORDER BY 1
        SELECT id, body -> '$.name', body ->> '$.tags[0]', json_array_length(body, '$.tags'), json_type(body, '$.age') FROM docs WHERE json_valid(body) ORDER BY id
        SELECT id FROM docs WHERE body ->> '$.name' = 'bob'
        SELECT json_group_array(body ->> 'name') FROM docs WHERE json_valid(body)
        SELECT json_group_object(id, json(body)) FROM docs WHERE json_valid(body)
        SELECT id, json_valid(body), json_error_position(body) FROM docs ORDER BY id
        SELECT body -> '$.name' FROM docs ORDER BY id
        SELECT json_extract(body, '$.nested.deep[1].k'), body -> '$.nested' -> 'deep' ->> 1 FROM docs WHERE id = 5
        """);
}

@test
fn jsonHandlesNull() -> Result<void, TestFailure> {
    let path = "out/json-null.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json(NULL), json_array(NULL), json_object('a', NULL), json_quote(NULL), json_extract(NULL, '$'), NULL -> '$', NULL ->> '$'
        SELECT json_type(NULL), json_type(NULL, '$'), json_valid(NULL), json_error_position(NULL), json_array_length(NULL), json_pretty(NULL)
        SELECT json_insert(NULL, '$.a', 1), json_replace(NULL, '$.a', 1), json_set(NULL, '$.a', 1), json_remove(NULL), json_patch(NULL, NULL), json_array_insert(NULL, '$[0]', 1)
        SELECT json_object(NULL, 1)
        SELECT json('null'), json_extract('null', '$'), json_type('null'), json_extract('{"a":null}', '$.a'), json_type('{"a":null}', '$.a'), '{"a":null}' -> 'a', '{"a":null}' ->> 'a'
        SELECT typeof(json_extract('{"a":null}', '$.a')), typeof('{"a":null}' -> 'a'), typeof('{"a":null}' ->> 'a'), typeof(json_extract('{"a":null}', '$.b'))
        """);
}

@test
fn jsonChecksArgumentCounts() -> Result<void, TestFailure> {
    let path = "out/json-arguments.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT json()
        SELECT json('1', '2')
        SELECT json_quote()
        SELECT json_quote(1, 2)
        SELECT json_type()
        SELECT json_type('1', '$', 3)
        SELECT json_valid()
        SELECT json_valid('1', 1, 1)
        SELECT json_array_length()
        SELECT json_array_length('[]', '$', 1)
        SELECT json_error_position()
        SELECT json_error_position('1', '2')
        SELECT json_patch('{}')
        SELECT json_patch('{}', '{}', '{}')
        SELECT json_pretty()
        SELECT json_pretty('1', ' ', 3)
        SELECT json_group_array() FROM t
        SELECT json_group_array(1, 2) FROM t
        SELECT json_group_object(1) FROM t
        SELECT json_group_object(1, 2, 3) FROM t
        SELECT json_array(), json_object(), json_extract(), json_extract('[1]'), json_remove(), json_insert(), json_replace(), json_set(), json_array_insert()
        SELECT json_object('a')
        SELECT json_object('a', 1, 'b')
        SELECT json_set('{}', '$.a', 1, '$.b')
        SELECT json_insert('{}', '$.a')
        SELECT json_replace('{}', '$.a', 1, '$.b')
        SELECT json_array_insert('[]', '$[0]')
        SELECT JSON_ARRAY(1), Json_Extract('{"a":1}', '$.a'), JSON('[1]')
        """);
}

/// The JSONB functions are not ported: unlike sqlite3, this engine does not know them.
@test
fn jsonbFunctionsAreNotPorted() -> Result<void, TestFailure> {
    let path = "out/json-jsonb.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    var session = Session.open(path)!;
    let names = ["jsonb", "jsonb_array", "jsonb_object", "jsonb_extract", "jsonb_set", "jsonb_insert", "jsonb_replace", "jsonb_remove", "jsonb_patch", "jsonb_array_insert"];
    for (k in 0..names.length) {
        var sql = String.from("SELECT ")!;
        sql.append(names[k])!;
        sql.append("('[1]')")!;
        let answer = ours(mut session, sql.view());
        var expected = String.from("error: no such function: ")!;
        expected.append(names[k])!;
        expected.append("\n")!;
        if (answer.view() != expected.view()) {
            return Check.fail(answer.view());
        }
    }
    return Ok();
}
