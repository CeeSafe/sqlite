// A SQLite value: one of the five storage classes (dynamic typing).

/// The five storage classes.
public enum SqliteValueType {
    Null,
    Integer,
    Real,
    Text,
    Blob,
}

/// One value of a row.
public enum SqliteValue {
    Null,
    Integer(i64),
    Real(f64),
    /// TEXT: any bytes, as SQLite keeps them; usually UTF-8, but `CAST(x'ff' AS TEXT)`, a record another program
    /// wrote and JSON's `"\ud800"` (ED A0 80) need not be.
    Text(ByteString),
    Blob(Vector<u8>),
}

impl SqliteValue {
    /// A text value holding a copy of `text`.
    public fn text(text: StringView) -> Result<SqliteValue, AllocError> =>
        Ok(SqliteValue.Text(ByteString.fromText(text)?));

    /// A text value holding a copy of `bytes`, which need not be UTF-8.
    public fn textOfBytes(bytes: Slice<u8>) -> Result<SqliteValue, AllocError> =>
        Ok(SqliteValue.Text(ByteString.copyOf(bytes)?));

    /// The text of a TEXT value as a `StringView`, when its bytes are UTF-8; null for any other value and for text
    /// that is not UTF-8 (`toText` gives every value's bytes as text).
    public fn textView(borrow this) -> StringView? => match (this) {
        SqliteValue.Text(s) => s.toUtf8(),
        _ => null,
    };

    /// A blob value holding a copy of `bytes`.
    public fn blob(bytes: Slice<u8>) -> Result<SqliteValue, AllocError> {
        var v = Vector<u8>.withCapacity(bytes.length)?;
        v.extend(bytes)?;
        return Ok(SqliteValue.Blob(v));
    }

    /// The value's storage class.
    public fn kind(borrow this) -> SqliteValueType => match (this) {
        SqliteValue.Null => SqliteValueType.Null,
        SqliteValue.Integer(_) => SqliteValueType.Integer,
        SqliteValue.Real(_) => SqliteValueType.Real,
        SqliteValue.Text(_) => SqliteValueType.Text,
        SqliteValue.Blob(_) => SqliteValueType.Blob,
    };

    /// Whether the value is NULL.
    public fn isNull(borrow this) -> bool => match (this) {
        SqliteValue.Null => true,
        _ => false,
    };

    /// A copy of the value.
    public fn clone(borrow this) -> Result<SqliteValue, AllocError> => match (this) {
        SqliteValue.Null => Ok(SqliteValue.Null),
        SqliteValue.Integer(i) => Ok(SqliteValue.Integer(i)),
        SqliteValue.Real(r) => Ok(SqliteValue.Real(r)),
        SqliteValue.Text(s) => Ok(SqliteValue.Text(s.clone()?)),
        SqliteValue.Blob(b) => Ok(SqliteValue.Blob(b.clone()?)),
    };
}

/// A copy of a row of values.
fn cloneValues(values: Slice<SqliteValue>) -> Result<Vector<SqliteValue>, AllocError> {
    var out = Vector<SqliteValue>.withCapacity(values.length)?;
    for (i in 0..values.length) {
        out.push(values[i].clone()?)?;
    }
    return Ok(out);
}
