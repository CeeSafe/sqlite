// Queries, answered by this engine and by the sqlite3 shell on the same database, compared as the shell prints
// them (list mode: columns joined by '|', NULL as nothing).

fn listText(result: borrow QueryResult) -> String {
    var out = String.create();
    for (r in 0..result.rows.length) {
        let row = borrow result.rows[r];
        for (c in 0..row.length) {
            if (c != 0) {
                out.append("|")!;
            }
            appendValueText(mut out, borrow row[c])!;
        }
        out.append("\n")!;
    }
    return out;
}

/// What this engine answers, or the error's message.
fn ours(session: borrow mut Session, sql: StringView) -> String {
    let none = Vector<SqliteValue>.create();
    match (session.query(sql, none.view())) {
        Ok(result) => { return listText(borrow result); }
        Err(e) => {
            var text = String.from("error: ")!;
            text.append(e.message())!;
            text.append("\n")!;
            return text;
        }
    }
}

/// What the sqlite3 shell answers, or "error: " and its message.
fn theirAnswer(path: StringView, sql: StringView) -> String {
    var arguments = Vector<StringView>.create();
    arguments.push(path)!;
    arguments.push(sql)!;
    let output = Process.capture("sqlite3", borrow arguments, "".bytes())!;
    if (output.status == 0) {
        return textFromBytesLossy(output.stdout.view())!;
    }
    // "Parse error in 2nd command line argument: no such column: x" and the like.
    let errors = textFromBytesLossy(output.stderr.view())!;
    let firstLine = errors.view().splitOnce("\n") ?? TextHalves { left: errors.view(), right: "" };
    let message = match (firstLine.left.splitOnce("argument: ")) {
        Some(halves) => halves.right,
        null => firstLine.left,
    };
    var text = String.from("error: ")!;
    text.append(message)!;
    text.append("\n")!;
    return text;
}

/// Runs each query (one a line) in both engines and compares.
fn sameAnswers(path: StringView, queries: StringView) -> Result<void, TestFailure> {
    var session = Session.open(path)!;
    var lines = queries.split("\n");
    while (lines.next() is Some(line)) {
        let sql = line.trim();
        if (sql.length == 0 || sql.startsWith("--")) {
            continue;
        }
        let theirs = theirAnswer(path, sql);
        let mine = ours(mut session, sql);
        if (theirs.view() != mine.view()) {
            var message = String.from(sql)!;
            message.append("\n  sqlite3:\n")!;
            message.append(theirs.view())!;
            message.append("  this engine:\n")!;
            message.append(mine.view())!;
            return Check.fail(message.view());
        }
    }
    return Ok();
}

const QUERY_FIXTURE: StringView = """
    CREATE TABLE emp(id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE, dept INTEGER, salary REAL, boss INTEGER, note);
    CREATE TABLE dept(id INTEGER PRIMARY KEY, title TEXT, budget NUMERIC);
    INSERT INTO dept VALUES (1, 'Sales', 1000), (2, 'Engineering', '2500.50'), (3, 'Empty', NULL);
    INSERT INTO emp VALUES
        (1, 'alice', 1, 5000, NULL, 'x'), (2, 'Bob', 1, 4000.5, 1, NULL), (3, 'carol', 2, 7000, 1, 12),
        (4, 'Dave', 2, 6500, 3, 1.5), (5, 'eve', 2, NULL, 3, x'4142'), (6, 'ALICE', NULL, 3000, 2, '7'),
        (7, 'frank', 9, 100, NULL, 'z');
    CREATE VIEW rich AS SELECT name, salary FROM emp WHERE salary > 4500;
    """;

@test
fn expressionsWithoutTables() -> Result<void, TestFailure> {
    let path = "out/query-expressions.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT 1 + 2 * 3, 7 / 2, 7.0 / 2, 7 % 3, -7 % 3, 5.5 % 2, 1 / 0, 9223372036854775807 + 1
        SELECT '12abc' + 1, ' 12 ' * 2, 'abc' || 1.5 || NULL, 1 < 2, 'a' < 'b', NULL = NULL, NULL IS NULL
        SELECT 1 << 63, 1 << 64, -8 >> 1, ~5, 6 & 3, 6 | 3, -9223372036854775808 / -1
        SELECT 0.1 + 0.2, 1e20, 1.0 / 3, 2.0 / 3, 100.0, -0.0, 1e308 * 10
        SELECT CAST('9007199254740993' AS INTEGER), CAST('1e3' AS INTEGER), CAST(' 12.7abc' AS REAL), CAST(12 AS TEXT), CAST('3.0' AS NUMERIC), CAST(x'3132' AS INTEGER)
        SELECT typeof(1), typeof(1.0), typeof('1'), typeof(x'01'), typeof(NULL), typeof(CAST(1 AS BLOB))
        SELECT abs(-5), abs(-5.5), abs('-12'), length('héllo'), length(x'0102'), length(123), octet_length('héllo')
        SELECT upper('abcé'), lower('ABCÉ'), substr('héllo', 2, 3), substr('héllo', -3), substr('abc', 0, 2), hex(substr(x'01020304', 2, 2))
        SELECT instr('héllo', 'l'), instr('abc', ''), instr('abc', 'z'), replace('aaa', 'a', 'bb'), replace(12, '', 'x')
        SELECT trim('  x  '), ltrim('xxhixx', 'x'), rtrim('xxhixx', 'x'), trim('éaé', 'é')
        SELECT coalesce(NULL, NULL, 3), ifnull(NULL, 'y'), nullif(1, 1), nullif(1, 2), iif(0, 'a', 'b'), iif(0, 1), iif(0, 1, 1, 2, 3)
        SELECT max(1, 2.5, '3'), min(1, 2.5, '3'), max(1, NULL), min('b', 'A' COLLATE NOCASE)
        SELECT hex('héllo'), hex(1.5), hex(NULL), quote('it''s'), quote(1.5), quote(x'0a'), quote(NULL), quote(1e999)
        SELECT round(2.5), round(-2.5), round(1.005, 2), round(3.14159, 3), round(5), round(NULL), round(1e20, 2)
        SELECT sign(-3.5), sign('abc'), sign(' 0 '), char(72, 105, 0x1F600), unicode('é'), unicode('')
        SELECT 'abc' LIKE 'A%', 'abc' LIKE 'a_c', 'a%c' LIKE 'a\%c' ESCAPE '\', 'abc' GLOB 'a*', 'abc' GLOB '[a-b]*', 'Abc' GLOB 'a*', 'é' LIKE 'É'
        SELECT 3 BETWEEN 1 AND 5, 3 NOT BETWEEN 4 AND 5, 2 IN (1, 2, 3), 2 IN (), NULL IN (1), 4 NOT IN (1, NULL)
        SELECT CASE 3 WHEN 1 THEN 'one' WHEN 3 THEN 'three' ELSE 'other' END, CASE WHEN 0 THEN 1 END
        SELECT 'a' = 'A' COLLATE NOCASE, 'a ' = 'a' COLLATE RTRIM, 1 = '1', 1 = +'1', (1, 2) = (1, 2), (1, 2) < (1, 3)
        SELECT unhex('4142'), unhex('41 42', ' '), unhex('4G'), zeroblob(2) = x'0000', concat('a', NULL, 1), concat_ws('-', 1, NULL, 'b')
        SELECT 1 AND NULL, 0 AND NULL, 1 OR NULL, 0 OR NULL, NOT NULL, NOT 0, NOT 'abc'
        SELECT 1 = 1.0, '1' = 1.0, 2 > '1', x'01' > 'z', 1 < x'00'
        """);
}

@test
fn selectsFromTables() -> Result<void, TestFailure> {
    let path = "out/query-tables.db";
    makeDatabase(path, QUERY_FIXTURE)?;
    return sameAnswers(path, """
        SELECT * FROM emp
        SELECT id, name FROM emp WHERE dept = 2 ORDER BY salary DESC
        SELECT name FROM emp WHERE name = 'ALICE' ORDER BY id
        SELECT name FROM emp ORDER BY name, id
        SELECT name FROM emp ORDER BY name COLLATE BINARY, id
        SELECT salary FROM emp ORDER BY salary NULLS LAST
        SELECT salary FROM emp ORDER BY 1 DESC NULLS FIRST
        SELECT id FROM emp WHERE note = 12
        SELECT id FROM emp WHERE note = '12'
        SELECT id FROM emp WHERE salary = '5000'
        SELECT id FROM emp WHERE dept IN (SELECT id FROM dept WHERE budget > 1500)
        SELECT id, (SELECT title FROM dept WHERE dept.id = emp.dept) FROM emp
        SELECT id FROM emp WHERE EXISTS (SELECT 1 FROM emp AS e2 WHERE e2.boss = emp.id)
        SELECT e.name, d.title FROM emp e JOIN dept d ON d.id = e.dept ORDER BY e.id
        SELECT e.name, d.title FROM emp e LEFT JOIN dept d ON d.id = e.dept ORDER BY e.id
        SELECT e.name, b.name FROM emp e LEFT JOIN emp b ON b.id = e.boss ORDER BY e.id
        SELECT count(*) FROM emp, dept
        SELECT * FROM dept NATURAL JOIN (SELECT id, 'x' AS tag FROM emp) ORDER BY id
        SELECT * FROM dept JOIN (SELECT id, 'x' AS tag FROM emp) USING (id) ORDER BY id
        SELECT dept, count(*), sum(salary), avg(salary), min(name), max(salary), total(salary) FROM emp GROUP BY dept ORDER BY dept
        SELECT dept, group_concat(name, ';') FROM emp GROUP BY dept HAVING count(*) > 1 ORDER BY 1
        SELECT count(*), count(note), count(DISTINCT dept), sum(id), avg(id) FROM emp
        SELECT count(*), sum(salary), max(salary) FROM emp WHERE id > 100
        SELECT name, max(salary) FROM emp
        SELECT DISTINCT dept FROM emp ORDER BY dept
        SELECT DISTINCT name FROM emp ORDER BY 1
        SELECT id FROM emp ORDER BY id LIMIT 3
        SELECT id FROM emp ORDER BY id LIMIT 2 OFFSET 3
        SELECT id FROM emp ORDER BY id LIMIT 4, 2
        SELECT id FROM emp LIMIT -1 OFFSET 5
        SELECT name AS n FROM emp WHERE n LIKE 'a%' ORDER BY n
        SELECT dept AS d, count(*) FROM emp GROUP BY d ORDER BY d
        SELECT id FROM emp WHERE id = 3
        SELECT id FROM emp WHERE rowid = '4'
        SELECT id FROM emp WHERE id = 3.5
        SELECT * FROM rich ORDER BY 1
        SELECT id FROM dept UNION SELECT dept FROM emp ORDER BY 1
        SELECT id FROM dept UNION ALL SELECT dept FROM emp ORDER BY 1
        SELECT dept FROM emp INTERSECT SELECT id FROM dept ORDER BY 1
        SELECT dept FROM emp EXCEPT SELECT id FROM dept ORDER BY 1
        VALUES (1, 'a'), (2, 'b')
        WITH big AS (SELECT * FROM emp WHERE salary > 4500) SELECT count(*) FROM big
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 10) SELECT sum(i), count(*) FROM n
        WITH RECURSIVE chain(id, depth) AS (SELECT id, 0 FROM emp WHERE boss IS NULL UNION ALL SELECT emp.id, depth + 1 FROM emp JOIN chain ON emp.boss = chain.id) SELECT id, depth FROM chain ORDER BY id
        SELECT id, name FROM emp WHERE salary > (SELECT avg(salary) FROM emp) ORDER BY id
        SELECT nosuch FROM emp
        SELECT * FROM nosuch
        SELECT id FROM emp ORDER BY 9
        SELECT count(*) FROM emp WHERE count(*) > 1
        """);
}

@test
fn readsWithoutRowidTables() -> Result<void, TestFailure> {
    let path = "out/query-without-rowid.db";
    makeDatabase(path, """
        CREATE TABLE kv(v TEXT, k TEXT PRIMARY KEY, n REAL) WITHOUT ROWID;
        CREATE TABLE pair(b INT, a TEXT COLLATE NOCASE, note, PRIMARY KEY (a, b DESC)) WITHOUT ROWID;
        CREATE TABLE big(id INTEGER PRIMARY KEY, body TEXT) WITHOUT ROWID;
        INSERT INTO kv VALUES ('one', 'x', 1), ('two', 'a', 2.5), ('three', 'm', NULL);
        INSERT INTO pair VALUES (1, 'b', 'p'), (2, 'B', 'q'), (3, 'a', 'r'), (1, 'A', 's');
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 400)
        INSERT INTO big SELECT i * 7 % 401, printf('%.*c', i * 3, 'x') FROM n;
        """)?;
    return sameAnswers(path, """
        SELECT * FROM kv
        SELECT k, v, n, typeof(n) FROM kv ORDER BY v
        SELECT * FROM pair
        SELECT a, b FROM pair WHERE a = 'b'
        SELECT count(*), sum(id), sum(length(body)) FROM big
        SELECT id, length(body) FROM big WHERE id BETWEEN 100 AND 105
        SELECT kv.k, pair.note FROM kv JOIN pair ON pair.a = kv.k ORDER BY 1, 2
        SELECT rowid FROM kv
        """);
}

@test
fn windowFunctionsMatchSqlite() -> Result<void, TestFailure> {
    let path = "out/query-windows.db";
    makeDatabase(path, """
        CREATE TABLE s(id INTEGER PRIMARY KEY, grp TEXT, v INT, r REAL, name TEXT COLLATE NOCASE);
        INSERT INTO s(grp, v, r, name) VALUES
            ('a', 1, 1.5, 'x'), ('a', 3, 2.5, 'Y'), ('a', 3, NULL, 'z'), ('a', 7, 0.5, 'y'),
            ('b', 2, 4.0, 'p'), ('b', NULL, 1.0, 'q'), ('b', 5, 2.0, 'P'),
            ('c', 10, 3.0, 'm'), (NULL, 4, 9.0, 'n');
        """)?;
    return sameAnswers(path, """
        SELECT id, row_number() OVER (ORDER BY id DESC), rank() OVER (ORDER BY v), dense_rank() OVER (ORDER BY v) FROM s ORDER BY id
        SELECT id, grp, v, percent_rank() OVER (PARTITION BY grp ORDER BY v), cume_dist() OVER (PARTITION BY grp ORDER BY v) FROM s ORDER BY id
        SELECT id, ntile(2) OVER (ORDER BY id), ntile(4) OVER (ORDER BY id), ntile(20) OVER (ORDER BY id) FROM s ORDER BY id
        SELECT id, lag(v) OVER (ORDER BY id), lead(v, 2) OVER (ORDER BY id), lag(v, 1, -1) OVER (PARTITION BY grp ORDER BY id), lead(name, 0) OVER (ORDER BY id) FROM s ORDER BY id
        SELECT id, first_value(v) OVER w, last_value(v) OVER w, nth_value(v, 2) OVER w FROM s WINDOW w AS (PARTITION BY grp ORDER BY id) ORDER BY id
        SELECT id, sum(v) OVER (ORDER BY id), count(*) OVER (), count(v) OVER (PARTITION BY grp), avg(r) OVER (PARTITION BY grp ORDER BY id) FROM s ORDER BY id
        SELECT id, sum(v) OVER (ORDER BY v), total(v) OVER (ORDER BY v DESC), max(name) OVER (ORDER BY id), min(r) OVER (PARTITION BY grp) FROM s ORDER BY id
        SELECT id, sum(v) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), sum(v) OVER (ORDER BY id ROWS BETWEEN 2 FOLLOWING AND UNBOUNDED FOLLOWING), sum(v) OVER (ORDER BY id ROWS 2 PRECEDING) FROM s ORDER BY id
        SELECT id, v, sum(id) OVER (ORDER BY v RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING), sum(id) OVER (ORDER BY v DESC RANGE BETWEEN 2 PRECEDING AND CURRENT ROW), sum(id) OVER (ORDER BY r RANGE BETWEEN 0.5 PRECEDING AND 1.5 FOLLOWING) FROM s ORDER BY id
        SELECT id, v, sum(id) OVER (ORDER BY v GROUPS BETWEEN 1 PRECEDING AND 1 FOLLOWING), count(*) OVER (ORDER BY v GROUPS CURRENT ROW), group_concat(id, '.') OVER (ORDER BY v GROUPS BETWEEN 1 FOLLOWING AND 2 FOLLOWING) FROM s ORDER BY id
        SELECT id, v, group_concat(id, ',') OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW), group_concat(id, ',') OVER (ORDER BY v RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE GROUP), group_concat(id, ',') OVER (ORDER BY v GROUPS BETWEEN 1 PRECEDING AND 1 FOLLOWING EXCLUDE TIES) FROM s ORDER BY id
        SELECT id, first_value(id) OVER (ORDER BY v ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW), last_value(id) OVER (ORDER BY v RANGE BETWEEN CURRENT ROW AND CURRENT ROW EXCLUDE TIES) FROM s ORDER BY id
        SELECT id, count(*) FILTER (WHERE v > 2) OVER (ORDER BY id), sum(v) FILTER (WHERE grp = 'a') OVER () FROM s ORDER BY id
        SELECT grp, sum(v), rank() OVER (ORDER BY sum(v) DESC), sum(sum(v)) OVER (ORDER BY grp) FROM s GROUP BY grp ORDER BY grp
        SELECT id, name, rank() OVER (ORDER BY name) FROM s ORDER BY id
        SELECT id, row_number() OVER (PARTITION BY name ORDER BY id) FROM s ORDER BY id
        SELECT id, v FROM s ORDER BY row_number() OVER (ORDER BY v DESC, id)
        SELECT id, sum(v) OVER win FROM s WINDOW win AS (ORDER BY id), other AS (ORDER BY v) ORDER BY id
        SELECT id, sum(v) OVER (win ROWS 1 PRECEDING) FROM s WINDOW win AS (PARTITION BY grp ORDER BY id) ORDER BY id
        SELECT DISTINCT grp, count(*) OVER (PARTITION BY grp) FROM s ORDER BY 1
        SELECT id, row_number() OVER () FROM s WHERE v > 2 ORDER BY id LIMIT 3
        SELECT id, grp, row_number() OVER (PARTITION BY grp ORDER BY id DESC) FROM s
        SELECT id, sum(v) OVER (ORDER BY id ROWS BETWEEN -1 PRECEDING AND CURRENT ROW) FROM s
        SELECT id, sum(v) OVER (ORDER BY id RANGE BETWEEN 'x' PRECEDING AND CURRENT ROW) FROM s
        SELECT ntile(0) OVER () FROM s
        SELECT nth_value(v, 0) OVER () FROM s
        SELECT lag(v, -1) OVER () FROM s
        SELECT count(DISTINCT v) OVER () FROM s
        SELECT row_number() FILTER (WHERE v > 1) OVER () FROM s
        SELECT id FROM s WHERE row_number() OVER () > 1
        SELECT sum(v) OVER nosuch FROM s
        SELECT abs(v) OVER () FROM s
        SELECT sum(v) OVER (ORDER BY v, id RANGE 1 PRECEDING) FROM s
        """);
}

@test
fn windowFunctionsInContext() -> Result<void, TestFailure> {
    let path = "out/query-windows-context.db";
    makeDatabase(path, """
        CREATE TABLE t(id INTEGER PRIMARY KEY, g INT, x INT);
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 20000)
        INSERT INTO t SELECT i, i % 7, (i * 7919) % 1000 FROM n;
        CREATE VIEW ranked AS SELECT id, g, x, rank() OVER (PARTITION BY g ORDER BY x DESC) AS rk FROM t;
        """)?;
    return sameAnswers(path, """
        SELECT count(*), sum(rk), max(rk) FROM ranked
        SELECT id, g, x FROM ranked WHERE rk = 1 ORDER BY g, id LIMIT 10
        SELECT g, max(running) FROM (SELECT g, sum(x) OVER (PARTITION BY g ORDER BY id) AS running FROM t) GROUP BY g ORDER BY g
        WITH w AS (SELECT id, lag(x) OVER (ORDER BY id) AS prev, x FROM t) SELECT count(*), sum(x - prev) FROM w WHERE prev IS NOT NULL
        SELECT id, (SELECT count(*) FROM (SELECT row_number() OVER () FROM t WHERE g = o.g AND id < o.id)) FROM t AS o WHERE id < 6 ORDER BY id
        SELECT sum(c) FROM (SELECT count(*) OVER (ORDER BY id ROWS BETWEEN 3 PRECEDING AND 3 FOLLOWING) AS c FROM t)
        SELECT id, x, avg(x) OVER (ORDER BY id ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) FROM t WHERE id <= 8 ORDER BY id
        SELECT 1, row_number() OVER () UNION ALL SELECT 2, rank() OVER (ORDER BY 1)
        """);
}

@test
fn rightAndFullJoinsMatchSqlite() -> Result<void, TestFailure> {
    let path = "out/query-right-joins.db";
    makeDatabase(path, """
        CREATE TABLE a(id INTEGER PRIMARY KEY, k INT, av TEXT);
        CREATE TABLE b(id INTEGER PRIMARY KEY, k INT, bv TEXT);
        CREATE TABLE c(k INT, cv TEXT);
        INSERT INTO a VALUES (1, 1, 'a1'), (2, 2, 'a2'), (3, 2, 'a3'), (4, NULL, 'a4');
        INSERT INTO b VALUES (1, 2, 'b2'), (2, 3, 'b3'), (3, NULL, 'bn'), (4, 5, 'b5');
        INSERT INTO c VALUES (3, 'c3'), (5, 'c5'), (9, 'c9');
        """)?;
    return sameAnswers(path, """
        SELECT av, bv FROM a RIGHT JOIN b ON a.k = b.k ORDER BY bv, av
        SELECT av, bv FROM a FULL JOIN b ON a.k = b.k ORDER BY av, bv
        SELECT av, bv FROM a FULL OUTER JOIN b USING (k) ORDER BY av, bv
        SELECT k, av, bv FROM a NATURAL FULL JOIN b ORDER BY 2, 3
        SELECT av, bv, cv FROM a RIGHT JOIN b ON a.k = b.k RIGHT JOIN c ON c.k = b.k ORDER BY cv, av
        SELECT av, bv, cv FROM a FULL JOIN b ON a.k = b.k LEFT JOIN c ON c.k = b.k ORDER BY av, bv
        SELECT av, bv, cv FROM a LEFT JOIN b ON a.k = b.k FULL JOIN c ON c.k = coalesce(b.k, a.k) ORDER BY av, bv, cv
        SELECT av, bv FROM a RIGHT JOIN b ON a.k = b.k WHERE av IS NULL ORDER BY bv
        SELECT count(*), count(av), count(bv) FROM a FULL JOIN b ON a.k = b.k
        SELECT b.id, av FROM a RIGHT JOIN b ON a.k = b.k AND b.id = 1 ORDER BY b.id, av
        SELECT av, x FROM a RIGHT JOIN (SELECT 2 AS x UNION ALL SELECT 7) ON a.k = x ORDER BY x, av
        SELECT av, bv FROM a RIGHT JOIN b ON a.k = b.k ORDER BY bv LIMIT 2
        SELECT * FROM a RIGHT JOIN b ON a.k = b.k WHERE b.id = 2
        SELECT * FROM a FULL JOIN b USING (k) ORDER BY av, bv
        SELECT a.*, b.k FROM a NATURAL RIGHT JOIN b ORDER BY bv
        """);
}

/// The result columns' names, joined by `|`, as `sqlite3 -header` prints them; or the error.
fn theirNames(path: StringView, sql: StringView) -> String {
    var arguments = Vector<StringView>.create();
    arguments.push("-header")!;
    arguments.push(path)!;
    arguments.push(sql)!;
    let output = Process.capture("sqlite3", borrow arguments, "".bytes())!;
    let text = textFromBytesLossy(output.stdout.view())!;
    let first = text.view().splitOnce("\n") ?? TextHalves { left: text.view(), right: "" };
    return String.from(first.left)!;
}

fn ourNames(session: borrow mut Session, sql: StringView) -> String {
    let none = Vector<SqliteValue>.create();
    var text = String.create();
    match (session.query(sql, none.view())) {
        Ok(result) => {
            for (i in 0..result.columns.length) {
                if (i != 0) {
                    text.append("|")!;
                }
                text.append(result.columns[i].view())!;
            }
        }
        Err(e) => { text.append(e.message())!; }
    }
    return text;
}

@test
fn resultColumnNamesMatchSqlite() -> Result<void, TestFailure> {
    let path = "out/query-names.db";
    makeDatabase(path, """
        CREATE TABLE t(abc INTEGER PRIMARY KEY, Def TEXT, "odd name" REAL);
        INSERT INTO t VALUES (1, 'x', 2.5);
        CREATE VIEW v AS SELECT abc + 1, Def AS d FROM t;
        """)?;
    var session = Session.open(path)!;
    let queries = [
        "SELECT ABC, T.def, \"Abc\", t.\"DEF\", main.t.abc, [abc], rowid, _ROWID_ FROM t",
        "SELECT * FROM t",
        "SELECT t.* FROM t",
        "SELECT abc  +  1, (SELECT 1), count(*), x'01', 'str', -abc, CAST(abc AS TEXT), abs( abc ) FROM t",
        "SELECT abc AS z, \"odd name\", Def || 'y' FROM t",
        "SELECT 1 -- note\n, 2/*x*/ ,    3   ",
        "SELECT * FROM v",
        "SELECT x FROM (SELECT abc AS x FROM t)",
        "SELECT abc FROM (SELECT abc FROM t)",
        "VALUES (1, 2), (3, 4)",
        "SELECT * FROM (VALUES (1, 'a'))",
        "SELECT abc, Def FROM t UNION SELECT 1, 2",
        "SELECT (abc), ((Def)) FROM t",
        "SELECT a.abc, b.Def FROM t AS a JOIN t AS b USING (abc)",
        "SELECT row_number() OVER (ORDER BY abc) FROM t",
        "WITH c(n) AS (SELECT 1) SELECT n, * FROM c",
    ];
    var failures = String.create();
    for (q in 0..queries.length) {
        let theirs = theirNames(path, queries[q]);
        let mine = ourNames(mut session, queries[q]);
        if (theirs.view() != mine.view()) {
            failures.append(queries[q])!;
            failures.append("\n  sqlite3:     ")!;
            failures.append(theirs.view())!;
            failures.append("\n  this engine: ")!;
            failures.append(mine.view())!;
            failures.append("\n")!;
        }
    }
    if (failures.length != 0) {
        return Check.fail(failures.view());
    }
    return Ok();
}

@test
fn indexSeeksGiveTheSameRows() -> Result<void, TestFailure> {
    let path = "out/query-index-seeks.db";
    makeDatabase(path, """
        CREATE TABLE t(id INTEGER PRIMARY KEY, n INT, s TEXT, c TEXT COLLATE NOCASE, b, r REAL, UNIQUE (n, s));
        CREATE INDEX t_s ON t(s);
        CREATE INDEX t_c ON t(c);
        CREATE INDEX t_b ON t(b);
        CREATE INDEX t_r_desc ON t(r DESC);
        CREATE INDEX t_s_binary ON t(c COLLATE BINARY);
        INSERT INTO t(n, s, c, b, r) VALUES
            (1, '1', 'Abc', 1, 1.0), (2, '2', 'abc', '1', 2.5), (3, '10', 'ABD', x'31', NULL), (NULL, NULL, NULL, NULL, 3),
            (5, 'x', 'b', 2.0, -1), (6, '05', 'B', 'abc', 6), (7, '7', 'c', NULL, 7.5), (8, ' 8', 'd', 8, 8);
        CREATE TABLE big(id INTEGER PRIMARY KEY, k INT, tag TEXT);
        CREATE INDEX big_k ON big(k);
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 20000)
        INSERT INTO big SELECT i, i % 500, 'tag' || (i % 37) FROM n;
        CREATE TABLE small(k INT, label TEXT);
        INSERT INTO small VALUES (3, 'three'), (499, 'last'), (777, 'none'), (NULL, 'null');
        """)?;
    return sameAnswers(path, """
        SELECT id FROM t WHERE n = 2
        SELECT id FROM t WHERE n = '2'
        SELECT id FROM t WHERE s = 1
        SELECT id FROM t WHERE s = '1'
        SELECT id FROM t WHERE s = 5
        SELECT id FROM t WHERE s = 8
        SELECT id FROM t WHERE c = 'abc' ORDER BY id
        SELECT id FROM t WHERE c = 'ABC' COLLATE BINARY ORDER BY id
        SELECT id FROM t WHERE b = 1 ORDER BY id
        SELECT id FROM t WHERE b = '1' ORDER BY id
        SELECT id FROM t WHERE b = x'31'
        SELECT id FROM t WHERE r = 3 ORDER BY id
        SELECT id FROM t WHERE r > 2 AND r <= 7.5 ORDER BY id
        SELECT id FROM t WHERE n > 2 ORDER BY id
        SELECT id FROM t WHERE n < 6 ORDER BY id
        SELECT id FROM t WHERE n BETWEEN 2 AND 6 ORDER BY id
        SELECT id FROM t WHERE n >= '3' AND n < '7' ORDER BY id
        SELECT id FROM t WHERE s > '1' ORDER BY id
        SELECT id FROM t WHERE s < 5 ORDER BY id
        SELECT id FROM t WHERE c >= 'b' ORDER BY id
        SELECT id FROM t WHERE n = 1 AND s = '1'
        SELECT id FROM t WHERE n = 2 AND s = 2
        SELECT id FROM t WHERE n IS NULL
        SELECT id FROM t WHERE n = NULL
        SELECT id FROM t WHERE s IS NULL AND n IS NULL
        SELECT id FROM t WHERE 6 = n
        SELECT id FROM t WHERE 6 < n ORDER BY id
        SELECT id FROM t WHERE n = 2.0
        SELECT id FROM t WHERE n = 2.5
        SELECT id FROM t WHERE s = n ORDER BY id
        SELECT count(*), sum(id) FROM big WHERE k = 7
        SELECT count(*), sum(id) FROM big WHERE k BETWEEN 10 AND 20 AND tag = 'tag5'
        SELECT small.label, count(big.id), sum(big.id) FROM small LEFT JOIN big ON big.k = small.k GROUP BY small.label ORDER BY 1
        SELECT small.label, big.id FROM small JOIN big ON big.k = small.k WHERE big.id < 1000 ORDER BY 2
        SELECT s.label, b.id FROM small AS s LEFT JOIN big AS b ON b.k = s.k AND b.id > 19000 ORDER BY 1, 2
        SELECT count(*) FROM small AS s, big AS b WHERE b.k = s.k + 1
        SELECT label FROM small WHERE EXISTS (SELECT 1 FROM big WHERE big.k = small.k AND big.id > 19990) ORDER BY 1
        SELECT id FROM t WHERE n = :missing
        """);
}

@test
fn negativeZeroLiterals() -> Result<void, TestFailure> {
    let path = "out/query-negative-zero.db";
    makeDatabase(path, "CREATE TABLE t(x REAL DEFAULT -0.0, y); INSERT INTO t(y) VALUES (0.0);")?;
    return sameAnswers(path, """
        SELECT -0.0, - 0.0, -(0.0), 1 / -0.0, atan2(0, -0.0), pow(-0.0, -1), -0, -0.0 = 0.0
        SELECT x, -y, atan2(0, x), atan2(0, -y) FROM t
        SELECT -1e-320, -1.5, - -2.5, -'0.0'
        """);
}

@test
fn inListSeeksGiveTheSameRows() -> Result<void, TestFailure> {
    let path = "out/query-in-seeks.db";
    makeDatabase(path, """
        CREATE TABLE t(id INTEGER PRIMARY KEY, n INT, s TEXT COLLATE NOCASE, d INT, UNIQUE (n, s));
        CREATE INDEX t_s ON t(s);
        CREATE INDEX t_d ON t(d DESC, n);
        INSERT INTO t(n, s, d) VALUES (1, 'a', 5), (2, 'B', 4), (3, 'c', 3), (NULL, 'b', 2), (2, 'x', 1), (5, NULL, NULL), (6, '6', 6);
        CREATE TABLE big(id INTEGER PRIMARY KEY, k INT);
        CREATE INDEX big_k ON big(k);
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 20000)
        INSERT INTO big SELECT i, i % 1000 FROM n;
        """)?;
    return sameAnswers(path, """
        SELECT id FROM t WHERE n IN (1, 3, 5)
        SELECT id FROM t WHERE n IN (3, 1, 3, NULL)
        SELECT id FROM t WHERE n IN ('2', 2.0)
        SELECT id FROM t WHERE s IN ('A', 'b')
        SELECT id FROM t WHERE s IN (6, 'C')
        SELECT id FROM t WHERE d IN (1, 5, 3)
        SELECT id FROM t WHERE d IN (5, 4) AND n > 1
        SELECT id FROM t WHERE n IN (2) AND s IN ('b', 'x', 'X')
        SELECT id FROM t WHERE n IN (2, 6) AND s = 'x'
        SELECT id FROM t WHERE n NOT IN (1, 2) ORDER BY id
        SELECT id FROM t WHERE n IN () ORDER BY id
        SELECT count(*), sum(id) FROM big WHERE k IN (1, 500, 999, 1000, 77)
        SELECT t.id, count(big.id) FROM t JOIN big ON big.k IN (t.n, t.d) GROUP BY t.id ORDER BY 1
        SELECT id FROM t WHERE n IN (SELECT 2) ORDER BY id
        """);
}

@test
fn orderedAggregatesMatchSqlite() -> Result<void, TestFailure> {
    let path = "out/query-ordered-aggregates.db";
    makeDatabase(path, """
        CREATE TABLE t(g, x, y);
        INSERT INTO t VALUES (1, 'a', 3), (1, 'b', 1), (1, 'c', 2), (2, 'd', NULL), (2, 'e', 5), (2, 'd', 4), (3, NULL, 1);
        """)?;
    return sameAnswers(path, """
        SELECT g, group_concat(x ORDER BY y), group_concat(x, '-' ORDER BY y DESC, x), string_agg(x, ';' ORDER BY x DESC) FROM t GROUP BY g ORDER BY g
        SELECT group_concat(DISTINCT x ORDER BY x DESC), json_group_array(x ORDER BY y), json_group_object(x, y ORDER BY y DESC) FROM t
        SELECT group_concat(x ORDER BY y NULLS LAST) FILTER (WHERE g > 1) FROM t
        SELECT max(x ORDER BY y), count(x ORDER BY y), sum(y ORDER BY x) FROM t
        SELECT group_concat(x ORDER BY 1) FROM t
        SELECT abs(1 ORDER BY 1)
        SELECT group_concat(x ORDER BY x) OVER () FROM t
        SELECT row_number(ORDER BY 1) OVER () FROM t LIMIT 1
        SELECT count(* ORDER BY 1) FROM t
        """);
}

@test
fn returningColumnNamesMatchSqlite() -> Result<void, TestFailure> {
    let statements = [
        "UPDATE t AS q SET a = q.a || '!' WHERE q.id = 1 RETURNING a, id  +  1, a AS z, t.b, ID, rowid",
        "DELETE FROM t AS d WHERE d.b = 20 RETURNING *, b*2",
        "INSERT INTO t VALUES (3, 'z', 30) RETURNING id, upper( a ), _rowid_",
    ];
    var failures = String.create();
    for (i in 0..statements.length) {
        let path = "out/query-returning-names.db";
        let _ = File.remove(path);
        makeDatabase(path, "CREATE TABLE t(id INTEGER PRIMARY KEY, a, b UNIQUE); INSERT INTO t VALUES (1, 'x', 10), (2, 'y', 20);")?;
        let theirs = theirNames(path, statements[i]);
        let _ = File.remove(path);
        makeDatabase(path, "CREATE TABLE t(id INTEGER PRIMARY KEY, a, b UNIQUE); INSERT INTO t VALUES (1, 'x', 10), (2, 'y', 20);")?;
        var session = Session.open(path)!;
        let mine = ourNames(mut session, statements[i]);
        if (theirs.view() != mine.view()) {
            failures.append(statements[i])!;
            failures.append("\n  sqlite3:     ")!;
            failures.append(theirs.view())!;
            failures.append("\n  this engine: ")!;
            failures.append(mine.view())!;
            failures.append("\n")!;
        }
    }
    if (failures.length != 0) {
        return Check.fail(failures.view());
    }
    return Ok();
}

@test
fn parenthesizedJoinsMatchSqlite() -> Result<void, TestFailure> {
    let path = "out/query-join-groups.db";
    makeDatabase(path, """
        CREATE TABLE a(id INTEGER PRIMARY KEY, x);
        CREATE TABLE b(id INTEGER PRIMARY KEY, aid, y);
        CREATE TABLE c(id INTEGER PRIMARY KEY, bid, z);
        INSERT INTO a VALUES (1, 'a1'), (2, 'a2'), (3, 'a3');
        INSERT INTO b VALUES (1, 1, 'b1'), (2, 1, 'b2'), (3, 2, 'b3');
        INSERT INTO c VALUES (1, 1, 'c1'), (2, 3, 'c3'), (3, 9, 'c9');
        """)?;
    return sameAnswers(path, """
        SELECT x, y, z FROM (a JOIN b ON b.aid = a.id) JOIN c ON c.bid = b.id ORDER BY 1, 2, 3
        SELECT x, y, z FROM a JOIN (b JOIN c ON c.bid = b.id) ON b.aid = a.id ORDER BY 1, 2, 3
        SELECT x, y, z FROM (a JOIN b ON b.aid = a.id) LEFT JOIN c ON c.bid = b.id ORDER BY 1, 2, 3
        SELECT x, y, z FROM a, (b JOIN c ON c.bid = b.id) WHERE b.aid = a.id ORDER BY 1, 2, 3
        SELECT x, y FROM (a JOIN b ON b.aid = a.id) ORDER BY 1, 2
        SELECT count(*) FROM ((a JOIN b ON b.aid = a.id) JOIN c ON c.bid = b.id)
        SELECT x FROM (a) ORDER BY 1
        """);
}

@test
fn badTokensAreReportedAsSqliteReportsThem() -> Result<void, TestFailure> {
    let path = "out/query-bad-tokens.db";
    makeDatabase(path, "CREATE TABLE t(x)")?;
    return sameAnswers(path, """
        SELECT 'abc
        SELECT "abc
        SELECT x'12
        SELECT [abc
        SELECT x'1G'
        SELECT 12abc
        SELECT 0x
        SELECT 1_000
        SELECT 1__0
        SELECT #
        SELECT €
        SELECT 3 +
        SELECT 3 +;
        SELECT 1;;
        """);
}
