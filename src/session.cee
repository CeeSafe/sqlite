// A connection to a database file: statements run against it in transactions of its writable pager.
//
// The C# engine loaded each table into memory the first time a statement changed it, and wrote whole tables back
// at commit. Here a statement's changes go to the pages they touch, held by the pager until the transaction
// commits, and reads see them; a commit journals and writes those pages only.

/// The result of a statement: its column names and its rows.
public struct QueryResult {
    public columns: Vector<String>;
    public rows: Vector<Vector<SqliteValue>>;
}

public struct Session {
    /// The database statements work on now: `active` in the list of databases (main is 0). The others wait in
    /// `stash`, which has `null` at the active one's place.
    pager: WritablePager;
    catalog: SchemaCatalog;
    entries: Vector<SchemaEntry>;
    active: usize;
    stash: Vector<DatabaseState?>;
    /// Each database's name (`main`, `temp`, or the name ATTACH gave), its file, and the file as PRAGMA
    /// database_list shows it (empty for TEMP and private databases).
    databaseNames: Vector<String>;
    databasePaths: Vector<String>;
    databaseShownPaths: Vector<String>;
    /// The TEMP database's place in the list, once a TEMP object made it.
    tempIndex: usize?;
    /// While a view or trigger stored outside TEMP compiles: its database, the only one its names may find.
    pinnedDatabase: usize?;
    /// Rows changed by the last INSERT, UPDATE or DELETE, and by all since the session opened.
    changes: i64;
    totalChanges: i64;
    lastInsertRowid: i64;
    /// Inside BEGIN … COMMIT: statements do not commit on their own.
    inTransaction: bool;
    /// PRAGMA foreign_keys, synchronous, cache_size and busy_timeout.
    foreignKeys: bool;
    synchronous: i64;
    cacheSize: i64;
    busyTimeout: i64;
    /// The OR action of the constraint (or RAISE) that failed the running statement, when it is FAIL or ROLLBACK:
    /// FAIL keeps the statement's earlier changes, ROLLBACK ends the transaction.
    conflictFailure: ConflictAction?;
    /// Indexes the running statement left to be rebuilt (by table and root), which a FAIL must rebuild.
    staleIndexes: Vector<StaleIndex>;
    /// The rows the running INSERT, UPDATE or DELETE has changed so far: what changes() says after an OR FAIL.
    runningChanges: i64;
    /// SAVEPOINT names open, innermost last, each with its level in the pager; and whether the outermost began
    /// the transaction (so that releasing it commits).
    savepoints: Vector<NamedSavepoint>;
    savepointBegan: bool;
    /// PRAGMA legacy_alter_table: RENAME TO leaves views and trigger bodies alone (SQLite before 3.26).
    legacyAlterTable: bool;
    /// The trigger firing now, and the names of those running.
    trigger: TriggerContext?;
    activeTriggers: Vector<String>;

    /// Opens the database file at `path`, making an empty database if there is none.
    public fn open(path: StringView) -> Result<Session, SqliteError> {
        if ((fileLength(path)? ?? 0) == 0) {
            var writer = DatabaseWriter.create(WriterOptions.defaults())?;
            writer.writeToFile(path)?;
        }
        var pager = WritablePager.open(path)?;
        let entries = readSchemaEntries(mut pager)?;
        let catalog = SchemaCatalog.fromEntries(entries.view())?;
        var stash = Vector<DatabaseState?>.create();
        stash.push(null)?;
        var names = Vector<String>.create();
        names.push(String.from("main")?)?;
        var paths = Vector<String>.create();
        paths.push(String.from(path)?)?;
        var shownPaths = Vector<String>.create();
        shownPaths.push(String.from(path)?)?;
        return Ok(Session {
            pager: pager,
            catalog: catalog,
            entries: entries,
            active: 0,
            stash: stash,
            databaseNames: names,
            databasePaths: paths,
            databaseShownPaths: shownPaths,
            tempIndex: null,
            pinnedDatabase: null,
            changes: 0,
            totalChanges: 0,
            lastInsertRowid: 0,
            inTransaction: false,
            foreignKeys: false,
            synchronous: 2,
            cacheSize: -2000,
            busyTimeout: 0,
            legacyAlterTable: false,
            savepoints: Vector<NamedSavepoint>.create(),
            conflictFailure: null,
            staleIndexes: Vector<StaleIndex>.create(),
            runningChanges: 0,
            savepointBegan: false,
            trigger: null,
            activeTriggers: Vector<String>.create(),
        });
    }

    /// Forgets every page and the schema read so far, after another connection changed the file: the next
    /// statement reads them afresh. The settings and change counts stay. (For the API's connections, which call it
    /// when a transaction starts and the file's change counter moved since their last one.)
    fn reopen(borrow mut this) -> Result<void, SqliteError> {
        let path = String.from(this.pager.filePath())?;
        this.pager = WritablePager.open(path.view())?;
        return this.reloadSchema();
    }

    /// Closes the database, forgetting a transaction in progress. In WAL mode the log is checkpointed into the
    /// file and removed, as SQLite does when its last connection closes.
    public fn close(this) -> Result<void, SqliteError> {
        var me = this;
        me.closeOthers()?;
        return me.pager.close();
    }

    /// What `close` does, for an owner that keeps the session (a connection with a drop block).
    fn closeLog(borrow mut this) -> Result<void, SqliteError> {
        this.inTransaction = false;
        this.closeOthers()?;
        return this.pager.closeLog();
    }

    /// Reads the schema again, after a statement changed it.
    fn reloadSchema(borrow mut this) -> Result<void, SqliteError> {
        this.entries = readSchemaEntries(mut this.pager)?;
        this.catalog = SchemaCatalog.fromEntries(this.entries.view())?;
        return Ok();
    }

    /// The CREATE VIEW statement of the view called `name`.
    fn viewSql(borrow this, name: StringView) -> Result<String?, SqliteError> {
        for (i in 0..this.entries.length) {
            let entry = borrow this.entries[i];
            if (entry.kind.view() == "view" && entry.name.view().equalsIgnoreAsciiCase(name)) {
                if (borrow entry.sql is Some(sql)) {
                    return Ok(sql.clone()?);
                }
            }
        }
        return Ok(null);
    }

    /// The CREATE INDEX statement of the index called `name`.
    fn indexSql(borrow this, name: StringView) -> Result<String?, SqliteError> {
        for (i in 0..this.entries.length) {
            let entry = borrow this.entries[i];
            if (entry.kind.view() == "index" && entry.name.view().equalsIgnoreAsciiCase(name)) {
                if (borrow entry.sql is Some(sql)) {
                    return Ok(sql.clone()?);
                }
            }
        }
        return Ok(null);
    }

    /// Whether any trigger is on the table called `name`.
    fn hasTriggers(borrow this, name: StringView) -> bool {
        for (i in 0..this.entries.length) {
            if (this.entries[i].kind.view() == "trigger" && this.entries[i].tableName.view().equalsIgnoreAsciiCase(
                name,
            )) {
                return true;
            }
        }
        return false;
    }

    /// Runs SQL inside the current statement, leaving the change counts as they were.
    fn runInternal(borrow mut this, sql: StringView, params: Slice<SqliteValue>) -> Result<QueryResult, SqliteError> {
        let changes = this.changes;
        let total = this.totalChanges;
        let last = this.lastInsertRowid;
        let stmt = Parser.parseStatement(sql)?;
        let result = this.run(borrow stmt, sql, params);
        this.changes = changes;
        this.totalChanges = total;
        this.lastInsertRowid = last;
        return result;
    }

    /// sqlite_sequence's value for the AUTOINCREMENT table `name`.
    fn sequenceValue(borrow mut this, name: StringView) -> Result<i64?, SqliteError> {
        if (this.catalog.table("sqlite_sequence")?.isNull()) {
            return Ok(null);
        }
        var params = Vector<SqliteValue>.create();
        params.push(SqliteValue.text(name)?)?;
        let result = this.runInternal("SELECT max(seq) FROM sqlite_sequence WHERE name = ?", params.view())?;
        if (result.rows.length != 0 && result.rows[0][0] is SqliteValue.Integer(n)) {
            return Ok(n);
        }
        return Ok(null);
    }

    /// Records that the AUTOINCREMENT table `name` used `rowId`.
    fn updateSequence(borrow mut this, name: StringView, rowId: i64) -> Result<void, SqliteError> {
        let current = this.sequenceValue(name)?;
        var params = Vector<SqliteValue>.create();
        params.push(SqliteValue.text(name)?)?;
        params.push(SqliteValue.Integer(rowId))?;
        if (current is Some(seq)) {
            if (seq < rowId) {
                let _ = this.runInternal("UPDATE sqlite_sequence SET seq = ?2 WHERE name = ?1", params.view())?;
            }
        } else {
            let _ = this.runInternal("INSERT INTO sqlite_sequence(name, seq) VALUES (?1, ?2)", params.view())?;
        }
        return Ok();
    }

    /// Forgets the AUTOINCREMENT counter of a dropped table.
    fn removeSequence(borrow mut this, name: StringView) -> Result<void, SqliteError> {
        var params = Vector<SqliteValue>.create();
        params.push(SqliteValue.text(name)?)?;
        let _ = this.runInternal("DELETE FROM sqlite_sequence WHERE name = ?", params.view())?;
        return Ok();
    }

    /// Runs one SQL statement with positional parameters (?, ?N, :name in order of first use).
    public fn query(borrow mut this, sql: StringView, params: Slice<SqliteValue>) -> Result<QueryResult, SqliteError> {
        // The statement's text, as sqlite_schema keeps a definition; token offsets are into it.
        let written = sql.trim();
        var text = written;
        while (text.endsWith(";")) {
            text = text[0..text.length - 1].trimEnd();
        }
        // Parsed as written, so that `SELECT 3 +;` is an error near ";" as in SQLite; the text without its
        // semicolons is what a definition keeps.
        let stmt = Parser.parseStatement(written)?;
        this.beginStatementAll();
        this.conflictFailure = null;
        this.runningChanges = 0;
        let result = this.run(borrow stmt, text, params);
        let failure = replace(mut this.conflictFailure, null);
        let keep = result.isOk() || failure == Some(ConflictAction.Fail);
        if (result.isOk()) {
            this.endStatementAll();
        } else if (failure == Some(ConflictAction.Fail)) {
            // OR FAIL: the rows changed before the failure stay, and count; indexes left to rebuild are rebuilt.
            this.changes = this.runningChanges;
            this.totalChanges += this.runningChanges;
            rebuildStaleIndexes(this)?;
            this.endStatementAll();
            this.reloadAllSchemas()?;
        } else if (failure == Some(ConflictAction.Rollback) && this.inTransaction) {
            // OR ROLLBACK: the whole transaction goes.
            this.rollbackAll();
            this.inTransaction = false;
            this.savepoints.clear();
            this.savepointBegan = false;
            this.reloadAllSchemas()?;
        } else if (this.inTransaction) {
            // A failed statement undoes itself alone.
            this.rollbackStatementAll()?;
            this.reloadAllSchemas()?;
        }
        this.staleIndexes.clear();
        if (!this.inTransaction) {
            // Each statement outside BEGIN is a transaction of its own.
            if (keep) {
                this.commitAll()?;
            } else {
                this.rollbackAll();
                this.reloadAllSchemas()?;
            }
        }
        return result;
    }

    /// Runs a statement.
    fn run(
        borrow mut this,
        stmt: borrow Stmt,
        sql: StringView,
        params: Slice<SqliteValue>,
    ) -> Result<QueryResult, SqliteError> {
        // The statement's database is made the active one while it runs.
        let target = this.statementDatabase(stmt)?;
        let previous = this.swapTo(target);
        let result = this.runHere(stmt, sql, params);
        let _ = this.swapTo(previous);
        return result;
    }

    /// The database a statement writes to or defines in: TEMP for a TEMP object, the database a schema name
    /// names, else the one where its table is (TEMP, main, attached, in that order), else main.
    fn statementDatabase(borrow mut this, stmt: borrow Stmt) -> Result<usize, SqliteError> {
        let fallback = this.pinnedDatabase ?? this.active;
        match (stmt) {
            Stmt.Insert(s) => { return this.objectDatabase(borrow s.table, fallback); }
            Stmt.Update(s) => { return this.objectDatabase(borrow s.table, fallback); }
            Stmt.Delete(s) => { return this.objectDatabase(borrow s.table, fallback); }
            Stmt.CreateTable(s) => {
                if (s.temporary) {
                    return this.ensureTemp();
                }
                if (borrow s.name.schema is Some(name)) {
                    return this.databaseNamed(name.view());
                }
                return Ok(0);
            }
            Stmt.CreateView(s) => {
                if (s.temporary) {
                    return this.ensureTemp();
                }
                if (borrow s.name.schema is Some(name)) {
                    return this.databaseNamed(name.view());
                }
                return Ok(0);
            }
            Stmt.CreateIndex(s) => {
                if (borrow s.name.schema is Some(name)) {
                    return this.databaseNamed(name.view());
                }
                let anywhere: String? = null;
                return Ok(this.findTable(borrow anywhere, s.table.view())? ?? 0);
            }
            Stmt.CreateTrigger(s) => {
                if (s.temporary) {
                    return this.ensureTemp();
                }
                if (borrow s.name.schema is Some(name)) {
                    return this.databaseNamed(name.view());
                }
                let anywhere: String? = null;
                let table = this.findTable(borrow anywhere, s.table.view())?;
                return Ok(table ?? this.findObject(borrow anywhere, "view", s.table.view())? ?? 0);
            }
            Stmt.Drop(s) => {
                let kind: StringView = match (s.kind) {
                    DropKind.Table => "table",
                    DropKind.Index => "index",
                    DropKind.View => "view",
                    DropKind.Trigger => "trigger",
                };
                return Ok(
                    this.findObject(
                        borrow s.name.schema,
                        kind,
                        s.name.name.view(),
                    )? ?? (if (borrow s.name.schema is Some(name)) this.databaseNamed(name.view())? else 0),
                );
            }
            Stmt.AlterTable(s) => { return this.objectDatabase(borrow s.table, 0); }
            Stmt.Pragma(s) => {
                if (borrow s.name.schema is Some(name)) {
                    return this.databaseNamed(name.view());
                }
                return Ok(this.active);
            }
            _ => { return Ok(this.active); }
        }
    }

    /// Where the table or view `name` is, or `fallback` when it is nowhere (the error then names it there).
    fn objectDatabase(borrow mut this, name: borrow QualifiedName, fallback: usize) -> Result<usize, SqliteError> {
        if (this.findTable(borrow name.schema, name.name.view())? is Some(i)) {
            return Ok(i);
        }
        if (this.findObject(borrow name.schema, "view", name.name.view())? is Some(i)) {
            return Ok(i);
        }
        if (borrow name.schema is Some(schema)) {
            return this.databaseNamed(schema.view());
        }
        return Ok(fallback);
    }

    /// Runs a statement in the active database.
    fn runHere(
        borrow mut this,
        stmt: borrow Stmt,
        sql: StringView,
        params: Slice<SqliteValue>,
    ) -> Result<QueryResult, SqliteError> {
        match (stmt) {
            Stmt.Insert(s) => { return executeInsert(s, params, this); }
            Stmt.Update(s) => { return executeUpdate(s, params, this); }
            Stmt.Delete(s) => { return executeDelete(s, params, this); }
            Stmt.CreateTable(s) => {
                executeCreateTable(s, sql, this)?;
                return Ok(emptyResult());
            }
            Stmt.CreateIndex(s) => {
                executeCreateIndex(s, sql, this)?;
                return Ok(emptyResult());
            }
            Stmt.CreateView(s) => {
                executeCreateView(s, sql, this)?;
                return Ok(emptyResult());
            }
            Stmt.Pragma(s) => { return executePragma(s, this); }
            Stmt.CreateTrigger(s) => {
                executeCreateTrigger(s, sql, this)?;
                return Ok(emptyResult());
            }
            Stmt.AlterTable(s) => {
                executeAlterTable(s, sql, this)?;
                return Ok(emptyResult());
            }
            Stmt.Drop(s) => {
                executeDrop(s, this)?;
                return Ok(emptyResult());
            }
            Stmt.Select(select) => {
                var compiler = newCompiler(this)?;
                let plan = compileSelect(mut compiler, select, this)?;
                var frame = newFrame(mut compiler, params, this)?;
                let rows = runSelect(borrow plan, mut frame, this)?;
                return Ok(QueryResult { columns: cloneStrings(borrow plan.columnNames)?, rows: rows });
            }
            Stmt.Begin(_) => {
                if (this.inTransaction) {
                    return Err(sqlError("cannot start a transaction within a transaction"));
                }
                this.inTransaction = true;
                return Ok(emptyResult());
            }
            Stmt.Commit => {
                if (!this.inTransaction) {
                    return Err(sqlError("cannot commit - no transaction is active"));
                }
                this.commitAll()?;
                this.inTransaction = false;
                this.savepoints.clear();
                this.savepointBegan = false;
                return Ok(emptyResult());
            }
            Stmt.Rollback(null) => {
                if (!this.inTransaction) {
                    return Err(sqlError("cannot rollback - no transaction is active"));
                }
                this.rollbackAll();
                this.inTransaction = false;
                this.savepoints.clear();
                this.savepointBegan = false;
                this.reloadAllSchemas()?;
                return Ok(emptyResult());
            }
            Stmt.Savepoint(name) => {
                // The statement's own level becomes the savepoint's; a fresh one is the statement's.
                if (!this.inTransaction) {
                    this.inTransaction = true;
                    this.savepointBegan = true;
                }
                let level = this.pager.savepointDepth() - 1;
                this.savepoints.push(NamedSavepoint { name: name.clone()?, level: level })?;
                this.beginStatementAll();
                return Ok(emptyResult());
            }
            Stmt.Release(name) => {
                let at = this.savepointNamed(name.view())?;
                let level = this.savepoints[at].level;
                this.savepoints.truncate(at);
                this.releaseLevelsAll(level);
                if (this.savepoints.length == 0 && this.savepointBegan) {
                    // Releasing the savepoint that began the transaction commits it.
                    this.commitAll()?;
                    this.inTransaction = false;
                    this.savepointBegan = false;
                }
                return Ok(emptyResult());
            }
            Stmt.Rollback(Some(name)) => {
                let at = this.savepointNamed(name.view())?;
                let level = this.savepoints[at].level;
                // The savepoint stays; those inside it go.
                this.savepoints.truncate(at + 1);
                this.rollbackToLevelAll(level)?;
                this.reloadAllSchemas()?;
                return Ok(emptyResult());
            }
            Stmt.Attach(attach) => {
                this.attachDatabase(borrow attach.target, attach.schema.view(), params)?;
                return Ok(emptyResult());
            }
            Stmt.Detach(name) => {
                this.detachDatabase(name.view())?;
                return Ok(emptyResult());
            }
            Stmt.Analyze(target) => {
                executeAnalyze(target, this)?;
                return Ok(emptyResult());
            }
            Stmt.Vacuum(into) => {
                executeVacuum(into, params, this)?;
                return Ok(emptyResult());
            }
            Stmt.Reindex => {
                executeReindex(this)?;
                return Ok(emptyResult());
            }
        }
    }
}

/// An index a statement must rebuild before it ends.
struct StaleIndex {
    table: String;
    root: u32;
}

/// A SAVEPOINT in progress: its name and its level in the pager.
struct NamedSavepoint {
    name: String;
    level: usize;
}

impl Session {
    /// The innermost open savepoint called `name`.
    fn savepointNamed(borrow this, name: StringView) -> Result<usize, SqliteError> {
        var i = this.savepoints.length;
        while (i > 0) {
            i -= 1;
            if (this.savepoints[i].name.view().equalsIgnoreAsciiCase(name)) {
                return Ok(i);
            }
        }
        return Err(namedError("no such savepoint: ", name));
    }
}

fn emptyResult() -> QueryResult =>
    QueryResult { columns: Vector<String>.create(), rows: Vector<Vector<SqliteValue>>.create() };

/// The frame a compiled statement runs in: its slots, parameters and CTEs, and its time.
fn newFrame(
    compiler: borrow mut Compiler,
    params: Slice<SqliteValue>,
    db: borrow Session,
) -> Result<Frame, SqliteError> {
    var frame = Frame.create();
    let _ = frame.pushSlots(compiler.slotsInUse)?;
    frame.params = cloneValues(params)?;
    frame.ctes = replace(mut compiler.ctePlans, Vector<CtePlan?>.create());
    for (i in 0..frame.ctes.length) {
        frame.cteRows.push(null)?;
    }
    for (i in 0..compiler.workingTables) {
        frame.working.push(Vector<Vector<SqliteValue>>.create())?;
    }
    frame.nowMillis = Clock.now().millis();
    fillTriggerSlots(mut frame, db)?;
    return Ok(frame);
}

/// A database of the session while another is active: its pager and schema.
struct DatabaseState {
    pager: WritablePager;
    catalog: SchemaCatalog;
    entries: Vector<SchemaEntry>;
}

/// The databases of a session: main, TEMP once used, and those ATTACH added. One at a time is active (in the
/// session's own fields), which is where DDL and writes go; reads go to each table's own database.
impl Session {
    fn databaseCount(borrow this) -> usize => this.databaseNames.length;

    /// The database called `name` (`main`, `temp`, or an attached one), if there is one.
    fn databaseIndex(borrow this, name: StringView) -> usize? {
        for (i in 0..this.databaseNames.length) {
            if (this.databaseNames[i].view().equalsIgnoreAsciiCase(name)) {
                return i;
            }
        }
        return null;
    }

    /// The database a schema name in a statement names: an error for an unknown one. `temp` is made on demand.
    fn databaseNamed(borrow mut this, name: StringView) -> Result<usize, SqliteError> {
        if (name.equalsIgnoreAsciiCase("temp") || name.equalsIgnoreAsciiCase("temporary")) {
            return this.ensureTemp();
        }
        return Ok(this.databaseIndex(name) ?? {
            return Err(namedError("unknown database ", name));
        });
    }

    fn pagerOf(borrow mut this, i: usize) -> borrow mut WritablePager {
        if (i != this.active && i < this.stash.length) {
            if (borrow mut this.stash[i] is Some(state)) {
                return borrow mut state.pager;
            }
        }
        return borrow mut this.pager;
    }

    fn catalogOf(borrow this, i: usize) -> borrow SchemaCatalog {
        if (i != this.active && i < this.stash.length) {
            if (borrow this.stash[i] is Some(state)) {
                return borrow state.catalog;
            }
        }
        return borrow this.catalog;
    }

    fn entriesOf(borrow this, i: usize) -> borrow Vector<SchemaEntry> {
        if (i != this.active && i < this.stash.length) {
            if (borrow this.stash[i] is Some(state)) {
                return borrow state.entries;
            }
        }
        return borrow this.entries;
    }

    /// Makes database `k` the active one; returns the one that was, for `swapTo` to restore.
    fn swapTo(borrow mut this, k: usize) -> usize {
        let previous = this.active;
        if (k == previous || k >= this.stash.length) {
            return previous;
        }
        let Some(incoming) = replace(mut this.stash[k], null) else {
            return previous;
        };
        let pager = replace(mut this.pager, incoming.pager);
        let catalog = replace(mut this.catalog, incoming.catalog);
        let entries = replace(mut this.entries, incoming.entries);
        this.stash[previous] = DatabaseState { pager: pager, catalog: catalog, entries: entries };
        this.active = k;
        return previous;
    }

    /// The TEMP database, made (as an empty file of its own, removed when the session closes) when first needed.
    fn ensureTemp(borrow mut this) -> Result<usize, SqliteError> {
        if (this.tempIndex is Some(i)) {
            return Ok(i);
        }
        var path = String.from(Environment.variable("TMPDIR") ?? "/tmp")?;
        if (!path.view().endsWith("/")) {
            path.append("/")?;
        }
        path.append("sqlite-temp-")?;
        let bytes = randomBytes(8)?;
        for (b in bytes.view()) {
            path.appendNumber(b as u64)?;
        }
        path.append(".db")?;
        let state = openDatabaseState(path.view())?;
        this.attachState("temp", path.view(), state)?;
        this.databaseShownPaths.push(String.create())?;
        let index = this.databaseNames.length - 1;
        this.tempIndex = index;
        return Ok(index);
    }

    /// Adds a database to the list, with as many savepoint levels as the others have open.
    fn attachState(
        borrow mut this,
        name: StringView,
        path: StringView,
        state: DatabaseState,
    ) -> Result<void, SqliteError> {
        var added = state;
        for (level in 0..this.pager.savepointDepth()) {
            added.pager.beginStatement();
        }
        this.stash.push(added)?;
        this.databaseNames.push(String.from(name)?)?;
        this.databasePaths.push(String.from(path)?)?;
        return Ok();
    }

    /// The database where table `name` is: in `schema` when one is written, else TEMP first, then main, then the
    /// attached ones in order.
    fn findTable(borrow mut this, schema: borrow String?, name: StringView) -> Result<usize?, SqliteError> {
        if (schema is Some(s)) {
            let i = this.databaseNamed(s.view())?;
            return Ok(if (this.catalogOf(i).table(name)?.isSome()) i else null);
        }
        if (this.pinnedDatabase is Some(i)) {
            return Ok(if (this.catalogOf(i).table(name)?.isSome()) i else null);
        }
        let order = this.searchOrder()?;
        for (k in 0..order.length) {
            let i = order[k];
            if (this.catalogOf(i).table(name)?.isSome()) {
                return Ok(i);
            }
        }
        return Ok(null);
    }

    /// The database where object `name` of `kind` ("view", "trigger", "index", or "" for any) is, searched as
    /// `findTable` does.
    fn findObject(
        borrow mut this,
        schema: borrow String?,
        kind: StringView,
        name: StringView,
    ) -> Result<usize?, SqliteError> {
        var order = Vector<usize>.create();
        if (schema is Some(s)) {
            order.push(this.databaseNamed(s.view())?)?;
        } else if (this.pinnedDatabase is Some(i)) {
            order.push(i)?;
        } else {
            order = this.searchOrder()?;
        }
        for (k in 0..order.length) {
            let entries = this.entriesOf(order[k]);
            for (e in 0..entries.length) {
                let entry = borrow entries[e];
                if ((kind.length == 0 || entry.kind.view() == kind) && entry.name.view().equalsIgnoreAsciiCase(name)) {
                    return Ok(order[k]);
                }
            }
        }
        return Ok(null);
    }

    /// TEMP, main, then the attached databases.
    fn searchOrder(borrow this) -> Result<Vector<usize>, AllocError> {
        var order = Vector<usize>.create();
        if (this.tempIndex is Some(t)) {
            order.push(t)?;
        }
        for (i in 0..this.databaseNames.length) {
            if (Some(i) != this.tempIndex) {
                order.push(i)?;
            }
        }
        return Ok(order);
    }

    // Each of these does to every database what the pager method of the same name does to one.
    fn beginStatementAll(borrow mut this) {
        for (i in 0..this.databaseCount()) {
            this.pagerOf(i).beginStatement();
        }
    }

    fn endStatementAll(borrow mut this) {
        for (i in 0..this.databaseCount()) {
            this.pagerOf(i).endStatement();
        }
    }

    fn rollbackStatementAll(borrow mut this) -> Result<void, SqliteError> {
        for (i in 0..this.databaseCount()) {
            this.pagerOf(i).rollbackStatement()?;
        }
        return Ok();
    }

    fn releaseLevelsAll(borrow mut this, level: usize) {
        for (i in 0..this.databaseCount()) {
            this.pagerOf(i).releaseLevels(level);
        }
    }

    fn rollbackToLevelAll(borrow mut this, level: usize) -> Result<void, SqliteError> {
        for (i in 0..this.databaseCount()) {
            this.pagerOf(i).rollbackToLevel(level)?;
        }
        return Ok();
    }

    /// Commits every database the transaction changed, main first. Each file commits atomically with its own
    /// journal; together they do not (SQLite's super-journal is not written).
    fn commitAll(borrow mut this) -> Result<void, SqliteError> {
        for (i in 0..this.databaseCount()) {
            this.pagerOf(i).commit()?;
        }
        return Ok();
    }

    fn rollbackAll(borrow mut this) {
        for (i in 0..this.databaseCount()) {
            this.pagerOf(i).rollback();
        }
    }

    /// Reads every database's schema again.
    fn reloadAllSchemas(borrow mut this) -> Result<void, SqliteError> {
        let previous = this.active;
        for (i in 0..this.databaseCount()) {
            let _ = this.swapTo(i);
            this.reloadSchema()?;
        }
        let _ = this.swapTo(previous);
        return Ok();
    }
}

/// A database file opened for a session, made empty when it does not exist.
fn openDatabaseState(path: StringView) -> Result<DatabaseState, SqliteError> {
    if ((fileLength(path)? ?? 0) == 0) {
        var writer = DatabaseWriter.create(WriterOptions.defaults())?;
        writer.writeToFile(path)?;
    }
    var pager = WritablePager.open(path)?;
    let entries = readSchemaEntries(mut pager)?;
    let catalog = SchemaCatalog.fromEntries(entries.view())?;
    return Ok(DatabaseState { pager: pager, catalog: catalog, entries: entries });
}

/// ATTACH and DETACH, and closing every database.
impl Session {
    fn attachDatabase(
        borrow mut this,
        target: borrow Expr,
        name: StringView,
        params: Slice<SqliteValue>,
    ) -> Result<void, SqliteError> {
        if (this.databaseIndex(
            name,
        ).isSome() || name.equalsIgnoreAsciiCase("main") || name.equalsIgnoreAsciiCase("temp")) {
            var message = String.from("database ")?;
            message.append(name)?;
            message.append(" is already in use")?;
            return Err(SqliteError.Sql(message));
        }
        var attached: usize = 0;
        for (i in 1..this.databaseCount()) {
            if (Some(i) != this.tempIndex) {
                attached += 1;
            }
        }
        if (attached >= 10) {
            return Err(sqlError("too many attached databases - max 10"));
        }
        var compiler = newCompiler(this)?;
        let compiled = compiler.compile(target, this)?;
        var frame = newFrame(mut compiler, params, this)?;
        let value = evaluate(borrow compiled, mut frame, this)?;
        let file = if (value.isNull()) String.create() else valueText(borrow value)?;
        // An empty name (and :memory:) is a private database: a temporary file here, shown without a name.
        var path = file.clone()?;
        var shown = file.clone()?;
        if (file.length == 0 || file.view() == ":memory:") {
            path = String.from(Environment.variable("TMPDIR") ?? "/tmp")?;
            if (!path.view().endsWith("/")) {
                path.append("/")?;
            }
            path.append("sqlite-attached-")?;
            let bytes = randomBytes(8)?;
            for (b in bytes.view()) {
                path.appendNumber(b as u64)?;
            }
            path.append(".db")?;
            shown = String.create();
        }
        let state = openDatabaseState(path.view())?;
        this.attachState(name, path.view(), state)?;
        let at = this.databasePaths.length - 1;
        this.databaseShownPaths.push(shown)?;
        let _ = at;
        return Ok();
    }

    fn detachDatabase(borrow mut this, name: StringView) -> Result<void, SqliteError> {
        if (name.equalsIgnoreAsciiCase("main") || name.equalsIgnoreAsciiCase("temp")) {
            var message = String.from("cannot detach database ")?;
            message.append(name)?;
            return Err(SqliteError.Sql(message));
        }
        let i = this.databaseIndex(name) ?? {
            return Err(namedError("no such database: ", name));
        };
        if (i == this.active || i == 0 || Some(i) == this.tempIndex) {
            return Err(namedError("cannot detach database ", name));
        }
        if (this.pagerOf(i).hasChanges()) {
            var message = String.from("database ")?;
            message.append(name)?;
            message.append(" is locked")?;
            return Err(SqliteError.Sql(message));
        }
        let Some(state) = this.stash.remove(i) else {
            return Ok();
        };
        let _ = this.databaseNames.remove(i);
        let removedPath = this.databasePaths.remove(i);
        let shown = this.databaseShownPaths.remove(i);
        if (this.tempIndex is Some(t)) {
            if (t > i) {
                this.tempIndex = t - 1;
            }
        }
        if (this.active > i) {
            this.active -= 1;
        }
        let pager = state.pager;
        pager.close()?;
        // A private database goes with its file.
        if (shown.length == 0) {
            let _ = File.remove(removedPath.view());
        }
        return Ok();
    }

    /// Closes the databases other than main (checkpointing their logs) and removes TEMP's file.
    fn closeOthers(borrow mut this) -> Result<void, SqliteError> {
        let _ = this.swapTo(0);
        while (this.stash.length > 1) {
            let i = this.stash.length - 1;
            let state = this.stash.remove(i);
            let path = this.databasePaths.remove(i);
            let shown = this.databaseShownPaths.remove(i);
            let _ = this.databaseNames.remove(i);
            if (state is Some(s)) {
                let pager = s.pager;
                pager.close()?;
            }
            if (shown.length == 0) {
                let _ = File.remove(path.view());
                let _ = File.remove(withSuffix(path.view(), "-journal")?.view());
            }
        }
        this.tempIndex = null;
        return Ok();
    }
}
