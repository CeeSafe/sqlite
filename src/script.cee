// Scripts: SQL text that holds many statements, split where SQLite would end each one.
//
// The ends are found as sqlite3_complete (complete.c) finds them: by a small machine over tokens, in which quoted
// text ('', "", ``, []) and comments (-- and /* */) are single tokens, and a CREATE TRIGGER statement ends only at a
// semicolon after `; END`. The C# split on semicolons with regular expressions: it ended a trigger at the first
// `END;`, which may be a CASE's (`SELECT CASE … END; END;`), missed a trigger with a comment before CREATE, and kept
// statements that were only comments.

/// Where one statement of a script is: its first token's start and its last token's end (the closing semicolon
/// and the comments around it left out).
public struct StatementSpan {
    public start: usize;
    public end: usize;
}

/// sqlite3_complete's token classes.
enum ScriptToken {
    Semi,
    Space,
    Other,
    Explain,
    Create,
    Temp,
    Trigger,
    End,
}

/// sqlite3_complete's states: 0 INVALID, 1 START, 2 NORMAL, 3 EXPLAIN, 4 CREATE, 5 TRIGGER, 6 SEMI, 7 END.
fn nextScriptState(state: u8, token: ScriptToken) -> u8 {
    let column: usize = match (token) {
        ScriptToken.Semi => 0,
        ScriptToken.Space => 1,
        ScriptToken.Other => 2,
        ScriptToken.Explain => 3,
        ScriptToken.Create => 4,
        ScriptToken.Temp => 5,
        ScriptToken.Trigger => 6,
        ScriptToken.End => 7,
    };
    let row: [u8; 8] = match (state) {
        0 => [1u8, 0, 2, 3, 4, 2, 2, 2],
        1 => [1u8, 1, 2, 3, 4, 2, 2, 2],
        2 => [1u8, 2, 2, 2, 2, 2, 2, 2],
        3 => [1u8, 3, 3, 2, 4, 2, 2, 2],
        4 => [1u8, 4, 2, 2, 2, 4, 5, 2],
        5 => [6u8, 5, 5, 5, 5, 5, 5, 5],
        6 => [6u8, 6, 5, 5, 5, 5, 5, 7],
        _ => [1u8, 7, 5, 5, 5, 5, 5, 5],
    };
    return row[column];
}

/// The class of the word `word`.
fn scriptWord(word: StringView) -> ScriptToken {
    if (word.equalsIgnoreAsciiCase("create")) {
        return ScriptToken.Create;
    }
    if (word.equalsIgnoreAsciiCase("trigger")) {
        return ScriptToken.Trigger;
    }
    if (word.equalsIgnoreAsciiCase("temp") || word.equalsIgnoreAsciiCase("temporary")) {
        return ScriptToken.Temp;
    }
    if (word.equalsIgnoreAsciiCase("end")) {
        return ScriptToken.End;
    }
    if (word.equalsIgnoreAsciiCase("explain")) {
        return ScriptToken.Explain;
    }
    return ScriptToken.Other;
}

/// Where the quoted text or comment starting at `at` ends: past its closing quote, or the script's end when
/// it is not closed (the parser then reports it).
fn skipQuoted(text: StringView, at: usize, close: u8) -> usize {
    let n = text.length;
    var i = at + 1;
    while (i < n) {
        if (text[i] == close) {
            if (close != ']' && i + 1 < n && text[i + 1] == close) {
                i += 2;
                continue;
            }
            return i + 1;
        }
        i += 1;
    }
    return n;
}

/// The statements of the script `sql`, in order. Empty statements (stray semicolons, comments alone) are left
/// out; text after the last semicolon is a statement when it has any token.
public fn splitScript(sql: StringView) -> Result<Vector<StatementSpan>, AllocError> {
    var spans = Vector<StatementSpan>.create();
    let n = sql.length;
    var state: u8 = 0;
    // The current statement's first token and the end of its last one, while it has one.
    var first: usize? = null;
    var last: usize = 0;
    var i: usize = 0;
    while (i < n) {
        let c = sql[i];
        let start = i;
        var token = ScriptToken.Other;
        if (c == ';') {
            token = ScriptToken.Semi;
            i += 1;
        } else if (isSqlSpace(c)) {
            token = ScriptToken.Space;
            i += 1;
        } else if (c == '-' && i + 1 < n && sql[i + 1] == '-') {
            token = ScriptToken.Space;
            while (i < n && sql[i] != '\n') {
                i += 1;
            }
        } else if (c == '/' && i + 1 < n && sql[i + 1] == '*') {
            token = ScriptToken.Space;
            i += 2;
            while (i < n && !(sql[i] == '*' && i + 1 < n && sql[i + 1] == '/')) {
                i += 1;
            }
            i = (i + 2).min(n);
        } else if (c == '\'' || c == '"' || c == '`') {
            i = skipQuoted(sql, i, c);
        } else if (c == '[') {
            i = skipQuoted(sql, i, ']');
        } else if (isSqlIdStart(c)) {
            while (i < n && isSqlIdChar(sql[i])) {
                i += 1;
            }
            token = scriptWord(sql[start..i]);
        } else {
            i += 1;
        }
        state = nextScriptState(state, token);
        match (token) {
            ScriptToken.Space => {
                // A comment after a statement's tokens is part of its text, as in sqlite3_prepare's: a result
                // column's name runs up to the next token (`SELECT 2 -- two` then `;` names it `2 -- two`).
                if (first.isSome() && c != ';' && !isSqlSpace(c)) {
                    last = i;
                }
            }
            ScriptToken.Semi => {
                if (state == 1) {
                    if (first is Some(f)) {
                        spans.push(StatementSpan { start: f, end: last })?;
                    }
                    first = null;
                } else {
                    // A semicolon inside a trigger's body belongs to the statement.
                    last = i;
                }
            }
            _ => {
                if (first.isNull()) {
                    first = start;
                }
                last = i;
            }
        }
    }
    if (first is Some(f)) {
        spans.push(StatementSpan { start: f, end: last })?;
    }
    return Ok(spans);
}

/// The text of each statement of the script `sql`, as `splitScript` finds them.
public fn splitStatements(sql: StringView) -> Result<Vector<String>, AllocError> {
    let spans = splitScript(sql)?;
    var list = Vector<String>.create();
    for (i in 0..spans.length) {
        list.push(String.from(sql[spans[i].start..spans[i].end])?)?;
    }
    return Ok(list);
}
