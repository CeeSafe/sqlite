// Running SELECT plans.

/// Where a core's rows go as the nested loops produce them.
struct CoreSink {
    rows: Vector<SortedRow>;
    distinctSeen: HashMap<Vector<u8>, bool>?;
    /// Aggregate queries: the groups, and each group's key.
    groups: Vector<GroupState>;
    groupIndex: HashMap<Vector<u8>, usize>;
    /// Stop once this many rows are kept: a query with LIMIT and nothing that needs every row.
    stopAfter: usize?;
    /// A query with ORDER BY and LIMIT: only this many rows (LIMIT and OFFSET) are kept, the first in the order;
    /// the others are let go as they are found, as SQLite's sorter does with a LIMIT.
    keepFirst: usize?;
    /// How many rows have arrived (`SortedRow.arrival`).
    arrived: usize;
    /// A core with window functions: its rows, kept until the windows are computed.
    windowRows: Vector<WindowRow>;
    /// For each RIGHT JOIN source: which of its rows (by their place in its scan) matched.
    rightMatched: Vector<Vector<bool>>;
    /// For each LEFT JOIN group (by its first source): whether a row of the whole group met its ON, and whether
    /// the group is being made NULL.
    groupReached: Vector<bool>;
    groupNulled: Vector<bool>;
}

struct GroupState {
    accumulators: Vector<Accumulator>;
    /// The rows of the core's slots the group's bare columns come from: its first row, as in SQLite, or the row
    /// of its one min() or max().
    slots: Vector<Slot>;
    /// The GROUP BY values: groups come out in their order, as SQLite's sorter gives them.
    key: Vector<SqliteValue>;
}

fn copySlot(slot: borrow Slot) -> Result<Slot, AllocError> =>
    Ok(Slot { values: cloneValues(slot.values.view())?, rowId: slot.rowId, isNull: slot.isNull });

/// A key for grouping and DISTINCT: the values in a form where equal ones (under their collations) are identical.
fn groupKey(values: Slice<SqliteValue>, collations: Slice<Collation>) -> Result<Vector<u8>, AllocError> {
    var normalized = Vector<SqliteValue>.withCapacity(values.length)?;
    for (i in 0..values.length) {
        let collation = if (i < collations.length) collations[i] else Collation.Binary;
        // Equal numbers of different types group together: 1 and 1.0.
        var v = normalizeForKey(borrow values[i], collation)?;
        if (v is SqliteValue.Real(r) && realAsExactInteger(r) is Some(n)) {
            v = SqliteValue.Integer(n);
        }
        normalized.push(v)?;
    }
    return Ok(Record.encode(normalized.view()).ok() ?? Vector<u8>.create());
}

/// Reads a table row's record into a slot's values, as the table's columns.
fn loadTableRow(
    plan: borrow TablePlan,
    rowId: i64,
    record: Vector<SqliteValue>,
    slot: borrow mut Slot,
) -> Result<void, AllocError> {
    // Into the slot's own vector, whose room the last row left: no new one each row.
    var values = replace(mut slot.values, Vector<SqliteValue>.create());
    values.clear();
    values.reserve(plan.recordPosition.length)?;
    var stored = record;
    for (c in 0..plan.recordPosition.length) {
        var v = SqliteValue.Null;
        if (plan.recordPosition[c] is Some(at)) {
            if (at < stored.length) {
                v = replace(mut stored[at], SqliteValue.Null);
            } else {
                v = plan.defaults[c].clone()?;
            }
        }
        if (plan.rowidAlias == Some(c)) {
            v = SqliteValue.Integer(rowId);
        } else if (plan.realColumns[c] && v is SqliteValue.Integer(i)) {
            v = SqliteValue.Real(round<f64>(i));
        }
        values.push(v)?;
    }
    slot.values = values;
    slot.rowId = rowId;
    slot.isNull = false;
    return Ok();
}

/// The nested loop at `level` over a table whose rows are loaded in two steps (`ColumnPhases`): the columns its ON
/// and this level's WHERE terms read, then, for a row they let through, the rest the query reads. A row turned away
/// has no other column decoded, and a column no part of the query reads stays NULL for the whole scan.
fn phasedScan(
    core: borrow CorePlan,
    level: usize,
    table: borrow TablePlan,
    phases: borrow ColumnPhases,
    cursor: TableCursor,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    let source = borrow core.sources[level];
    var scan = cursor;
    var matched = false;
    var ordinal: usize = 0;
    // The record each row is decoded into: it keeps the room of the values the slot let go.
    var record = Vector<SqliteValue>.create();
    clearSlot(table, mut frame.slots[source.slot])?;
    loop {
        if (sink.stopAfter is Some(n) && sink.rows.length >= n) {
            return Ok();
        }
        let Some(rowId) = scan.advance(db.pagerOf(table.database))? else {
            break;
        };
        ordinal += 1;
        let present = scan.decodeCurrent(db.pagerOf(table.database), phases.earlyRecord.view(), mut record)?;
        loadColumnsInto(table, rowId, mut record, present, phases.early.view(), mut frame.slots[source.slot])?;
        if (borrow source.on is Some(on)) {
            let ok = evaluate(on, frame, db)?;
            if (!isTrue(borrow ok)) {
                continue;
            }
        }
        matched = true;
        markRightMatch(source, level, ordinal - 1, sink)?;
        if (!termsHold(core, level, frame, db)?) {
            continue;
        }
        let rest = scan.decodeCurrent(db.pagerOf(table.database), phases.lateRecord.view(), mut record)?;
        loadColumnsInto(table, rowId, mut record, rest, phases.late.view(), mut frame.slots[source.slot])?;
        joinLevel(core, level + 1, frame, db, sink)?;
    }
    return finishLeft(core, level, matched, frame, db, sink);
}

/// A slot of a table's width, every column NULL.
fn clearSlot(plan: borrow TablePlan, slot: borrow mut Slot) -> Result<void, AllocError> {
    let n = plan.recordPosition.length;
    slot.values.truncate(n);
    for (c in 0..slot.values.length) {
        slot.values[c] = SqliteValue.Null;
    }
    while (slot.values.length < n) {
        slot.values.push(SqliteValue.Null)?;
    }
    return Ok();
}

/// The columns `columns` marks loaded into the slot from `record` (decoded by `TableCursor.decodeCurrent`, which
/// found `present` columns in it), as `loadTableRowInto` loads them; the others are left as they are.
fn loadColumnsInto(
    plan: borrow TablePlan,
    rowId: i64,
    record: borrow mut Vector<SqliteValue>,
    present: usize,
    columns: Slice<bool>,
    slot: borrow mut Slot,
) -> Result<void, AllocError> {
    for (c in 0..columns.length) {
        if (!columns[c]) {
            continue;
        }
        if (plan.rowidAlias == Some(c)) {
            slot.values[c] = SqliteValue.Integer(rowId);
            continue;
        }
        match (plan.recordPosition[c]) {
            Some(at) => {
                if (at < present && at < record.length) {
                    // Each takes the other's value: the record keeps the old one's room for the next row.
                    let fresh = replace(mut record[at], SqliteValue.Null);
                    record[at] = replace(mut slot.values[c], fresh);
                } else {
                    slot.values[c] = plan.defaults[c].clone()?;
                }
            }
            null => { slot.values[c] = SqliteValue.Null; }
        }
        if (plan.realColumns[c] && slot.values[c] is SqliteValue.Integer(i)) {
            slot.values[c] = SqliteValue.Real(round<f64>(i));
        }
    }
    slot.rowId = rowId;
    slot.isNull = false;
    return Ok();
}

/// `loadTableRow` from `record`, leaving in it the values the slot had: their room (a text's bytes) is used again
/// for the next row (`RowCursor.nextInto`), so a scan does not allocate for each row.
fn loadTableRowInto(
    plan: borrow TablePlan,
    rowId: i64,
    record: borrow mut Vector<SqliteValue>,
    slot: borrow mut Slot,
) -> Result<void, AllocError> {
    let n = plan.recordPosition.length;
    slot.values.truncate(n);
    while (slot.values.length < n) {
        slot.values.push(SqliteValue.Null)?;
    }
    for (c in 0..n) {
        if (plan.rowidAlias == Some(c)) {
            slot.values[c] = SqliteValue.Integer(rowId);
            continue;
        }
        match (plan.recordPosition[c]) {
            Some(at) => {
                if (at < record.length) {
                    // Each takes the other's value: the record keeps the old one's room for the next row.
                    let fresh = replace(mut record[at], SqliteValue.Null);
                    record[at] = replace(mut slot.values[c], fresh);
                } else {
                    slot.values[c] = plan.defaults[c].clone()?;
                }
            }
            null => { slot.values[c] = SqliteValue.Null; }
        }
        if (plan.realColumns[c] && slot.values[c] is SqliteValue.Integer(i)) {
            slot.values[c] = SqliteValue.Real(round<f64>(i));
        }
    }
    slot.rowId = rowId;
    slot.isNull = false;
    return Ok();
}

/// Evaluates VIRTUAL generated columns for the row in `slot`.
fn computeGenerated(
    plan: borrow TablePlan,
    slot: usize,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<void, SqliteError> {
    for (g in 0..plan.generated.length) {
        let v = evaluate(borrow plan.generated[g].expr, frame, db)?;
        let column = plan.generated[g].column;
        frame.slots[slot].values[column] = v;
    }
    return Ok();
}

/// Rows of a computed source: a subquery, a view, a CTE or a working table.
fn sourceRows(
    kind: borrow SourceKind,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<Vector<SqliteValue>>, SqliteError> {
    match (kind) {
        SourceKind.Rows(plan) => { return runSelect(plan, frame, db); }
        SourceKind.Cte(index) => { return cteRows(index, frame, db); }
        SourceKind.Working(index) => {
            var copy = Vector<Vector<SqliteValue>>.withCapacity(frame.working[index].length)?;
            for (i in 0..frame.working[index].length) {
                copy.push(cloneValues(frame.working[index][i].view())?)?;
            }
            return Ok(copy);
        }
        SourceKind.Pragma(name, argument) => {
            var text: ByteString? = null;
            if (argument is Some(a)) {
                let v = evaluate(a, frame, db)?;
                // A pragma's argument keeps its bytes.
                text = valueText(borrow v)?;
            }
            var rows = pragmaRows(name.view(), text, db)?;
            // The hidden argument column.
            for (i in 0..rows.length) {
                rows[i].push(SqliteValue.Null)?;
            }
            return Ok(rows);
        }
        SourceKind.JsonEach(plan) => { return jsonEachRows(plan, frame, db); }
        SourceKind.Table(_) => { return Ok(Vector<Vector<SqliteValue>>.create()); }
    }
}

/// A CTE's rows, computed the first time they are needed.
fn cteRows(
    index: usize,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<Vector<SqliteValue>>, SqliteError> {
    if (frame.cteRows[index].isNull()) {
        let plan = replace(mut frame.ctes[index], null) ?? {
            return Err(sqlError("circular reference in a common table expression"));
        };
        let rows = match (borrow plan) {
            CtePlan.Plain(p) => runSelect(p, frame, db),
            CtePlan.Recursive(r) => runRecursive(r, frame, db),
        };
        frame.ctes[index] = plan;
        frame.cteRows[index] = rows?;
    }
    var copy = Vector<Vector<SqliteValue>>.create();
    if (borrow frame.cteRows[index] is Some(cached)) {
        for (i in 0..cached.length) {
            copy.push(cloneValues(cached[i].view())?)?;
        }
    }
    return Ok(copy);
}

/// Runs a recursive CTE: the anchor's rows, then the recursive part on each step's rows until it gives none.
fn runRecursive(
    plan: borrow RecursivePlan,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<Vector<SqliteValue>>, SqliteError> {
    let limit = limitValue(borrow plan.limit, frame, db)?;
    let offset = limitValue(borrow plan.offset, frame, db)? ?? 0;
    var all = Vector<Vector<SqliteValue>>.create();
    var seen = HashMap<Vector<u8>, bool>.create();
    var produced: usize = 0;
    var pending = runSelect(borrow plan.anchor, frame, db)?;
    let collations = plan.anchor.columnCollations.view();
    var binary = Vector<Collation>.create();
    for (i in 0..collations.length) {
        binary.push(collations[i] ?? Collation.Binary)?;
    }
    loop {
        var next = Vector<Vector<SqliteValue>>.create();
        for (row in pending.drain()) {
            if (plan.distinct) {
                let key = groupKey(row.view(), binary.view())?;
                if (seen.contains(borrow key)) {
                    continue;
                }
                let _ = seen.put(key, true)?;
            }
            if (limit is Some(l) && produced >= l + offset) {
                return Ok(skipRows(all, offset)?);
            }
            produced += 1;
            all.push(cloneValues(row.view())?)?;
            next.push(row)?;
        }
        if (next.length == 0) {
            break;
        }
        // One step: the recursive part sees the rows the last step added.
        frame.working[plan.working] = next;
        pending = runSelect(borrow plan.recursive, frame, db)?;
    }
    return Ok(skipRows(all, offset)?);
}

fn skipRows(rows: Vector<Vector<SqliteValue>>, offset: usize) -> Result<Vector<Vector<SqliteValue>>, AllocError> {
    var all = rows;
    var out = Vector<Vector<SqliteValue>>.create();
    var index: usize = 0;
    for (row in all.drain()) {
        index += 1;
        if (index > offset) {
            out.push(row)?;
        }
    }
    return Ok(out);
}

/// LIMIT or OFFSET: `null` for none (or a negative LIMIT).
fn limitValue(e: borrow XExpr?, frame: borrow mut Frame, db: borrow mut Session) -> Result<usize?, SqliteError> {
    let Some(x) = e else {
        return Ok(null);
    };
    let v = evaluate(x, frame, db)?;
    let n = match (v) {
        SqliteValue.Integer(i) => i,
        SqliteValue.Text(s) => match (textWithNumericAffinity(s.view().bytes(), true)) {
            Some(SqliteValue.Integer(i)) => i,
            _ => { return Err(sqlError("datatype mismatch")); },
        },
        SqliteValue.Real(r) => match (realAsExactInteger(r)) {
            Some(i) => i,
            null => { return Err(sqlError("datatype mismatch")); },
        },
        _ => { return Err(sqlError("datatype mismatch")); },
    };
    if (n < 0) {
        return Ok(null);
    }
    return Ok(truncate<usize>(n));
}

/// The rowid a seek expression gives: `null` when no row can match (NULL, a non-integral number, text that is not
/// a number).
fn seekRowid(e: borrow XExpr, frame: borrow mut Frame, db: borrow mut Session) -> Result<i64?, SqliteError> {
    let v = evaluate(e, frame, db)?;
    match (v) {
        SqliteValue.Integer(i) => { return Ok(i); }
        SqliteValue.Real(r) => { return Ok(realAsExactInteger(r)); }
        SqliteValue.Text(s) => {
            return Ok(match (textWithNumericAffinity(s.view().bytes(), true)) {
                Some(SqliteValue.Integer(i)) => i,
                _ => null,
            });
        }
        _ => { return Ok(null); }
    }
}

/// The nested loop at `level`: each row of source `level` that its ON allows, then the next level.
fn joinLevel(
    core: borrow CorePlan,
    level: usize,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    if (!groupsEnd(core, level, frame, db, sink)?) {
        return Ok();
    }
    // Each row comes here at the last level: it goes on without entering `loopLevel`, whose many locals the C
    // ceesafec writes clears on entry (CEESAFE_FINDINGS.md 55).
    if (level == core.sources.length) {
        return acceptRow(core, frame, db, sink);
    }
    return loopLevel(core, level, frame, db, sink);
}

/// The nested loop at `level`: each row its source gives, with the next levels run for it.
fn loopLevel(
    core: borrow CorePlan,
    level: usize,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    let source = borrow core.sources[level];
    var matched = false;
    if (source.group > 1) {
        sink.groupReached[level] = false;
    }
    match (borrow source.kind) {
        SourceKind.Table(table) => {
            if (borrow source.indexSeek is Some(seek)) {
                return seekLevel(core, level, table, seek, frame, db, sink);
            }
            var only: i64? = null;
            if (borrow source.rowidSeek is Some(seek)) {
                let Some(rowId) = seekRowid(seek, frame, db)? else {
                    return finishLeft(core, level, matched, frame, db, sink);
                };
                only = rowId;
            }
            if (borrow source.phases is Some(phases)) {
                let scan = match (only) {
                    Some(rowId) => TableCursor.range(table.root, rowId, rowId),
                    null => TableCursor.scan(table.root),
                };
                return phasedScan(core, level, table, phases, scan, frame, db, sink);
            }
            var cursor = RowCursor.scan(table);
            if (only is Some(rowId)) {
                cursor = RowCursor.Rows(TableCursor.range(table.root, rowId, rowId));
            }
            var ordinal: usize = 0;
            // The record each row is decoded into: it keeps the room of the values the slot let go.
            var record = Vector<SqliteValue>.create();
            loop {
                if (sink.stopAfter is Some(n) && sink.rows.length >= n) {
                    return Ok();
                }
                let Some(rowId) = cursor.nextInto(db.pagerOf(table.database), mut record)? else {
                    break;
                };
                ordinal += 1;
                loadTableRowInto(table, rowId, mut record, mut frame.slots[source.slot])?;
                if (table.generated.length != 0) {
                    computeGenerated(table, source.slot, frame, db)?;
                }
                if (borrow source.on is Some(on)) {
                    let ok = evaluate(on, frame, db)?;
                    if (!isTrue(borrow ok)) {
                        continue;
                    }
                }
                matched = true;
                markRightMatch(source, level, ordinal - 1, sink)?;
                if (!termsHold(core, level, frame, db)?) {
                    continue;
                }
                joinLevel(core, level + 1, frame, db, sink)?;
            }
        }
        _ => {
            var rows = sourceRows(borrow source.kind, frame, db)?;
            var rowId: i64 = 0;
            for (values in rows.drain()) {
                if (sink.stopAfter is Some(n) && sink.rows.length >= n) {
                    return Ok();
                }
                rowId += 1;
                frame.slots[source.slot] = Slot { values: values, rowId: rowId, isNull: false };
                if (borrow source.on is Some(on)) {
                    let ok = evaluate(on, frame, db)?;
                    if (!isTrue(borrow ok)) {
                        continue;
                    }
                }
                matched = true;
                markRightMatch(source, level, truncate<usize>(rowId - 1), sink)?;
                if (!termsHold(core, level, frame, db)?) {
                    continue;
                }
                joinLevel(core, level + 1, frame, db, sink)?;
            }
        }
    }
    return finishLeft(core, level, matched, frame, db, sink);
}

/// At `level`, the LEFT JOIN groups that end there: a row of a whole group must meet the group's ON, which then
/// counts the group as matched. False when one refuses the row. A group being made NULL is not checked.
fn groupsEnd(
    core: borrow CorePlan,
    level: usize,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<bool, SqliteError> {
    var g = level;
    while (g > 0) {
        g -= 1;
        let source = borrow core.sources[g];
        if (source.group <= 1 || g + source.group != level || sink.groupNulled[g]) {
            continue;
        }
        if (borrow source.groupOn is Some(on)) {
            let ok = evaluate(on, frame, db)?;
            if (!isTrue(borrow ok)) {
                return Ok(false);
            }
        }
        sink.groupReached[g] = true;
    }
    return Ok(true);
}

fn hasRightJoin(core: borrow CorePlan) -> bool {
    for (s in 0..core.sources.length) {
        if (core.sources[s].right) {
            return true;
        }
    }
    return false;
}

/// Notes that row `ordinal` of a RIGHT JOIN source matched.
fn markRightMatch(
    source: borrow SourcePlan,
    level: usize,
    ordinal: usize,
    sink: borrow mut CoreSink,
) -> Result<void, AllocError> {
    if (!source.right) {
        return Ok();
    }
    let marks = borrow mut sink.rightMatched[level];
    while (marks.length <= ordinal) {
        marks.push(false)?;
    }
    marks[ordinal] = true;
    return Ok();
}

/// RIGHT and FULL JOIN: each row of a right source that matched nothing, with every earlier source NULL, joined on
/// to the later sources. The sources go in order, so an earlier one's rows reach a later one's matches.
fn unmatchedRightRows(
    core: borrow CorePlan,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    for (level in 0..core.sources.length) {
        let source = borrow core.sources[level];
        if (!source.right) {
            continue;
        }
        for (s in 0..level) {
            frame.slots[core.sources[s].slot] = Slot { values: Vector<SqliteValue>.create(), rowId: 0, isNull: true };
        }
        let marks = replace(mut sink.rightMatched[level], Vector<bool>.create());
        let wasMatched = (ordinal: usize) => ordinal < marks.length && marks[ordinal];
        match (borrow source.kind) {
            SourceKind.Table(table) => {
                var cursor = RowCursor.scan(table);
                var ordinal: usize = 0;
                while (cursor.next(db.pagerOf(table.database))? is Some(row)) {
                    ordinal += 1;
                    if (wasMatched(ordinal - 1)) {
                        continue;
                    }
                    loadTableRow(table, row.rowId, row.columns, mut frame.slots[source.slot])?;
                    if (table.generated.length != 0) {
                        computeGenerated(table, source.slot, frame, db)?;
                    }
                    joinLevel(core, level + 1, frame, db, sink)?;
                }
            }
            _ => {
                var rows = sourceRows(borrow source.kind, frame, db)?;
                var r: usize = 0;
                for (values in rows.drain()) {
                    r += 1;
                    if (wasMatched(r - 1)) {
                        continue;
                    }
                    frame.slots[source.slot] = Slot { values: values, rowId: truncate<i64>(r + 1), isNull: false };
                    joinLevel(core, level + 1, frame, db, sink)?;
                }
            }
        }
    }
    return Ok();
}

/// A LEFT JOIN source that matched nothing: one row of NULLs.
fn finishLeft(
    core: borrow CorePlan,
    level: usize,
    matched: bool,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    let source = borrow core.sources[level];
    if (source.group > 1) {
        // A LEFT JOIN group: NULL for all its sources when no row of the whole group met its ON.
        if (sink.groupReached[level]) {
            return Ok();
        }
        for (s in level..level + source.group) {
            frame.slots[core.sources[s].slot] = Slot { values: Vector<SqliteValue>.create(), rowId: 0, isNull: true };
        }
        sink.groupNulled[level] = true;
        let result = joinLevel(core, level + source.group, frame, db, sink);
        sink.groupNulled[level] = false;
        return result;
    }
    if (matched || !source.left) {
        return Ok();
    }
    frame.slots[source.slot] = Slot { values: Vector<SqliteValue>.create(), rowId: 0, isNull: true };
    joinLevel(core, level + 1, frame, db, sink)?;
    return Ok();
}

/// A complete row of the core's sources: filtered, then added to its group or projected.
fn acceptRow(
    core: borrow CorePlan,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    // The WHERE's terms not checked in an outer loop (`placeTerms`).
    if (core.levelHasTerms.length == 0) {
        if (borrow core.filter is Some(f)) {
            let ok = evaluate(f, frame, db)?;
            if (!isTrue(borrow ok)) {
                return Ok();
            }
        }
    } else if (!termsHold(core, core.sources.length, frame, db)?) {
        return Ok();
    }
    if (core.isAggregate) {
        // Without GROUP BY every row is in the one group: after the first, no key is made or looked up.
        if (core.groupBy.length == 0 && sink.groups.length == 1) {
            return stepGroup(core, 0, frame, db, sink);
        }
        var keyValues = Vector<SqliteValue>.withCapacity(core.groupBy.length)?;
        for (g in 0..core.groupBy.length) {
            keyValues.push(evaluate(borrow core.groupBy[g], frame, db)?)?;
        }
        let key = groupKey(keyValues.view(), core.groupCollations.view())?;
        var index = sink.groups.length;
        if (sink.groupIndex.get(borrow key) is Some(at)) {
            index = *at;
        } else {
            var accumulators = Vector<Accumulator>.withCapacity(core.aggregates.length)?;
            for (a in 0..core.aggregates.length) {
                accumulators.push(Accumulator.create(borrow core.aggregates[a]))?;
            }
            sink.groups.push(
                GroupState {
                    accumulators: accumulators,
                    slots: Vector<Slot>.create(),
                    key: cloneValues(keyValues.view())?,
                },
            )?;
            let _ = sink.groupIndex.put(key, index)?;
        }
        return stepGroup(core, index, frame, db, sink);
    }
    return project(core, frame, db, sink);
}

/// Adds the row in the frame to group `index`'s aggregates. Bare columns come from the group's first row, or from
/// the row of its one min() or max().
fn stepGroup(
    core: borrow CorePlan,
    index: usize,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    var takeRow = false;
    for (a in 0..core.aggregates.length) {
        let newBest = sink.groups[index].accumulators[a].step(borrow core.aggregates[a], frame, db)?;
        if (core.minMax == Some(a) && newBest) {
            takeRow = true;
        }
    }
    if (takeRow || sink.groups[index].slots.length == 0) {
        var slots = Vector<Slot>.withCapacity(core.sources.length)?;
        for (s in 0..core.sources.length) {
            slots.push(copySlot(borrow frame.slots[core.sources[s].slot])?)?;
        }
        sink.groups[index].slots = slots;
    }
    return Ok();
}

/// Evaluates the result columns and sort keys for the current row, and keeps them; with window functions, keeps
/// the row until they are computed.
fn project(
    core: borrow CorePlan,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    if (core.windows.length != 0) {
        return keepWindowRow(core, frame, db, sink);
    }
    return projectRow(core, frame, db, sink);
}

fn projectRow(
    core: borrow CorePlan,
    frame: borrow mut Frame,
    db: borrow mut Session,
    sink: borrow mut CoreSink,
) -> Result<void, SqliteError> {
    var values = Vector<SqliteValue>.withCapacity(core.outputs.length)?;
    for (i in 0..core.outputs.length) {
        values.push(evaluate(borrow core.outputs[i], frame, db)?)?;
    }
    if (borrow mut sink.distinctSeen is Some(seen)) {
        let key = groupKey(values.view(), core.outputCollations.view())?;
        if (seen.contains(borrow key)) {
            return Ok();
        }
        let _ = seen.put(key, true)?;
    }
    var keys = Vector<SqliteValue>.withCapacity(core.sortKeys.length)?;
    for (k in 0..core.sortKeys.length) {
        if (core.sortKeys[k].output is Some(at)) {
            keys.push(values[at].clone()?)?;
        } else {
            keys.push(evaluate(borrow core.sortKeys[k].expr, frame, db)?)?;
        }
    }
    sink.rows.push(SortedRow { values: values, keys: keys, arrival: sink.arrived })?;
    sink.arrived += 1;
    if (sink.keepFirst is Some(keep) && sink.rows.length >= 2 * keep + 64) {
        sortRows(mut sink.rows, core.sortKeys.view(), db.textEncoding());
        sink.rows.truncate(keep);
    }
    return Ok();
}

/// Sorts rows by their ORDER BY keys, rows with equal keys in the order they came.
fn sortRows(rows: borrow mut Vector<SortedRow>, terms: Slice<XOrderTerm>, encoding: TextEncoding) {
    rows.sortBy(
        (x, y) => thenInOrder(compareKeys(x.keys.view(), y.keys.view(), terms, encoding), x.arrival, y.arrival),
    );
}

/// `c`, or when it is 0 the order of `a` and `b`: a comparison made stable by the order elements came in.
fn thenInOrder(c: i32, a: usize, b: usize) -> i32 => if (c != 0) c else if (a < b) -1 else if (a > b) 1 else 0;

/// Runs one core.
fn runCore(
    core: borrow CorePlan,
    frame: borrow mut Frame,
    db: borrow mut Session,
    stopAfter: usize?,
) -> Result<Vector<SortedRow>, SqliteError> {
    var sink = CoreSink {
        rows: Vector<SortedRow>.create(),
        distinctSeen: if (core.distinct) HashMap<Vector<u8>, bool>.create() else null,
        groups: Vector<GroupState>.create(),
        groupIndex: HashMap<Vector<u8>, usize>.create(),
        stopAfter: if (core.isAggregate || core.distinct ||
            core.sortKeys.length != 0 || core.windows.length != 0 || hasRightJoin(
            core,
        )) null
            else stopAfter,
        keepFirst: if (core.sortKeys.length != 0 && !core.isAggregate && core.windows.length == 0) stopAfter
            else null,
        arrived: 0,
        windowRows: Vector<WindowRow>.create(),
        rightMatched: Vector<Vector<bool>>.create(),
        groupReached: Vector<bool>.create(),
        groupNulled: Vector<bool>.create(),
    };
    for (s in 0..core.sources.length) {
        sink.rightMatched.push(Vector<bool>.create())?;
        sink.groupReached.push(false)?;
        sink.groupNulled.push(false)?;
    }
    joinLevel(core, 0, frame, db, mut sink)?;
    unmatchedRightRows(core, frame, db, mut sink)?;
    if (!core.isAggregate) {
        if (core.windows.length != 0) {
            finishWindows(core, frame, db, mut sink)?;
        }
        return Ok(sink.rows);
    }
    // An aggregate without GROUP BY gives one row even with no input: its bare columns are NULL.
    if (sink.groups.length == 0 && core.groupBy.length == 0) {
        var accumulators = Vector<Accumulator>.withCapacity(core.aggregates.length)?;
        for (a in 0..core.aggregates.length) {
            accumulators.push(Accumulator.create(borrow core.aggregates[a]))?;
        }
        var slots = Vector<Slot>.create();
        for (s in 0..core.sources.length) {
            slots.push(Slot { values: Vector<SqliteValue>.create(), rowId: 0, isNull: true })?;
        }
        sink.groups.push(GroupState { accumulators: accumulators, slots: slots, key: Vector<SqliteValue>.create() })?;
    }
    let saved = replace(mut frame.aggregates, Vector<SqliteValue>.create());
    var groups = replace(mut sink.groups, Vector<GroupState>.create());
    // In the order of their GROUP BY values (NULLs first, each under its collation), as SQLite's sorter gives them;
    // or, read through an index that gives the GROUP BY order, in the order the scan met them, as SQLite does.
    if (core.groupBy.length != 0 && !groupsInScanOrder(core)) {
        var order = Vector<usize>.withCapacity(groups.length)?;
        for (g in 0..groups.length) {
            order.push(g)?;
        }
        let collations = core.groupCollations.view();
        let encoding = db.textEncoding();
        order.sortBy((a, b) => {
            for (k in 0..collations.length) {
                let c = compareForOrder(
                    borrow groups[a].key[k],
                    borrow groups[b].key[k],
                    collations[k],
                    false,
                    true,
                    encoding,
                );
                if (c != 0) {
                    return c;
                }
            }
            return thenInOrder(0, *a, *b);
        });
        var sorted = Vector<GroupState>.withCapacity(groups.length)?;
        for (i in 0..order.length) {
            sorted.push(
                replace(
                    mut groups[order[i]],
                    GroupState {
                        accumulators: Vector<Accumulator>.create(),
                        slots: Vector<Slot>.create(),
                        key: Vector<SqliteValue>.create(),
                    },
                ),
            )?;
        }
        groups = sorted;
    }
    for (g in 0..groups.length) {
        var results = Vector<SqliteValue>.withCapacity(core.aggregates.length)?;
        for (a in 0..core.aggregates.length) {
            groups[g].accumulators[a].replay(borrow core.aggregates[a], frame, db)?;
            results.push(groups[g].accumulators[a].finish(borrow core.aggregates[a])?)?;
        }
        frame.aggregates = results;
        var slots = replace(mut groups[g].slots, Vector<Slot>.create());
        for (s in 0..slots.length) {
            let at = core.sources[s].slot;
            frame.slots[at] = replace(
                mut slots[s],
                Slot { values: Vector<SqliteValue>.create(), rowId: 0, isNull: true },
            );
        }
        if (borrow core.having is Some(h)) {
            let ok = evaluate(h, frame, db)?;
            if (!isTrue(borrow ok)) {
                continue;
            }
        }
        project(core, frame, db, mut sink)?;
    }
    frame.aggregates = saved;
    if (core.windows.length != 0) {
        finishWindows(core, frame, db, mut sink)?;
    }
    return Ok(sink.rows);
}

/// Compares two rows' sort keys.
fn compareKeys(a: Slice<SqliteValue>, b: Slice<SqliteValue>, terms: Slice<XOrderTerm>, encoding: TextEncoding) -> i32 {
    for (i in 0..terms.length) {
        let c = compareForOrder(
            borrow a[i],
            borrow b[i],
            terms[i].collation,
            terms[i].descending,
            terms[i].nullsFirst,
            encoding,
        );
        if (c != 0) {
            return c;
        }
    }
    return 0;
}

/// One ORDER BY term's comparison: NULLs first or last as asked, then the order, reversed for DESC.
fn compareForOrder(
    a: borrow SqliteValue,
    b: borrow SqliteValue,
    collation: Collation,
    descending: bool,
    nullsFirst: bool,
    encoding: TextEncoding,
) -> i32 {
    if (a.isNull() || b.isNull()) {
        if (a.isNull() && b.isNull()) {
            return 0;
        }
        return if (a.isNull() == nullsFirst) -1 else 1;
    }
    let c = compareValuesIn(a, b, collation, encoding);
    return if (descending) 0 - c else c;
}

/// Runs a SELECT plan, and gives its rows.
fn runSelect(
    plan: borrow SelectPlan,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<Vector<SqliteValue>>, SqliteError> {
    let limit = limitValue(borrow plan.limit, frame, db)?;
    let offset = limitValue(borrow plan.offset, frame, db)? ?? 0;
    var stopAfter: usize? = null;
    if (limit is Some(l)) {
        stopAfter = l + offset;
    }
    if (plan.cores.length == 1) {
        let core = borrow plan.cores[0];
        var rows = runCore(core, frame, db, stopAfter)?;
        if (core.sortKeys.length != 0) {
            let terms = core.sortKeys.view();
            // Stable, as SQLite's sorter is: rows with equal keys stay in the order they came.
            sortRows(mut rows, terms, db.textEncoding());
        }
        var out = Vector<Vector<SqliteValue>>.withCapacity(rows.length)?;
        var index: usize = 0;
        for (row in rows.drain()) {
            if (index >= offset && (limit.isNull() || out.length < limit!)) {
                out.push(row.values)?;
            }
            index += 1;
        }
        return Ok(out);
    }
    // A compound: each core's rows, combined left to right.
    var collations = Vector<Collation>.withCapacity(plan.columnCollations.length)?;
    for (i in 0..plan.columnCollations.length) {
        collations.push(plan.columnCollations[i] ?? Collation.Binary)?;
    }
    var result = Vector<Vector<SqliteValue>>.create();
    for (c in 0..plan.cores.length) {
        var rows = runCore(borrow plan.cores[c], frame, db, null)?;
        var values = Vector<Vector<SqliteValue>>.withCapacity(rows.length)?;
        for (i in 0..rows.length) {
            values.push(replace(mut rows[i].values, Vector<SqliteValue>.create()))?;
        }
        if (c == 0) {
            result = values;
            continue;
        }
        result = combine(plan.ops[c - 1], result, values, collations.view())?;
    }
    if (plan.compoundOrder.length != 0) {
        let order = plan.compoundOrder.view();
        // Stable, as SQLite's sorter is: rows equal on the ORDER BY columns keep the compound's order.
        let encoding = db.textEncoding();
        result.sortStableBy((x, y) => compareByColumns(x.view(), y.view(), order, encoding));
    }
    var out = Vector<Vector<SqliteValue>>.create();
    var index: usize = 0;
    for (row in result.drain()) {
        index += 1;
        if (index > offset && (limit.isNull() || out.length < limit!)) {
            out.push(row)?;
        }
    }
    return Ok(out);
}

fn compareByColumns(
    a: Slice<SqliteValue>,
    b: Slice<SqliteValue>,
    order: Slice<ColumnOrder>,
    encoding: TextEncoding,
) -> i32 {
    for (i in 0..order.length) {
        let at = order[i].column;
        let c = compareForOrder(
            borrow a[at],
            borrow b[at],
            order[i].collation,
            order[i].descending,
            order[i].nullsFirst,
            encoding,
        );
        if (c != 0) {
            return c;
        }
    }
    return 0;
}

/// UNION, UNION ALL, INTERSECT or EXCEPT of two row lists. All but UNION ALL give distinct rows.
fn combine(
    op: CompoundOp,
    leftIn: Vector<Vector<SqliteValue>>,
    rightIn: Vector<Vector<SqliteValue>>,
    collations: Slice<Collation>,
) -> Result<Vector<Vector<SqliteValue>>, SqliteError> {
    var left = leftIn;
    var right = rightIn;
    var out = Vector<Vector<SqliteValue>>.create();
    if (op == CompoundOp.UnionAll) {
        out = left;
        for (row in right.drain()) {
            out.push(row)?;
        }
        return Ok(out);
    }
    var rightKeys = HashMap<Vector<u8>, bool>.create();
    if (op != CompoundOp.Union) {
        for (i in 0..right.length) {
            let _ = rightKeys.put(groupKey(right[i].view(), collations)?, true)?;
        }
    }
    var seen = HashMap<Vector<u8>, bool>.create();
    for (row in left.drain()) {
        let key = groupKey(row.view(), collations)?;
        if (seen.contains(borrow key)) {
            continue;
        }
        let keep = match (op) {
            CompoundOp.Intersect => rightKeys.contains(borrow key),
            CompoundOp.Except => !rightKeys.contains(borrow key),
            _ => true,
        };
        let _ = seen.put(key, true)?;
        if (keep) {
            out.push(row)?;
        }
    }
    if (op == CompoundOp.Union) {
        for (row in right.drain()) {
            let key = groupKey(row.view(), collations)?;
            if (seen.contains(borrow key)) {
                continue;
            }
            let _ = seen.put(key, true)?;
            out.push(row)?;
        }
    }
    return Ok(out);
}

/// A subquery's rows, cached when it does not depend on the current row.
fn subqueryRows(
    sub: borrow XSubquery,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<Vector<SqliteValue>>, SqliteError> {
    if (!sub.correlated) {
        while (frame.cache.length <= sub.cacheIndex) {
            frame.cache.push(null)?;
        }
        if (borrow frame.cache[sub.cacheIndex] is Some(rows)) {
            var copy = Vector<Vector<SqliteValue>>.withCapacity(rows.length)?;
            for (i in 0..rows.length) {
                copy.push(cloneValues(rows[i].view())?)?;
            }
            return Ok(copy);
        }
    }
    let rows = runSelect(borrow sub.plan, frame, db)?;
    if (!sub.correlated) {
        var copy = Vector<Vector<SqliteValue>>.withCapacity(rows.length)?;
        for (i in 0..rows.length) {
            copy.push(cloneValues(rows[i].view())?)?;
        }
        frame.cache[sub.cacheIndex] = copy;
    }
    return Ok(rows);
}

/// A subquery's first row, or `null` when it has none.
fn subqueryFirstRow(
    sub: borrow XSubquery,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<SqliteValue>?, SqliteError> {
    var rows = subqueryRows(sub, frame, db)?;
    if (rows.length == 0) {
        return Ok(null);
    }
    return Ok(rows.swapRemove(0));
}

/// A subquery's first column, for IN.
fn subqueryFirstColumn(
    sub: borrow XSubquery,
    frame: borrow mut Frame,
    db: borrow mut Session,
) -> Result<Vector<SqliteValue>, SqliteError> {
    var rows = subqueryRows(sub, frame, db)?;
    var out = Vector<SqliteValue>.withCapacity(rows.length)?;
    for (i in 0..rows.length) {
        if (rows[i].length != 1) {
            return Err(sqlError("sub-select returns more than 1 column"));
        }
        out.push(rows[i].swapRemove(0))?;
    }
    return Ok(out);
}

/// A walk over a table's rows: a rowid table's b-tree, or a WITHOUT ROWID table's index b-tree, whose entries
/// are its records (in primary-key order, with no rowid).
enum RowCursor {
    Rows(TableCursor),
    Keys(IndexCursor),
}

/// A row a RowCursor found: its rowid (0 in a WITHOUT ROWID table) and its record.
struct CursorRow {
    rowId: i64;
    columns: Vector<SqliteValue>;
}

impl RowCursor {
    fn scan(table: borrow TablePlan) -> RowCursor =>
        if (table.withoutRowid) RowCursor.Keys(
            IndexCursor.create(table.root, IndexRange.all(IndexOrder.plain()), false),
        )
            else RowCursor.Rows(TableCursor.scan(table.root));

    /// The next row's rowid (0 in a WITHOUT ROWID table), its record decoded into `record`, whose values the last
    /// row left; `null` after the last.
    fn nextInto(
        borrow mut this,
        pager: borrow mut WritablePager,
        record: borrow mut Vector<SqliteValue>,
    ) -> Result<i64?, SqliteError> {
        match (this) {
            RowCursor.Rows(cursor) => { return cursor.nextInto(pager, record); }
            RowCursor.Keys(cursor) => {
                let Some(entry) = cursor.next(pager)? else {
                    return Ok(null);
                };
                record = entry;
                return Ok(0);
            }
        }
    }

    fn next(borrow mut this, pager: borrow mut WritablePager) -> Result<CursorRow?, SqliteError> {
        match (this) {
            RowCursor.Rows(cursor) => {
                let Some(row) = cursor.next(pager)? else {
                    return Ok(null);
                };
                return Ok(CursorRow { rowId: row.rowId, columns: row.columns });
            }
            RowCursor.Keys(cursor) => {
                let Some(entry) = cursor.next(pager)? else {
                    return Ok(null);
                };
                return Ok(CursorRow { rowId: 0, columns: entry });
            }
        }
    }
}

/// Whether the core's first table is read through an index whose next columns (after those `=` fixes) are the GROUP
/// BY columns, in any order: SQLite then groups in the index's order instead of sorting.
fn groupsInScanOrder(core: borrow CorePlan) -> bool {
    if (core.sources.length == 0) {
        return false;
    }
    let source = borrow core.sources[0];
    let Some(seek) = borrow source.indexSeek else {
        return false;
    };
    if (seek.byRowid || seek.inAt.isSome()) {
        return false;
    }
    let start = seek.equal.length;
    let n = core.groupBy.length;
    if (start + n > seek.columns.length) {
        return false;
    }
    for (g in 0..n) {
        let XExpr.Column(slot, column) = core.groupBy[g] else {
            return false;
        };
        if (slot != source.slot) {
            return false;
        }
        var found = false;
        for (k in start..start + n) {
            found = found || seek.columns[k] == Some(column);
        }
        if (!found) {
            return false;
        }
    }
    return true;
}
