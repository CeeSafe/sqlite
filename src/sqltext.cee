// SQL text of any bytes. SQLite takes a statement as bytes: a string literal keeps every byte it holds, an
// identifier may hold any byte above 0x7F, and names, definitions and error messages carry those bytes on. The
// engine works on statements as `String`s (the tokenizer, the parser, names in the catalog, sqlite_schema's SQL,
// messages), so a statement's bytes enter it in a form a `String` can hold and that loses nothing:
//
// - UTF-8 stays as it is;
// - each byte of a sequence that is not UTF-8 (always 0x80 or above) stands as one code point of the last 128 of
//   plane 16, U+10FF80 + (byte - 0x80);
// - a real U+10FF80..U+10FFFF, already UTF-8, has its four bytes escaped in the same way, so that every escape
//   in the text is one.
//
// `sqlBytes` undoes it. The mapping is one to one, so names compare as their bytes would (ASCII case folding
// only, since every escape is above 0x7F), and the tokenizer sees an escaped byte as SQLite sees the byte, a
// character of an identifier. Text leaves in its bytes wherever it becomes a value (a literal, a name in a
// pragma's rows, sqlite_schema's columns, a result column's name) or an error's message.

/// The escape of byte `b` (0x80..0xFF): U+10FF80 + (b - 0x80) in UTF-8.
fn appendEscapedByte(out: borrow mut String, b: u8) -> Result<void, AllocError> {
    let _ = out.appendChar(0x10FF00u32 + (b as u32))?;
    return Ok();
}

/// Whether the four bytes at `at` are an escape (or a real U+10FF80..U+10FFFF, which is escaped).
fn isEscapeAt(bytes: Slice<u8>, at: usize) -> bool =>
    at + 3 < bytes.length && bytes[at] == 0xF4 && bytes[at + 1] == 0x8F &&
        (bytes[at + 2] == 0xBE || bytes[at + 2] == 0xBF);

/// The byte an escape at `at` stands for.
fn escapedByteAt(bytes: Slice<u8>, at: usize) -> u8 =>
    if (bytes[at + 2] == 0xBE) bytes[at + 3] else bytes[at + 3] + 0x40;

/// Appends `bytes`, SQL text of any bytes, to `out` in the engine's form.
fn appendSqlText(out: borrow mut String, bytes: Slice<u8>) -> Result<void, AllocError> {
    var chunks = ByteStringView.fromBytes(bytes).chunks();
    for (chunk in chunks) {
        let valid = chunk.valid.bytes();
        var from: usize = 0;
        var at: usize = 0;
        while (at < valid.length) {
            if (isEscapeAt(valid, at)) {
                if (from < at) {
                    let _ = out.appendUtf8(valid[from..at])?;
                }
                for (k in 0..4) {
                    appendEscapedByte(out, valid[at + k])?;
                }
                at += 4;
                from = at;
            } else {
                at += 1;
            }
        }
        if (from < valid.length) {
            let _ = out.appendUtf8(valid[from..valid.length])?;
        }
        for (b in chunk.invalid) {
            appendEscapedByte(out, b)?;
        }
    }
    return Ok();
}

/// SQL text of any bytes in the engine's form.
fn sqlTextOf(bytes: Slice<u8>) -> Result<String, AllocError> {
    var out = String.create();
    appendSqlText(mut out, bytes)?;
    return Ok(out);
}

/// Whether `text` holds an escape, so that its bytes differ from its UTF-8.
fn hasEscapes(text: StringView) -> bool {
    let bytes = text.bytes();
    var at: usize = 0;
    while (at < bytes.length) {
        if (isEscapeAt(bytes, at)) {
            return true;
        }
        at += 1;
    }
    return false;
}

/// Appends the bytes `text` (in the engine's form) stands for.
fn appendSqlBytes(out: borrow mut ByteString, text: StringView) -> Result<void, AllocError> {
    let bytes = text.bytes();
    var from: usize = 0;
    var at: usize = 0;
    while (at < bytes.length) {
        if (isEscapeAt(bytes, at)) {
            if (from < at) {
                out.appendBytes(bytes[from..at])?;
            }
            out.appendByte(escapedByteAt(bytes, at))?;
            at += 4;
            from = at;
        } else {
            at += 1;
        }
    }
    if (from < bytes.length) {
        out.appendBytes(bytes[from..bytes.length])?;
    }
    return Ok();
}

/// The bytes `text` (in the engine's form) stands for.
fn sqlBytes(text: StringView) -> Result<ByteString, AllocError> {
    var out = ByteString.withCapacity(text.length)?;
    appendSqlBytes(mut out, text)?;
    return Ok(out);
}

impl SqliteValue {
    /// A text value of the bytes `text`, SQL text in the engine's form, stands for: a string literal's value, a
    /// name or a definition.
    fn sqlText(text: StringView) -> Result<SqliteValue, AllocError> => Ok(SqliteValue.Text(sqlBytes(text)?));
}

/// Result column names, made in the engine's form, as the bytes they stand for.
fn columnNamesOf(names: Vector<String>) -> Result<Vector<ByteString>, AllocError> {
    var out = Vector<ByteString>.withCapacity(names.length)?;
    for (i in 0..names.length) {
        out.push(sqlBytes(names[i].view())?)?;
    }
    return Ok(out);
}

/// Whether `text` starts with `prefix`, ASCII case ignored, compared by bytes: slicing a `String` at the prefix's
/// length would stop inside a character of a name such as "abcdefé".
fn startsWithIgnoreAsciiCase(text: StringView, prefix: StringView) -> bool =>
    text.length >= prefix.length &&
        ByteStringView.fromBytes(text.bytes()[0..prefix.length]).equalsIgnoreAsciiCase(prefix.bytes());
