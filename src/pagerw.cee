// The writable pager: a transaction's view of a database's pages. Pages are changed in memory; `commit` journals
// the old ones, writes the new, and removes the journal; in WAL mode it appends the new ones to the write-ahead
// log instead (wal.cee). Freed pages go to SQLite's freelist and are used again.
// https://www.sqlite.org/fileformat2.html#the_freelist
//
// Differences from the C# engine, which this replaces:
// - a database that keeps pointer-map pages (auto-vacuum or incremental vacuum) is refused. The C# changed its
//   b-trees without updating the pointer map, which SQLite then finds in disagreement with the file;
// - in WAL mode one pager does both: reads see the log, commits append to it. The C# had a second pager for WAL
//   mode (WalPager), whose freelist made every freed page a trunk and checked no page number it read;
// - in WAL mode page 1 is written only when a commit changes it, as SQLite does, so a commit's frames are the
//   pages SQLite would write;
// - page numbers and counts read from the freelist are checked, so a damaged freelist is `Corrupt` instead of a
//   page handed out twice;
// - a freed page becomes a leaf of the first trunk page while that has room. The C# made every freed page a
//   trunk of its own, which is a valid freelist but touches the header for each page;
// - the page that holds SQLite's lock bytes is never allocated;
// - `rollback` forgets a transaction's changes. The C# pager could only be thrown away;
// - the pager takes SQLite's file locks (below), so connections in this process and in others, sqlite3 among
//   them, are kept apart as SQLite keeps its connections apart. The C# took none.
//
// Locks (os_unix.c's, on bytes of the database file past any page, which sqlite3 sees):
// - SHARED, for a read transaction: a read lock on the 510 bytes from SHARED_FIRST, taken while holding a read
//   lock on PENDING_BYTE, so that a writer waiting for readers to leave is not overtaken;
// - RESERVED, at a transaction's first write: a write lock on RESERVED_BYTE, which one connection at a time holds;
// - PENDING, on the way to EXCLUSIVE: a write lock on PENDING_BYTE, which keeps new readers out;
// - EXCLUSIVE, to commit: a write lock on the SHARED range, granted once every reader has left.
// A transaction ends with no lock. Before reading, a connection that took SHARED looks for a hot journal (one
// that exists while no writer holds RESERVED): it then takes EXCLUSIVE, plays the journal back, and goes on.
// It also compares the files with what they were when it last held a lock, and forgets every page it holds when
// another connection committed since (SQLite's change-counter check).
//
// WAL mode (wal.c's, through the wal-index of walindex.cee): a connection holds SHARED on the database file for as
// long as it has the database open in WAL mode, as SQLite's does, so that no connection leaves WAL mode or removes
// the log under it. Its transactions take the locks of the `-shm` file instead: a read transaction a read mark, a
// write transaction the writer's lock as well. Readers run beside the writer, each on the last commit it saw. The
// connection that closes last, the only one that can take EXCLUSIVE, checkpoints the log and removes it and the
// `-shm`. The locking is POSIX-only: on Windows (os_win.c's scheme) WAL mode is refused.

/// SQLite's default for PRAGMA wal_autocheckpoint, in frames.
const WAL_DEFAULT_AUTOCHECKPOINT: u32 = 1000;

/// The bytes of SQLite's locks (os_unix.c): PENDING_BYTE (journal.cee) and the two after it, then the range readers
/// share.
const RESERVED_BYTE: u64 = 0x40000001;
const SHARED_FIRST: u64 = 0x40000002;
const SHARED_SIZE: u64 = 510;

/// A connection's lock on a database file, in SQLite's order.
const LOCK_NONE: u8 = 0;
const LOCK_SHARED: u8 = 1;
const LOCK_RESERVED: u8 = 2;
const LOCK_PENDING: u8 = 3;
const LOCK_EXCLUSIVE: u8 = 4;

/// sqliteDefaultBusyCallback's sleeps, in milliseconds, and their running totals.
const BUSY_DELAYS: [u64; 12] = [1, 2, 5, 10, 15, 20, 25, 25, 25, 50, 50, 100];
const BUSY_TOTALS: [u64; 12] = [0, 1, 3, 8, 18, 33, 53, 78, 103, 128, 178, 228];

/// SQLite's default busy handler: before try `count + 2` of a lock (counting from 0 for the first retry), sleeps
/// as sqliteDefaultBusyCallback does, and gives up (false) once `timeout` milliseconds would be spent.
fn busyWait(count: usize, timeout: i64) -> bool {
    let limit = checkedTruncate<u64>(timeout) ?? 0;
    var delay: u64 = BUSY_DELAYS[11];
    var prior: u64 = BUSY_TOTALS[11] + delay * ((count.saturatingSub(11)) as u64);
    if (count < 12) {
        delay = BUSY_DELAYS[count];
        prior = BUSY_TOTALS[count];
    }
    if (prior + delay > limit) {
        if (prior >= limit) {
            return false;
        }
        delay = limit - prior;
    }
    Thread.sleep(delay);
    return true;
}

fn busyError() -> SqliteError => SqliteError.Busy(ownedMessage("database is locked"));

/// What a database's files were when a connection last knew its pages to be current: the file header, the
/// file's length, and the log's length and header.
struct FilesSeen {
    header: Vector<u8>;
    length: u64;
    walLength: u64;
    walHeader: Vector<u8>;

    fn same(borrow this, other: borrow FilesSeen) -> bool =>
        this.length == other.length && this.walLength == other.walLength && this.header.view() == other.header.view() &&
            this.walHeader.view() == other.walHeader.view();

    /// The schema cookie in the header (offset 40).
    fn schemaCookie(borrow this) -> u32 => if (this.header.length >= 44) this.header.view().readBE<u32>(40) else 0;
}

struct WritablePager {
    private file: File;
    /// The lock this pager's file handle holds (LOCK_NONE … LOCK_EXCLUSIVE).
    private lock: u8;
    /// Milliseconds to wait for another connection's lock (PRAGMA busy_timeout), which the session sets.
    busyTimeout: i64;
    /// The files as they were when the pages held here were read; null before the first transaction.
    private seen: FilesSeen?;
    /// Whether this transaction committed, so that `seen` must be read again before the lock goes.
    private committedHere: bool;
    /// PRAGMA data_version: goes up each time a transaction finds another connection's commit.
    dataVersion: i64;
    /// The write-ahead log and its wal-index, while the database is open in WAL mode; commits go to the log.
    private shared: SharedWal?;
    private walMode: bool;
    /// A commit that leaves this many frames or more in the log checkpoints it; 0 never does.
    autoCheckpoint: u32;
    /// Whether the last commit left enough frames for the automatic checkpoint, made when the transaction ends.
    private checkpointDue: bool;
    /// Whether a transaction was open on this database before the running statement began (the session says).
    readBeforeStatement: bool;
    private path: String;
    pageSize: usize;
    usable: usize;
    textEncoding: TextEncoding;
    /// The number of pages the database has in this transaction.
    pageCount: u32;
    // The state at the last commit, which `rollback` returns to and the journal restores.
    private committedPageCount: u32;
    private committedFreeTrunk: u32;
    private committedFreeCount: u32;
    private changeCounter: u32;
    private freeTrunk: u32;
    private freeCount: u32;
    // The pages the transaction has looked at: `slots` says where in `pages` each one is.
    private slots: HashMap<u32, usize>;
    /// Shared with the readers given them (`readPage`); a write copies a page only while a reader still has it.
    private pages: Vector<Arc<Vector<u8>>>;
    private preImages: HashMap<u32, Vector<u8>>;
    private dirty: HashMap<u32, bool>;
    /// Savepoints in progress, innermost last (a statement's own is the top one): each holds the content pages had
    /// when it began, saved before their first change while it was the innermost.
    private levels: Vector<StatementUndo>;

    /// Opens the database at `path` for changes, making the file (an empty database) when there is none, and
    /// starts a read transaction on it (`startRead`): the pager comes back holding SHARED, which the caller ends
    /// with `endTransaction`. A commit that was interrupted is undone first.
    fn open(path: StringView) -> Result<WritablePager, SqliteError> => WritablePager.openWaiting(path, 0);

    /// `open`, waiting up to `busyTimeout` milliseconds for another connection's lock.
    fn openWaiting(path: StringView, busyTimeout: i64) -> Result<WritablePager, SqliteError> {
        let file = File.openOrCreate(path)?;
        var pager = WritablePager {
            file: file,
            lock: LOCK_NONE,
            busyTimeout: busyTimeout,
            seen: null,
            committedHere: false,
            dataVersion: 1,
            shared: null,
            walMode: false,
            autoCheckpoint: WAL_DEFAULT_AUTOCHECKPOINT,
            checkpointDue: false,
            readBeforeStatement: false,
            path: String.from(path)?,
            pageSize: 4096,
            usable: 4096,
            textEncoding: TextEncoding.Utf8,
            pageCount: 0,
            committedPageCount: 0,
            committedFreeTrunk: 0,
            committedFreeCount: 0,
            changeCounter: 0,
            freeTrunk: 0,
            freeCount: 0,
            slots: HashMap<u32, usize>.create(),
            pages: Vector<Arc<Vector<u8>>>.create(),
            preImages: HashMap<u32, Vector<u8>>.create(),
            dirty: HashMap<u32, bool>.create(),
            levels: Vector<StatementUndo>.create(),
        };
        let _ = pager.startRead()?;
        return Ok(pager);
    }

    // ── locks ────────────────────────────────────────────────────────────────────────────────────────────────

    /// The transaction's lock (LOCK_NONE … LOCK_EXCLUSIVE). In WAL mode, where SHARED on the file is held between
    /// transactions, it is the transaction's: SHARED for a read mark, RESERVED for the writer's lock as well.
    fn lockLevel(borrow this) -> u8 {
        if (borrow this.shared is Some(wal)) {
            if (wal.holdsWriteLock()) {
                return LOCK_RESERVED;
            }
            return if (wal.readMark() >= 0) LOCK_SHARED else LOCK_NONE;
        }
        return this.lock;
    }

    /// SHARED, from no lock (unixLock): a read lock on PENDING_BYTE while the SHARED range is read-locked, then
    /// released. False when a writer holds PENDING or EXCLUSIVE.
    private fn tryShared(borrow mut this) -> Result<bool, SqliteError> {
        if (this.lock >= LOCK_SHARED) {
            return Ok(true);
        }
        if (!this.file.tryLock(FileLock.Shared, PENDING_BYTE, 1)?) {
            return Ok(false);
        }
        let shared = this.file.tryLock(FileLock.Shared, SHARED_FIRST, SHARED_SIZE);
        this.file.unlock(PENDING_BYTE, 1)?;
        if (!shared?) {
            return Ok(false);
        }
        this.lock = LOCK_SHARED;
        return Ok(true);
    }

    /// RESERVED, from SHARED: the one writer's byte. False when another connection is writing.
    private fn tryReserved(borrow mut this) -> Result<bool, SqliteError> {
        if (this.lock >= LOCK_RESERVED) {
            return Ok(true);
        }
        if (this.lock != LOCK_SHARED || !this.file.tryLock(FileLock.Exclusive, RESERVED_BYTE, 1)?) {
            return Ok(false);
        }
        this.lock = LOCK_RESERVED;
        return Ok(true);
    }

    /// EXCLUSIVE, from SHARED or more: PENDING first, which keeps new readers out, then the SHARED range for
    /// writing, which is granted once every reader has left. When readers remain the lock stays PENDING (as in
    /// unixLock), and a later try goes on from there.
    private fn tryExclusive(borrow mut this) -> Result<bool, SqliteError> {
        if (this.lock == LOCK_EXCLUSIVE) {
            return Ok(true);
        }
        if (this.lock == LOCK_NONE) {
            return Ok(false);
        }
        if (this.lock < LOCK_PENDING) {
            if (!this.file.tryLock(FileLock.Exclusive, PENDING_BYTE, 1)?) {
                return Ok(false);
            }
            this.lock = LOCK_PENDING;
        }
        // The read lock this handle holds on the range becomes a write lock (fcntl converts it in place).
        if (!this.file.tryLock(FileLock.Exclusive, SHARED_FIRST, SHARED_SIZE)?) {
            return Ok(false);
        }
        this.lock = LOCK_EXCLUSIVE;
        return Ok(true);
    }

    /// Back to SHARED from a stronger lock (unixUnlock): the SHARED range read-locked again, PENDING_BYTE and
    /// RESERVED_BYTE released.
    private fn downgradeToShared(borrow mut this) -> Result<void, SqliteError> {
        if (this.lock <= LOCK_SHARED) {
            return Ok();
        }
        if (this.lock == LOCK_EXCLUSIVE && !this.file.tryLock(FileLock.Shared, SHARED_FIRST, SHARED_SIZE)?) {
            // A handle's own write lock always converts; anything else is a broken lock table.
            this.unlockAll();
            return Err(busyError());
        }
        this.file.unlock(PENDING_BYTE, 2)?;
        this.lock = LOCK_SHARED;
        return Ok();
    }

    /// Releases every lock: PENDING_BYTE, RESERVED_BYTE and the SHARED range, 512 bytes in a row. In WAL mode the
    /// log and the wal-index are closed too (and their locks go): without SHARED the database may leave WAL mode,
    /// so the next transaction looks at the files afresh.
    private fn unlockAll(borrow mut this) {
        if (this.shared.isSome()) {
            this.shared = null;
            this.walMode = false;
            this.seen = null;
        }
        if (this.lock == LOCK_NONE) {
            return;
        }
        // An unlock that fails leaves nothing to do but close the file, which releases every lock; it fails only
        // for a handle that is not open.
        let _ = this.file.unlock(PENDING_BYTE, 2 + SHARED_SIZE);
        this.lock = LOCK_NONE;
    }

    /// Starts a read transaction, from no lock: SHARED (in WAL mode a read mark too), with a hot journal rolled back
    /// and the pages forgotten if another connection committed since this one's last transaction. Waits up to
    /// the busy timeout, then fails with "database is locked". True when the schema cookie moved (or the file
    /// was read for the first time), so the schema must be read again.
    fn startRead(borrow mut this) -> Result<bool, SqliteError> {
        if (this.lockLevel() != LOCK_NONE) {
            return Ok(false);
        }
        return this.startFromNone(false);
    }

    /// The writer's lock: RESERVED on the file, or in WAL mode the `-shm` writer's lock, which a transaction
    /// whose snapshot is no longer the last commit cannot have. False when another connection is writing.
    private fn tryWriter(borrow mut this) -> Result<bool, SqliteError> {
        if (borrow mut this.shared is Some(wal)) {
            return wal.beginWrite();
        }
        return this.tryReserved();
    }

    /// What a try that failed took is released before the next: in WAL mode the transaction's `-shm` locks (SHARED
    /// on the file stays), else every lock.
    private fn releaseForRetry(borrow mut this) {
        if (borrow mut this.shared is Some(wal)) {
            wal.endRead();
            return;
        }
        this.unlockAll();
    }

    /// Makes this transaction a write transaction: RESERVED. From no lock it waits as `startRead` does. Holding
    /// SHARED, it waits only with `mayRestart` (the statement began without this database locked: its SHARED is
    /// given up between tries, as sqlite3BtreeBeginTrans does); otherwise a reader that waited could deadlock
    /// with the writer waiting for it to leave, so it fails at once, as SQLite does. True as for `startRead`.
    fn startWrite(borrow mut this, mayRestart: bool) -> Result<bool, SqliteError> {
        if (this.lockLevel() >= LOCK_RESERVED) {
            return Ok(false);
        }
        if (this.lockLevel() == LOCK_SHARED) {
            if (this.tryWriter()?) {
                return Ok(false);
            }
            if (!mayRestart) {
                return Err(busyError());
            }
            this.releaseForRetry();
            if (!busyWait(0, this.busyTimeout)) {
                return Err(busyError());
            }
        }
        return this.startFromNone(true);
    }

    /// The retry loop of `startRead` and `startWrite`, from no lock.
    private fn startFromNone(borrow mut this, write: bool) -> Result<bool, SqliteError> {
        var changed = false;
        var attempt: usize = 0;
        loop {
            match (this.tryStart()) {
                Ok(Some(c)) => {
                    changed = changed || c;
                    match (if (write) this.tryWriter() else Ok(true)) {
                        Ok(true) => { return Ok(changed); }
                        Ok(false) => {}
                        Err(e) => {
                            this.releaseForRetry();
                            return Err(e);
                        }
                    }
                }
                Ok(null) => {}
                Err(e) => {
                    this.releaseForRetry();
                    return Err(e);
                }
            }
            this.releaseForRetry();
            if (!busyWait(attempt, this.busyTimeout)) {
                return Err(busyError());
            }
            attempt += 1;
        }
    }

    /// One try at a read transaction, from no lock (pagerSharedLock): null when another connection's lock is in
    /// the way, which the caller releases what was taken for, else whether the schema may have changed.
    private fn tryStart(borrow mut this) -> Result<bool?, SqliteError> {
        if (!this.tryShared()?) {
            return Ok(null);
        }
        if (this.walMode) {
            return this.startWal();
        }
        // A hot journal: one that exists while no writer holds RESERVED (a writer's own journal is not hot). The
        // RESERVED byte is tested by taking it for a moment, as no fcntl test of another's lock is offered.
        if (Journal.mayBeHot(this.path.view())?) {
            let free = this.file.tryLock(FileLock.Exclusive, RESERVED_BYTE, 1)?;
            if (free) {
                this.file.unlock(RESERVED_BYTE, 1)?;
            }
            if (free && this.file.length()? > 0) {
                if (!this.tryExclusive()?) {
                    return Ok(null);
                }
                let _ = Journal.rollBack(this.path.view(), mut this.file)?;
                this.downgradeToShared()?;
            }
        }
        var now = this.filesNow()?;
        // An empty file is an empty database: page 1 is written now, under EXCLUSIVE.
        if (now.length == 0) {
            if (!this.tryReserved()? || !this.tryExclusive()?) {
                return Ok(null);
            }
            if (this.file.length()? == 0) {
                // A journal beside an empty file is not hot, and is removed (as hasHotJournal does); so is a log,
                // as pagerOpenWalIfPresent removes it.
                Journal.remove(this.path.view())?;
                removeIfThere(withSuffix(this.path.view(), WAL_SUFFIX)?.view())?;
                removeIfThere(withSuffix(this.path.view(), SHM_SUFFIX)?.view())?;
                this.writeEmptyDatabase()?;
            }
            this.downgradeToShared()?;
            now = this.filesNow()?;
        }
        // A database whose header says WAL, or with a log beside it, is opened in WAL mode, as SQLite opens it.
        let isWal = now.header.length == 100 && (now.header[18] == 2 || now.header[19] == 2);
        if (isWal || now.walLength > 0) {
            return this.startWal();
        }
        if (borrow this.seen is Some(seen)) {
            if (seen.same(borrow now)) {
                return Ok(false);
            }
        }
        let schemaMoved = match (borrow this.seen) {
            Some(seen) => seen.schemaCookie() != now.schemaCookie(),
            null => true,
        };
        // As pager_reset does, the first read too: sqlite3 answers 2 before any other connection commits.
        this.dataVersion += 1;
        this.loadState()?;
        this.seen = now;
        return Ok(schemaMoved);
    }

    /// One try at a read transaction in WAL mode, holding SHARED on the file: the log and the wal-index are opened
    /// the first time, then a read mark is taken (walBeginReadTransaction). The pages held are forgotten when the
    /// index's header moved since this connection's last transaction. Null as for `tryStart`.
    private fn startWal(borrow mut this) -> Result<bool?, SqliteError> {
        if (this.shared.isNull()) {
            if (onWindows()) {
                return Err(
                    unsupported("WAL mode needs POSIX file locks on the -shm file; it is not supported on Windows yet"),
                );
            }
            match (SharedWal.open(this.path.view())?) {
                Some(wal) => { this.shared = wal; }
                null => { return Ok(null); }
            }
            this.walMode = true;
            this.seen = null;
        }
        let moved = match (borrow mut this.shared) {
            Some(wal) => wal.beginRead()?,
            null => { return Ok(null); },
        };
        let Some(changed) = moved else {
            return Ok(null);
        };
        if (!changed && this.seen.isSome()) {
            return Ok(false);
        }
        let previousCookie = match (borrow this.seen) {
            Some(seen) => Some(seen.schemaCookie()),
            null => null,
        };
        // As pager_reset does when the header moved, the first read too.
        this.dataVersion += 1;
        this.loadState()?;
        let now = this.walSeen()?;
        let cookie = now.schemaCookie();
        this.seen = now;
        return Ok(match (previousCookie) {
            Some(previous) => previous != cookie,
            null => true,
        });
    }

    /// What `seen` holds in WAL mode: the database header as this transaction reads it, for its schema cookie.
    /// Whether the pages held are current is the wal-index header's to say.
    private fn walSeen(borrow mut this) -> Result<FilesSeen, SqliteError> {
        var header = Vector<u8>.create();
        header.extend(this.read(1)?[0..100])?;
        return Ok(FilesSeen { header: header, length: 0, walLength: 0, walHeader: Vector<u8>.create() });
    }

    /// Writes page 1 of an empty database into the empty file, as the first commit to it.
    private fn writeEmptyDatabase(borrow mut this) -> Result<void, SqliteError> {
        var writer = DatabaseWriter.create(WriterOptions.defaults())?;
        let store = writer.buildPages()?;
        for (i in 0..store.pages.length) {
            this.file.writeAt(store.pages[i].view(), (i as u64) * (store.pageSize as u64))?;
        }
        this.file.syncAll()?;
        Directory.sync(directoryOf(this.path.view()))?;
        return Ok();
    }

    /// The files as they are now (see `FilesSeen`).
    private fn filesNow(borrow mut this) -> Result<FilesSeen, SqliteError> {
        var header = Vector<u8>.create();
        header.resize(100, 0)?;
        if (!readFully(mut this.file, header.viewMut(), 0)?) {
            header.clear();
        }
        let length = this.file.length()?;
        var walLength: u64 = 0;
        var walHeader = Vector<u8>.create();
        let name = withSuffix(this.path.view(), WAL_SUFFIX)?;
        match (File.open(name.view())) {
            Ok(f) => {
                var wal = f;
                walLength = wal.length()?;
                walHeader.resize(32, 0)?;
                if (!readFully(mut wal, walHeader.viewMut(), 0)?) {
                    walHeader.clear();
                }
            }
            Err(IoError.NotFound) => {}
            Err(e) => { return Err(SqliteError.Io(e)); }
        }
        return Ok(FilesSeen { header: header, length: length, walLength: walLength, walHeader: walHeader });
    }

    /// Takes EXCLUSIVE for a commit, waiting up to the busy timeout for readers to leave (pager_wait_on_lock).
    /// Without it the transaction is left as it was, holding PENDING, and fails with "database is locked".
    fn lockForCommit(borrow mut this) -> Result<void, SqliteError> {
        if (this.walMode) {
            // In WAL mode readers stay while the writer commits: the writer's lock is all it needs.
            return this.reserve();
        }
        if (this.lock == LOCK_EXCLUSIVE) {
            return Ok();
        }
        this.reserve()?;
        var attempt: usize = 0;
        while (!this.tryExclusive()?) {
            if (!busyWait(attempt, this.busyTimeout)) {
                return Err(busyError());
            }
            attempt += 1;
        }
        return Ok();
    }

    /// RESERVED for a change, without waiting: a statement that writes took it when it began (`startWrite`), so
    /// this is only for a change the session did not foresee.
    private fn reserve(borrow mut this) -> Result<void, SqliteError> {
        if (this.lockLevel() >= LOCK_RESERVED) {
            return Ok();
        }
        if (this.lockLevel() == LOCK_NONE) {
            return Err(unsupported("a page is changed outside a transaction"));
        }
        if (!this.tryWriter()?) {
            return Err(busyError());
        }
        return Ok();
    }

    /// Ends the transaction's hold on the file: changes not committed are forgotten, and every lock goes.
    fn endTransaction(borrow mut this) -> Result<void, SqliteError> {
        if (this.dirty.length() != 0) {
            this.rollback();
        }
        if (this.walMode) {
            return this.endWalTransaction();
        }
        if (this.lock == LOCK_NONE) {
            return Ok();
        }
        var result: Result<void, SqliteError> = Ok();
        if (this.committedHere) {
            // What this connection wrote is what its pages hold: the next transaction keeps them if no other
            // connection commits in between.
            match (this.filesNow()) {
                Ok(now) => { this.seen = now; }
                Err(e) => {
                    this.seen = null;
                    result = Err(e);
                }
            }
            this.committedHere = false;
        }
        this.unlockAll();
        return result;
    }

    /// The end of a transaction in WAL mode: its `-shm` locks go (SHARED on the file stays), and the automatic
    /// checkpoint a commit called for is made, as SQLite's wal hook makes it once the transaction is over.
    private fn endWalTransaction(borrow mut this) -> Result<void, SqliteError> {
        var result: Result<void, SqliteError> = Ok();
        if (this.committedHere) {
            // What this connection wrote is what its pages hold; the schema cookie is the one it wrote.
            match (this.walSeen()) {
                Ok(seen) => { this.seen = seen; }
                Err(e) => {
                    this.seen = null;
                    result = Err(e);
                }
            }
            this.committedHere = false;
        }
        if (borrow mut this.shared is Some(wal)) {
            wal.endRead();
        }
        if (this.checkpointDue) {
            this.checkpointDue = false;
            if (result.isOk()) {
                result = match (this.checkpoint(CheckpointMode.Passive)) {
                    Ok(_) => Ok(),
                    Err(e) => Err(e),
                };
            }
        }
        return result;
    }

    /// Reads the header afresh, forgetting every page held: the state at the last commit, whoever made it (in WAL
    /// mode, the commit of this transaction's snapshot). The caller holds SHARED, or a read mark in WAL mode.
    private fn loadState(borrow mut this) -> Result<void, SqliteError> {
        var bytes = Vector<u8>.create();
        bytes.resize(100, 0)?;
        if (!readFully(mut this.file, bytes.viewMut(), 0)?) {
            return Err(notADatabase("file is too small to be a SQLite database"));
        }
        let fileHeader = DatabaseHeader.parse(bytes.view())?;
        let pages = this.file.length()? / (fileHeader.pageSize as u64);
        let filePages = checkedTruncate<u32>(pages) ?? {
            return Err(corrupt("database file has more pages than the format allows"));
        };
        var pageCount = filePages;
        if (borrow mut this.shared is Some(wal)) {
            // Page 1 and the size as the snapshot has them: the log's when it holds them.
            var page = Vector<u8>.create();
            page.resize(fileHeader.pageSize, 0)?;
            if (wal.readPage(1, page.viewMut())?) {
                bytes.viewMut().copyFrom(page.view()[0..100]);
            }
            if (wal.databasePages() != 0) {
                pageCount = wal.databasePages();
            }
        }
        let header = DatabaseHeader.parse(bytes.view())?;
        if (header.pageSize != fileHeader.pageSize) {
            return Err(corrupt("the write-ahead log's page 1 gives another page size"));
        }
        if (bytes[18] > 2 || bytes[19] > 2) {
            return Err(unsupported("the database's file format is newer than this engine"));
        }
        if (bytes.view().readBE<u32>(52) != 0) {
            return Err(unsupported("databases with auto-vacuum or incremental vacuum cannot be written"));
        }
        if (header.schemaFormat > 4) {
            return Err(unsupported("the database's schema format is newer than this engine"));
        }
        this.pageSize = header.pageSize;
        this.usable = header.usableSize();
        this.textEncoding = header.textEncoding;
        this.pageCount = pageCount;
        this.committedPageCount = pageCount;
        this.committedFreeTrunk = header.firstFreelistTrunkPage;
        this.committedFreeCount = header.freelistPageCount;
        this.changeCounter = header.fileChangeCounter;
        this.freeTrunk = header.firstFreelistTrunkPage;
        this.freeCount = header.freelistPageCount;
        this.slots.clear();
        this.pages.clear();
        this.preImages.clear();
        this.dirty.clear();
        return Ok();
    }

    /// The file's path, as it was opened.
    fn filePath(borrow this) -> StringView => this.path.view();

    /// Whether the transaction has changed anything.
    fn hasChanges(borrow this) -> bool => this.dirty.length() != 0;

    /// The number of pages the transaction has changed.
    fn changedPages(borrow this) -> usize => this.dirty.length();

    /// The first trunk page of the freelist, and the number of pages on it, as the transaction sees them.
    fn freelistTrunk(borrow this) -> u32 => this.freeTrunk;

    fn freelistCount(borrow this) -> u32 => this.freeCount;

    /// The number of pages the file held at the last commit.
    fn committedPages(borrow this) -> u32 => this.committedPageCount;

    /// The page that holds SQLite's lock bytes, which no b-tree may use.
    private fn pendingPage(borrow this) -> u32 => truncate<u32>(PENDING_BYTE / (this.pageSize as u64)) + 1;

    private fn load(borrow mut this, number: u32) -> Result<void, SqliteError> {
        if (this.lockLevel() == LOCK_NONE) {
            // Pages are read only inside a transaction, which holds a lock that keeps writers out (in WAL mode,
            // a read mark that keeps checkpoints from overwriting its pages).
            return Err(unsupported("a page is read outside a transaction"));
        }
        if (number < 1 || number > this.pageCount) {
            return Err(corrupt("a page pointer leads outside the database file"));
        }
        if (this.slots.contains(borrow number)) {
            return Ok();
        }
        var bytes = Vector<u8>.create();
        bytes.resize(this.pageSize, 0)?;
        if (number <= this.committedPageCount) {
            let offset = ((number - 1) as u64) * (this.pageSize as u64);
            if (borrow mut this.shared is Some(wal)) {
                // The snapshot's latest frame of the page; else the file, where a page past its end (in no
                // frame) reads as zeros, as SQLite reads it.
                if (!wal.readPage(number, bytes.viewMut())? && !readFully(mut this.file, bytes.viewMut(), offset)?) {
                    bytes.viewMut().fill(0);
                }
            } else if (!readFully(mut this.file, bytes.viewMut(), offset)?) {
                return Err(corrupt("database file ends inside a page"));
            }
        }
        let slot = this.pages.length;
        this.pages.push(Arc<Vector<u8>>.create(bytes)?)?;
        let _ = this.slots.put(number, slot)?;
        return Ok();
    }

    /// Where page `number`, which is loaded, is in `pages`.
    private fn slotOf(borrow this, number: u32) -> usize => *this.slots.get(borrow number)!;

    /// Page `number` as the transaction sees it.
    fn read(borrow mut this, number: u32) -> Result<Slice<u8>, SqliteError> {
        this.load(number)?;
        return Ok(this.pages[this.slotOf(number)].get().view());
    }

    /// A copy of page `number`, for code that reads other pages while it looks at this one.
    fn copy(borrow mut this, number: u32) -> Result<Vector<u8>, SqliteError> {
        this.load(number)?;
        return Ok(this.pages[this.slotOf(number)].get().clone()?);
    }

    /// Page `number`, to change. Its old image is kept for the journal.
    fn write(borrow mut this, number: u32) -> Result<SliceMut<u8>, SqliteError> {
        this.reserve()?;
        this.load(number)?;
        if (this.levels.length != 0) {
            let top = this.levels.length - 1;
            let undo = borrow mut this.levels[top];
            if (!undo.saved.contains(borrow number)) {
                let image = this.pages[*this.slots.get(borrow number)!].get().clone()?;
                let wasDirty = this.dirty.contains(borrow number);
                let _ = undo.saved.put(number, SavedPage { image: image, wasDirty: wasDirty })?;
            }
        }
        if (number <= this.committedPageCount && !this.preImages.contains(borrow number)) {
            let image = this.pages[this.slotOf(number)].get().clone()?;
            let _ = this.preImages.put(number, image)?;
        }
        let _ = this.dirty.put(number, true)?;
        let slot = this.slotOf(number);
        if (this.pages[slot].getMut().isNull()) {
            // A reader still has this image: it keeps it, and the transaction changes a copy.
            let fresh = this.pages[slot].get().clone()?;
            this.pages[slot] = Arc<Vector<u8>>.create(fresh)?;
        }
        return Ok(this.pages[slot].getMut()!.viewMut());
    }

    /// The number of page numbers a freelist trunk page can hold. SQLite keeps six slots unused, for the sake
    /// of old versions of itself.
    private fn trunkCapacity(borrow this) -> usize => this.usable / 4 - 8;

    /// A zeroed page: one from the freelist if it has any, else a new one at the end of the file.
    fn allocatePage(borrow mut this) -> Result<u32, SqliteError> {
        this.reserve()?;
        if (this.freeTrunk != 0) {
            let trunkNumber = this.freeTrunk;
            let mostLeaves = this.usable / 4 - 2;
            let next = this.read(trunkNumber)?.readBE<u32>(0);
            let leaves = this.read(trunkNumber)?.readBE<u32>(4) as usize;
            if (leaves > mostLeaves) {
                return Err(corrupt("a freelist trunk page claims more leaves than fit in it"));
            }
            var taken = trunkNumber;
            if (leaves > 0) {
                taken = this.read(trunkNumber)?.readBE<u32>(8 + (leaves - 1) * 4);
                if (taken < 2 || taken > this.pageCount || taken == trunkNumber) {
                    return Err(corrupt("the freelist names a page outside the database file"));
                }
                this.write(trunkNumber)?.writeBE(4, truncate<u32>(leaves - 1));
            } else {
                // A trunk without leaves is itself the page to use; the next trunk heads the list.
                if (next > this.pageCount || next == trunkNumber) {
                    return Err(corrupt("the freelist names a page outside the database file"));
                }
                this.freeTrunk = next;
            }
            this.freeCount = this.freeCount.saturatingSub(1);
            this.write(taken)?.fill(0);
            return Ok(taken);
        }
        var number = this.pageCount;
        loop {
            if (number >= 4294967294) {
                return Err(unsupported("the database would have more pages than the file format allows"));
            }
            number += 1;
            var bytes = Vector<u8>.create();
            bytes.resize(this.pageSize, 0)?;
            let slot = this.pages.length;
            this.pages.push(Arc<Vector<u8>>.create(bytes)?)?;
            let _ = this.slots.put(number, slot)?;
            let _ = this.dirty.put(number, true)?;
            this.pageCount = number;
            if (number != this.pendingPage()) {
                return Ok(number);
            }
        }
    }

    /// Puts page `number` on the freelist: nothing refers to it any more.
    fn freePage(borrow mut this, number: u32) -> Result<void, SqliteError> {
        if (number < 2 || number > this.pageCount) {
            return Err(corrupt("a page to free is outside the database file"));
        }
        if (this.freeTrunk != 0) {
            let trunkNumber = this.freeTrunk;
            let leaves = this.read(trunkNumber)?.readBE<u32>(4) as usize;
            if (leaves < this.trunkCapacity()) {
                let trunk = this.write(trunkNumber)?;
                trunk.writeBE(8 + leaves * 4, number);
                trunk.writeBE(4, truncate<u32>(leaves + 1));
                this.freeCount += 1;
                return Ok();
            }
        }
        // The page becomes a trunk, at the head of the list.
        let previous = this.freeTrunk;
        let page = this.write(number)?;
        page.fill(0);
        page.writeBE(0, previous);
        this.freeTrunk = number;
        this.freeCount += 1;
        return Ok();
    }

    /// Adds one to the schema cookie, so that other connections read the schema again.
    fn bumpSchemaCookie(borrow mut this) -> Result<void, SqliteError> {
        let header = this.write(1)?;
        let cookie = header.readBE<u32>(40);
        header.writeBE(40, cookie.wrappingAdd(1));
        return Ok();
    }

    /// Starts a statement (or a savepoint): `rollbackStatement` can then undo its changes alone.
    fn beginStatement(borrow mut this) {
        let level = StatementUndo {
            saved: HashMap<u32, SavedPage>.create(),
            pageCount: this.pageCount,
            freeTrunk: this.freeTrunk,
            freeCount: this.freeCount,
        };
        if (this.levels.push(level).isErr()) {
            // Without room for the level its changes cannot be undone alone; the transaction still can be.
        }
    }

    /// How many savepoints are open, the statement's own included.
    fn savepointDepth(borrow this) -> usize => this.levels.length;

    /// Keeps the statement's changes in the savepoint around it (or the transaction).
    fn endStatement(borrow mut this) {
        if (this.levels.length == 0) {
            return;
        }
        let top = this.levels.pop()!;
        this.mergeDown(top);
    }

    /// Hands a closed level's saved pages to the level below, which keeps its own older ones.
    private fn mergeDown(borrow mut this, closed: StatementUndo) {
        if (this.levels.length == 0) {
            return;
        }
        let below = this.levels.length - 1;
        var saved = closed.saved;
        for (i in 0..saved.length()) {
            let number = *saved.keyAt(i);
            if (this.levels[below].saved.contains(borrow number)) {
                continue;
            }
            let page = replace(mut saved.getMut(borrow number)!.image, Vector<u8>.create());
            let wasDirty = saved.get(borrow number)!.wasDirty;
            if (this.levels[below].saved.put(number, SavedPage { image: page, wasDirty: wasDirty }).isErr()) {
                return;
            }
        }
    }

    /// Releases savepoint level `level` and those inside it, except the innermost (the running statement's):
    /// their changes join the level below `level`, or the transaction.
    fn releaseLevels(borrow mut this, level: usize) {
        if (level + 1 >= this.levels.length) {
            return;
        }
        let statement = this.levels.pop()!;
        // Inner levels first, each into the one below: a lower level's image of a page is the older, and stays.
        while (this.levels.length > level) {
            let closed = this.levels.pop()!;
            this.mergeDown(closed);
        }
        let _ = this.levels.push(statement);
    }

    /// Undoes the changes since savepoint level `level` began; the level stays open, emptied, and those inside
    /// it except the innermost (the running statement's) are closed.
    fn rollbackToLevel(borrow mut this, level: usize) -> Result<void, SqliteError> {
        if (level + 1 >= this.levels.length) {
            return Ok();
        }
        let statement = this.levels.pop()!;
        // Fold the inner levels into `level`, keeping the oldest image of each page, then undo it.
        while (this.levels.length > level + 1) {
            let closed = this.levels.pop()!;
            this.mergeDown(closed);
        }
        let undo = this.levels.pop()!;
        let restored = StatementUndo {
            saved: HashMap<u32, SavedPage>.create(),
            pageCount: undo.pageCount,
            freeTrunk: undo.freeTrunk,
            freeCount: undo.freeCount,
        };
        this.undoLevel(undo)?;
        this.levels.push(restored)?;
        this.levels.push(statement)?;
        return Ok();
    }

    /// Undoes the statement's changes, leaving the transaction as it was before it.
    fn rollbackStatement(borrow mut this) -> Result<void, SqliteError> {
        if (this.levels.length == 0) {
            return Ok();
        }
        let undo = this.levels.pop()!;
        return this.undoLevel(undo);
    }

    /// Puts back the pages a level saved, and the page count and freelist it began with.
    private fn undoLevel(borrow mut this, undo: StatementUndo) -> Result<void, SqliteError> {
        var saved = undo.saved;
        for (i in 0..saved.length()) {
            let number = *saved.keyAt(i);
            if (number > undo.pageCount) {
                continue;
            }
            let slot = *this.slots.get(borrow number)!;
            let page = saved.getMut(borrow number)!;
            this.pages[slot] = Arc<Vector<u8>>.create(replace(mut page.image, Vector<u8>.create()))?;
            if (!page.wasDirty) {
                let _ = this.dirty.remove(borrow number);
            }
        }
        // Pages added since the level began are gone again.
        var gone = Vector<u32>.create();
        for (i in 0..this.dirty.length()) {
            let number = *this.dirty.keyAt(i);
            if (number > undo.pageCount) {
                gone.push(number)?;
            }
        }
        for (i in 0..gone.length) {
            let _ = this.dirty.remove(borrow gone[i]);
            let _ = this.slots.remove(borrow gone[i]);
        }
        this.pageCount = undo.pageCount;
        this.freeTrunk = undo.freeTrunk;
        this.freeCount = undo.freeCount;
        return Ok();
    }

    /// VACUUM: the transaction's database becomes exactly `pages` (page 1 first), with an empty freelist. The old
    /// content stays in the journal until the commit.
    fn replaceAll(borrow mut this, pages: Slice<Vector<u8>>) -> Result<void, SqliteError> {
        // New pages come after the last one, not from the old freelist.
        this.freeTrunk = 0;
        this.freeCount = 0;
        for (i in 0..pages.length) {
            let number = truncate<u32>(i + 1);
            if (number <= this.pageCount) {
                this.write(number)?.copyFrom(pages[i].view());
            } else {
                let added = this.allocatePage()?;
                this.write(added)?.copyFrom(pages[i].view());
            }
        }
        this.pageCount = truncate<u32>(pages.length);
        this.freeTrunk = 0;
        this.freeCount = 0;
        return Ok();
    }

    /// The page size in bytes.
    fn pageSizeBytes(borrow this) -> usize => this.pageSize;

    /// The bytes a page keeps at its end for extensions (header byte 20).
    fn reservedBytes(borrow this) -> usize => this.pageSize - this.usable;

    /// Forgets everything the transaction changed.
    fn rollback(borrow mut this) {
        this.levels.clear();
        this.slots.clear();
        this.pages.clear();
        this.preImages.clear();
        this.dirty.clear();
        this.pageCount = this.committedPageCount;
        this.freeTrunk = this.committedFreeTrunk;
        this.freeCount = this.committedFreeCount;
    }

    /// Makes the transaction's changes durable, as one step: after a crash the database holds all of them or
    /// none.
    fn commit(borrow mut this) -> Result<void, SqliteError> {
        // Savepoints end with the transaction.
        this.levels.clear();
        if (this.dirty.length() == 0) {
            return Ok();
        }
        // Readers must leave before the file changes (in WAL mode they stay: the writer's lock is enough).
        this.lockForCommit()?;
        this.committedHere = true;
        let pageCount = this.pageCount;
        let freeTrunk = this.freeTrunk;
        let freeCount = this.freeCount;
        // In WAL mode, as in SQLite, page 1 is written only when the commit changes it: its size or freelist
        // fields, or anything else on it. A rollback-journal commit always counts a change in it.
        let first: u32 = 1;
        let headerChanged = this.dirty.contains(borrow first) || pageCount != this.committedPageCount ||
            freeTrunk != this.committedFreeTrunk || freeCount != this.committedFreeCount;
        var counter = this.changeCounter;
        if (!this.walMode || headerChanged) {
            counter = counter.wrappingAdd(1);
            let header = this.write(1)?;
            header.writeBE(24, counter);
            header.writeBE(28, pageCount);
            header.writeBE(32, freeTrunk);
            header.writeBE(36, freeCount);
            // The version-valid-for number says the in-header size is current.
            header.writeBE(92, counter);
            header.writeBE(96, WRITER_SQLITE_VERSION);
        }

        if (this.walMode) {
            this.commitToLog(pageCount)?;
        } else {
            var journal = JournalWriter.begin(this.path.view(), this.pageSize, this.committedPageCount)?;
            for (i in 0..this.preImages.length()) {
                journal.add(*this.preImages.keyAt(i), this.preImages.valueAt(i).view())?;
            }
            journal.finish()?;
            for (i in 0..this.dirty.length()) {
                let number = *this.dirty.keyAt(i);
                let offset = ((number - 1) as u64) * (this.pageSize as u64);
                let slot = this.slotOf(number);
                this.file.writeAt(this.pages[slot].get().view(), offset)?;
            }
            this.file.setLength((pageCount as u64) * (this.pageSize as u64))?;
            this.file.syncAll()?;
            Journal.remove(this.path.view())?;
        }

        this.changeCounter = counter;
        this.committedPageCount = pageCount;
        this.committedFreeTrunk = freeTrunk;
        this.committedFreeCount = freeCount;
        this.preImages.clear();
        this.dirty.clear();
        // SQLite's automatic checkpoint: a passive one once the log holds wal_autocheckpoint frames, made when the
        // transaction has ended (`endWalTransaction`).
        if (borrow this.shared is Some(wal)) {
            this.checkpointDue = this.autoCheckpoint != 0 && wal.hdr.frames >= this.autoCheckpoint;
        }
        return Ok();
    }

    /// Appends the changed pages to the log, in page order, the last frame marking the commit.
    private fn commitToLog(borrow mut this, pageCount: u32) -> Result<void, SqliteError> {
        var numbers = Vector<u32>.withCapacity(this.dirty.length())?;
        for (i in 0..this.dirty.length()) {
            numbers.push(*this.dirty.keyAt(i))?;
        }
        numbers.sortBy((a, b) => if (*a < *b) -1 else if (*a > *b) 1 else 0);
        let pageSize = this.pageSize;
        let Some(wal) = borrow mut this.shared else {
            return Err(unsupported("the write-ahead log is not open"));
        };
        wal.beginCommit(pageSize)?;
        for (k in 0..numbers.length) {
            let number = numbers[k];
            let commitSize = if (k + 1 == numbers.length) pageCount else 0;
            let slot = *this.slots.get(borrow number)!;
            wal.addFrame(number, this.pages[slot].get().view(), commitSize)?;
        }
        wal.finishCommit(pageCount)?;
        return Ok();
    }

    /// Whether the database is in WAL mode: commits go to its write-ahead log.
    fn inWalMode(borrow this) -> bool => this.walMode;

    /// PRAGMA wal_checkpoint (sqlite3WalCheckpoint): copies the log's committed pages into the database file as
    /// far as readers allow, waiting for them as `mode` says. As SQLite's, it runs outside a read transaction:
    /// the running statement's own ends first. The transaction must have no changes.
    fn checkpoint(borrow mut this, mode: CheckpointMode) -> Result<WalCheckpoint, SqliteError> {
        assert(this.dirty.length() == 0, "a checkpoint is made between transactions");
        let pageSize = this.pageSize;
        let timeout = this.busyTimeout;
        let Some(wal) = borrow mut this.shared else {
            return Ok(WalCheckpoint { busy: false, logFrames: -1, checkpointed: -1 });
        };
        wal.endRead();
        var changed = false;
        return wal.checkpoint(mut this.file, pageSize, mode, timeout, mut changed);
    }

    /// Puts the database in WAL mode: the header's format numbers become 2, in a commit of its own (through the
    /// rollback journal, under EXCLUSIVE); then the connection holds SHARED, opens the log and the wal-index, and
    /// goes on in a read transaction on them.
    fn enterWalMode(borrow mut this) -> Result<void, SqliteError> {
        if (this.walMode) {
            return Ok();
        }
        if (onWindows()) {
            return Err(
                unsupported("WAL mode needs POSIX file locks on the -shm file; it is not supported on Windows yet"),
            );
        }
        let header = this.write(1)?;
        header[18] = 2;
        header[19] = 2;
        this.commit()?;
        this.committedHere = false;
        this.downgradeToShared()?;
        this.seen = null;
        let started = this.startWal()?;
        if (started.isNull()) {
            return Err(busyError());
        }
        return Ok();
    }

    /// Leaves WAL mode for a rollback journal (sqlite3PagerCloseWal): only with EXCLUSIVE on the file, which no
    /// other connection with the database open in WAL mode lets this one have; the log is checkpointed and
    /// removed with the wal-index, and the header's format numbers become 1.
    fn leaveWalMode(borrow mut this) -> Result<void, SqliteError> {
        if (!this.walMode) {
            return Ok();
        }
        if (borrow mut this.shared is Some(wal)) {
            wal.endRead();
        }
        if (!this.tryReserved()? || !this.tryExclusive()?) {
            this.downgradeToShared()?;
            let _ = this.startWal()?;
            return Err(busyError());
        }
        if (!this.checkpointAndRemoveLog()?) {
            return Err(busyError());
        }
        let header = this.write(1)?;
        header[18] = 1;
        header[19] = 1;
        this.commit()?;
        return Ok();
    }

    /// Ends the connection: a transaction in progress is forgotten and, as SQLite does when its last connection
    /// closes, a write-ahead log is checkpointed and removed.
    fn close(this) -> Result<void, SqliteError> {
        var me = this;
        return me.closeLog();
    }

    /// What closing does, the pager staying usable: forgets a transaction in progress, and in WAL mode copies the
    /// log into the file and removes it and the wal-index, as SQLite's last connection does: only when the
    /// EXCLUSIVE lock can be had at once, which means no other connection (a sqlite3 holding the database open in
    /// WAL mode among them) is using it. Otherwise the log stays for the others. Every lock goes.
    fn closeLog(borrow mut this) -> Result<void, SqliteError> {
        this.rollback();
        this.checkpointDue = false;
        var result: Result<void, SqliteError> = Ok();
        if (!this.walMode && this.lock == LOCK_NONE) {
            // One try, without waiting: a database in WAL mode is opened in it, so that its log is removed.
            match (this.tryStart()) {
                Ok(_) => {}
                Err(e) => { result = Err(e); }
            }
        }
        if (this.walMode && result.isOk()) {
            if (borrow mut this.shared is Some(wal)) {
                wal.endRead();
            }
            match (this.tryReserved()) {
                Ok(true) => {
                    match (this.tryExclusive()) {
                        Ok(true) => {
                            match (this.checkpointAndRemoveLog()) {
                                Ok(_) => {}
                                Err(e) => { result = Err(e); }
                            }
                        }
                        Ok(false) => {}
                        Err(e) => { result = Err(e); }
                    }
                }
                Ok(false) => {}
                Err(e) => { result = Err(e); }
            }
        }
        this.committedHere = false;
        // The files changed; the next transaction reads them afresh.
        this.unlockAll();
        this.seen = null;
        return result;
    }

    /// Holding EXCLUSIVE on the file: copies every frame into it and removes the log and the wal-index, leaving
    /// WAL mode. False when a frame could not be copied.
    private fn checkpointAndRemoveLog(borrow mut this) -> Result<bool, SqliteError> {
        let done = this.checkpoint(CheckpointMode.Passive)?;
        let complete = match (borrow this.shared) {
            Some(wal) => !done.busy && wal.fullyCheckpointed(),
            null => true,
        };
        if (!complete) {
            return Ok(false);
        }
        let Some(wal) = replace(mut this.shared, null) else {
            return Ok(true);
        };
        this.walMode = false;
        wal.closeAndRemove()?;
        return Ok(true);
    }
}

/// Whether the program is built for Windows, whose locks (os_win.c's scheme) the WAL code does not follow yet.
fn onWindows() -> bool {
    if (cfg("target.windows")) {
        return true;
    }
    return false;
}

impl PageSource for WritablePager {
    fn readPage(borrow mut this, number: u32) -> Result<Page, SqliteError> {
        this.load(number)?;
        return Ok(Page { bytes: this.pages[this.slotOf(number)].clone() });
    }

    fn usableSize(borrow this) -> usize => this.usable;

    fn textEncoding(borrow this) -> TextEncoding => this.textEncoding;

    fn totalPages(borrow this) -> u32 => this.pageCount;
}

impl PageSink for WritablePager {
    fn usableSize(borrow this) -> usize => this.usable;

    fn allocate(borrow mut this) -> Result<u32, SqliteError> => this.allocatePage();

    fn pageMut(borrow mut this, number: u32) -> Result<SliceMut<u8>, SqliteError> {
        let usable = this.usable;
        let page = this.write(number)?;
        return Ok(borrow mut page[0..usable]);
    }
}

/// A page's content before a statement changed it.
struct SavedPage {
    image: Vector<u8>;
    wasDirty: bool;
}

struct StatementUndo {
    saved: HashMap<u32, SavedPage>;
    pageCount: u32;
    freeTrunk: u32;
    freeCount: u32;
}
