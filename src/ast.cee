// The syntax tree the parser builds.
//
// The C# tree keeps operators, join kinds, frame bounds and conflict actions as strings; here they are enums, so
// a misspelt or unsupported one cannot reach the executor. Named windows (`OVER w`) stay names in the tree and
// are looked up in the SELECT's WINDOW clause when the query runs: the C# resolved them while parsing, and only
// in part of the select list.

// ── Expressions ──────────────────────────────────────────────────────────────────────────────────────────────

enum LiteralKind {
    Null,
    /// The text is decimal digits (with a sign for the smallest integer) or a hexadecimal literal.
    Integer,
    Float,
    String,
    /// The text is the blob's hex digits.
    Blob,
    True,
    False,
    CurrentTime,
    CurrentDate,
    CurrentTimestamp,
}

struct Literal {
    kind: LiteralKind;
    text: String;
}

struct ColumnRef {
    schema: String?;
    table: String?;
    name: String;
    /// An unqualified name written in double quotes: a string when no column has the name.
    doubleQuoted: bool;
}

enum UnaryOp {
    Negate,
    Plus,
    BitNot,
    Not,
}

enum BinaryOp {
    Or,
    And,
    Equal,
    NotEqual,
    Less,
    LessOrEqual,
    Greater,
    GreaterOrEqual,
    Add,
    Subtract,
    Multiply,
    Divide,
    Modulo,
    Concat,
    BitAnd,
    BitOr,
    ShiftLeft,
    ShiftRight,
    /// `->`: a JSON value.
    JsonGet,
    /// `->>`: a JSON value as SQL text or number.
    JsonGetValue,
}

enum LikeOp {
    Like,
    Glob,
    Match,
    Regexp,
}

enum RaiseAction {
    Ignore,
    Rollback,
    Abort,
    Fail,
}

struct BetweenExpr {
    operand: Expr;
    low: Expr;
    high: Expr;
    negated: bool;
}

struct LikeExpr {
    op: LikeOp;
    operand: Expr;
    pattern: Expr;
    escape: Expr?;
    negated: bool;
}

/// What stands to the right of IN.
enum InSource {
    /// `IN (a, b, c)`.
    Items(Vector<Expr>),
    /// `IN (SELECT …)`.
    Select(SelectStmt),
    /// `IN some_table`.
    Table(QualifiedName),
}

struct InExpr {
    operand: Expr;
    negated: bool;
    source: InSource;
}

enum FrameMode {
    Rows,
    Range,
    Groups,
}

enum FrameBoundKind {
    UnboundedPreceding,
    Preceding,
    CurrentRow,
    Following,
    UnboundedFollowing,
}

struct FrameBound {
    kind: FrameBoundKind;
    /// The distance of a `Preceding` or `Following` bound.
    offset: Expr?;
}

enum FrameExclude {
    NoOthers,
    CurrentRow,
    Group,
    Ties,
}

struct FrameSpec {
    mode: FrameMode;
    start: FrameBound;
    end: FrameBound;
    exclude: FrameExclude;
}

struct OverClause {
    /// `OVER w`, or `OVER (w …)`: the window of the WINDOW clause this one builds on.
    baseName: String?;
    partitionBy: Vector<Expr>;
    orderBy: Vector<OrderTerm>;
    frame: FrameSpec?;
}

struct FunctionCall {
    name: String;
    distinct: bool;
    /// `count(*)`.
    star: bool;
    args: Vector<Expr>;
    /// `FILTER (WHERE …)`.
    filter: Expr?;
    /// A window function when present.
    over: OverClause?;
    /// `group_concat(x ORDER BY y)`: the order an aggregate takes its rows in.
    orderBy: Vector<OrderTerm>;
}

struct WhenThen {
    when: Expr;
    then: Expr;
}

struct CaseExpr {
    /// `CASE operand WHEN …`.
    operand: Expr?;
    branches: Vector<WhenThen>;
    otherwise: Expr?;
}

enum Expr {
    Literal(Literal),
    Column(ColumnRef),
    /// `(a, b, …)`.
    RowValue(Vector<Expr>),
    /// `?`, `?1`, `:name`, `@name` or `$name`, as written.
    Param(String),
    Unary(UnaryOp, Box<Expr>),
    Binary(BinaryOp, Box<Expr>, Box<Expr>),
    /// `operand COLLATE name`.
    Collate(Box<Expr>, String),
    /// `left IS right`, or with `true`, `left IS NOT right`.
    Is(Box<Expr>, Box<Expr>, bool),
    Between(Box<BetweenExpr>),
    Like(Box<LikeExpr>),
    In(Box<InExpr>),
    Function(Box<FunctionCall>),
    /// `CAST(operand AS type)`.
    Cast(Box<Expr>, String),
    Case(Box<CaseExpr>),
    Subquery(Box<SelectStmt>),
    Exists(Box<SelectStmt>),
    /// `RAISE(action, message)`, in a trigger.
    Raise(RaiseAction, Box<Expr>?),
}

// ── Shared ───────────────────────────────────────────────────────────────────────────────────────────────────

struct QualifiedName {
    /// `main`, `temp` or an attached database's name, as written; `null` when the name is not qualified.
    schema: String?;
    name: String;
}

// ── SELECT ───────────────────────────────────────────────────────────────────────────────────────────────────

enum ResultColumn {
    /// `*`.
    Star,
    /// `table.*`.
    TableStar(String),
    /// An expression and its alias.
    Expr(Expr, String?),
}

struct TableSource {
    name: QualifiedName;
    alias: String?;
    indexedBy: String?;
    notIndexed: bool;
}

struct SubquerySource {
    select: SelectStmt;
    alias: String?;
}

struct TableFunctionSource {
    name: String;
    args: Vector<Expr>;
    alias: String?;
}

enum FromItem {
    Table(TableSource),
    Subquery(Box<SubquerySource>),
    TableFunction(TableFunctionSource),
}

enum JoinKind {
    /// `,`.
    Comma,
    /// `JOIN` or `INNER JOIN`.
    Inner,
    Left,
    Right,
    Full,
    Cross,
}

enum JoinConstraint {
    None,
    On(Expr),
    Using(Vector<String>),
}

struct Join {
    kind: JoinKind;
    natural: bool;
    item: FromItem;
    constraint: JoinConstraint;
    /// `LEFT JOIN (b JOIN c ON …) ON cond`: at the group's first item, how many items it has, and its ON. The
    /// group's items follow as joins of their own.
    group: usize;
    groupOn: Expr?;
}

struct FromClause {
    source: FromItem;
    joins: Vector<Join>;
}

struct OrderTerm {
    expr: Expr;
    descending: bool;
    /// `NULLS FIRST` (true) or `NULLS LAST` (false); `null` when neither is written.
    nullsFirst: bool?;
}

struct NamedWindow {
    name: String;
    spec: OverClause;
}

struct SelectCore {
    distinct: bool;
    columns: Vector<ResultColumn>;
    from: FromClause?;
    filter: Expr?;
    groupBy: Vector<Expr>;
    having: Expr?;
    windows: Vector<NamedWindow>;
    /// A row of VALUES: `columns` are its expressions, and there is nothing else.
    isValues: bool;
    /// Each result column's text as written (empty for `*`), which names a column without an alias.
    columnTexts: Vector<String>;
}

enum CompoundOp {
    Union,
    UnionAll,
    Intersect,
    Except,
}

struct CommonTableExpr {
    name: String;
    columns: Vector<String>;
    select: SelectStmt;
}

struct WithClause {
    recursive: bool;
    ctes: Vector<CommonTableExpr>;
}

struct SelectStmt {
    with: WithClause?;
    cores: Vector<SelectCore>;
    /// One fewer than `cores`: the operator between each core and the next.
    compoundOps: Vector<CompoundOp>;
    orderBy: Vector<OrderTerm>;
    limit: Expr?;
    offset: Expr?;
}

// ── Statements ───────────────────────────────────────────────────────────────────────────────────────────────

enum ConflictAction {
    Rollback,
    Abort,
    Fail,
    Ignore,
    Replace,
}

struct Assignment {
    column: String;
    value: Expr;
}

/// One `ON CONFLICT [(columns)] DO …` of an INSERT.
struct UpsertClause {
    /// The conflict target's columns; empty for a bare `ON CONFLICT`.
    target: Vector<String>;
    /// `DO NOTHING` when empty.
    assignments: Vector<Assignment>;
    filter: Expr?;
}

enum InsertSource {
    DefaultValues,
    Values(Vector<Vector<Expr>>),
    Select(SelectStmt),
}

struct InsertStmt {
    with: WithClause?;
    /// `INSERT OR action`, or `Replace` for `REPLACE INTO`.
    conflict: ConflictAction?;
    table: QualifiedName;
    columns: Vector<String>;
    source: InsertSource;
    upserts: Vector<UpsertClause>;
    returning: Vector<ResultColumn>;
    /// `INTO t AS alias`: the name DO UPDATE uses for the row.
    alias: String?;
    /// Each RETURNING column's text as written, which names it.
    returningTexts: Vector<String>;
}

struct UpdateStmt {
    with: WithClause?;
    conflict: ConflictAction?;
    table: QualifiedName;
    assignments: Vector<Assignment>;
    from: FromClause?;
    filter: Expr?;
    returning: Vector<ResultColumn>;
    /// `UPDATE t AS alias`: the name SET, FROM and WHERE use for the row.
    alias: String?;
    returningTexts: Vector<String>;
}

struct DeleteStmt {
    with: WithClause?;
    table: QualifiedName;
    filter: Expr?;
    returning: Vector<ResultColumn>;
    /// `DELETE FROM t AS alias`: the name WHERE uses for the row.
    alias: String?;
    returningTexts: Vector<String>;
}

/// A column of CREATE TABLE: its name, and the tokens of its type and constraints, which the schema catalog reads.
struct ColumnDef {
    name: String;
    body: Vector<Token>;
}

struct CreateTableStmt {
    temporary: bool;
    ifNotExists: bool;
    name: QualifiedName;
    columns: Vector<ColumnDef>;
    /// The tokens of each table constraint.
    constraints: Vector<Vector<Token>>;
    withoutRowid: bool;
    strict: bool;
    /// `CREATE TABLE … AS SELECT`: the query whose result columns and rows make the table.
    asSelect: Box<SelectStmt>?;
}

struct IndexedColumn {
    /// A plain column's name; empty for an expression.
    name: String;
    expression: Expr?;
    descending: bool;
    /// The column's COLLATE; empty to inherit the table column's.
    collation: String;
}

struct CreateIndexStmt {
    unique: bool;
    ifNotExists: bool;
    name: QualifiedName;
    table: String;
    columns: Vector<IndexedColumn>;
    filter: Expr?;
}

struct CreateViewStmt {
    temporary: bool;
    ifNotExists: bool;
    name: QualifiedName;
    columns: Vector<String>;
    select: SelectStmt;
}

enum TriggerTiming {
    Before,
    After,
    InsteadOf,
}

enum TriggerEvent {
    Insert,
    Update,
    Delete,
}

struct CreateTriggerStmt {
    temporary: bool;
    ifNotExists: bool;
    name: QualifiedName;
    timing: TriggerTiming;
    event: TriggerEvent;
    /// `UPDATE OF a, b`.
    updateOf: Vector<String>;
    table: String;
    when: Expr?;
    body: Vector<Stmt>;
}

enum AlterAction {
    AddColumn(ColumnDef),
    RenameTo(String),
    /// From, to.
    /// The old name, the new, and whether the statement quoted the new name (renameEditSql's bQuote).
    RenameColumn(String, String, bool),
    DropColumn(String),
}

struct AlterTableStmt {
    table: QualifiedName;
    action: AlterAction;
}

enum DropKind {
    Table,
    Index,
    View,
    Trigger,
}

struct DropStmt {
    kind: DropKind;
    ifExists: bool;
    name: QualifiedName;
}

struct PragmaStmt {
    name: QualifiedName;
    /// The value as written (a quoted one without its quotes); `null` for a query.
    value: String?;
    /// `PRAGMA x(value)` rather than `PRAGMA x = value`.
    parenthesized: bool;
}

enum TransactionKind {
    Deferred,
    Immediate,
    Exclusive,
}

struct AttachStmt {
    /// ':memory:' or a file name.
    target: Expr;
    schema: String;
}

enum Stmt {
    Select(Box<SelectStmt>),
    Insert(Box<InsertStmt>),
    Update(Box<UpdateStmt>),
    Delete(Box<DeleteStmt>),
    CreateTable(Box<CreateTableStmt>),
    CreateIndex(Box<CreateIndexStmt>),
    CreateView(Box<CreateViewStmt>),
    CreateTrigger(Box<CreateTriggerStmt>),
    AlterTable(Box<AlterTableStmt>),
    Drop(DropStmt),
    Pragma(PragmaStmt),
    Begin(TransactionKind),
    Commit,
    /// `ROLLBACK`, or `ROLLBACK TO name`.
    Rollback(String?),
    Savepoint(String),
    Release(String),
    Attach(Box<AttachStmt>),
    Detach(String),
    /// `VACUUM [schema] [INTO filename]`.
    Vacuum(Expr?),
    /// `ANALYZE`, or `ANALYZE name`.
    Analyze(String?),
    Reindex,
}

// ── copies ───────────────────────────────────────────────────────────────────────────────────────────────────

fn cloneString(s: borrow String?) -> Result<String?, AllocError> => match (s) {
    Some(x) => Ok(x.clone()?),
    null => Ok(null),
};

fn cloneStrings(list: borrow Vector<String>) -> Result<Vector<String>, AllocError> {
    var out = Vector<String>.withCapacity(list.length)?;
    for (i in 0..list.length) {
        out.push(list[i].clone()?)?;
    }
    return Ok(out);
}

fn cloneBoxed(e: borrow Expr) -> Result<Box<Expr>, AllocError> => Box.create(cloneExpr(e)?);

fn cloneOptional(e: borrow Expr?) -> Result<Expr?, AllocError> => match (e) {
    Some(x) => Ok(cloneExpr(x)?),
    null => Ok(null),
};

fn cloneExprList(list: borrow Vector<Expr>) -> Result<Vector<Expr>, AllocError> {
    var out = Vector<Expr>.withCapacity(list.length)?;
    for (i in 0..list.length) {
        out.push(cloneExpr(borrow list[i])?)?;
    }
    return Ok(out);
}

fn cloneName(n: borrow QualifiedName) -> Result<QualifiedName, AllocError> =>
    Ok(QualifiedName { schema: cloneString(borrow n.schema)?, name: n.name.clone()? });

fn cloneOrderList(list: borrow Vector<OrderTerm>) -> Result<Vector<OrderTerm>, AllocError> {
    var out = Vector<OrderTerm>.withCapacity(list.length)?;
    for (i in 0..list.length) {
        out.push(
            OrderTerm {
                expr: cloneExpr(borrow list[i].expr)?,
                descending: list[i].descending,
                nullsFirst: list[i].nullsFirst,
            },
        )?;
    }
    return Ok(out);
}

fn cloneOver(o: borrow OverClause) -> Result<OverClause, AllocError> {
    var frame: FrameSpec? = null;
    if (borrow o.frame is Some(f)) {
        frame = FrameSpec {
            mode: f.mode,
            start: FrameBound { kind: f.start.kind, offset: cloneOptional(borrow f.start.offset)? },
            end: FrameBound { kind: f.end.kind, offset: cloneOptional(borrow f.end.offset)? },
            exclude: f.exclude,
        };
    }
    return Ok(
        OverClause {
            baseName: cloneString(borrow o.baseName)?,
            partitionBy: cloneExprList(borrow o.partitionBy)?,
            orderBy: cloneOrderList(borrow o.orderBy)?,
            frame: frame,
        },
    );
}

/// A deep copy of an expression.
fn cloneExpr(e: borrow Expr) -> Result<Expr, AllocError> {
    match (e) {
        Expr.Literal(l) => { return Ok(Expr.Literal(Literal { kind: l.kind, text: l.text.clone()? })); }
        Expr.Column(c) => {
            return Ok(
                Expr.Column(
                    ColumnRef {
                        schema: cloneString(borrow c.schema)?,
                        table: cloneString(borrow c.table)?,
                        name: c.name.clone()?,
                        doubleQuoted: c.doubleQuoted,
                    },
                ),
            );
        }
        Expr.RowValue(items) => { return Ok(Expr.RowValue(cloneExprList(items)?)); }
        Expr.Param(p) => { return Ok(Expr.Param(p.clone()?)); }
        Expr.Unary(op, x) => { return Ok(Expr.Unary(op, cloneBoxed(x)?)); }
        Expr.Binary(op, a, b) => { return Ok(Expr.Binary(op, cloneBoxed(a)?, cloneBoxed(b)?)); }
        Expr.Collate(x, name) => { return Ok(Expr.Collate(cloneBoxed(x)?, name.clone()?)); }
        Expr.Is(a, b, negated) => { return Ok(Expr.Is(cloneBoxed(a)?, cloneBoxed(b)?, negated)); }
        Expr.Between(b) => {
            return Ok(
                Expr.Between(
                    Box.create(
                        BetweenExpr {
                            operand: cloneExpr(borrow b.operand)?,
                            low: cloneExpr(borrow b.low)?,
                            high: cloneExpr(borrow b.high)?,
                            negated: b.negated,
                        },
                    )?,
                ),
            );
        }
        Expr.Like(l) => {
            return Ok(
                Expr.Like(
                    Box.create(
                        LikeExpr {
                            op: l.op,
                            operand: cloneExpr(borrow l.operand)?,
                            pattern: cloneExpr(borrow l.pattern)?,
                            escape: cloneOptional(borrow l.escape)?,
                            negated: l.negated,
                        },
                    )?,
                ),
            );
        }
        Expr.In(i) => {
            let source = match (borrow i.source) {
                InSource.Items(items) => InSource.Items(cloneExprList(items)?),
                InSource.Select(s) => InSource.Select(cloneSelect(s)?),
                InSource.Table(t) => InSource.Table(cloneName(t)?),
            };
            return Ok(
                Expr.In(
                    Box.create(InExpr { operand: cloneExpr(borrow i.operand)?, negated: i.negated, source: source })?,
                ),
            );
        }
        Expr.Function(f) => {
            var over: OverClause? = null;
            if (borrow f.over is Some(o)) {
                over = cloneOver(o)?;
            }
            return Ok(
                Expr.Function(
                    Box.create(
                        FunctionCall {
                            name: f.name.clone()?,
                            distinct: f.distinct,
                            star: f.star,
                            args: cloneExprList(borrow f.args)?,
                            filter: cloneOptional(borrow f.filter)?,
                            over: over,
                            orderBy: cloneOrderList(borrow f.orderBy)?,
                        },
                    )?,
                ),
            );
        }
        Expr.Cast(x, t) => { return Ok(Expr.Cast(cloneBoxed(x)?, t.clone()?)); }
        Expr.Case(c) => {
            var branches = Vector<WhenThen>.withCapacity(c.branches.length)?;
            for (k in 0..c.branches.length) {
                branches.push(
                    WhenThen {
                        when: cloneExpr(borrow c.branches[k].when)?,
                        then: cloneExpr(borrow c.branches[k].then)?,
                    },
                )?;
            }
            return Ok(
                Expr.Case(
                    Box.create(
                        CaseExpr {
                            operand: cloneOptional(borrow c.operand)?,
                            branches: branches,
                            otherwise: cloneOptional(borrow c.otherwise)?,
                        },
                    )?,
                ),
            );
        }
        Expr.Subquery(s) => { return Ok(Expr.Subquery(Box.create(cloneSelect(s)?)?)); }
        Expr.Exists(s) => { return Ok(Expr.Exists(Box.create(cloneSelect(s)?)?)); }
        Expr.Raise(action, message) => {
            var m: Box<Expr>? = null;
            if (message is Some(x)) {
                m = cloneBoxed(x)?;
            }
            return Ok(Expr.Raise(action, m));
        }
    }
}

fn cloneResultColumns(list: borrow Vector<ResultColumn>) -> Result<Vector<ResultColumn>, AllocError> {
    var out = Vector<ResultColumn>.withCapacity(list.length)?;
    for (i in 0..list.length) {
        out.push(match (borrow list[i]) {
            ResultColumn.Star => ResultColumn.Star,
            ResultColumn.TableStar(t) => ResultColumn.TableStar(t.clone()?),
            ResultColumn.Expr(e, alias) => ResultColumn.Expr(cloneExpr(e)?, cloneString(alias)?),
        })?;
    }
    return Ok(out);
}

fn cloneFromItem(item: borrow FromItem) -> Result<FromItem, AllocError> => match (item) {
    FromItem.Table(t) => Ok(
        FromItem.Table(
            TableSource {
                name: cloneName(borrow t.name)?,
                alias: cloneString(borrow t.alias)?,
                indexedBy: cloneString(borrow t.indexedBy)?,
                notIndexed: t.notIndexed,
            },
        ),
    ),
    FromItem.Subquery(s) => Ok(
        FromItem.Subquery(
            Box.create(SubquerySource { select: cloneSelect(borrow s.select)?, alias: cloneString(borrow s.alias)? })?,
        ),
    ),
    FromItem.TableFunction(f) => Ok(
        FromItem.TableFunction(
            TableFunctionSource {
                name: f.name.clone()?,
                args: cloneExprList(borrow f.args)?,
                alias: cloneString(borrow f.alias)?,
            },
        ),
    ),
};

/// A deep copy of a SELECT.
fn cloneWith(with: borrow WithClause?) -> Result<WithClause?, AllocError> {
    let Some(w) = with else {
        return Ok(null);
    };
    var ctes = Vector<CommonTableExpr>.withCapacity(w.ctes.length)?;
    for (i in 0..w.ctes.length) {
        ctes.push(
            CommonTableExpr {
                name: w.ctes[i].name.clone()?,
                columns: cloneStrings(borrow w.ctes[i].columns)?,
                select: cloneSelect(borrow w.ctes[i].select)?,
            },
        )?;
    }
    return Ok(WithClause { recursive: w.recursive, ctes: ctes });
}

fn cloneJoin(join: borrow Join) -> Result<Join, AllocError> {
    let constraint = match (borrow join.constraint) {
        JoinConstraint.None => JoinConstraint.None,
        JoinConstraint.On(e) => JoinConstraint.On(cloneExpr(e)?),
        JoinConstraint.Using(names) => JoinConstraint.Using(cloneStrings(names)?),
    };
    return Ok(
        Join {
            kind: join.kind,
            natural: join.natural,
            item: cloneFromItem(borrow join.item)?,
            constraint: constraint,
            group: join.group,
            groupOn: cloneOptional(borrow join.groupOn)?,
        },
    );
}

fn cloneFromClause(from: borrow FromClause?) -> Result<FromClause?, AllocError> {
    let Some(f) = from else {
        return Ok(null);
    };
    var joins = Vector<Join>.withCapacity(f.joins.length)?;
    for (j in 0..f.joins.length) {
        joins.push(cloneJoin(borrow f.joins[j])?)?;
    }
    return Ok(FromClause { source: cloneFromItem(borrow f.source)?, joins: joins });
}

fn cloneSelect(s: borrow SelectStmt) -> Result<SelectStmt, AllocError> {
    let with = cloneWith(borrow s.with)?;
    var cores = Vector<SelectCore>.withCapacity(s.cores.length)?;
    for (i in 0..s.cores.length) {
        let c = borrow s.cores[i];
        let from = cloneFromClause(borrow c.from)?;
        var windows = Vector<NamedWindow>.withCapacity(c.windows.length)?;
        for (k in 0..c.windows.length) {
            windows.push(NamedWindow { name: c.windows[k].name.clone()?, spec: cloneOver(borrow c.windows[k].spec)? })?;
        }
        cores.push(SelectCore {
            distinct: c.distinct,
            columns: cloneResultColumns(borrow c.columns)?,
            from: from,
            filter: cloneOptional(borrow c.filter)?,
            groupBy: cloneExprList(borrow c.groupBy)?,
            having: cloneOptional(borrow c.having)?,
            windows: windows,
            isValues: c.isValues,
            columnTexts: cloneStrings(borrow c.columnTexts)?,
        })?;
    }
    var ops = Vector<CompoundOp>.withCapacity(s.compoundOps.length)?;
    for (i in 0..s.compoundOps.length) {
        ops.push(s.compoundOps[i])?;
    }
    return Ok(
        SelectStmt {
            with: with,
            cores: cores,
            compoundOps: ops,
            orderBy: cloneOrderList(borrow s.orderBy)?,
            limit: cloneOptional(borrow s.limit)?,
            offset: cloneOptional(borrow s.offset)?,
        },
    );
}
