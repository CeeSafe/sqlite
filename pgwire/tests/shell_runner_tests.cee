// A copy of the root package's tests/shell_runner_tests.cee (its process helpers), kept alike.
//
// Running the sqlite3 shell (and the few other programs the tests start) on every system, with lib/std's
// `Process.capture` and `Process.run` (on Windows they run programs since ceesafec 0.95.7, CEESAFE_FINDINGS.md 45
// and 46). On Windows the shell reads `.crlf off` from a `.sqliterc` of its own: `Process.captureWith` runs it with
// HOME set to a directory that holds one (since ceesafec 0.95.12, finding 51).

/// Whether the sqlite3 on the path is Apple's build (its source id ends in "aapl"). The engine follows sqlite.org's
/// SQLite 3.54.1, which CI runs; Apple's sqlite3 3.54.0, from an earlier snapshot of SQLite, answers a few
/// statements differently. Where a comparison meets one of them with Apple's shell, the engine is checked against
/// sqlite.org's answer (`officialAnswerWhereAppleDiffers`) instead of Apple's; with sqlite.org's shell every
/// answer is the shell's.
fn sqliteIsApples() -> bool {
    var arguments = Vector<StringView>.create();
    arguments.push(":memory:")!;
    arguments.push("SELECT sqlite_source_id()")!;
    return match (captureSqlite(borrow arguments, "".bytes())) {
        Ok(output) => withoutCarriageReturns(output.stdout.view()).view().endsWith("aapl\n".bytes()),
        Err(_) => false,
    };
}

/// Whether the tests run on Windows.
fn onWindowsHost() -> bool {
    if (cfg("target.windows")) {
        return true;
    }
    return false;
}

/// `program` run with `arguments` and `input` as its standard input: its exit status and what it wrote.
fn captureProgram(program: StringView, arguments: borrow Vector<StringView>, input: Slice<u8>) -> Result<ProcessOutput, IoError> {
    return Process.capture(program, arguments, input);
}

/// `program` run with `arguments`: its exit status. What it writes is the test's output.
fn runProgram(program: StringView, arguments: borrow Vector<StringView>) -> Result<i32, IoError> {
    return Process.run(program, arguments);
}

/// The sqlite3 shell run with `arguments` and `input`. On Windows the shell ends its lines with "\r\n", except in
/// csv mode, where it writes "\r\n" itself in binary: `.crlf off`, in a `.sqliterc` it reads before the arguments,
/// has it write what it writes elsewhere, without changing the arguments' numbers in its messages as `-cmd` would.
/// It says so ("crlf is OFF") on standard error, which is dropped.
fn captureSqlite(arguments: borrow Vector<StringView>, input: Slice<u8>) -> Result<ProcessOutput, IoError> {
    if (!onWindowsHost()) {
        return Process.capture("sqlite3", arguments, input);
    }
    let directory = Directory.temporary()?;
    let rc = pathIn(directory.view(), ".sqliterc");
    let result = captureWithHome(directory.view(), rc.view(), arguments, input);
    let _ = File.remove(rc.view());
    let _ = Directory.remove(directory.view());
    var output = result?;
    let said = "crlf is OFF".bytes();
    var errors = withoutCarriageReturns(output.stderr.view());
    if (errors.view().startsWith(said)) {
        var at = said.length;
        if (at < errors.length && errors[at] == '\n') {
            at += 1;
        }
        var rest = Vector<u8>.create();
        rest.extend(errors.view()[at..])!;
        errors = rest;
    }
    output.stderr = errors;
    return Ok(output);
}

/// The sqlite3 shell run with `arguments`: its exit status.
fn runSqlite(arguments: borrow Vector<StringView>) -> Result<i32, IoError> {
    if (!onWindowsHost()) {
        return Process.run("sqlite3", arguments);
    }
    return Ok(captureSqlite(arguments, "".bytes())?.status);
}

/// `bytes` without the "\r" of each "\r\n".
fn withoutCarriageReturns(bytes: Slice<u8>) -> Vector<u8> {
    var out = Vector<u8>.create();
    for (i in 0..bytes.length) {
        if (bytes[i] == '\r' && i + 1 < bytes.length && bytes[i + 1] == '\n') {
            continue;
        }
        out.push(bytes[i])!;
    }
    return out;
}

/// `directory/name`.
fn pathIn(directory: StringView, name: StringView) -> String {
    var path = String.from(directory)!;
    path.append("/")!;
    path.append(name)!;
    return path;
}

/// The sqlite3 shell run with HOME and USERPROFILE set to `home`, where `rc` is written with `.crlf off` first.
fn captureWithHome(home: StringView, rc: StringView, arguments: borrow Vector<StringView>, input: Slice<u8>) -> Result<ProcessOutput, IoError> {
    {
        var file = File.create(rc)?;
        file.write(".crlf off\n".bytes())?;
    }
    var options = ChildOptions.inherit();
    options.setEnvironment("HOME", home)!;
    options.setEnvironment("USERPROFILE", home)!;
    return Process.captureWith("sqlite3", arguments, input, borrow options);
}
