// Writing through SQL: the same statements run in this engine on one file and in the sqlite3 shell on another;
// every statement's answer must agree, and the shell must find this engine's file sound.

/// Runs each statement (one a line) in both engines, each on its own file, comparing answers.
fn sameScript(name: StringView, script: StringView) -> Result<void, TestFailure> {
    var ourPath = String.from("out/script-ours-")!;
    ourPath.append(name)!;
    ourPath.append(".db")!;
    var theirPath = String.from("out/script-theirs-")!;
    theirPath.append(name)!;
    theirPath.append(".db")!;
    freshPath(ourPath.view());
    freshPath(theirPath.view());
    var session = Session.open(ourPath.view())!;
    var lines = script.split("\n");
    var step: u64 = 0;
    while (lines.next() is Some(line)) {
        let sql = line.trim();
        if (sql.length == 0 || sql.startsWith("--")) {
            continue;
        }
        step += 1;
        let theirs = theirAnswer(theirPath.view(), sql);
        let mine = ours(mut session, sql);
        if (theirs.view() != mine.view()) {
            var message = String.from("step ")!;
            message.appendNumber(step)!;
            message.append(": ")!;
            message.append(sql)!;
            message.append("\n  sqlite3:\n")!;
            message.append(theirs.view())!;
            message.append("  this engine:\n")!;
            message.append(mine.view())!;
            return Check.fail(message.view());
        }
        if (Environment.variable("SQLITE_STEP_CHECK").isSome()) {
            let verdict = match (askSqlite(ourPath.view(), "PRAGMA integrity_check")) {
                Ok(v) => v,
                Err(_) => String.from("sqlite3 cannot read the file")!,
            };
            if (verdict.view() != "ok\n") {
                var message = String.from("damaged after step ")!;
                message.appendNumber(step)!;
                message.append(": ")!;
                message.append(sql)!;
                message.append("\n")!;
                message.append(verdict.view())!;
                return Check.fail(message.view());
            }
        }
    }
    return expectIntact(ourPath.view());
}

@test
fn insertsUpdatesAndDeletes() -> Result<void, TestFailure> {
    return sameScript("dml", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT NOT NULL, score REAL, tag TEXT UNIQUE COLLATE NOCASE, n INT CHECK (n >= 0), d DEFAULT 'none')
        INSERT INTO t(name, score, tag, n) VALUES ('a', 1, 'x', 1), ('b', '2.5', 'y', 2), ('c', NULL, NULL, 3)
        INSERT INTO t VALUES (10, 'ten', 10, 'z', 10, 'given')
        INSERT INTO t(name) VALUES ('next')
        SELECT * FROM t ORDER BY id
        SELECT typeof(score), score FROM t ORDER BY id
        INSERT INTO t(name, tag) VALUES ('dup', 'X')
        INSERT INTO t(name, n) VALUES ('neg', -1)
        INSERT INTO t(tag) VALUES ('w')
        INSERT INTO t(id, name) VALUES (1, 'clash')
        INSERT INTO t(id, name) VALUES ('abc', 'bad id')
        INSERT OR IGNORE INTO t(name, tag) VALUES ('ignored', 'x')
        INSERT OR REPLACE INTO t(name, tag) VALUES ('replaced', 'Y')
        SELECT id, name, tag FROM t ORDER BY id
        UPDATE t SET score = score * 2 WHERE score IS NOT NULL
        UPDATE t SET tag = 'x' WHERE id = 3
        UPDATE t SET id = id + 100 WHERE id = 10
        UPDATE t SET n = -5
        SELECT id, name, score, tag, n FROM t ORDER BY id
        DELETE FROM t WHERE id > 100
        DELETE FROM t WHERE name = 'a'
        SELECT id, name FROM t ORDER BY id
        SELECT count(*) FROM t WHERE tag = 'Y'
        INSERT INTO t(name, tag) VALUES ('returning', 'r') RETURNING id, upper(name)
        DELETE FROM t RETURNING name
        SELECT count(*) FROM t
        """);
}

@test
fn manyRowsAndIndexes() -> Result<void, TestFailure> {
    return sameScript("bulk", """
        CREATE TABLE big(id INTEGER PRIMARY KEY, k INT, s TEXT)
        CREATE INDEX big_k ON big(k)
        WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 3000) INSERT INTO big(k, s) SELECT i % 97, 'row ' || i FROM c
        SELECT count(*), sum(k), max(id) FROM big
        CREATE UNIQUE INDEX big_s ON big(s)
        CREATE INDEX big_ks ON big(k DESC, s) WHERE k > 50
        UPDATE big SET k = k + 1000 WHERE id % 3 = 0
        DELETE FROM big WHERE id % 5 = 0
        SELECT count(*), sum(k) FROM big
        SELECT id FROM big WHERE k = 1003 ORDER BY id LIMIT 5
        INSERT INTO big(s) VALUES ('row 7')
        CREATE UNIQUE INDEX big_k_unique ON big(k)
        DROP INDEX big_ks
        SELECT name FROM sqlite_schema ORDER BY name
        """);
}

@test
fn schemaChanges() -> Result<void, TestFailure> {
    return sameScript("ddl", """
        CREATE TABLE a(x, y)
        CREATE TABLE a(z)
        CREATE TABLE IF NOT EXISTS a(z)
        CREATE TABLE seq(id INTEGER PRIMARY KEY AUTOINCREMENT, v)
        INSERT INTO seq(v) VALUES (1), (2), (3)
        DELETE FROM seq WHERE id = 3
        INSERT INTO seq(v) VALUES (4)
        SELECT * FROM seq
        SELECT * FROM sqlite_sequence
        CREATE VIEW va AS SELECT x + 1 AS x1 FROM a
        INSERT INTO a VALUES (1, 2), (3, 4)
        SELECT * FROM va ORDER BY 1
        DROP TABLE va
        DROP VIEW va
        DROP VIEW va
        DROP VIEW IF EXISTS va
        CREATE INDEX a_x ON a(x)
        CREATE INDEX a_x ON a(y)
        DROP TABLE a
        SELECT type, name, tbl_name, sql FROM sqlite_schema ORDER BY name
        DROP TABLE seq
        SELECT count(*) FROM sqlite_schema
        CREATE TABLE sqlite_mine(x)
        DROP TABLE nosuch
        """);
}

/// Runs a script (one statement a line) through one sqlite3 process on standard input, and through one session;
/// compares what both print, errors included, line by line.
fn sameSession(name: StringView, script: StringView) -> Result<void, TestFailure> {
    return sameSessionWith(name, script, "", "");
}

/// `sameSession`, with each `AUXFILE` in the script a file of each engine's own (`theirAux`, `ourAux`), so that
/// the two runs do not share an attached database.
fn sameSessionWith(name: StringView, scriptText: StringView, theirAux: StringView, ourAux: StringView) -> Result<void, TestFailure> {
    let script = scriptText;
    var ourPath = String.from("out/session-ours-")!;
    ourPath.append(name)!;
    ourPath.append(".db")!;
    var theirPath = String.from("out/session-theirs-")!;
    theirPath.append(name)!;
    theirPath.append(".db")!;
    freshPath(ourPath.view());
    freshPath(theirPath.view());
    // The shell's input: each line a statement; its errors go to stderr as "… near line N: message".
    var input = String.create();
    var lines = script.split("\n");
    var statements = Vector<StringView>.create();
    while (lines.next() is Some(line)) {
        let sql = line.trim();
        if (sql.length == 0) {
            continue;
        }
        statements.push(sql)!;
        input.append(replaceAll(sql, "AUXFILE", theirAux).view())!;
        input.append(";\n")!;
    }
    var arguments = Vector<StringView>.create();
    arguments.push(theirPath.view())!;
    let output = Process.capture("sqlite3", borrow arguments, input.view().bytes())!;
    var theirs = shownText(output.stdout.view());
    // Errors, in order, as "error: message".
    let errors = shownText(output.stderr.view());
    var errorLines = errors.view().split("\n");
    var theirErrors = String.create();
    while (errorLines.next() is Some(e)) {
        if (e.splitOnce(": ") is Some(halves)) {
            theirErrors.append("error: ")!;
            theirErrors.append(halves.right)!;
            theirErrors.append("\n")!;
        }
    }
    var session = Session.open(ourPath.view())!;
    var mine = String.create();
    var myErrors = String.create();
    for (i in 0..statements.length) {
        let statement = replaceAll(statements[i], "AUXFILE", ourAux);
        let answer = ours(mut session, statement.view());
        if (answer.view().startsWith("error: ")) {
            myErrors.append(answer.view())!;
        } else {
            mine.append(answer.view())!;
        }
    }
    Check.equalText(theirs.view(), mine.view())?;
    Check.equalText(theirErrors.view(), myErrors.view())?;
    return expectIntact(ourPath.view());
}

@test
fn transactionsUndoWhatTheyShould() -> Result<void, TestFailure> {
    return sameSession("tx", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, v UNIQUE)
        BEGIN
        INSERT INTO t(v) VALUES (1), (2)
        INSERT INTO t(v) VALUES (3), (1), (4)
        SELECT v FROM t ORDER BY v
        COMMIT
        SELECT v FROM t ORDER BY v
        BEGIN
        DELETE FROM t
        CREATE TABLE u(x)
        INSERT INTO u VALUES (1)
        ROLLBACK
        SELECT v FROM t ORDER BY v
        SELECT count(*) FROM sqlite_schema WHERE name = 'u'
        COMMIT
        BEGIN
        BEGIN
        INSERT INTO t(v) VALUES (9)
        COMMIT
        SELECT v FROM t ORDER BY v
        """);
}

@test
fn pragmasDescribeTheSchema() -> Result<void, TestFailure> {
    return sameScript("pragma", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT NOT NULL DEFAULT 'x', b INT DEFAULT (1+2) UNIQUE, c REAL DEFAULT -1.5, d AS (a||'!'), e INT REFERENCES u(id) ON DELETE CASCADE, UNIQUE(a,b))
        CREATE TABLE u(id INTEGER PRIMARY KEY)
        CREATE INDEX t_c ON t(c DESC, a COLLATE NOCASE)
        CREATE INDEX t_p ON t(b) WHERE b > 0
        CREATE INDEX t_x ON t(lower(a))
        PRAGMA table_info(t)
        PRAGMA table_xinfo(t)
        PRAGMA index_list(t)
        PRAGMA index_info(t_c)
        PRAGMA index_xinfo(t_c)
        PRAGMA index_info(t_x)
        PRAGMA foreign_key_list(t)
        PRAGMA table_info(nosuch)
        PRAGMA encoding
        PRAGMA journal_mode
        PRAGMA user_version
        PRAGMA user_version = 42
        PRAGMA user_version
        PRAGMA application_id = -7
        PRAGMA application_id
        PRAGMA foreign_keys
        PRAGMA page_size
        PRAGMA freelist_count
        SELECT name, type FROM pragma_table_info('t') ORDER BY cid
        SELECT count(*) FROM pragma_index_list('t') WHERE "unique"
        PRAGMA no_such_pragma
        """);
}

@test
fn alterTableRewritesDefinitions() -> Result<void, TestFailure> {
    // The macOS sqlite3 shell runs with legacy_alter_table on.
    return sameScript("alter", """
        PRAGMA legacy_alter_table = ON
        CREATE TABLE t(a INT, b TEXT CHECK (b <> a), UNIQUE (a, b))
        CREATE INDEX t_b ON t(b) WHERE a > 0
        CREATE TABLE child(id INTEGER PRIMARY KEY, ref INT REFERENCES t(a))
        INSERT INTO t VALUES (1, 'x'), (2, 'y')
        ALTER TABLE t RENAME COLUMN a TO x
        ALTER TABLE t RENAME COLUMN nope TO z
        ALTER TABLE t RENAME COLUMN b TO x
        ALTER TABLE t RENAME TO u
        ALTER TABLE u ADD COLUMN c REAL DEFAULT 1.5
        ALTER TABLE u ADD d TEXT
        ALTER TABLE u ADD COLUMN e NOT NULL
        ALTER TABLE u ADD COLUMN p INTEGER PRIMARY KEY
        ALTER TABLE u ADD COLUMN q UNIQUE
        ALTER TABLE u ADD COLUMN r DEFAULT CURRENT_TIME
        ALTER TABLE u ADD COLUMN s INT NOT NULL DEFAULT 7
        SELECT type, name, tbl_name, sql FROM sqlite_schema ORDER BY name
        SELECT * FROM u ORDER BY x
        INSERT INTO u(x, b) VALUES (3, 'z')
        SELECT * FROM u ORDER BY x
        ALTER TABLE nosuch RENAME TO v
        ALTER TABLE u RENAME TO child
        """);
}

@test
fn renamedColumnsAreQuotedAsSqliteQuotesThem() -> Result<void, TestFailure> {
    // renameEditSql: the new name in double quotes everywhere when RENAME COLUMN quoted it, else in double quotes
    // only where the old name was quoted. The C# port wrote it bare wherever it could stand bare.
    return sameScript("alter-quotes", """
        PRAGMA legacy_alter_table = ON
        CREATE TABLE t(a INT, "b" TEXT, c, CHECK (a > 0 AND "b" <> ''))
        CREATE INDEX t_ab ON t(a, b)
        CREATE TABLE child(x REFERENCES t(a), y REFERENCES t("b"))
        ALTER TABLE t RENAME COLUMN a TO "z"
        ALTER TABLE t RENAME COLUMN b TO y
        ALTER TABLE t RENAME COLUMN c TO [w]
        SELECT name, sql FROM sqlite_schema ORDER BY name
        """);
}

@test
fn upsertsFollowSqlite() -> Result<void, TestFailure> {
    return sameScript("upsert", """
        CREATE TABLE kv(k TEXT PRIMARY KEY, v INT, hits INT DEFAULT 0)
        CREATE TABLE n(id INTEGER PRIMARY KEY, name TEXT UNIQUE, c INT)
        INSERT INTO kv(k, v) VALUES ('a', 1), ('b', 2)
        INSERT INTO kv(k, v) VALUES ('a', 10) ON CONFLICT(k) DO UPDATE SET v = excluded.v, hits = hits + 1
        INSERT INTO kv(k, v) VALUES ('b', 20) ON CONFLICT DO NOTHING
        INSERT INTO kv(k, v) VALUES ('c', 3) ON CONFLICT(k) DO UPDATE SET v = 0
        INSERT INTO kv(k, v) VALUES ('a', 5) ON CONFLICT(k) DO UPDATE SET v = excluded.v WHERE excluded.v > v
        INSERT INTO kv(k, v) VALUES ('a', 50) ON CONFLICT(k) DO UPDATE SET v = excluded.v WHERE excluded.v > v RETURNING k, v, hits
        SELECT * FROM kv ORDER BY k
        INSERT INTO kv(k, v) VALUES ('a', 1) ON CONFLICT(v) DO NOTHING
        INSERT INTO n VALUES (1, 'x', 0)
        INSERT INTO n VALUES (1, 'y', 0) ON CONFLICT(id) DO UPDATE SET c = c + 1
        INSERT INTO n VALUES (2, 'x', 0) ON CONFLICT(name) DO UPDATE SET c = c + 10
        INSERT INTO n VALUES (3, 'x', 0) ON CONFLICT(id) DO NOTHING
        INSERT INTO n VALUES (3, 'x', 0) ON CONFLICT(id) DO NOTHING ON CONFLICT(name) DO UPDATE SET c = -1
        SELECT * FROM n ORDER BY id
        """);
}

@test
fn triggersFireAsInSqlite() -> Result<void, TestFailure> {
    return sameSession("triggers", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, v INT, note TEXT)
        CREATE TABLE log(seq INTEGER PRIMARY KEY, what TEXT, old_v INT, new_v INT)
        CREATE TRIGGER t_ins AFTER INSERT ON t BEGIN INSERT INTO log(what, new_v) VALUES ('ins', new.v); END
        CREATE TRIGGER t_upd AFTER UPDATE OF v ON t WHEN new.v <> old.v BEGIN INSERT INTO log(what, old_v, new_v) VALUES ('upd', old.v, new.v); END
        CREATE TRIGGER t_del BEFORE DELETE ON t BEGIN INSERT INTO log(what, old_v) VALUES ('del', old.v); END
        CREATE TRIGGER t_guard BEFORE INSERT ON t WHEN new.v < 0 BEGIN SELECT RAISE(ABORT, 'negative'); END
        CREATE TRIGGER t_skip BEFORE INSERT ON t WHEN new.v = 0 BEGIN SELECT RAISE(IGNORE); END
        INSERT INTO t(v, note) VALUES (1, 'a'), (2, 'b'), (0, 'skipped'), (3, 'c')
        INSERT INTO t(v) VALUES (-1)
        UPDATE t SET v = v * 10 WHERE id <= 2
        UPDATE t SET note = 'n'
        UPDATE t SET v = v WHERE id = 3
        DELETE FROM t WHERE v > 20
        SELECT * FROM t ORDER BY id
        SELECT what, old_v, new_v FROM log ORDER BY seq
        SELECT changes()
        CREATE TRIGGER t_ins AFTER INSERT ON t BEGIN SELECT 1; END
        CREATE TRIGGER nope AFTER INSERT ON nosuch BEGIN SELECT 1; END
        DROP TRIGGER t_guard
        INSERT INTO t(v) VALUES (-5)
        SELECT count(*) FROM t
        DROP TABLE t
        SELECT count(*) FROM sqlite_schema WHERE type = 'trigger'
        """);
}

@test
fn foreignKeysFollowSqlite() -> Result<void, TestFailure> {
    return sameSession("fk", """
        PRAGMA foreign_keys = ON
        CREATE TABLE p(id INTEGER PRIMARY KEY, code TEXT UNIQUE)
        CREATE TABLE c(id INTEGER PRIMARY KEY, pid INT REFERENCES p(id) ON DELETE CASCADE ON UPDATE CASCADE, note TEXT)
        CREATE TABLE s(id INTEGER PRIMARY KEY, pcode TEXT REFERENCES p(code) ON DELETE SET NULL)
        CREATE TABLE r(id INTEGER PRIMARY KEY, pid INT DEFAULT 1 REFERENCES p ON DELETE SET DEFAULT)
        CREATE TABLE x(id INTEGER PRIMARY KEY, pid INT REFERENCES p(id))
        INSERT INTO p VALUES (1, 'a'), (2, 'b'), (3, 'c')
        INSERT INTO c VALUES (10, 1, 'one'), (11, 2, 'two'), (12, NULL, 'none')
        INSERT INTO c VALUES (13, 9, 'bad')
        INSERT INTO s VALUES (20, 'b'), (21, 'c')
        INSERT INTO r VALUES (30, 3)
        INSERT INTO x VALUES (40, 2)
        DELETE FROM p WHERE id = 2
        UPDATE p SET id = 5 WHERE id = 1
        SELECT * FROM c ORDER BY id
        DELETE FROM p WHERE id = 3
        SELECT * FROM s ORDER BY id
        SELECT * FROM r ORDER BY id
        UPDATE x SET pid = 7
        DELETE FROM x
        DELETE FROM p WHERE id = 2
        SELECT * FROM p ORDER BY id
        PRAGMA foreign_keys = OFF
        INSERT INTO c VALUES (14, 99, 'unchecked')
        SELECT count(*) FROM c
        """);
}

@test
fn updateFromJoinsLikeSqlite() -> Result<void, TestFailure> {
    return sameScript("update-from", """
        CREATE TABLE inv(id INTEGER PRIMARY KEY, item TEXT, qty INT)
        CREATE TABLE sales(item TEXT, n INT)
        CREATE TABLE price(item TEXT PRIMARY KEY, p REAL)
        INSERT INTO inv(item, qty) VALUES ('a', 10), ('b', 20), ('c', 30)
        INSERT INTO sales VALUES ('a', 3), ('b', 5)
        INSERT INTO price VALUES ('a', 1.5), ('c', 2.0)
        UPDATE inv SET qty = qty - sales.n FROM sales WHERE sales.item = inv.item
        SELECT * FROM inv ORDER BY id
        UPDATE inv SET qty = t.total FROM (SELECT item, sum(n) * 100 AS total FROM sales GROUP BY item) AS t WHERE t.item = inv.item AND t.total > 400 RETURNING id, qty
        UPDATE inv SET qty = qty + 1 FROM sales JOIN price USING (item) WHERE inv.item = sales.item
        SELECT * FROM inv ORDER BY id
        UPDATE inv SET qty = 0 FROM sales WHERE nosuch.item = inv.item
        UPDATE inv SET nope = 0 FROM sales
        WITH s AS (SELECT 'c' AS item) UPDATE inv SET qty = -1 FROM s WHERE s.item = inv.item
        SELECT * FROM inv ORDER BY id
        """);
}

@test
fn withoutRowidTablesChangeLikeSqlite() -> Result<void, TestFailure> {
    return sameScript("without-rowid", """
        CREATE TABLE kv(v TEXT, k TEXT PRIMARY KEY COLLATE NOCASE, n INT UNIQUE) WITHOUT ROWID
        CREATE TABLE pair(a INT, b TEXT, note, PRIMARY KEY (b DESC, a)) WITHOUT ROWID
        CREATE INDEX kv_v ON kv(v)
        CREATE INDEX pair_note ON pair(note, a)
        INSERT INTO kv VALUES ('one', 'x', 1), ('two', 'a', 2), ('three', 'm', 3)
        INSERT INTO kv VALUES ('dup', 'X', 9)
        INSERT INTO kv VALUES ('nokey', NULL, 10)
        INSERT INTO kv VALUES ('dupn', 'q', 1)
        INSERT OR REPLACE INTO kv VALUES ('again', 'X', 4)
        INSERT OR IGNORE INTO kv VALUES ('ignored', 'a', 5)
        INSERT INTO kv VALUES ('up', 'm', 0) ON CONFLICT(k) DO UPDATE SET v = v || '!', n = excluded.n + 30
        UPDATE kv SET k = 'b' WHERE k = 'a'
        UPDATE kv SET n = n * 10
        SELECT * FROM kv
        SELECT k FROM kv ORDER BY v
        UPDATE kv SET k = 'm' WHERE k = 'b'
        DELETE FROM kv WHERE n > 35
        SELECT * FROM kv
        INSERT INTO pair VALUES (1, 'x', 'p'), (2, 'x', 'q'), (1, 'y', 'p'), (3, 'a', NULL)
        UPDATE pair SET a = a + 10 WHERE b = 'x'
        DELETE FROM pair WHERE note IS NULL
        SELECT * FROM pair
        SELECT last_insert_rowid()
        CREATE TABLE big(id INTEGER PRIMARY KEY, body TEXT, tag INT) WITHOUT ROWID
        CREATE INDEX big_tag ON big(tag)
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 600) INSERT INTO big SELECT i * 7 % 601, printf('%.*c', i % 50 + 1, 'x'), i % 13 FROM n
        DELETE FROM big WHERE tag IN (2, 5, 7)
        UPDATE big SET id = id + 1000 WHERE id % 3 = 0
        UPDATE big SET body = body || body WHERE tag = 4
        SELECT count(*), sum(id), sum(length(body)), sum(tag) FROM big
        DELETE FROM big WHERE id % 2 = 0
        SELECT count(*), sum(id), sum(length(body)) FROM big
        DELETE FROM big
        SELECT count(*) FROM big
        """);
}

@test
fn windowFunctionsFeedWrites() -> Result<void, TestFailure> {
    return sameScript("window-writes", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, g TEXT, v INT)
        INSERT INTO t(g, v) VALUES ('a', 5), ('a', 3), ('b', 9), ('b', 1), ('b', 4)
        CREATE TABLE r(id INT, pos INT)
        INSERT INTO r SELECT id, row_number() OVER (PARTITION BY g ORDER BY v) FROM t
        UPDATE t SET v = (SELECT pos FROM r WHERE r.id = t.id) * 100
        DELETE FROM t WHERE id IN (SELECT id FROM (SELECT id, rank() OVER (ORDER BY v DESC) AS rk FROM t) WHERE rk <= 2)
        SELECT * FROM t ORDER BY id
        SELECT * FROM r ORDER BY id
        """);
}

@test
fn writesThroughIndexSeeks() -> Result<void, TestFailure> {
    return sameScript("index-seek-writes", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, k INT, s TEXT COLLATE NOCASE, v)
        CREATE INDEX t_k ON t(k)
        CREATE UNIQUE INDEX t_s ON t(s)
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 3000) INSERT INTO t SELECT i, i % 50, 'name' || i, i FROM n
        UPDATE t SET k = k + 1 WHERE k BETWEEN 10 AND 12
        SELECT k, count(*) FROM t WHERE k BETWEEN 9 AND 14 GROUP BY k ORDER BY k
        UPDATE t SET k = 1000 + id WHERE k = 13
        SELECT count(*), min(k), max(k) FROM t WHERE k > 999
        DELETE FROM t WHERE k < 5
        SELECT count(*) FROM t
        UPDATE t SET v = 'found' WHERE s = 'NAME77'
        SELECT id, v FROM t WHERE s = 'name77'
        DELETE FROM t WHERE s >= 'name2' AND s < 'name3'
        SELECT count(*) FROM t
        UPDATE t SET s = 'name5' WHERE s = 'name6'
        UPDATE t SET v = -1 WHERE k IN (20, 21, 20, NULL)
        DELETE FROM t WHERE s IN ('NAME100', 'name101', 'nope')
        SELECT count(*), sum(v) FROM t
        SELECT count(*), sum(k) FROM t
        """);
}

@test
fn createTableAsSelectLikeSqlite() -> Result<void, TestFailure> {
    return sameScript("create-as", """
        CREATE TABLE src(a INTEGER, b TEXT, c REAL, d BLOB, e NUMERIC, f, g VARCHAR(5))
        INSERT INTO src VALUES (1, 'x', 2.5, x'41', 3, 'f', 'g'), (2, '7', 3, NULL, '4.0', 5, 6)
        CREATE TABLE t AS SELECT a, b, c, d, e, f, g, a + 1, b || 'y' AS "odd name", 1 AS select_, a AS a FROM src
        CREATE TABLE "q t" AS SELECT 1 AS x
        CREATE TABLE IF NOT EXISTS t AS SELECT 1
        CREATE TABLE t AS SELECT 1
        CREATE TABLE u AS SELECT * FROM src WHERE 0
        CREATE TABLE w AS VALUES (1, 'a'), (2, 'b')
        CREATE TABLE k AS SELECT 1 AS "select", 2 AS "a""b", 3 AS "9x", 4 AS a, 5 AS A, 6 AS "a:1"
        CREATE TABLE s AS SELECT b, typeof(b) AS tb, e + 0 AS en FROM src ORDER BY a DESC
        SELECT type, name, sql FROM sqlite_schema ORDER BY name
        SELECT * FROM t
        SELECT typeof(a), typeof("a+1"), typeof(e) FROM t
        SELECT * FROM "q t"
        SELECT * FROM w
        SELECT * FROM k
        SELECT rowid, * FROM s
        """);
}

@test
fn dropColumnLikeSqlite() -> Result<void, TestFailure> {
    return sameScript("drop-column", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, b TEXT UNIQUE, c REAL CHECK (c > 0), d DEFAULT 4, e AS (a * 2), f, g, h AS (g || 'x') STORED, CHECK (f <> 1))
        CREATE INDEX t_g ON t(g)
        CREATE INDEX t_part ON t(f) WHERE d > 0
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 500) INSERT INTO t(id, a, b, c, f, g) SELECT i, i, 'b' || i, i + 0.5, i + 1, i * 3 FROM n
        ALTER TABLE t DROP COLUMN id
        ALTER TABLE t DROP COLUMN b
        ALTER TABLE t DROP COLUMN a
        ALTER TABLE t DROP COLUMN f
        ALTER TABLE t DROP COLUMN g
        ALTER TABLE t DROP COLUMN nope
        ALTER TABLE t DROP COLUMN d
        ALTER TABLE t DROP COLUMN c
        ALTER TABLE t DROP COLUMN h
        ALTER TABLE t DROP e
        SELECT name, sql FROM sqlite_schema ORDER BY name
        SELECT * FROM t WHERE rowid IN (1, 250, 500)
        SELECT count(*), sum(a), sum(g) FROM t
        CREATE TABLE one(x)
        ALTER TABLE one DROP COLUMN x
        CREATE TABLE p(x PRIMARY KEY, y, z) WITHOUT ROWID
        INSERT INTO p VALUES (1, 2, 3), (4, 5, 6)
        ALTER TABLE p DROP COLUMN y
        SELECT sql FROM sqlite_schema WHERE name = 'p'
        SELECT * FROM p
        ALTER TABLE p ADD COLUMN w DEFAULT 'w'
        ALTER TABLE p DROP COLUMN z
        SELECT * FROM p
        """);
}

