@test
fn insteadOfTriggersOnViews() -> Result<void, TestFailure> {
    return sameSession("instead-of", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, a, b)
        INSERT INTO t VALUES (1, 'x', 1), (2, 'y', 2)
        CREATE VIEW v AS SELECT id, a, b * 10 AS b10 FROM t
        CREATE TABLE log(m)
        INSERT INTO v VALUES (3, 'z', 30)
        CREATE TRIGGER before_v BEFORE INSERT ON v BEGIN SELECT 1; END
        CREATE TRIGGER on_t INSTEAD OF INSERT ON t BEGIN SELECT 1; END
        CREATE TRIGGER vi INSTEAD OF INSERT ON v BEGIN INSERT INTO t VALUES (new.id, new.a, new.b10 / 10); INSERT INTO log VALUES ('ins ' || new.id); END
        CREATE TRIGGER vd INSTEAD OF DELETE ON v BEGIN DELETE FROM t WHERE id = old.id; END
        CREATE TRIGGER vu INSTEAD OF UPDATE OF a ON v WHEN new.a <> 'skip' BEGIN UPDATE t SET a = new.a WHERE id = old.id; INSERT INTO log VALUES ('upd ' || old.a || '>' || new.a); END
        INSERT INTO v VALUES (3, 'z', 30), (4, 'w', 40)
        SELECT changes(), total_changes(), last_insert_rowid()
        INSERT INTO v(id) VALUES (5)
        INSERT INTO v(id, nope) VALUES (6, 1)
        INSERT INTO v VALUES (6)
        UPDATE v SET a = upper(a) WHERE id < 3
        SELECT changes(), total_changes()
        UPDATE v SET b10 = 0
        UPDATE v SET a = 'skip' WHERE id = 1
        DELETE FROM v WHERE id = 4
        SELECT changes(), total_changes()
        INSERT INTO v VALUES (9, 'q', 1) RETURNING *, b10 + 1
        UPDATE v SET a = t.id * 100 FROM t WHERE t.id = v.id AND t.id > 2 RETURNING id, a
        DELETE FROM v WHERE id = 9 RETURNING a
        SELECT * FROM t ORDER BY id
        SELECT * FROM log
        DROP VIEW v
        SELECT name FROM sqlite_schema ORDER BY name
        """);
}

@test
fn renamesReachViewsAndTriggers() -> Result<void, TestFailure> {
    return sameSession("rename-views", """
        PRAGMA legacy_alter_table = OFF
        CREATE TABLE t(a, b)
        CREATE TABLE o(oa, c, ref REFERENCES t(a))
        CREATE VIEW v1 AS SELECT a, t.b, x.oa AS xa FROM t, o AS x WHERE t.a = x.oa
        CREATE VIEW v2 AS SELECT * FROM t WHERE a > (SELECT count(*) FROM t AS inner_t WHERE inner_t.a = t.a)
        CREATE VIEW v3 AS SELECT a AS a, "t".b FROM main.t JOIN o ON o.oa = t.a
        CREATE VIEW v4(first, second) AS SELECT a, upper(b) FROM t
        CREATE TRIGGER tr AFTER INSERT ON t BEGIN INSERT INTO o(oa, c) VALUES (new.a, new.b); UPDATE t SET b = a WHERE a = new.a; DELETE FROM t WHERE t.a IS NULL; END
        CREATE TRIGGER tr2 AFTER UPDATE OF a, b ON t WHEN old.a <> new.a BEGIN SELECT a FROM t; END
        CREATE TRIGGER tr3 AFTER INSERT ON o BEGIN UPDATE t SET a = new.oa WHERE a = new.c; END
        INSERT INTO t VALUES (1, 'x'), (2, 'y')
        ALTER TABLE t RENAME COLUMN a TO aa
        SELECT name, sql FROM sqlite_schema WHERE type <> 'index' ORDER BY name
        ALTER TABLE t RENAME TO u
        SELECT name, tbl_name, sql FROM sqlite_schema WHERE type <> 'index' ORDER BY name
        SELECT * FROM v1 ORDER BY 1
        SELECT * FROM v3 ORDER BY 1
        SELECT * FROM v4 ORDER BY 1
        INSERT INTO u VALUES (3, 'z')
        SELECT * FROM u ORDER BY 1
        SELECT * FROM o ORDER BY 1
        ALTER TABLE o RENAME COLUMN oa TO z
        SELECT name, sql FROM sqlite_schema WHERE type IN ('view', 'trigger') ORDER BY name
        PRAGMA legacy_alter_table = ON
        PRAGMA legacy_alter_table
        ALTER TABLE u RENAME TO w
        SELECT name, tbl_name, sql FROM sqlite_schema ORDER BY name
        """);
}

@test
fn targetAliasesAndReturningNames() -> Result<void, TestFailure> {
    return sameScript("target-alias", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, a, b UNIQUE)
        INSERT INTO t VALUES (1, 'x', 10), (2, 'y', 20)
        UPDATE t AS q SET a = q.a || '!' WHERE q.id = 1 RETURNING a, id  +  1, a AS z, t.b
        UPDATE t AS q SET a = t.a
        UPDATE t AS q SET a = 1 RETURNING q.a
        DELETE FROM t AS d WHERE d.b = 20 RETURNING *, b*2
        INSERT INTO t AS n VALUES (3, 'z', 10) ON CONFLICT(b) DO UPDATE SET a = n.a || excluded.a RETURNING *, rowid
        CREATE TABLE s(k, v)
        INSERT INTO s VALUES (1, 'q'), (2, 'r')
        UPDATE t AS q SET a = s.v FROM s WHERE s.k = q.id RETURNING id, a
        SELECT * FROM t
        """);
}

@test
fn constraintConflictClausesApply() -> Result<void, TestFailure> {
    return sameScript("constraint-conflict", """
        CREATE TABLE r(id INTEGER PRIMARY KEY ON CONFLICT REPLACE, u UNIQUE ON CONFLICT IGNORE, n NOT NULL ON CONFLICT IGNORE, d NOT NULL ON CONFLICT REPLACE DEFAULT 'dflt')
        INSERT INTO r VALUES (1, 'a', 1, 'x'), (2, 'b', 2, 'y')
        INSERT INTO r VALUES (1, 'c', 3, 'z')
        INSERT INTO r VALUES (5, 'a', 4, 'w')
        INSERT INTO r VALUES (6, 'f', NULL, 'v')
        INSERT INTO r VALUES (7, 'g', 7, NULL)
        INSERT OR ABORT INTO r VALUES (8, 'b', 8, 'q')
        INSERT OR FAIL INTO r VALUES (9, 'h', NULL, 'q')
        UPDATE r SET u = 'b' WHERE id = 1
        UPDATE r SET id = 2 WHERE id = 1
        SELECT * FROM r ORDER BY id
        CREATE TABLE k(a, b, c, UNIQUE (a, b) ON CONFLICT REPLACE, UNIQUE (c) ON CONFLICT ABORT)
        INSERT INTO k VALUES (1, 1, 'x'), (1, 2, 'y')
        INSERT INTO k VALUES (1, 1, 'y')
        INSERT INTO k VALUES (1, 1, 'z')
        SELECT * FROM k ORDER BY a, b
        CREATE TABLE w(p PRIMARY KEY ON CONFLICT IGNORE, v) WITHOUT ROWID
        INSERT INTO w VALUES (1, 'one'), (1, 'uno'), (2, 'two')
        SELECT * FROM w
        CREATE TABLE bad(a UNIQUE ON CONFLICT IGNORE, UNIQUE (a) ON CONFLICT REPLACE)
        CREATE TABLE fine(a UNIQUE ON CONFLICT IGNORE, UNIQUE (a))
        """);
}

@test
fn savepointsNestAsInSqlite() -> Result<void, TestFailure> {
    return sameSession("savepoints", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, v)
        CREATE INDEX t_v ON t(v)
        SAVEPOINT a
        INSERT INTO t VALUES (1, 'a')
        SAVEPOINT b
        INSERT INTO t VALUES (2, 'b')
        WITH RECURSIVE n(i) AS (SELECT 10 UNION ALL SELECT i + 1 FROM n WHERE i < 600) INSERT INTO t SELECT i, printf('%.*c', i % 40, 'x') FROM n
        SELECT count(*) FROM t
        ROLLBACK TO b
        SELECT count(*) FROM t
        INSERT INTO t VALUES (3, 'c')
        SAVEPOINT c
        CREATE TABLE inner_t(x)
        INSERT INTO inner_t VALUES (1)
        RELEASE c
        SELECT name FROM sqlite_schema ORDER BY name
        ROLLBACK TO a
        SELECT count(*) FROM t
        SELECT name FROM sqlite_schema ORDER BY name
        INSERT INTO t VALUES (4, 'd')
        RELEASE a
        SELECT * FROM t
        RELEASE nope
        ROLLBACK TO nope
        BEGIN
        INSERT INTO t VALUES (5, 'e')
        SAVEPOINT s1
        INSERT INTO t VALUES (6, 'f')
        SAVEPOINT s1
        INSERT INTO t VALUES (7, 'g')
        ROLLBACK TO s1
        SELECT * FROM t ORDER BY id
        RELEASE s1
        RELEASE s1
        INSERT INTO t VALUES (8, 'h')
        ROLLBACK TO s1
        COMMIT
        SELECT * FROM t ORDER BY id
        SAVEPOINT x
        INSERT INTO t VALUES (9, 'i')
        ROLLBACK
        SELECT count(*) FROM t
        SAVEPOINT y
        INSERT INTO t VALUES (10, 'j')
        COMMIT
        SELECT count(*) FROM t
        PRAGMA integrity_check
        """);
}

@test
fn analyzeAndReindexLikeSqlite() -> Result<void, TestFailure> {
    return sameScript("analyze", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, a, b, c UNIQUE, s TEXT COLLATE NOCASE)
        CREATE INDEX t_ab ON t(a, b)
        CREATE INDEX t_p ON t(b) WHERE b > 5
        CREATE INDEX t_s ON t(s)
        CREATE INDEX t_e ON t(a + b)
        CREATE TABLE e(x)
        CREATE TABLE ei(x)
        CREATE INDEX ei_x ON ei(x)
        CREATE TABLE n(x)
        INSERT INTO n VALUES (1), (2)
        CREATE TABLE w(k PRIMARY KEY, v) WITHOUT ROWID
        INSERT INTO w VALUES (1, 1), (2, 1), (3, 2)
        WITH RECURSIVE q(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM q WHERE i < 100) INSERT INTO t SELECT i, i % 7, i % 3, i, char(65 + i % 5 + (i % 2) * 32) FROM q
        ANALYZE
        SELECT * FROM sqlite_stat1 ORDER BY tbl, idx
        SELECT type, name, sql FROM sqlite_schema WHERE name LIKE 'sqlite_stat%'
        INSERT INTO n VALUES (3)
        ANALYZE n
        ANALYZE t_ab
        SELECT * FROM sqlite_stat1 ORDER BY tbl, idx
        ANALYZE nosuch
        REINDEX
        SELECT count(*) FROM t WHERE a = 3
        """);
}

@test
fn vacuumPacksTheFile() -> Result<void, TestFailure> {
    return sameScript("vacuum", """
        PRAGMA user_version = 7
        CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT, a, b TEXT)
        CREATE INDEX t_a ON t(a)
        CREATE TABLE w(k TEXT PRIMARY KEY COLLATE NOCASE, v) WITHOUT ROWID
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 2000) INSERT INTO t(a, b) SELECT i % 97, printf('%.*c', i % 3000, 'x') FROM n
        INSERT INTO w SELECT 'key' || id, a FROM t WHERE id % 3 = 0
        CREATE VIEW v AS SELECT a, count(*) AS n FROM t GROUP BY a
        CREATE TRIGGER tr AFTER DELETE ON t BEGIN DELETE FROM w WHERE v = old.a; END
        DELETE FROM t WHERE id % 4 <> 0
        SELECT count(*), sum(length(b)) FROM t
        VACUUM
        PRAGMA freelist_count
        PRAGMA user_version
        SELECT count(*), sum(length(b)), sum(a) FROM t
        SELECT count(*), sum(v) FROM w
        SELECT * FROM w WHERE k = 'KEY12'
        SELECT * FROM v ORDER BY a LIMIT 3
        SELECT * FROM sqlite_sequence
        SELECT type, name, tbl_name, sql FROM sqlite_schema ORDER BY name
        INSERT INTO t(a, b) VALUES (1, 'after')
        SELECT id FROM t WHERE b = 'after'
        """);
}

@test
fn failAndRollbackActions() -> Result<void, TestFailure> {
    return sameSession("fail-rollback", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, u UNIQUE, n NOT NULL ON CONFLICT FAIL, s)
        CREATE INDEX t_s ON t(s)
        INSERT INTO t VALUES (1, 'a', 1, 'x')
        INSERT OR FAIL INTO t VALUES (2, 'b', 2, 'y'), (3, 'a', 3, 'z'), (4, 'c', 4, 'w')
        SELECT changes(), total_changes()
        SELECT * FROM t
        BEGIN
        INSERT INTO t VALUES (5, 'e', 5, 'v')
        INSERT OR ROLLBACK INTO t VALUES (6, 'f', 6, 'u'), (7, 'a', 7, 't')
        SELECT * FROM t
        COMMIT
        INSERT INTO t VALUES (8, 'h', 8, 's'), (9, 'i', NULL, 'r'), (10, 'j', 10, 'q')
        SELECT * FROM t
        WITH RECURSIVE q(i) AS (SELECT 100 UNION ALL SELECT i + 1 FROM q WHERE i < 900) INSERT INTO t SELECT i, 'k' || i, i, printf('%.*c', i % 30, 's') FROM q
        DELETE FROM t WHERE id % 2 = 0 AND id > 100
        UPDATE OR FAIL t SET u = 'z', s = 'moved' WHERE id >= 2
        SELECT count(*), sum(s = 'moved') FROM t
        SELECT * FROM t WHERE id < 100
        CREATE TABLE r(x)
        CREATE TRIGGER tr BEFORE INSERT ON r WHEN new.x = 3 BEGIN SELECT RAISE(FAIL, 'three'); END
        INSERT INTO r VALUES (1), (2), (3), (4)
        SELECT * FROM r
        BEGIN
        INSERT INTO r VALUES (10)
        CREATE TRIGGER tr2 BEFORE INSERT ON r WHEN new.x = 20 BEGIN SELECT RAISE(ROLLBACK, 'twenty'); END
        INSERT INTO r VALUES (20)
        SELECT * FROM r
        COMMIT
        PRAGMA integrity_check
        """);
}

@test
fn vacuumIntoWritesACopy() -> Result<void, TestFailure> {
    let copy = "out/vacuum-into-copy.db";
    let _ = File.remove(copy);
    let existing = "out/vacuum-into-existing.db";
    let _ = File.create(existing)!;
    sameScript("vacuum-into", """
        PRAGMA user_version = 3
        CREATE TABLE t(id INTEGER PRIMARY KEY, a, b TEXT)
        CREATE INDEX t_a ON t(a)
        WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 500) INSERT INTO t(a, b) SELECT i % 13, printf('%.*c', i * 7, 'y') FROM n
        DELETE FROM t WHERE id % 3 = 0
        VACUUM INTO NULL
        VACUUM INTO 5
        VACUUM INTO 'out/vacuum-into-existing.db'
        SELECT count(*) FROM t
        """)?;
    // Ours writes a copy that sqlite3 reads, intact, with the same rows.
    var session = Session.open("out/script-ours-vacuum-into.db")!;
    let none = Vector<SqliteValue>.create();
    let _ = session.query("VACUUM INTO 'out/vacuum-into-copy.db'", none.view())!;
    Check.equalText("ok\n", askSqlite(copy, "PRAGMA integrity_check")?.view())?;
    Check.equalText("334|3|0\n", askSqlite(copy, "SELECT count(*), (SELECT user_version FROM pragma_user_version), (SELECT freelist_count FROM pragma_freelist_count) FROM t")?.view())?;
    Check.equalText(askSqlite("out/script-ours-vacuum-into.db", "SELECT sum(length(b)), sum(a) FROM t")?.view(), askSqlite(copy, "SELECT sum(length(b)), sum(a) FROM t")?.view())?;
    match (session.query("VACUUM INTO 'out/vacuum-into-copy.db'", none.view())) {
        Err(e) => { Check.equalText("output file already exists", e.messageText()!.view())?; }
        Ok(_) => { return Check.fail("expected the existing file to be refused"); }
    }
    return Ok();
}

/// `text` with every `from` replaced by `to`.
fn replaceAll(text: StringView, from: StringView, to: StringView) -> String {
    var out = String.create();
    var first = true;
    for (part in text.split(from)) {
        if (!first) {
            out.append(to)!;
        }
        first = false;
        out.append(part)!;
    }
    return out;
}

@test
fn tempTablesAndAttachedDatabases() -> Result<void, TestFailure> {
    freshPath("out/attach-theirs.db");
    freshPath("out/attach-ours.db");
    sameSessionWith("attach", """
        CREATE TABLE t(id INTEGER PRIMARY KEY, v)
        INSERT INTO t VALUES (1, 'main1'), (2, 'main2')
        CREATE TEMP TABLE t(id INTEGER PRIMARY KEY, v)
        INSERT INTO t VALUES (10, 'temp10')
        SELECT * FROM t
        SELECT * FROM main.t ORDER BY id
        SELECT * FROM temp.t
        CREATE TEMPORARY TABLE scratch(x UNIQUE)
        INSERT INTO scratch SELECT v FROM main.t
        INSERT INTO scratch VALUES ('main1')
        SELECT * FROM scratch ORDER BY x
        CREATE TEMP VIEW tv AS SELECT x FROM scratch WHERE x LIKE '%2'
        SELECT * FROM tv
        SELECT type, name, tbl_name FROM sqlite_temp_schema ORDER BY name
        SELECT type, name FROM temp.sqlite_master ORDER BY name
        SELECT name FROM sqlite_schema ORDER BY name
        ATTACH 'AUXFILE' AS aux
        ATTACH 'AUXFILE' AS aux
        ATTACH 'x' AS main
        CREATE TABLE aux.u(k TEXT PRIMARY KEY, n INT)
        CREATE INDEX aux.u_n ON u(n)
        INSERT INTO aux.u VALUES ('a', 1), ('b', 2)
        INSERT INTO u SELECT v, id FROM main.t
        SELECT * FROM u ORDER BY k
        SELECT u.k, t.v FROM aux.u JOIN main.t ON t.id = u.n ORDER BY 1
        UPDATE aux.u SET n = n * 10 WHERE k > 'a'
        DELETE FROM u WHERE n = 1
        SELECT * FROM aux.u ORDER BY k
        SELECT name, tbl_name FROM aux.sqlite_schema ORDER BY name
        SELECT seq, name FROM pragma_database_list
        CREATE TEMP TRIGGER tr AFTER INSERT ON main.t BEGIN INSERT INTO scratch VALUES (new.v); END
        INSERT INTO main.t VALUES (3, 'main3')
        SELECT * FROM scratch ORDER BY x
        BEGIN
        INSERT INTO aux.u VALUES ('z', 26)
        INSERT INTO main.t VALUES (4, 'main4')
        ROLLBACK
        SELECT count(*) FROM aux.u
        SELECT count(*) FROM main.t
        BEGIN
        INSERT INTO aux.u VALUES ('y', 25)
        DETACH aux
        COMMIT
        SELECT count(*) FROM aux.u
        DROP TABLE temp.t
        SELECT * FROM t ORDER BY id
        DROP TABLE aux.u
        SELECT name FROM aux.sqlite_schema
        DETACH aux
        DETACH aux
        DETACH main
        DETACH temp
        SELECT * FROM nosuch.t
        CREATE TABLE nosuch.t(x)
        """, "out/attach-theirs.db", "out/attach-ours.db")?;
    // The attached file this engine wrote is a sound database with the rows sqlite3's has.
    Check.equalText("ok\n", askSqlite("out/attach-ours.db", "PRAGMA integrity_check")?.view())?;
    Check.equalText(askSqlite("out/attach-theirs.db", "SELECT type, name FROM sqlite_schema ORDER BY name")?.view(), askSqlite("out/attach-ours.db", "SELECT type, name FROM sqlite_schema ORDER BY name")?.view())?;
    return Ok();
}
